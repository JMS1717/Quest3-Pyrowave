#version 450

// YCbCr -> RGBA8, BT.709, full or limited range by push constant.
//
// This is the pass ALVR's GLES client needs and a Vulkan-native client would not: PyroWave
// decodes into three single-component planes, but GLES can only import an RGBA8
// AHardwareBuffer on this device, so the planes have to be combined before the handoff.
//
// The range must match what the server encoded (Settings::m_useFullRangeEncoding). Getting it
// wrong is silent and costs ~25 dB: lifted blacks and crushed whites, looking like a codec fault.
//
// Chroma is read through a sampler rather than by integer index, so 4:2:0 upsamples for free and
// 4:4:4 costs the same code path.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D planeY;
layout(set = 0, binding = 1) uniform sampler2D planeCb;
layout(set = 0, binding = 2) uniform sampler2D planeCr;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outImage;

layout(push_constant) uniform Params { int limitedRange; int chromaFilter; } params;

// PyroWave multilevel Haar mode 3 writes luma as RGBA8 at half size, one 2x2 pixel quad per texel
// in the order (0,0), (1,0), (0,1), (1,1).
layout(constant_id = 0) const bool PACKED_LUMA = false;

float fetch_luma(ivec2 coord) {
    if (PACKED_LUMA)
        return texelFetch(planeY, coord >> 1, 0)[(coord.x & 1) | ((coord.y & 1) << 1)];
    return texelFetch(planeY, coord, 0).r;
}

float catmull(float a, float b, float c, float d, float t) {
    return b + 0.5 * t * (c - a + t * (2.0 * a - 5.0 * b + 4.0 * c - d + t * (3.0 * (b - c) + d - a)));
}

float sample_chroma(sampler2D plane, vec2 uv) {
    if (params.chromaFilter == 0)
        return texture(plane, uv).r;
    vec2 size = vec2(textureSize(plane, 0));
    vec2 coord = uv * size - 0.5;
    vec2 f = fract(coord);
    ivec2 i0 = ivec2(floor(coord));
    ivec2 last = ivec2(size) - 1;
    float col[4];
    for (int x = 0; x < 4; x++) {
        float row[4];
        for (int y = 0; y < 4; y++) {
            ivec2 p = clamp(i0 + ivec2(x - 1, y - 1), ivec2(0), last);
            row[y] = texelFetch(plane, p, 0).r;
        }
        col[x] = catmull(row[0], row[1], row[2], row[3], f.y);
    }
    return catmull(col[0], col[1], col[2], col[3], f.x);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);

    float Y = fetch_luma(coord);
    float Cb = sample_chroma(planeCb, uv);
    float Cr = sample_chroma(planeCr, uv);

    if (params.limitedRange != 0) {
        // 8-bit limited: Y 16..235 -> 0..1, chroma 16..240 -> -0.5..0.5
        Y = (Y - 16.0 / 255.0) * (255.0 / 219.0);
        Cb = (Cb - 128.0 / 255.0) * (255.0 / 224.0);
        Cr = (Cr - 128.0 / 255.0) * (255.0 / 224.0);
    } else {
        Cb -= 0.5;
        Cr -= 0.5;
    }

    vec3 rgb = vec3(Y + 1.5748 * Cr,
                    Y - 0.1873 * Cb - 0.4681 * Cr,
                    Y + 1.8556 * Cb);

    imageStore(outImage, coord, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
