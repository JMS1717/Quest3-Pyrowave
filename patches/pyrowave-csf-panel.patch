+	// PSNR-HVS-M at panel resolution, and is neutral at 2784 (docs/ENCODER-CSF.md).
+	const float panel_scale = std::max(1.0f, float(height) / 2208.0f);
+	const float cpd_nyquist = cpd_override > 0.0f ? cpd_override : 0.5f * float(height) / 99.0f * panel_scale;
 
