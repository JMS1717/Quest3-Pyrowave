index 0000000000000000000000000000000000000000..bce9285f5e273b849c294c286111f2909cc96d6b
--- /dev/null
+++ b/src/tests/hello_xr/src/main/java/com/xrwired/distortiongrid/StereoDecoder.java
@@ -0,0 +1,111 @@
+package com.xrwired.distortiongrid;
+
+import android.app.Activity;
+import android.graphics.SurfaceTexture;
+import android.media.MediaCodec;
+import android.media.MediaFormat;
+import android.util.Log;
+import android.view.Surface;
+
+import java.io.BufferedInputStream;
+import java.io.DataInputStream;
+import java.io.EOFException;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.ByteBuffer;
+
+public final class StereoDecoder {
+    private static final String TAG = "XRWiredStereo";
+    private static final int PORT = 45101;
+    private static final int MAX_AU = 16 * 1024 * 1024;
+    private final SurfaceTexture texture;
+    private final Surface surface;
+    private volatile boolean running = true;
+
+    public StereoDecoder(Activity activity, int textureName) {
+        texture = new SurfaceTexture(textureName);
+        surface = new Surface(texture);
+        Thread thread = new Thread(this::serve, "xr-stereo-decoder");
+        thread.start();
+        Log.i(TAG, "Stereo decoder listening on " + PORT);
+    }
+
+    public SurfaceTexture getSurfaceTexture() { return texture; }
+
+    private void serve() {
+        while (running) {
+            try (ServerSocket server = new ServerSocket(PORT); Socket socket = server.accept()) {
+                socket.setTcpNoDelay(true);
+                decode(socket);
+            } catch (Exception error) {
+                if (running) {
+                    Log.e(TAG, "Stereo stream failed", error);
+                    try { Thread.sleep(500); } catch (InterruptedException ignored) { }
+                }
+            }
+        }
+    }
+
+    private void decode(Socket socket) throws Exception {
+        DataInputStream input = new DataInputStream(new BufferedInputStream(socket.getInputStream(), 1024 * 1024));
+        byte[] magic = new byte[4];
+        input.readFully(magic);
+        boolean hevc = magic[0] == 'X' && magic[1] == 'R' && magic[2] == 'H' && magic[3] == '1';
+        boolean avc = magic[0] == 'X' && magic[1] == 'R' && magic[2] == 'S' && magic[3] == '1';
+        if (!hevc && !avc)
+            throw new IllegalArgumentException("Bad stereo stream magic");
+        int width = input.readInt();
+        int height = input.readInt();
+        int fps = input.readInt();
+        texture.setDefaultBufferSize(width, height);
+
+        MediaCodec codec;
+        String mime = hevc ? MediaFormat.MIMETYPE_VIDEO_HEVC : MediaFormat.MIMETYPE_VIDEO_AVC;
+        try { codec = MediaCodec.createByCodecName(hevc ? "c2.qti.hevc.decoder.low_latency" : "c2.qti.avc.decoder.low_latency"); }
+        catch (Exception unavailable) { codec = MediaCodec.createDecoderByType(mime); }
+        MediaFormat format = MediaFormat.createVideoFormat(mime, width, height);
+        format.setInteger(MediaFormat.KEY_LOW_LATENCY, 1);
+        format.setInteger(MediaFormat.KEY_PRIORITY, 0);
+        format.setInteger(MediaFormat.KEY_OPERATING_RATE, fps);
+        format.setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, MAX_AU);
+        codec.configure(format, surface, null, 0);
+        codec.start();
+        Log.i(TAG, "Decoding " + width + "x" + height + "@" + fps + " " + (hevc ? "HEVC" : "H264") + " with " + codec.getName());
+        MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+        long frames = 0;
+        try {
+            while (running) {
+                int size;
+                try { size = input.readInt(); } catch (EOFException done) { break; }
+                long ptsUs = input.readLong();
+                if (size <= 0 || size > MAX_AU) throw new IllegalArgumentException("Bad AU size " + size);
+                byte[] au = new byte[size];
+                input.readFully(au);
+                int index;
+                do {
+                    drain(codec, info);
+                    index = codec.dequeueInputBuffer(10_000);
+                } while (index < 0 && running);
+                if (index < 0) break;
+                ByteBuffer buffer = codec.getInputBuffer(index);
+                if (buffer == null || buffer.capacity() < size) throw new IllegalStateException("Input buffer too small");
+                buffer.clear();
+                buffer.put(au);
+                codec.queueInputBuffer(index, 0, size, ptsUs, 0);
+                drain(codec, info);
+                if (++frames % 60 == 0) Log.i(TAG, "Decoded stereo AUs: " + frames);
+            }
+        } finally {
+            try { codec.stop(); } catch (Exception ignored) { }
+            codec.release();
+        }
+    }
+
+    private static void drain(MediaCodec codec, MediaCodec.BufferInfo info) {
+        while (true) {
+            int output = codec.dequeueOutputBuffer(info, 0);
+            if (output >= 0) codec.releaseOutputBuffer(output, true);
+            else if (output != MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) break;
+        }
+    }
+}
