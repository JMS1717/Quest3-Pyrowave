 				cmd.begin_region("iDWT final");
@@ -1135,6 +1137,19 @@ void Decoder::set_idwt_enabled(bool enabled)
 	impl->idwt_enabled = enabled;
 }
 
+bool Decoder::set_skip_final_luma_idwt(bool enabled)
+{
+	// The caller's shader mirrors only the original pair-local Haar pass with FP32 math and
+	// FP16 storage. Fused multilevel Haar, dedicated pair kernels, other precisions, 4:4:4 and
+	// the fragment path keep their own final pass, so refuse rather than leave luma unwritten.
+	if (enabled && (!impl->haar || impl->chroma != ChromaSubsampling::Chroma420 || impl->fragment_path ||
+	                impl->fused_haar || impl->haar_pairs_mode != 0 ||
+	                Configuration::get().get_precision() != 1))
+		return false;
+	impl->skip_final_luma_idwt = enabled;
+	return true;
+}
