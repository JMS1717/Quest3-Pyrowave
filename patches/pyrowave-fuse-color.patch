     }();
 	bool timestamp_recording = true;
 	bool idwt_enabled = true;   // XRW Experiment 3
+	// Q3PW fuse_color: the caller reconstructs final 4:2:0 Haar luma with colour conversion.
+	bool skip_final_luma_idwt = false;
 
 	BufferHandle dequant_offset_buffer, payload_data;
 	BufferViewHandle payload_u32_view, payload_u16_view, payload_u8_view;
@@ -812,7 +814,7 @@ bool Decoder::Impl::idwt(CommandBuffer &cmd, const ViewBuffers &views)
 					cmd.end_region();
