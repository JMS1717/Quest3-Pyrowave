+namespace PyroWave {
+void Decoder::set_timestamp_recording(bool enabled) { impl->timestamp_recording = enabled; }
+bool Decoder::prerecord_upload_fits() const {
+    if (!impl->payload_data) return false;
+    const uint64_t capacity = impl->payload_data->get_create_info().size;
+    // Same +16 robustness padding as upload_payload. No growth/replacement of
+    // GPU payload storage while the preceding submission is outstanding.
+    return capacity >= 16 && impl->payload_data_cpu.size() <= (capacity - 16) / sizeof(uint32_t);
+}
