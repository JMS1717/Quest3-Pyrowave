-            Ok(d) => d,
-            Err(e) => {
-                // would be "warn!" but this is a severe caveat and a pretty major error.
-                error!("Attempting software fallback due to error in default decoder: {e:#}");
-
-                decoder_attempt_setup(config.codec, true, &format, &image_reader)?
+        let named = decoder_name.as_deref().map(|name| {
+            decoder_attempt_setup(config.codec, false, Some(name), &format, &image_reader)
+                .inspect_err(|e| error!("Named decoder {name} failed, using default: {e:#}"))
+        });
+        match named {
+            Some(Ok(d)) => {
+                info!("Using named decoder {}", decoder_name.as_deref().unwrap_or_default());
+                d
