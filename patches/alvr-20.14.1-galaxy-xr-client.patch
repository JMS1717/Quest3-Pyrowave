@@ -254,7 +261,16 @@ fn decoder_lifecycle(
     format.set_i32("height", 1024);
     format.set_buffer("csd-0", &csd_0);
 
+    let decoder_name = config
+        .options
+        .iter()
+        .find(|(key, _)| key == DECODER_NAME_OPTION)
+        .map(|(_, prop)| prop.value.clone());
+
     for (key, prop) in &config.options {
+        if key == DECODER_NAME_OPTION {
+            continue;
+        }
         let maybe_error = match prop.ty {
             MediacodecPropType::Float => prop
