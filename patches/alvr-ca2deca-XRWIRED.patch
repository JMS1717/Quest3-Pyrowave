+// One-frame diagnostic: read back actual pixels instead of inferring capture health from packets.
+void ProbeTexture(CD3DRender& render, ID3D11Texture2D* texture, const char* label) {
+    D3D11_TEXTURE2D_DESC desc = {};
+    texture->GetDesc(&desc);
+    Info("[XRWIRED] PixelProbe %s: size=%ux%u format=%u\n", label, desc.Width, desc.Height, desc.Format);
+    if (desc.Format != DXGI_FORMAT_R8G8B8A8_UNORM && desc.Format != DXGI_FORMAT_R8G8B8A8_UNORM_SRGB
+        && desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM && desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM_SRGB) {
+        return;
+    }
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> staging;
+    HRESULT hr = render.GetDevice()->CreateTexture2D(&desc, nullptr, &staging);
+    if (FAILED(hr)) { Info("[XRWIRED] PixelProbe %s: create failed=%ld\n", label, hr); return; }
+    render.GetContext()->CopyResource(staging.Get(), texture);
+    D3D11_MAPPED_SUBRESOURCE mapped = {};
+    hr = render.GetContext()->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &mapped);
+    if (FAILED(hr)) { Info("[XRWIRED] PixelProbe %s: map failed=%ld\n", label, hr); return; }
+    for (unsigned x : { desc.Width / 4, desc.Width / 2, desc.Width * 3 / 4 }) {
+        const auto* pixel = static_cast<const unsigned char*>(mapped.pData) + (desc.Height / 2) * mapped.RowPitch + x * 4;
+        Info("[XRWIRED] PixelProbe %s x=%u: RGBA=%u,%u,%u,%u\n", label, x, pixel[0], pixel[1], pixel[2], pixel[3]);
+    }
+    render.GetContext()->Unmap(staging.Get(), 0);
+}
