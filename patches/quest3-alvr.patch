diff --git a/alvr/client_core/src/wired_video.rs b/alvr/client_core/src/wired_video.rs
new file mode 100644
index 0000000000000000000000000000000000000000..945f83fe933804864acec796c24e18855c63ab7a
--- /dev/null
+++ b/alvr/client_core/src/wired_video.rs
@@ -0,0 +1,291 @@
+//! PyroWave's parallel wired video connections (alvr_packets::PYROWAVE_WIRED_PORT and up). Each
+//! connection carries one contiguous slice of every frame; a frame whose slices have all arrived
+//! goes to the decoder exactly as if it had arrived on ALVR's video stream.
+
+use crate::connection::ConnectionContext;
+use alvr_common::{info, parking_lot::Mutex, warn, ConnectionState};
+use alvr_packets::{
+    PyroWaveSliceHeader, PYROWAVE_WIRED_HEADER_LEN, PYROWAVE_WIRED_HELLO,
+    PYROWAVE_WIRED_MAX_CONNECTIONS, PYROWAVE_WIRED_PORT,
+};
+use std::{
+    io::{ErrorKind, Read, Write},
+    net::{Ipv4Addr, TcpListener, TcpStream},
+    sync::Arc,
+    thread::{self, JoinHandle},
+    time::{Duration, Instant},
+};
+
+const READ_TIMEOUT: Duration = Duration::from_millis(500);
+const ACCEPT_POLL: Duration = Duration::from_millis(20);
+/// Frames older than the newest complete one are dropped, so only a few can be pending at once.
+const MAX_PENDING: usize = 8;
+
+fn is_streaming(ctx: &ConnectionContext) -> bool {
+    *ctx.state.read() == ConnectionState::Streaming
+}
+
+/// Binds the listeners before the client reports StreamReady, so the server's connects wait in
+/// the backlog. Loopback only: adb delivers forwarded connections on the headset's loopback.
+pub fn listen(count: u32) -> Vec<TcpListener> {
+    let count = count.min(PYROWAVE_WIRED_MAX_CONNECTIONS as u32) as u16;
+    let mut listeners = vec![];
+    for i in 0..count {
+        match TcpListener::bind((Ipv4Addr::LOCALHOST, PYROWAVE_WIRED_PORT + i)) {
+            Ok(listener) => listeners.push(listener),
+            Err(e) => {
+                // The server then gets no hello on this port and keeps video on the stream socket.
+                warn!("PyroWave wired video port {}: {e}", PYROWAVE_WIRED_PORT + i);
+                return vec![];
+            }
+        }
+    }
+    listeners
+}
+
+struct Pending {
+    header: PyroWaveSliceHeader,
+    frame: Vec<u8>,
+    /// Byte ranges already written, so a repeated or overlapping slice is not counted twice.
+    ranges: Vec<(u32, u32)>,
+    received: usize,
+}
+
+/// Frame order: the server's sequence number, or the timestamp from an older server that sends
+/// none. A repeated timestamp is a different frame, so timestamps alone cannot key frames.
+fn frame_key(h: &PyroWaveSliceHeader) -> u64 {
+    if h.sequence != 0 {
+        h.sequence as u64
+    } else {
+        h.timestamp_ns
+    }
+}
+
+#[derive(Default)]
+struct Assembly {
+    pending: Vec<Pending>,
+    last_complete: u64,
+    complete: u64,
+    dropped: u64,
+    rejected: u64,
+    last_log: Option<Instant>,
+}
+
+impl Assembly {
+    fn push(&mut self, slice: PyroWaveSliceHeader, data: &[u8]) -> Option<(PyroWaveSliceHeader, Vec<u8>)> {
+        let key = frame_key(&slice);
+        if key <= self.last_complete {
+            self.dropped += 1;
+            return None;
+        }
+        let index = match self.pending.iter().position(|p| frame_key(&p.header) == key) {
+            Some(index) => index,
+            None => {
+                crate::frame_trace::record(b'F', slice.timestamp_ns, slice.frame_len as i64, slice.offset as i64);
+                if self.pending.len() >= MAX_PENDING {
+                    self.pending.remove(0);
+                    self.dropped += 1;
+                }
+                self.pending.push(Pending {
+                    header: slice,
+                    frame: vec![0; slice.frame_len as usize],
+                    ranges: vec![],
+                    received: 0,
+                });
+                self.pending.len() - 1
+            }
+        };
+        let pending = &mut self.pending[index];
+        let (start, end) = (slice.offset, slice.offset + slice.len);
+        if pending.header.frame_len != slice.frame_len
+            || pending.header.timestamp_ns != slice.timestamp_ns
+            || pending.ranges.iter().any(|&(s, e)| start < e && s < end)
+        {
+            self.rejected += 1;
+            return None;
+        }
+        pending.frame[start as usize..end as usize].copy_from_slice(data);
+        pending.ranges.push((start, end));
+        pending.received += data.len();
+        if pending.received < pending.frame.len() {
+            return None;
+        }
+        let Pending { header, frame, .. } = self.pending.remove(index);
+        self.last_complete = key;
+        let before = self.pending.len();
+        self.pending.retain(|p| frame_key(&p.header) > key);
+        self.dropped += (before - self.pending.len()) as u64;
+        self.complete += 1;
+        if self.last_log.is_none_or(|t| t.elapsed() > Duration::from_secs(5)) {
+            self.last_log = Some(Instant::now());
+            info!(
+                "PyroWave wired video: {} frames complete, {} dropped, {} rejected",
+                self.complete, self.dropped, self.rejected
+            );
+        }
+        Some((header, frame))
+    }
+}
+
+/// Reads exactly `buf.len()` bytes, giving up when the stream ends or the connection closes.
+fn read_full(ctx: &ConnectionContext, stream: &mut TcpStream, buf: &mut [u8]) -> bool {
+    let mut done = 0;
+    while done < buf.len() {
+        match stream.read(&mut buf[done..]) {
+            Ok(0) => return false,
+            Ok(n) => done += n,
+            Err(e) if matches!(e.kind(), ErrorKind::WouldBlock | ErrorKind::TimedOut | ErrorKind::Interrupted) => {
+                if !is_streaming(ctx) {
+                    return false;
+                }
+            }
+            Err(_) => return false,
+        }
+    }
+    true
+}
+
+fn accept(ctx: &ConnectionContext, listener: &TcpListener) -> Option<TcpStream> {
+    listener.set_nonblocking(true).ok()?;
+    while is_streaming(ctx) {
+        match listener.accept() {
+            Ok((stream, _)) => return Some(stream),
+            Err(e) if e.kind() == ErrorKind::WouldBlock => thread::sleep(ACCEPT_POLL),
+            Err(e) => {
+                warn!("PyroWave wired video accept: {e}");
+                return None;
+            }
+        }
+    }
+    None
+}
+
+fn deliver(ctx: &ConnectionContext, header: PyroWaveSliceHeader, frame: &[u8]) {
+    let timestamp = Duration::from_nanos(header.timestamp_ns);
+    crate::frame_trace::record(b'A', header.timestamp_ns, frame.len() as i64, 0);
+    if let Some(stats) = &mut *ctx.statistics_manager.lock() {
+        stats.report_video_packet_received(timestamp);
+    }
+    crate::push_foveation_center(timestamp, header.foveation_center);
+    // PyroWave frames are independent, so a frame the decoder refuses needs no IDR.
+    if let Some(callback) = ctx.decoder_callback.lock().as_mut() {
+        callback(timestamp, frame);
+    }
+}
+
+fn receive(ctx: &ConnectionContext, listener: TcpListener, assembly: &Mutex<Assembly>) -> Option<()> {
+    let mut stream = accept(ctx, &listener)?;
+    drop(listener);
+    stream.set_nonblocking(false).ok()?;
+    stream.set_nodelay(true).ok()?;
+    stream.set_read_timeout(Some(READ_TIMEOUT)).ok()?;
+    stream.write_all(&PYROWAVE_WIRED_HELLO).ok()?;
+    let mut head = [0u8; PYROWAVE_WIRED_HEADER_LEN];
+    let mut slice = Vec::new();
+    while is_streaming(ctx) {
+        if !read_full(ctx, &mut stream, &mut head) {
+            return None;
+        }
+        let Some(header) = PyroWaveSliceHeader::from_bytes(&head) else {
+            warn!("PyroWave wired video: malformed slice header, closing the connection");
+            return None;
+        };
+        slice.resize(header.len as usize, 0);
+        if !read_full(ctx, &mut stream, &mut slice) {
+            return None;
+        }
+        let complete = assembly.lock().push(header, &slice);
+        if let Some((header, frame)) = complete {
+            deliver(ctx, header, &frame);
+        }
+    }
+    Some(())
+}
+
+/// One thread per connection; each exits when the stream ends or its connection closes.
+pub fn spawn_receivers(ctx: &Arc<ConnectionContext>, listeners: Vec<TcpListener>) -> Vec<JoinHandle<()>> {
+    let assembly = Arc::new(Mutex::new(Assembly::default()));
+    listeners
+        .into_iter()
+        .enumerate()
+        .map(|(index, listener)| {
+            let ctx = Arc::clone(ctx);
+            let assembly = Arc::clone(&assembly);
+            thread::spawn(move || {
+                crate::thread_hints::publish_current(
+                    crate::thread_hints::ThreadRole::ApplicationWorker,
+                    ["wired_video_0", "wired_video_1", "wired_video_2", "wired_video_3"][index.min(3)],
+                );
+                receive(&ctx, listener, &assembly);
+            })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn numbered(sequence: u32, ts: u64, frame_len: u32, offset: u32, len: u32) -> PyroWaveSliceHeader {
+        PyroWaveSliceHeader { timestamp_ns: ts, frame_len, offset, len, is_idr: false, sequence, foveation_center: [[0.0; 2]; 2] }
+    }
+
+    fn slice(ts: u64, frame_len: u32, offset: u32, len: u32) -> PyroWaveSliceHeader {
+        numbered(0, ts, frame_len, offset, len)
+    }
+
+    #[test]
+    fn slices_in_any_order_make_one_frame() {
+        let mut a = Assembly::default();
+        assert!(a.push(slice(10, 6, 3, 3), &[4, 5, 6]).is_none());
+        let (h, frame) = a.push(slice(10, 6, 0, 3), &[1, 2, 3]).unwrap();
+        assert_eq!(h.timestamp_ns, 10);
+        assert_eq!(frame, [1, 2, 3, 4, 5, 6]);
+        assert!(a.pending.is_empty());
+    }
+
+    #[test]
+    fn older_frames_are_dropped_once_a_newer_one_completes() {
+        let mut a = Assembly::default();
+        assert!(a.push(slice(10, 4, 0, 2), &[1, 2]).is_none());
+        assert!(a.push(slice(20, 2, 0, 2), &[7, 8]).is_some());
+        assert!(a.pending.is_empty());
+        assert_eq!(a.dropped, 1);
+        assert!(a.push(slice(10, 4, 2, 2), &[3, 4]).is_none());
+        assert_eq!(a.dropped, 2);
+    }
+
+    #[test]
+    fn a_repeated_timestamp_never_mixes_two_frames() {
+        // A game stutter makes the encoder send two frames with one timestamp. Their slices
+        // interleave across connections; each frame must still complete with only its own bytes.
+        let mut a = Assembly::default();
+        assert!(a.push(numbered(1, 10, 4, 0, 2), &[1, 1]).is_none());
+        assert!(a.push(numbered(2, 10, 4, 0, 2), &[2, 2]).is_none());
+        let (h, frame) = a.push(numbered(1, 10, 4, 2, 2), &[1, 1]).unwrap();
+        assert_eq!((h.sequence, frame), (1, vec![1, 1, 1, 1]));
+        let (h, frame) = a.push(numbered(2, 10, 4, 2, 2), &[2, 2]).unwrap();
+        assert_eq!((h.sequence, frame), (2, vec![2, 2, 2, 2]));
+        assert_eq!(a.rejected, 0);
+    }
+
+    #[test]
+    fn a_repeated_slice_does_not_complete_a_frame() {
+        let mut a = Assembly::default();
+        assert!(a.push(numbered(1, 10, 4, 0, 2), &[1, 2]).is_none());
+        assert!(a.push(numbered(1, 10, 4, 0, 2), &[1, 2]).is_none());
+        assert!(a.push(numbered(1, 10, 4, 1, 2), &[9, 9]).is_none());
+        assert_eq!(a.rejected, 2);
+        let (_, frame) = a.push(numbered(1, 10, 4, 2, 2), &[3, 4]).unwrap();
+        assert_eq!(frame, [1, 2, 3, 4]);
+    }
+
+    #[test]
+    fn a_slice_disagreeing_with_its_frame_is_rejected() {
+        let mut a = Assembly::default();
+        assert!(a.push(numbered(1, 10, 4, 0, 2), &[1, 2]).is_none());
+        assert!(a.push(numbered(1, 11, 4, 2, 2), &[3, 4]).is_none());
+        assert!(a.push(numbered(1, 10, 6, 2, 2), &[3, 4]).is_none());
+        assert_eq!(a.rejected, 2);
+    }
+}
