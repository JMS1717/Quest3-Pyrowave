diff --git a/alvr/session/src/headset_settings.rs b/alvr/session/src/headset_settings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cc2e5185b2e6892a7d98295c00a10080a22d6682
--- /dev/null
+++ b/alvr/session/src/headset_settings.rs
@@ -0,0 +1,343 @@
+//! Settings the headset menu may change, and how the server turns a request into session edits.
+//! The client never names a session path: it sends typed fields, and only the assignments built
+//! here reach `set_values`, after each value is checked against a fixed range.
+
+use crate::{
+    beta::PANEL_PER_EYE,
+    settings::{BitrateMode, CodecType, FrameSize, Settings},
+};
+use serde::{Deserialize, Serialize};
+use serde_json as json;
+
+/// Highest bitrate any control offers (the schema sliders, the dashboard and the headset menu).
+/// It is a ceiling, not a sustainable rate: measured ADB forwarding carries about 2.5 Gbit/s.
+pub const MAX_BITRATE_MBPS: u64 = 4000;
+pub const BITRATE_MBPS: (u64, u64, u64) = (100, MAX_BITRATE_MBPS, 50);
+/// Matches the dashboard's stream scales. Above 100% adds Quest decode work with no panel benefit.
+pub const STREAM_PERCENT: (u32, u32, u32) = (50, 100, 10);
+/// Matches the dashboard's game render scales. The PC filters the render down to the stream size,
+/// so this costs PC GPU time only.
+pub const RENDER_PERCENT: (u32, u32, u32) = (100, 200, 25);
+
+/// Every field is optional; `None` leaves that setting alone.
+#[derive(Serialize, Deserialize, Clone, Debug, Default, PartialEq)]
+pub struct HeadsetSettingsRequest {
+    pub request_id: u32,
+    pub refresh_hz: Option<f32>,
+    pub bitrate_mbps: Option<u64>,
+    pub chroma_444: Option<bool>,
+    /// Encoded (streamed) per-eye size, percent of the Quest 3 panel
+    pub stream_percent: Option<u32>,
+    /// Size SteamVR asks the game to render per eye, percent of the Quest 3 panel
+    pub render_percent: Option<u32>,
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+pub struct HeadsetSettingsAck {
+    pub request_id: u32,
+    pub applied: bool,
+    /// The stream ends and reconnects so the new values take effect
+    pub reconnect: bool,
+    pub message: String,
+}
+
+#[derive(Debug, PartialEq)]
+pub struct HeadsetSettingsPlan {
+    /// Paths relative to `session_settings`, as in `beta::StreamingProfile`
+    pub assignments: Vec<(String, json::Value)>,
+    pub reconnect: bool,
+    pub changes: Vec<String>,
+}
+
+/// Per-eye size for a percentage of the Quest 3 panel.
+pub fn panel_percent_size(percent: u32) -> (u32, u32) {
+    crate::beta::render_scale_size(percent)
+}
+
+/// The panel percentage a configured size corresponds to, when it can be known from settings
+/// alone. `Scale` is relative to the headset's recommended size, which only the client knows.
+pub fn frame_size_percent(size: &FrameSize) -> Option<u32> {
+    match size {
+        FrameSize::Absolute { width, .. } => {
+            Some((*width as f64 * 100.0 / PANEL_PER_EYE.0 as f64).round() as u32)
+        }
+        FrameSize::Scale(_) => None,
+    }
+}
+
+fn check_step(name: &str, value: u64, (min, max, step): (u64, u64, u64)) -> Result<(), String> {
+    if value < min || value > max || (value - min) % step != 0 {
+        Err(format!("{name} {value} is outside {min}-{max} in steps of {step}"))
+    } else {
+        Ok(())
+    }
+}
+
+fn size_matches(size: &FrameSize, percent: u32) -> bool {
+    let (width, height) = panel_percent_size(percent);
+    matches!(size, FrameSize::Absolute { width: w, height: Some(h) } if *w == width && *h == height)
+}
+
+fn size_assignments(field: &str, percent: u32) -> Vec<(String, json::Value)> {
+    let (width, height) = panel_percent_size(percent);
+    vec![
+        (format!("video.{field}.variant"), "Absolute".into()),
+        (format!("video.{field}.Absolute.width"), width.into()),
+        (format!("video.{field}.Absolute.height.set"), true.into()),
+        (format!("video.{field}.Absolute.height.content"), height.into()),
+    ]
+}
+
+/// Validates the whole request before anything is assigned, so a bad field rejects all of it.
+/// `supported_refresh` is the list the client confirmed when this stream was negotiated.
+pub fn plan(
+    request: &HeadsetSettingsRequest,
+    settings: &Settings,
+    supported_refresh: &[f32],
+) -> Result<HeadsetSettingsPlan, String> {
+    let video = &settings.video;
+    let mut plan = HeadsetSettingsPlan {
+        assignments: vec![],
+        reconnect: false,
+        changes: vec![],
+    };
+
+    if let Some(mbps) = request.bitrate_mbps {
+        check_step("Bitrate", mbps, BITRATE_MBPS)?;
+        if !matches!(video.bitrate.mode, BitrateMode::ConstantMbps(current) if current == mbps) {
+            plan.assignments.extend([
+                ("video.bitrate.mode.variant".into(), "ConstantMbps".into()),
+                ("video.bitrate.mode.ConstantMbps".into(), mbps.into()),
+            ]);
+            plan.changes.push(format!("bitrate {mbps} Mbps"));
+        }
+    }
+
+    if let Some(hz) = request.refresh_hz {
+        let Some(rate) = supported_refresh
+            .iter()
+            .copied()
+            .find(|rate| rate.is_finite() && (rate - hz).abs() < 0.01)
+        else {
+            return Err(format!("{hz} Hz is not a rate this headset confirmed"));
+        };
+        if (rate - video.preferred_fps).abs() >= 0.01 {
+            plan.assignments
+                .push(("video.preferred_fps".into(), json::json!(rate)));
+            plan.changes.push(format!("{rate:.0} Hz"));
+            plan.reconnect = true;
+        }
+    }
+
+    if let Some(full) = request.chroma_444 {
+        if video.preferred_codec != CodecType::PyroWave {
+            return Err("Chroma can only be chosen for PyroWave".into());
+        }
+        if full != video.pyrowave.chroma_444 {
+            plan.assignments
+                .push(("video.pyrowave.chroma_444".into(), full.into()));
+            plan.changes
+                .push(if full { "4:4:4" } else { "4:2:0" }.into());
+            plan.reconnect = true;
+        }
+    }
+
+    for (percent, range, field, label) in [
+        (
+            request.stream_percent,
+            STREAM_PERCENT,
+            "transcoding_view_resolution",
+            "stream",
+        ),
+        (
+            request.render_percent,
+            RENDER_PERCENT,
+            "emulated_headset_view_resolution",
+            "render",
+        ),
+    ] {
+        let Some(percent) = percent else { continue };
+        check_step(
+            &format!("{label} size"),
+            percent as u64,
+            (range.0 as u64, range.1 as u64, range.2 as u64),
+        )?;
+        let current = if field == "transcoding_view_resolution" {
+            &video.transcoding_view_resolution
+        } else {
+            &video.emulated_headset_view_resolution
+        };
+        if !size_matches(current, percent) {
+            plan.assignments.extend(size_assignments(field, percent));
+            let (w, h) = panel_percent_size(percent);
+            plan.changes.push(format!("{label} {percent}% ({w}x{h})"));
+            plan.reconnect = true;
+        }
+    }
+
+    Ok(plan)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::SessionConfig;
+
+    #[test]
+    fn schema_bitrate_sliders_use_the_shared_ceiling() {
+        let slider = format!("max = {MAX_BITRATE_MBPS}, logarithmic)), suffix = \"Mbps\"");
+        assert_eq!(include_str!("settings.rs").matches(&slider).count(), 3);
+    }
+
+    // Applies assignments the way the server's `set_values` does, failing on an unknown path.
+    fn apply(assignments: &[(String, json::Value)]) -> Settings {
+        let mut session = SessionConfig::default();
+        let mut root = json::to_value(&session.session_settings).unwrap();
+        for (path, value) in assignments {
+            let mut node = &mut root;
+            for segment in path.split('.') {
+                node = node.get_mut(segment).unwrap_or_else(|| panic!("no {path}"));
+            }
+            *node = value.clone();
+        }
+        session.session_settings = json::from_value(root).unwrap();
+        session.to_settings()
+    }
+
+    fn settings() -> Settings {
+        apply(&[
+            ("video.preferred_codec.variant".into(), "PyroWave".into()),
+            ("video.bitrate.mode.variant".into(), "ConstantMbps".into()),
+            ("video.bitrate.mode.ConstantMbps".into(), 1000.into()),
+            ("video.preferred_fps".into(), json::json!(120.0)),
+        ])
+    }
+
+    #[test]
+    fn every_assignment_applies_to_a_real_session_path() {
+        let request = HeadsetSettingsRequest {
+            request_id: 1,
+            refresh_hz: Some(90.0),
+            bitrate_mbps: Some(600),
+            chroma_444: Some(true),
+            stream_percent: Some(80),
+            render_percent: Some(150),
+        };
+        let p = plan(&request, &settings(), &[90.0, 120.0]).unwrap();
+        let s = apply(&p.assignments);
+        assert!(matches!(s.video.bitrate.mode, BitrateMode::ConstantMbps(600)));
+        assert_eq!(s.video.preferred_fps, 90.0);
+        assert!(s.video.pyrowave.chroma_444);
+        assert!(size_matches(&s.video.transcoding_view_resolution, 80));
+        assert!(size_matches(&s.video.emulated_headset_view_resolution, 150));
+        // Applying the same request again changes nothing
+        let again = plan(&request, &s, &[90.0, 120.0]).unwrap();
+        assert!(again.assignments.is_empty() && !again.reconnect);
+    }
+
+    #[test]
+    fn bitrate_alone_is_live_and_unchanged_values_assign_nothing() {
+        let s = settings();
+        let rates = [72.0, 90.0, 120.0];
+        let same = HeadsetSettingsRequest {
+            bitrate_mbps: Some(1000),
+            refresh_hz: Some(120.0),
+            chroma_444: Some(s.video.pyrowave.chroma_444),
+            ..Default::default()
+        };
+        let p = plan(&same, &s, &rates).unwrap();
+        assert!(p.assignments.is_empty() && !p.reconnect);
+
+        let p = plan(
+            &HeadsetSettingsRequest {
+                bitrate_mbps: Some(800),
+                ..Default::default()
+            },
+            &s,
+            &rates,
+        )
+        .unwrap();
+        assert!(!p.reconnect);
+        assert_eq!(p.assignments[1], ("video.bitrate.mode.ConstantMbps".into(), 800.into()));
+    }
+
+    #[test]
+    fn refresh_must_be_client_confirmed_and_reconnects() {
+        let s = settings();
+        let request = |hz| HeadsetSettingsRequest {
+            refresh_hz: Some(hz),
+            ..Default::default()
+        };
+        assert!(plan(&request(207.0), &s, &[72.0, 120.0]).is_err());
+        let p = plan(&request(90.0), &s, &[72.0, 90.0, 120.0]).unwrap();
+        assert!(p.reconnect);
+        assert_eq!(p.assignments, [("video.preferred_fps".into(), json::json!(90.0))]);
+    }
+
+    #[test]
+    fn out_of_range_or_off_step_values_reject_the_whole_request() {
+        let s = settings();
+        for request in [
+            HeadsetSettingsRequest {
+                bitrate_mbps: Some(5000),
+                ..Default::default()
+            },
+            HeadsetSettingsRequest {
+                bitrate_mbps: Some(825),
+                ..Default::default()
+            },
+            HeadsetSettingsRequest {
+                bitrate_mbps: Some(800),
+                stream_percent: Some(30),
+                ..Default::default()
+            },
+            HeadsetSettingsRequest {
+                render_percent: Some(103),
+                ..Default::default()
+            },
+            // stream above the panel and game render below it are outside the contract
+            HeadsetSettingsRequest {
+                stream_percent: Some(110),
+                ..Default::default()
+            },
+            HeadsetSettingsRequest {
+                render_percent: Some(75),
+                ..Default::default()
+            },
+        ] {
+            assert!(plan(&request, &s, &[120.0]).is_err(), "{request:?}");
+        }
+    }
+
+    #[test]
+    fn sizes_use_panel_percent_and_round_trip() {
+        let s = settings();
+        let p = plan(
+            &HeadsetSettingsRequest {
+                stream_percent: Some(80),
+                render_percent: Some(150),
+                ..Default::default()
+            },
+            &s,
+            &[120.0],
+        )
+        .unwrap();
+        assert!(p.reconnect);
+        let (w, h) = panel_percent_size(150);
+        assert!(p.assignments.contains(&(
+            "video.emulated_headset_view_resolution.Absolute.width".into(),
+            w.into()
+        )));
+        assert!(p.assignments.contains(&(
+            "video.emulated_headset_view_resolution.Absolute.height.content".into(),
+            h.into()
+        )));
+        assert_eq!(
+            frame_size_percent(&FrameSize::Absolute {
+                width: panel_percent_size(80).0,
+                height: None
+            }),
+            Some(80)
+        );
+    }
+}
