diff --git a/alvr/client_openxr/src/performance.rs b/alvr/client_openxr/src/performance.rs
new file mode 100644
index 0000000..869319d
--- /dev/null
+++ b/alvr/client_openxr/src/performance.rs
@@ -0,0 +1,304 @@
+use crate::interaction::{ButtonAction, InteractionContext};
+use alvr_client_core::{
+    performance::{metric, overlay_visibility, OverlayToggle},
+    ClientCoreContext,
+};
+use alvr_common::{
+    glam::UVec2, parking_lot::RwLock, LEFT_THUMBSTICK_CLICK_ID, RIGHT_THUMBSTICK_CLICK_ID,
+};
+use alvr_graphics::{GraphicsContext, PerformanceRenderer, SDR_FORMAT_GL};
+use alvr_packets::{PerformanceSnapshot, StreamConfig};
+use openxr as xr;
+use std::{
+    rc::Rc,
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+const RESOLUTION: UVec2 = UVec2::new(960, 448);
+
+pub struct PerformanceOverlay {
+    session: xr::Session<xr::OpenGlEs>,
+    context: Rc<GraphicsContext>,
+    interactions: Arc<RwLock<InteractionContext>>,
+    space: xr::Space,
+    swapchain: xr::Swapchain<xr::OpenGlEs>,
+    renderer: PerformanceRenderer,
+    toggle: OverlayToggle,
+    next_update: Instant,
+    next_property_poll: Instant,
+    visibility_property: String,
+    visible: bool,
+    probe: bool,
+    header: String,
+}
+
+impl PerformanceOverlay {
+    pub fn new(
+        session: xr::Session<xr::OpenGlEs>,
+        context: Rc<GraphicsContext>,
+        interactions: Arc<RwLock<InteractionContext>>,
+    ) -> xr::Result<Self> {
+        context.make_current();
+        let space =
+            session.create_reference_space(xr::ReferenceSpaceType::VIEW, xr::Posef::IDENTITY)?;
+        let swapchain = session.create_swapchain(&xr::SwapchainCreateInfo {
+            create_flags: xr::SwapchainCreateFlags::EMPTY,
+            usage_flags: xr::SwapchainUsageFlags::COLOR_ATTACHMENT
+                | xr::SwapchainUsageFlags::SAMPLED,
+            format: SDR_FORMAT_GL,
+            sample_count: 1,
+            width: RESOLUTION.x,
+            height: RESOLUTION.y,
+            face_count: 1,
+            array_size: 1,
+            mip_count: 1,
+        })?;
+        let renderer = PerformanceRenderer::new(
+            Rc::clone(&context),
+            RESOLUTION,
+            &swapchain.enumerate_images()?,
+        );
+        Ok(Self {
+            session,
+            context,
+            interactions,
+            space,
+            swapchain,
+            renderer,
+            toggle: OverlayToggle::default(),
+            next_update: Instant::now(),
+            next_property_poll: Instant::now(),
+            visibility_property: String::new(),
+            visible: true,
+            probe: crate::extra_extensions::perf_settings::system_property("debug.q3pw.loop_probe")
+                == "1",
+            header: "Connecting".into(),
+        })
+    }
+
+    pub fn set_stream(&mut self, config: &StreamConfig) {
+        let v = &config.settings.video;
+        let n = &config.negotiated_config;
+        let transport = if n.wired {
+            "USB/TCP"
+        } else if v.preferred_codec == alvr_session::CodecType::PyroWave {
+            if v.pyrowave.transport == alvr_session::PyroWaveTransport::Udp {
+                "Wi-Fi/PWU2 UDP"
+            } else {
+                "Wi-Fi/TCP"
+            }
+        } else {
+            "Wireless"
+        };
+        self.header = format!(
+            "{:?} {}  |  {}x{} /eye  |  {:.0} Hz",
+            v.preferred_codec,
+            if v.preferred_codec == alvr_session::CodecType::PyroWave && v.pyrowave.chroma_444 {
+                "4:4:4"
+            } else {
+                "4:2:0"
+            },
+            n.view_resolution.x,
+            n.view_resolution.y,
+            n.refresh_rate_hint
+        );
+        self.header.push_str(&format!("  |  {transport}"));
+        self.next_update = Instant::now();
+    }
+
+    pub fn disconnected(&mut self) {
+        self.header = "Waiting for stream".into();
+        self.next_update = Instant::now();
+    }
+
+    pub fn update(&mut self, core: &ClientCoreContext) -> xr::Result<()> {
+        let interactions = self.interactions.read();
+        let pressed = |id: u64| {
+            if let Some(ButtonAction::Binary(action)) = interactions.button_actions.get(&id) {
+                action
+                    .state(&self.session, xr::Path::NULL)
+                    .ok()
+                    .is_some_and(|state| state.is_active && state.current_state)
+            } else {
+                false
+            }
+        };
+        let was_visible = self.visible;
+        self.toggle.update(
+            pressed(*LEFT_THUMBSTICK_CLICK_ID),
+            pressed(*RIGHT_THUMBSTICK_CLICK_ID),
+        );
+        drop(interactions);
+        if Instant::now() >= self.next_property_poll {
+            let property = crate::extra_extensions::perf_settings::system_property(
+                "debug.q3pw.overlay_visible",
+            );
+            if property != self.visibility_property {
+                alvr_common::error!(
+                    "[Q3PW_OVERLAY_CONTROL] mode={}",
+                    match property.trim() {
+                        "0" => "forced_hidden",
+                        "1" => "forced_visible",
+                        _ => "controllers",
+                    }
+                );
+            }
+            self.visibility_property = property;
+            self.next_property_poll = Instant::now() + Duration::from_millis(500);
+        }
+        self.visible = overlay_visibility(&self.visibility_property, self.toggle.visible);
+        if was_visible != self.visible {
+            alvr_common::error!(
+                "[Q3PW_OVERLAY] visible={} forced={}",
+                self.visible,
+                matches!(self.visibility_property.trim(), "0" | "1")
+            );
+        }
+        if !was_visible && self.visible {
+            self.next_update = Instant::now();
+        }
+        if !self.visible || Instant::now() < self.next_update {
+            return Ok(());
+        }
+        let text_started = self.probe.then(Instant::now);
+        let text = self.text(core.performance_snapshot());
+        let text_ms = text_started
+            .map(|t| t.elapsed().as_secs_f64() * 1000.0)
+            .unwrap_or(0.0);
+        let acquire_started = self.probe.then(Instant::now);
+        self.context.make_current();
+        let image = self.swapchain.acquire_image()?;
+        self.swapchain.wait_image(xr::Duration::INFINITE)?;
+        let acquire_ms = acquire_started
+            .map(|t| t.elapsed().as_secs_f64() * 1000.0)
+            .unwrap_or(0.0);
+        let draw_started = self.probe.then(Instant::now);
+        self.renderer.update(image as usize, &text);
+        let draw_ms = draw_started
+            .map(|t| t.elapsed().as_secs_f64() * 1000.0)
+            .unwrap_or(0.0);
+        let release_started = self.probe.then(Instant::now);
+        self.swapchain.release_image()?;
+        if let Some(t) = release_started {
+            alvr_common::error!("[Q3PW_OVERLAY_DRAW] text_cpu_ms={text_ms:.3} acquire_wait_cpu_ms={acquire_ms:.3} renderer_submit_cpu_ms={draw_ms:.3} release_cpu_ms={:.3}", t.elapsed().as_secs_f64() * 1000.0);
+        }
+        self.next_update = Instant::now() + Duration::from_millis(500);
+        Ok(())
+    }
+
+    fn text(&self, data: Option<PerformanceSnapshot>) -> String {
+        let Some(s) = data.filter(|s| s.frame_age_ms < 2000.0) else {
+            return format!("QUEST3 PYROWAVE PERFORMANCE\n{}\n\nWaiting for fresh stream statistics\n\nBoth thumbstick clicks: toggle overlay", self.header);
+        };
+        let mut text = format!(
+            "QUEST3 PYROWAVE PERFORMANCE\n{}\n\
+            Bitrate {} Mbps  |  target {} Mbps\n\
+            Delivered {} FPS  |  Game/host {} FPS*\n\
+            Latency {} ms*  |  Game {} / Encode {} / Network {}*\n\
+            Decode {} / Queue {} / Render {} / Vsync {} ms\n\
+            Presented frames {}  |  Lost packets {}\n",
+            self.header,
+            metric(s.bitrate_bps / 1e6),
+            metric(s.requested_bitrate_bps / 1e6),
+            metric(s.client_fps),
+            metric(s.server_fps),
+            metric(s.total_ms),
+            metric(s.game_ms),
+            metric(s.encoder_ms),
+            metric(s.network_ms),
+            metric(s.decoder_ms),
+            metric(s.queue_ms),
+            metric(s.compositor_ms),
+            metric(s.vsync_ms),
+            s.frames_total,
+            s.packets_lost_total
+        );
+        if let Some(h) = s.headset {
+            if let Some(p) = h.pyrowave {
+                let mean = |values: &[f32]| {
+                    let values: Vec<_> = values
+                        .iter()
+                        .copied()
+                        .filter(|v| v.is_finite() && *v >= 0.0)
+                        .collect();
+                    if values.is_empty() {
+                        "--".into()
+                    } else {
+                        metric(values.iter().sum::<f32>() / values.len() as f32)
+                    }
+                };
+                text.push_str(&format!(
+                    "GPU decode {} / Completion {} ms  |  Decoded {}\n\
+                    Dropped {} / Skipped {} / Superseded {} / Errors {}\n",
+                    mean(&p.gpu_decode_ms),
+                    mean(&p.fence_ms),
+                    p.complete,
+                    p.dropped,
+                    p.skipped,
+                    p.superseded,
+                    p.decode_failures
+                ));
+            }
+            text.push_str(&format!(
+                "Battery {}% / {} C  |  Thermal {}  |  GPU {} MHz\n",
+                h.battery_level
+                    .map(|v| metric(v * 100.0))
+                    .unwrap_or_else(|| "--".into()),
+                h.battery_temperature_c
+                    .map(metric)
+                    .unwrap_or_else(|| "--".into()),
+                h.thermal_status
+                    .map(|v| v.to_string())
+                    .unwrap_or_else(|| "--".into()),
+                gpu_clock()
+            ));
+        }
+        text.push_str("*ALVR estimates; host presents proxy game FPS. Network is residual.\nBoth thumbstick clicks: toggle overlay");
+        text
+    }
+
+    pub fn layer(&self) -> Option<xr::CompositionLayerQuad<'_, xr::OpenGlEs>> {
+        self.visible.then(|| {
+            xr::CompositionLayerQuad::new()
+                .layer_flags(
+                    xr::CompositionLayerFlags::BLEND_TEXTURE_SOURCE_ALPHA
+                        | xr::CompositionLayerFlags::UNPREMULTIPLIED_ALPHA,
+                )
+                .space(&self.space)
+                .eye_visibility(xr::EyeVisibility::BOTH)
+                .sub_image(
+                    xr::SwapchainSubImage::new()
+                        .swapchain(&self.swapchain)
+                        .image_array_index(0)
+                        .image_rect(xr::Rect2Di {
+                            offset: xr::Offset2Di { x: 0, y: 0 },
+                            extent: xr::Extent2Di {
+                                width: RESOLUTION.x as i32,
+                                height: RESOLUTION.y as i32,
+                            },
+                        }),
+                )
+                .pose(xr::Posef {
+                    position: xr::Vector3f {
+                        x: 0.0,
+                        y: -0.32,
+                        z: -1.2,
+                    },
+                    ..xr::Posef::IDENTITY
+                })
+                .size(xr::Extent2Df {
+                    width: 0.9,
+                    height: 0.42,
+                })
+        })
+    }
+}
+
+fn gpu_clock() -> String {
+    std::fs::read_to_string("/sys/class/kgsl/kgsl-3d0/gpuclk")
+        .ok()
+        .and_then(|v| v.trim().parse::<f32>().ok())
+        .map(|v| metric(v / 1e6))
+        .unwrap_or_else(|| "--".into())
+}
diff --git a/alvr/client_openxr/src/refresh_probe.rs b/alvr/client_openxr/src/refresh_probe.rs
new file mode 100644
index 0000000..766b412
--- /dev/null
+++ b/alvr/client_openxr/src/refresh_probe.rs
@@ -0,0 +1,112 @@
+//! Quest 3 HorizonOS v2.7 permits rates absent from enumeration. Never infer support
+//! from a property: require request success, runtime frequency and three frame periods.
+use openxr as xr;
+use std::{collections::VecDeque, time::Instant};
+
+pub struct RefreshProbe {
+    pending: VecDeque<f32>,
+    current: Option<(f32, Instant)>,
+    stable: usize,
+    confirmed: Vec<f32>,
+    enumerated: Vec<f32>,
+    restore: f32,
+    restoring: bool,
+}
+
+pub fn matches(target: f32, actual: f32, period_ns: i64) -> bool {
+    period_ns > 0
+        && target.is_finite()
+        && actual.is_finite()
+        && (actual - target).abs() < 0.1
+        && (1e9 / period_ns as f64 - target as f64).abs() < target as f64 * 0.005
+}
+
+impl RefreshProbe {
+    pub fn new(enumerated: Vec<f32>, restore: f32) -> Self {
+        Self {
+            pending: [72.0, 90.0, 120.0, 144.0, 207.0, 240.0].into(),
+            current: None,
+            stable: 0,
+            confirmed: vec![],
+            enumerated,
+            restore,
+            restoring: false,
+        }
+    }
+
+    // Called only while the session runs, before xrWaitFrame. No sleeps on render thread.
+    pub fn request_next(&mut self, session: &xr::Session<xr::OpenGlEs>) {
+        while self.current.is_none() {
+            let target = if let Some(rate) = self.pending.pop_front() {
+                rate
+            } else {
+                self.restoring = true;
+                self.restore
+            };
+            match session.request_display_refresh_rate(target) {
+                Ok(()) => {
+                    self.current = Some((target, Instant::now()));
+                    self.stable = 0;
+                }
+                Err(err) => {
+                    alvr_common::error!("[Q3PW_PROBE] request={target} confirmed=false reason=request_rejected error={err:?}");
+                    if self.restoring {
+                        self.current = Some((target, Instant::now()));
+                        break;
+                    }
+                }
+            }
+        }
+    }
+
+    pub fn observe(
+        &mut self,
+        session: &xr::Session<xr::OpenGlEs>,
+        period_ns: i64,
+    ) -> Option<Vec<f32>> {
+        let (target, start) = self.current?;
+        let actual = session.get_display_refresh_rate().ok();
+        if actual.is_some_and(|actual| matches(target, actual, period_ns)) {
+            self.stable += 1;
+        } else {
+            self.stable = 0;
+        }
+        let confirmed = self.stable >= 3;
+        if !confirmed && start.elapsed().as_secs_f32() < 2.0 {
+            return None;
+        }
+        alvr_common::error!("[Q3PW_PROBE] request={target} confirmed={confirmed} runtime_hz={actual:?} period_ns={period_ns} restore={}", self.restoring);
+        self.current = None;
+        if self.restoring {
+            // Preserve ordinary enumerated modes; extended benchmark modes only after confirmation.
+            let mut rates: Vec<_> = self
+                .enumerated
+                .iter()
+                .copied()
+                .filter(|r| ![72.0, 90.0, 120.0, 144.0, 207.0, 240.0].contains(r))
+                .collect();
+            rates.extend(&self.confirmed);
+            rates.sort_by(f32::total_cmp);
+            rates.dedup();
+            alvr_common::error!("[Q3PW_VERIFIED] rates={:?}", self.confirmed);
+            return Some(rates);
+        }
+        if confirmed {
+            self.confirmed.push(target);
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::matches;
+    #[test]
+    fn runtime_and_period_must_agree() {
+        assert!(matches(207.0, 207.0, 4_830_918));
+        assert!(!matches(207.0, 207.0, 8_333_333));
+        assert!(!matches(207.0, 120.0, 4_830_918));
+        assert!(!matches(240.0, f32::NAN, 4_166_667));
+        assert!(!matches(240.0, 240.0, 0));
+    }
+}
