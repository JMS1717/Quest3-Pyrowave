diff --git a/alvr/client_openxr/src/surface_probe.rs b/alvr/client_openxr/src/surface_probe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7bde1488686bc3f5bbfd7b80889607a57dec8557
--- /dev/null
+++ b/alvr/client_openxr/src/surface_probe.rs
@@ -0,0 +1,233 @@
+//! Default-off creation probe only. Surface swapchains never enter the GLES eye loop.
+use openxr as xr;
+use std::{ffi::c_void, ptr};
+
+#[link(name = "pyroclient")]
+extern "C" {
+    fn pyroclient_probe_android_surface(java_vm: *mut c_void, surface: *mut c_void) -> i32;
+    fn pyroclient_create_surface_chart(
+        java_vm: *mut c_void,
+        surface: *mut c_void,
+        status: *mut i32,
+    ) -> *mut c_void;
+    fn pyroclient_present_surface_chart(chart: *mut c_void) -> i32;
+    fn pyroclient_poll_surface_chart(chart: *mut c_void) -> i32;
+    fn pyroclient_destroy_surface_chart(chart: *mut c_void);
+}
+
+pub fn requested() -> bool {
+    crate::extra_extensions::perf_settings::system_property("debug.q3pw.surface_probe").trim()
+        == "1"
+}
+
+pub fn chart_requested() -> bool {
+    crate::extra_extensions::perf_settings::system_property("debug.q3pw.surface_chart").trim()
+        == "1"
+}
+
+/// Separate static diagnostic quad; no pose-matched video or ordinary eye calls.
+pub struct SurfaceChart {
+    native: *mut c_void,
+    swapchain: xr::Swapchain<xr::OpenGlEs>,
+    space: xr::Space,
+    presented: bool,
+}
+
+impl SurfaceChart {
+    pub fn new(session: &xr::Session<xr::OpenGlEs>) -> xr::Result<Option<Self>> {
+        if !chart_requested() {
+            return Ok(None);
+        }
+        let Some(extension) = session
+            .instance()
+            .exts()
+            .khr_android_surface_swapchain
+            .as_ref()
+        else {
+            alvr_common::error!("[Q3PW_SURFACE_CHART] unsupported keep_gles=true");
+            return Ok(None);
+        };
+        let space =
+            session.create_reference_space(xr::ReferenceSpaceType::VIEW, xr::Posef::IDENTITY)?;
+        let info = xr::sys::SwapchainCreateInfo {
+            ty: xr::sys::SwapchainCreateInfo::TYPE,
+            next: ptr::null(),
+            create_flags: xr::SwapchainCreateFlags::EMPTY,
+            usage_flags: xr::SwapchainUsageFlags::COLOR_ATTACHMENT
+                | xr::SwapchainUsageFlags::SAMPLED,
+            format: 0,
+            sample_count: 0,
+            width: 64,
+            height: 32,
+            face_count: 0,
+            array_size: 0,
+            mip_count: 0,
+        };
+        let mut handle = xr::sys::Swapchain::NULL;
+        let mut surface = ptr::null_mut();
+        let result = unsafe {
+            (extension.create_swapchain_android_surface)(
+                session.as_raw(),
+                &info,
+                &mut handle,
+                &mut surface,
+            )
+        };
+        if result.into_raw() < 0 {
+            return Err(result);
+        }
+        if handle == xr::sys::Swapchain::NULL {
+            return Err(xr::sys::Result::ERROR_RUNTIME_FAILURE);
+        }
+        // Wrapper is for destruction/layer reference ONLY; no enumerate/acquire/wait/release.
+        let swapchain = unsafe { xr::Swapchain::<xr::OpenGlEs>::from_raw(session.clone(), handle) };
+        let mut status = 0;
+        let native = unsafe {
+            pyroclient_create_surface_chart(
+                ndk_context::android_context().vm().cast(),
+                surface.cast(),
+                &mut status,
+            )
+        };
+        if native.is_null() {
+            alvr_common::error!("[Q3PW_SURFACE_CHART] prepare_failed={status} keep_gles=true");
+            return Ok(None);
+        }
+        alvr_common::error!("[Q3PW_SURFACE_CHART] prepared=true submitted=false keep_gles=true");
+        Ok(Some(Self {
+            native,
+            swapchain,
+            space,
+            presented: false,
+        }))
+    }
+
+    pub fn update(&mut self, visible: bool) -> bool {
+        if !visible {
+            return true;
+        }
+        if !self.presented {
+            // One static enqueue, only after processing VISIBLE/FOCUSED state.
+            alvr_common::error!("[Q3PW_SURFACE_CHART] write_allowed=true visible=true");
+            let result = unsafe { pyroclient_present_surface_chart(self.native) };
+            if result != 0 {
+                alvr_common::error!(
+                    "[Q3PW_SURFACE_CHART] present_failed={result} retirement_required=true"
+                );
+                return false;
+            }
+            self.presented = true;
+        }
+        let result = unsafe { pyroclient_poll_surface_chart(self.native) };
+        if result < 0 {
+            alvr_common::error!(
+                "[Q3PW_SURFACE_CHART] poll_failed={result} retirement_required=true"
+            );
+            return false;
+        }
+        true
+    }
+
+    pub fn layer(&self, visible: bool) -> Option<xr::CompositionLayerQuad<'_, xr::OpenGlEs>> {
+        (visible && self.presented).then(|| {
+            xr::CompositionLayerQuad::new()
+                .space(&self.space)
+                .eye_visibility(xr::EyeVisibility::BOTH)
+                .sub_image(
+                    xr::SwapchainSubImage::new()
+                        .swapchain(&self.swapchain)
+                        .image_array_index(0)
+                        .image_rect(xr::Rect2Di {
+                            offset: xr::Offset2Di { x: 0, y: 0 },
+                            extent: xr::Extent2Di {
+                                width: 64,
+                                height: 32,
+                            },
+                        }),
+                )
+                .pose(xr::Posef {
+                    position: xr::Vector3f {
+                        x: 0.55,
+                        y: 0.35,
+                        z: -1.2,
+                    },
+                    ..xr::Posef::IDENTITY
+                })
+                .size(xr::Extent2Df {
+                    width: 0.55,
+                    height: 0.275,
+                })
+        })
+    }
+}
+
+impl Drop for SurfaceChart {
+    fn drop(&mut self) {
+        // Native waits bounded render + EXT presentation fences before freeing;
+        // unproved completion fails closed by terminating this opt-in client.
+        // XrSwapchain field drops only AFTER the native producer has retired.
+        unsafe {
+            pyroclient_destroy_surface_chart(self.native);
+        }
+        alvr_common::error!("[Q3PW_SURFACE_CHART] producer_destroyed=true");
+    }
+}
+
+pub fn run(session: &xr::Session<xr::OpenGlEs>) {
+    if !requested() {
+        return;
+    }
+    let Some(extension) = session
+        .instance()
+        .exts()
+        .khr_android_surface_swapchain
+        .as_ref()
+    else {
+        alvr_common::error!("[Q3PW_SURFACE_PROBE] unsupported keep_gles=true");
+        return;
+    };
+    // KHR Surface swapchain requires zero format/sample/face/array/mip fields.
+    // Only destroy is valid on its handle; the ordinary acquire/wait/release
+    // calls are forbidden, so this stays separate from every eye swapchain.
+    let info = xr::sys::SwapchainCreateInfo {
+        ty: xr::sys::SwapchainCreateInfo::TYPE,
+        next: ptr::null(),
+        create_flags: xr::SwapchainCreateFlags::EMPTY,
+        usage_flags: xr::SwapchainUsageFlags::COLOR_ATTACHMENT | xr::SwapchainUsageFlags::SAMPLED,
+        format: 0,
+        sample_count: 0,
+        width: 64,
+        height: 32,
+        face_count: 0,
+        array_size: 0,
+        mip_count: 0,
+    };
+    let mut handle = xr::sys::Swapchain::NULL;
+    let mut surface = ptr::null_mut();
+    let result = unsafe {
+        (extension.create_swapchain_android_surface)(
+            session.as_raw(),
+            &info,
+            &mut handle,
+            &mut surface,
+        )
+    };
+    if result.into_raw() < 0 {
+        alvr_common::error!("[Q3PW_SURFACE_PROBE] create_failed={result:?} keep_gles=true");
+        return;
+    }
+    if handle == xr::sys::Swapchain::NULL {
+        alvr_common::error!("[Q3PW_SURFACE_PROBE] null_handle keep_gles=true");
+        return;
+    }
+    // RAII owns only the XrSwapchain; no reference to this handle is returned or
+    // submitted to xrEndFrame. Native probe destroys WSI/window/JNI refs first.
+    let swapchain = unsafe { xr::Swapchain::<xr::OpenGlEs>::from_raw(session.clone(), handle) };
+    let status = unsafe {
+        pyroclient_probe_android_surface(ndk_context::android_context().vm().cast(), surface.cast())
+    };
+    drop(swapchain);
+    alvr_common::error!(
+        "[Q3PW_SURFACE_PROBE] native_result={status} destroyed=true submitted=false keep_gles=true"
+    );
+}
diff --git a/alvr/client_openxr/src/thread_hints.rs b/alvr/client_openxr/src/thread_hints.rs
new file mode 100644
index 0000000000000000000000000000000000000000..358b58d00e5683ff20e7a17d0195a07262f9617b
--- /dev/null
+++ b/alvr/client_openxr/src/thread_hints.rs
@@ -0,0 +1,74 @@
+// [Q3PW_THREAD_HINTS] With `debug.q3pw.thread_hints=1`, declares the stream's time-critical
+// threads through XR_KHR_android_thread_settings: this frame loop as RENDERER_MAIN, the PyroWave
+// decode workers as RENDERER_WORKER, and the socket, frame hand-off and tracking input threads as
+// APPLICATION_WORKER. The extension only promises that the runtime "adjusts scheduling priority",
+// so each declaration logs the thread's policy, nice value and allowed CPUs before and after.
+// [Q3PW_SOC_CAPS] is logged once per session either way: core clocks and FastRPC visibility.
+
+#[cfg(target_os = "android")]
+use alvr_client_core::thread_hints::{self, ThreadRole};
+#[cfg(target_os = "android")]
+use alvr_common::error;
+use openxr as xr;
+
+pub struct ThreadHints {
+    #[cfg(target_os = "android")]
+    declare: Option<(xr::sys::Session, xr::sys::pfn::SetAndroidApplicationThreadKHR)>,
+}
+
+impl ThreadHints {
+    pub fn new<G>(session: &xr::Session<G>) -> Self {
+        #[cfg(target_os = "android")]
+        let declare = {
+            error!("[Q3PW_SOC_CAPS] {}", thread_hints::soc_caps());
+            let requested = thread_hints::requested();
+            let extension = session.instance().exts().khr_android_thread_settings;
+            error!(
+                "[Q3PW_THREAD_HINTS] requested={requested} enabled={}",
+                extension.is_some()
+            );
+            let declare = extension
+                .filter(|_| requested)
+                .map(|extension| (session.as_raw(), extension.set_android_application_thread));
+            if declare.is_some() {
+                thread_hints::publish_current(ThreadRole::RendererMain, "openxr_frame_loop");
+            }
+            declare
+        };
+        #[cfg(not(target_os = "android"))]
+        let _ = session;
+        Self {
+            #[cfg(target_os = "android")]
+            declare,
+        }
+    }
+
+    /// Declares the threads published since the last call. Called every frame; one atomic swap
+    /// when there is nothing new.
+    pub fn declare_pending(&self) {
+        #[cfg(target_os = "android")]
+        {
+            let Some((session, set_thread)) = self.declare else { return };
+            for thread in thread_hints::take_pending() {
+                let before = thread_hints::sched_snapshot(thread.tid);
+                let result = unsafe { set_thread(session, thread_type(thread.role), thread.tid as u32) };
+                error!(
+                    "[Q3PW_THREAD_HINTS] name={} role={:?} tid={} result={result:?} before=({before}) after=({})",
+                    thread.name,
+                    thread.role,
+                    thread.tid,
+                    thread_hints::sched_snapshot(thread.tid)
+                );
+            }
+        }
+    }
+}
+
+#[cfg(target_os = "android")]
+fn thread_type(role: ThreadRole) -> xr::sys::AndroidThreadTypeKHR {
+    match role {
+        ThreadRole::RendererMain => xr::sys::AndroidThreadTypeKHR::RENDERER_MAIN,
+        ThreadRole::RendererWorker => xr::sys::AndroidThreadTypeKHR::RENDERER_WORKER,
+        ThreadRole::ApplicationWorker => xr::sys::AndroidThreadTypeKHR::APPLICATION_WORKER,
+    }
+}
