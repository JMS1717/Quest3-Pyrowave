+    const FLOAT white[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+    for (const D3D11_VIEWPORT* eye : { &m_viewportL, &m_viewportR }) {
+        const q3pw_latency::Stamp stamp = q3pw_latency::make_stamp((int32_t)eye->TopLeftX,
+            (int32_t)eye->TopLeftY, (uint32_t)eye->Width, (uint32_t)eye->Height, ms, m_stampFrame);
+        D3D11_RECT rects[q3pw_latency::kMaxLit];
+        auto toRect = [](const q3pw_latency::Rect& r) {
+            D3D11_RECT out = { r.left, r.top, r.right, r.bottom };
+            return out;
+        };
+        rects[0] = toRect(stamp.background);
+        m_stampContext->ClearView(m_pRenderTargetView.Get(), black, rects, 1);
+        for (int i = 0; i < stamp.lit_count; i++) {
+            rects[i] = toRect(stamp.lit[i]);
+        }
