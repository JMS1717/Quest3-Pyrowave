+        let chroma = if pyrowave && v.pyrowave.chroma_444 {
+            "4:4:4"
+        } else {
+            "4:2:0"
+        };
+        // Negotiated sizes are padded to 32, so 2080 still reads as the 100% panel width.
+        let negotiated_percent =
+            (n.view_resolution.x as f64 * 100.0 / PANEL_PER_EYE.0 as f64).round() as u32;
+        let stream_percent =
+            frame_size_percent(&v.transcoding_view_resolution).unwrap_or(negotiated_percent);
+        self.stream = Some(StreamInfo {
+            subtitle: format!(
+                "{:?} {chroma}  |  {} x {} /eye  |  {:.0} Hz  |  {transport}",
