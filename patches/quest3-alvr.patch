+/// `ALVR_PACING_SPIN_US=<u64>`: sleep until this long before the virtual vsync, then spin the rest.
+/// `thread::sleep` overshoots by a fraction of a millisecond on Windows, so frame starts jittered
+/// about +/-0.45 ms (p5-p95, 240 Hz) and at 144 Hz the median interval was 7.03 ms for a 6.94 ms
+/// period: the self-correcting clock then skipped frames (142.3 instead of 144 per second). Spinning
+/// costs at most this long of one core per frame. Default 0 keeps the plain sleep.
+static PACING_SPIN: Lazy<Duration> = Lazy::new(|| {
+    Duration::from_micros(
+        std::env::var("ALVR_PACING_SPIN_US")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .unwrap_or(0)
+            .min(3000),
+    )
+});
+
+/// Sleep for `duration`, spinning the final `spin` of it for a precise wake-up.
+fn precise_sleep(duration: Duration, spin: Duration) {
+    if spin.is_zero() {
+        thread::sleep(duration);
+        return;
+    }
+    let deadline = Instant::now() + duration;
+    if let Some(coarse) = duration.checked_sub(spin) {
+        thread::sleep(coarse);
+    }
+    while Instant::now() < deadline {
+        std::hint::spin_loop();
+    }
+}
