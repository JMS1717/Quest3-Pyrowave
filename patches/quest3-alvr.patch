+        let first_set = log.iter().position(|c| c.starts_with("setprop ")).unwrap();
+        assert!(wake < first_set, "properties must change while awake");
+        assert_eq!(log.last().unwrap(), "am broadcast -a com.oculus.vrpowermanager.automation_disable");
