+/// Scheduler state of one thread of this process (0 = the caller), for before/after logs:
+/// policy, real-time priority, nice value and the CPUs it may run on.
+#[cfg(target_os = "android")]
+pub fn sched_snapshot(tid: i32) -> String {
+    unsafe {
+        let policy = libc::sched_getscheduler(tid);
+        let mut param: libc::sched_param = std::mem::zeroed();
+        let rt = if libc::sched_getparam(tid, &mut param) == 0 { param.sched_priority } else { -1 };
+        let nice = libc::getpriority(libc::PRIO_PROCESS, tid as libc::id_t);
+        let mut set: libc::cpu_set_t = std::mem::zeroed();
+        let cpus = if libc::sched_getaffinity(tid, std::mem::size_of::<libc::cpu_set_t>(), &mut set) == 0 {
+            (0..64usize).filter(|&cpu| libc::CPU_ISSET(cpu, &set)).fold(0u64, |mask, cpu| mask | 1 << cpu)
+        } else {
+            0
+        };
+        format!("policy={} rt={rt} nice={nice} cpus=0x{cpus:x}", policy_name(policy))
+    }
