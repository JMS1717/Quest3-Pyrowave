@@ -0,0 +1,146 @@
+//! Start the ADB daemon without inheriting SteamVR/dashboard socket handles.
+//! Stable Rust Command currently inherits arbitrary inheritable handles; changing
+//! stdout alone does not restrict that list. This bootstrap needs no stdio.
+use std::{ffi::OsStr, io, mem::size_of, os::windows::ffi::OsStrExt, ptr};
+use windows_sys::Win32::{
+    Foundation::{CloseHandle, HANDLE, WAIT_OBJECT_0, WAIT_TIMEOUT},
+    System::Threading::{CreateProcessW, GetExitCodeProcess, TerminateProcess,
+        WaitForSingleObject, CREATE_NO_WINDOW, PROCESS_INFORMATION, STARTUPINFOW},
+};
+
+struct ProcessHandles(PROCESS_INFORMATION);
+impl Drop for ProcessHandles {
+    fn drop(&mut self) {
+        unsafe {
+            CloseHandle(self.0.hThread);
+            CloseHandle(self.0.hProcess);
+        }
+    }
+}
+
+fn wide(value: &OsStr) -> io::Result<Vec<u16>> {
+    let mut result: Vec<_> = value.encode_wide().collect();
+    if result.contains(&0) {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "NUL in process argument"));
+    }
+    result.push(0);
+    Ok(result)
+}
+
+fn run_no_inherit(program: &OsStr, command_line: &OsStr) -> io::Result<u32> {
+    wide(program)?; // validate even when Windows resolves a bare executable name
+    let mut command_line = wide(command_line)?;
+    let mut startup: STARTUPINFOW = unsafe { std::mem::zeroed() };
+    startup.cb = size_of::<STARTUPINFOW>() as u32;
+    let mut process = unsafe { std::mem::zeroed() };
+    unsafe {
+        // NULL application name enables Windows PATH lookup for an OS-provided
+        // adb.exe; the executable token in our command line is quoted explicitly.
+        if CreateProcessW(ptr::null(), command_line.as_mut_ptr(), ptr::null(),
+            ptr::null(), 0, CREATE_NO_WINDOW, ptr::null(), ptr::null(),
+            &startup, &mut process) == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let process = ProcessHandles(process);
+        match WaitForSingleObject(process.0.hProcess, 30_000) {
+            WAIT_OBJECT_0 => {},
+            WAIT_TIMEOUT => {
+                // Only the bootstrap process we just created. Do not kill an
+                // existing ADB daemon, SteamVR process, or unrelated application.
+                TerminateProcess(process.0.hProcess, 1);
+                return Err(io::Error::new(io::ErrorKind::TimedOut, "ADB bootstrap timed out"));
+            }
+            _ => return Err(io::Error::last_os_error()),
+        }
+        let mut exit_code = 0;
+        if GetExitCodeProcess(process.0.hProcess, &mut exit_code) == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(exit_code)
+    }
+}
+
+pub fn start_server(adb_path: &str) -> io::Result<()> {
+    if adb_path.contains('"') {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "Quote in ADB executable path"));
+    }
+    let command_line = format!("\"{adb_path}\" start-server");
+    match run_no_inherit(OsStr::new(adb_path), OsStr::new(&command_line))? {
+        0 => Ok(()),
+        code => Err(io::Error::other(format!("ADB bootstrap exited with {code}"))),
+    }
+}
