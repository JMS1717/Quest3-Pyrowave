+fn bitrate_controls(ui: &mut Ui, settings: &mut json::Value) -> Vec<PathValuePair> {
+    let mut changes = Vec::new();
+    let pyrowave = settings["video"]["preferred_codec"]["variant"] == "PyroWave";
+    let mode = &mut settings["video"]["bitrate"]["mode"];
+    let mut automatic = mode["variant"] == "Adaptive";
+    ui.label("Auto bitrate");
+    if ui
+        .checkbox(
+            &mut automatic,
+            "Adapt to network / encoder feedback",
+        )
+        .changed()
+    {
+        mode["variant"] = json::json!(if automatic {
+            "Adaptive"
+        } else {
+            "ConstantMbps"
+        });
+        changes.push(PathValuePair {
+            path: vec![
+                "session_settings".into(),
+                "video".into(),
+                "bitrate".into(),
+                "mode".into(),
+                "variant".into(),
+            ],
+            value: mode["variant"].clone(),
+        });
+        if automatic {
+            let ceiling = mode["ConstantMbps"].as_u64().unwrap_or(400).clamp(5, 2000);
+            mode["Adaptive"]["max_throughput_mbps"]["enabled"] = json::json!(true);
+            mode["Adaptive"]["max_throughput_mbps"]["content"] = json::json!(ceiling);
+            // A minimum floor can prevent recovery from congestion. Leave it opt-in in Video.
+            mode["Adaptive"]["min_throughput_mbps"]["enabled"] = json::json!(false);
+            for (field, leaf, value) in [
+                ("max_throughput_mbps", "enabled", json::json!(true)),
+                ("max_throughput_mbps", "content", json::json!(ceiling)),
+                ("min_throughput_mbps", "enabled", json::json!(false)),
+            ] {
+                changes.push(PathValuePair {
+                    path: vec![
+                        "session_settings".into(),
+                        "video".into(),
+                        "bitrate".into(),
+                        "mode".into(),
+                        "Adaptive".into(),
+                        field.into(),
+                        leaf.into(),
+                    ],
+                    value,
+                });
+            }
+        }
+    }
+    ui.end_row();
+    if automatic && pyrowave {
+        ui.label("PyroWave Auto");
+        ui.label("Decoder latency limiter is ignored: fixed GPU cost needs lower resolution or fewer passes.");
+        ui.end_row();
+    }
+    let mut mbps = if automatic {
+        mode["Adaptive"]["max_throughput_mbps"]["content"].as_u64()
+    } else {
+        mode["ConstantMbps"].as_u64()
+    }
+    .unwrap_or(400);
+    ui.label(if automatic {
+        "Auto bitrate ceiling"
+    } else {
+        "Video bitrate"
+    });
+    if ui
+        .add(egui::Slider::new(&mut mbps, 5..=2000).suffix(" Mbps"))
+        .changed()
+    {
+        let mut path = vec![
+            "session_settings".into(),
+            "video".into(),
+            "bitrate".into(),
+            "mode".into(),
+        ];
+        if automatic {
+            mode["Adaptive"]["max_throughput_mbps"]["content"] = json::json!(mbps);
+            mode["Adaptive"]["max_throughput_mbps"]["enabled"] = json::json!(true);
+            changes.push(PathValuePair {
+                path: vec![
+                    "session_settings".into(),
+                    "video".into(),
+                    "bitrate".into(),
+                    "mode".into(),
+                    "Adaptive".into(),
+                    "max_throughput_mbps".into(),
+                    "enabled".into(),
+                ],
+                value: json::json!(true),
+            });
+            path.extend([
+                "Adaptive".into(),
+                "max_throughput_mbps".into(),
+                "content".into(),
+            ]);
+        } else {
+            mode["ConstantMbps"] = json::json!(mbps);
+            path.push("ConstantMbps".into());
+        }
+        changes.push(PathValuePair {
+            path,
+            value: json::json!(mbps),
+        });
+    }
+    ui.end_row();
+    ui.label("Per-frame budget");
+    let video = &settings["video"];
+    let res = &video["transcoding_view_resolution"];
+    if res["variant"] == "Absolute" {
+        if let Some(b) = alvr_session::beta::frame_budget(
+            res["Absolute"]["width"].as_u64().unwrap_or(0) as u32,
+            res["Absolute"]["height"]["content"].as_u64().unwrap_or(0) as u32,
+            video["preferred_fps"].as_f64().unwrap_or(0.0),
+            mbps,
+            video["pyrowave"]["chroma_444"].as_bool().unwrap_or(false),
+        ) {
+            ui.label(format!("{}×{} / eye • {:.2} ms • ≤{} B/frame • {:.2}:1 raw/payload{}",
+                b.eye_width, b.eye_height, b.frame_ms, b.payload_bytes, b.raw_to_payload,
+                if automatic { " at ceiling" } else { "" }))
+                .on_hover_text("PyroWave 8-bit codec payload after 32-pixel padding. Excludes network overhead. This budget does not prove decode speed or image quality. Resolution/refresh changes need a SteamVR restart.");
+        } else {
+            ui.label("Choose a valid resolution and refresh rate");
+        }
+    } else {
+        ui.label("Select an absolute panel render size to calculate the budget");
+    }
+    ui.end_row();
+    changes
+}
