+#[cfg(not(target_os = "android"))]
+pub fn sched_snapshot(_tid: i32) -> String {
+    String::new()
+}
+
+pub fn policy_name(policy: i32) -> &'static str {
+    const SCHED_RESET_ON_FORK: i32 = 0x4000_0000;
+    let policy = if policy < 0 { policy } else { policy & !SCHED_RESET_ON_FORK };
+    match policy {
+        0 => "OTHER",
+        1 => "FIFO",
+        2 => "RR",
+        3 => "BATCH",
+        5 => "IDLE",
+        _ => "?",
+    }
+}
+
+/// One line of SoC facts the CPU and DSP levers depend on, read without side effects: each core's
+/// maximum clock (MHz, which separates performance from efficiency cores), the calling thread's
+/// scheduler state, and whether any Hexagon FastRPC node is visible and openable by this app.
+#[cfg(target_os = "android")]
+pub fn soc_caps() -> String {
+    let mut cores = Vec::new();
+    for cpu in 0..16 {
+        let dir = format!("/sys/devices/system/cpu/cpu{cpu}");
+        if !std::path::Path::new(&dir).exists() {
+            break;
+        }
+        let mhz = std::fs::read_to_string(format!("{dir}/cpufreq/cpuinfo_max_freq"))
+            .ok()
+            .and_then(|khz| khz.trim().parse::<u64>().ok())
+            .map(|khz| (khz / 1000).to_string())
+            .unwrap_or_else(|| "?".into());
+        cores.push(format!("{cpu}:{mhz}"));
+    }
+    let nodes = [
+        "/dev/adsprpc-smd",
+        "/dev/cdsprpc-smd",
+        "/dev/fastrpc-adsp",
+        "/dev/fastrpc-cdsp",
+        "/dev/fastrpc-cdsp-secure",
+    ]
+    .iter()
+    .filter(|path| std::path::Path::new(path).exists())
+    .map(|path| {
+        let c_path = std::ffi::CString::new(*path).unwrap();
+        let rw = unsafe { libc::access(c_path.as_ptr(), libc::R_OK | libc::W_OK) } == 0;
+        format!("{path}:{}", if rw { "rw" } else { "denied" })
+    })
+    .collect::<Vec<_>>();
+    format!(
+        "max_mhz=[{}] caller=({}) fastrpc=[{}]",
+        cores.join(" "),
+        sched_snapshot(0),
+        nodes.join(" ")
+    )
+}
+
+#[cfg(target_os = "android")]
+fn property(name: &std::ffi::CStr) -> String {
+    let mut value = [0u8; 92]; // PROP_VALUE_MAX
+    let len = unsafe { libc::__system_property_get(name.as_ptr(), value.as_mut_ptr().cast()) };
+    String::from_utf8_lossy(&value[..len.max(0) as usize]).into_owned()
+}
+
+#[cfg(not(target_os = "android"))]
+fn property(_name: &std::ffi::CStr) -> String {
+    String::new()
+}
