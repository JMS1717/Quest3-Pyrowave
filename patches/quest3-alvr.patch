+    use super::*;
+
+    #[test]
+    fn only_one_turns_it_on() {
+        assert!(requested_from_str("1"));
+        assert!(requested_from_str("1\n"));
+        assert!(!requested_from_str(""));
+        assert!(!requested_from_str("0"));
+        assert!(!requested_from_str("true"));
+    }
+
+    #[test]
+    fn published_threads_are_taken_once_in_order() {
+        let decode = DeclaredThread { role: ThreadRole::RendererWorker, tid: 41, name: "decode" };
+        let receive = DeclaredThread { role: ThreadRole::ApplicationWorker, tid: 42, name: "receive" };
+        publish(decode);
+        publish(receive);
+        assert_eq!(take_pending(), vec![decode, receive]);
+        assert!(take_pending().is_empty());
+        publish(decode);
+        assert_eq!(take_pending(), vec![decode]);
+    }
+
+    #[test]
+    fn policy_names_cover_the_linux_policies() {
+        assert_eq!(policy_name(0), "OTHER");
+        assert_eq!(policy_name(1), "FIFO");
+        assert_eq!(policy_name(2), "RR");
+        assert_eq!(policy_name(0x4000_0001), "FIFO");
+        assert_eq!(policy_name(-1), "?");
+        assert_eq!(policy_name(9), "?");
+    }
+}
