+/// A connection whose writes stall this long is treated as lost, so video falls back to the
+/// stream socket instead of blocking the video thread.
+const WIRED_VIDEO_WRITE_TIMEOUT: Duration = Duration::from_secs(1);
+
+/// One writer thread per wired video connection; each writes its slice of every frame, so the
+/// slices cross USB in parallel. Frames are numbered because a repeated timestamp cannot
+/// identify a frame.
+struct WiredVideoSender {
+    senders: Vec<std::sync::mpsc::SyncSender<Arc<(u32, VideoPacket)>>>,
+    next_sequence: u32,
+}
+
+impl WiredVideoSender {
+    fn new(streams: Vec<std::net::TcpStream>) -> Self {
+        use std::io::Write;
+        let count = streams.len();
+        let senders = streams
+            .into_iter()
+            .enumerate()
+            .map(|(index, mut stream)| {
+                let (sender, receiver) = std::sync::mpsc::sync_channel::<Arc<(u32, VideoPacket)>>(1);
+                thread::spawn(move || {
+                    if let Err(e) = stream.set_write_timeout(Some(WIRED_VIDEO_WRITE_TIMEOUT)) {
+                        warn!("[PYROWAVE] wired video connection {index}: {e}");
+                        return;
+                    }
+                    let mut buffer = Vec::new();
+                    for frame in receiver {
+                        let (sequence, packet) = &*frame;
+                        let range =
+                            alvr_packets::pyrowave_wired_slice(packet.payload.len(), index, count);
+                        if range.is_empty() {
+                            continue;
+                        }
+                        let header = alvr_packets::PyroWaveSliceHeader {
+                            timestamp_ns: packet.header.timestamp.as_nanos() as u64,
+                            frame_len: packet.payload.len() as u32,
+                            offset: range.start as u32,
+                            len: range.len() as u32,
+                            is_idr: packet.header.is_idr,
+                            sequence: *sequence,
+                            foveation_center: packet.header.foveation_center,
+                        };
+                        buffer.clear();
+                        buffer.extend_from_slice(&header.to_bytes());
+                        buffer.extend_from_slice(&packet.payload[range]);
+                        if let Err(e) = stream.write_all(&buffer) {
+                            warn!("[PYROWAVE] wired video connection {index}: {e}");
+                            return;
+                        }
+                    }
+                });
+                sender
+            })
+            .collect();
+        Self { senders, next_sequence: 1 }
+    }
+
+    /// False once any connection has failed; the frame may then be incomplete.
+    fn send(&mut self, packet: VideoPacket) -> bool {
+        let frame = Arc::new((self.next_sequence, packet));
+        // 0 marks an older server's unnumbered frames, so skip it on wrap-around.
+        self.next_sequence = self.next_sequence.wrapping_add(1).max(1);
+        self.senders
+            .iter()
+            .all(|sender| sender.send(Arc::clone(&frame)).is_ok())
+    }
+}
