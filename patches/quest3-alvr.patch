diff --git a/alvr/graphics/src/native_release.rs b/alvr/graphics/src/native_release.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ce5922223ca7be1431987787d1b4c8af057a9399
--- /dev/null
+++ b/alvr/graphics/src/native_release.rs
@@ -0,0 +1,125 @@
+//! Optional EGL native release fence; no ready-fence import or CPU wait here.
+use super::{direct_eye::import_diagnostic, GraphicsContext};
+use glow::HasContext;
+use std::ffi::{c_void, CStr};
+
+type Create = unsafe extern "C" fn(*mut c_void, u32, *const i32) -> *mut c_void;
+type Destroy = unsafe extern "C" fn(*mut c_void, *mut c_void) -> u32;
+type Duplicate = unsafe extern "C" fn(*mut c_void, *mut c_void) -> i32;
+type Query = unsafe extern "C" fn(*mut c_void, i32) -> *const std::ffi::c_char;
+
+pub struct ReleaseFence {
+    pub buffer: usize,
+    pub token: u64,
+    fd: i32,
+}
+impl ReleaseFence {
+    /// Transfer ownership exactly once. Receiver must consume on failure too.
+    pub fn into_raw_fd(mut self) -> i32 {
+        let fd = self.fd;
+        self.fd = -1;
+        fd
+    }
+}
+impl Drop for ReleaseFence {
+    fn drop(&mut self) {
+        #[cfg(target_os = "android")]
+        if self.fd >= 0 {
+            extern "C" {
+                fn close(fd: i32) -> i32;
+            }
+            unsafe {
+                close(self.fd);
+            }
+        }
+    }
+}
+
+pub(super) struct NativeRelease {
+    create: Create,
+    destroy: Destroy,
+    duplicate: Duplicate,
+}
+
+fn requested() -> bool {
+    #[cfg(target_os = "android")]
+    unsafe {
+        extern "C" {
+            fn __system_property_get(
+                name: *const std::ffi::c_char,
+                value: *mut std::ffi::c_char,
+            ) -> i32;
+        }
+        let mut value = [0; 92];
+        return __system_property_get(c"debug.q3pw.release_fd".as_ptr(), value.as_mut_ptr()) == 1
+            && value[0] == b'1' as std::ffi::c_char;
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        false
+    }
+}
+
+impl NativeRelease {
+    pub(super) unsafe fn new(context: &GraphicsContext) -> Option<Self> {
+        if !requested() {
+            return None;
+        }
+        let addresses = [
+            "eglQueryString",
+            "eglCreateSyncKHR",
+            "eglDestroySyncKHR",
+            "eglDupNativeFenceFDANDROID",
+        ]
+        .map(|name| context.gl_proc_address(name));
+        if addresses.iter().any(|address| address.is_null()) {
+            import_diagnostic(
+                5,
+                "[Q3PW_RELEASE_FD] EGL active=0 reason=entry_points".into(),
+            );
+            return None;
+        }
+        let query: Query = std::mem::transmute(addresses[0]);
+        let extensions = query(context.egl_display.as_ptr(), 0x3055);
+        if extensions.is_null()
+            || !CStr::from_ptr(extensions)
+                .to_string_lossy()
+                .split_whitespace()
+                .any(|extension| extension == "EGL_ANDROID_native_fence_sync")
+        {
+            import_diagnostic(5, "[Q3PW_RELEASE_FD] EGL active=0 reason=extension".into());
+            return None;
+        }
+        import_diagnostic(
+            4,
+            "[Q3PW_RELEASE_FD] EGL export available; per-frame native token required".into(),
+        );
+        Some(Self {
+            create: std::mem::transmute(addresses[1]),
+            destroy: std::mem::transmute(addresses[2]),
+            duplicate: std::mem::transmute(addresses[3]),
+        })
+    }
+    pub(super) unsafe fn export(
+        &self,
+        context: &GraphicsContext,
+        buffer: usize,
+        token: u64,
+    ) -> Option<ReleaseFence> {
+        let display = context.egl_display.as_ptr();
+        // No FD attribute: fence covers all prior GLES commands, including both eyes.
+        let attributes = [0x3038]; // EGL_NONE
+        let sync = (self.create)(display, 0x3144, attributes.as_ptr());
+        if sync.is_null() {
+            return None;
+        }
+        context.gl_context.flush();
+        let fd = (self.duplicate)(display, sync);
+        let destroyed = (self.destroy)(display, sync);
+        let fence = (fd >= 0).then_some(ReleaseFence { buffer, token, fd });
+        if destroyed == 0 {
+            return None;
+        } // Owned fence closes through Drop.
+        fence
+    }
+}
