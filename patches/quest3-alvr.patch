+        snapshot.client_fps = if client_interval > 0.0 { 1.0 / client_interval } else { 0.0 };
+        snapshot.server_fps = if server_interval > 0.0 { 1.0 / server_interval } else { 0.0 };
+        snapshot.bitrate_bps = mean(|s| s.bitrate_bps);
+        snapshot.total_ms = mean(|s| s.total_ms);
+        snapshot.game_ms = mean(|s| s.game_ms);
