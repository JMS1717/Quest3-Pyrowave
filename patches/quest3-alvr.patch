+/// PyroWave's optional parallel wired video connections (alvr_packets::PYROWAVE_WIRED_PORT and
+/// up). Empty when none are requested or the client does not answer on every one: video then
+/// stays on the stream socket.
+fn connect_wired_video(client_ip: IpAddr, count: u32) -> Vec<std::net::TcpStream> {
+    use std::io::Read;
+    let count = count.min(alvr_packets::PYROWAVE_WIRED_MAX_CONNECTIONS as u32) as u16;
+    let mut streams = vec![];
+    for i in 0..count {
+        let addr = std::net::SocketAddr::new(client_ip, alvr_packets::PYROWAVE_WIRED_PORT + i);
+        // adb accepts a forwarded connection even when nothing listens on the headset, so only
+        // the client's hello proves the connection reaches it.
+        let connect = || -> std::io::Result<std::net::TcpStream> {
+            let mut stream = std::net::TcpStream::connect_timeout(&addr, Duration::from_secs(1))?;
+            stream.set_nodelay(true)?;
+            stream.set_read_timeout(Some(Duration::from_secs(2)))?;
+            let mut hello = [0u8; 4];
+            stream.read_exact(&mut hello)?;
+            if hello != alvr_packets::PYROWAVE_WIRED_HELLO {
+                return Err(std::io::Error::other("unexpected hello"));
+            }
+            stream.set_read_timeout(None)?;
+            Ok(stream)
+        };
+        match connect() {
+            Ok(stream) => streams.push(stream),
+            Err(e) => {
+                warn!("[PYROWAVE] wired video connection {addr}: {e}; video stays on the stream socket");
+                return vec![];
+            }
+        }
+    }
+    streams
+}
