diff --git a/alvr/client_core/src/video_decoder/pyrowave_udp_assembly.rs b/alvr/client_core/src/video_decoder/pyrowave_udp_assembly.rs
new file mode 100644
index 0000000..16daa19
--- /dev/null
+++ b/alvr/client_core/src/video_decoder/pyrowave_udp_assembly.rs
@@ -0,0 +1,239 @@
+//! Bounded, reorder-tolerant transport assembly. Never submit missing blocks to the codec.
+use alvr_packets::PyroWavePacketHeader;
+use std::{
+    collections::BTreeMap,
+    time::{Duration, Instant},
+};
+
+const MAX_PACKETS: usize = 8192;
+const MAX_PENDING: usize = 4;
+
+pub struct CompleteFrame {
+    pub timestamp_ns: u64,
+    pub packets: Vec<Vec<u8>>,
+}
+
+impl CompleteFrame {
+    pub fn into_bitstream(self) -> Vec<u8> {
+        self.packets.into_iter().flatten().collect()
+    }
+}
+
+struct PartialFrame {
+    first_seen: Instant,
+    packets: Vec<Option<Vec<u8>>>,
+    remaining: usize,
+}
+
+#[derive(Default, Clone, Copy)]
+pub struct AssemblyCounters {
+    pub complete: u64,
+    pub dropped: u64,
+    pub duplicates: u64,
+    pub stale: u64,
+    pub invalid: u64,
+}
+
+pub struct Assembler {
+    pending: BTreeMap<u64, PartialFrame>,
+    retired_through: Option<u64>,
+    timeout: Duration,
+    pub counters: AssemblyCounters,
+}
+
+impl Assembler {
+    pub fn new(frame_period: Duration) -> Self {
+        Self {
+            pending: BTreeMap::new(),
+            retired_through: None,
+            // Wi-Fi can reorder tails across the next frame. Three periods is a bounded
+            // assembly window, not an additional wait on an already complete frame.
+            timeout: (frame_period * 3).clamp(Duration::from_millis(25), Duration::from_millis(50)),
+            counters: AssemblyCounters::default(),
+        }
+    }
+
+    fn retire(&mut self, timestamp: u64) {
+        self.retired_through = Some(
+            self.retired_through
+                .map_or(timestamp, |old| old.max(timestamp)),
+        );
+        let cutoff = self.retired_through.unwrap();
+        self.pending.retain(|ts, _| {
+            if *ts <= cutoff {
+                self.counters.dropped += 1;
+                false
+            } else {
+                true
+            }
+        });
+    }
+
+    pub fn expire(&mut self, now: Instant) {
+        let expired = self
+            .pending
+            .iter()
+            .filter(|(_, p)| now.duration_since(p.first_seen) >= self.timeout)
+            .map(|(ts, _)| *ts)
+            .max();
+        if let Some(ts) = expired {
+            self.retire(ts);
+        }
+    }
+
+    /// Returns (first packet for this frame, completed frame). Duplicate indices cannot
+    /// satisfy completeness; count changes and truncated/empty payloads are rejected.
+    pub fn push(
+        &mut self,
+        header: PyroWavePacketHeader,
+        payload: &[u8],
+        now: Instant,
+    ) -> (bool, Option<CompleteFrame>) {
+        if header.count == 0
+            || header.index >= header.count
+            || header.count as usize > MAX_PACKETS
+            || payload.is_empty()
+            || payload.len() > alvr_packets::PYROWAVE_UDP_PAYLOAD
+        {
+            self.counters.invalid += 1;
+            return (false, None);
+        }
+        if self
+            .retired_through
+            .is_some_and(|ts| header.timestamp_ns <= ts)
+        {
+            self.counters.stale += 1;
+            return (false, None);
+        }
+        let first = !self.pending.contains_key(&header.timestamp_ns);
+        if first && self.pending.len() == MAX_PENDING {
+            if header.timestamp_ns < *self.pending.first_key_value().unwrap().0 {
+                self.counters.stale += 1;
+                return (false, None);
+            }
+            self.retire(*self.pending.first_key_value().unwrap().0);
+            if self
+                .retired_through
+                .is_some_and(|ts| header.timestamp_ns <= ts)
+            {
+                self.counters.stale += 1;
+                return (false, None);
+            }
+        }
+        let frame = self
+            .pending
+            .entry(header.timestamp_ns)
+            .or_insert_with(|| PartialFrame {
+                first_seen: now,
+                packets: vec![None; header.count as usize],
+                remaining: header.count as usize,
+            });
+        if frame.packets.len() != header.count as usize {
+            self.counters.invalid += 1;
+            return (false, None);
+        }
+        let packet = &mut frame.packets[header.index as usize];
+        if packet.is_some() {
+            self.counters.duplicates += 1;
+            return (false, None);
+        }
+        *packet = Some(payload.to_vec());
+        frame.remaining -= 1;
+        if frame.remaining != 0 {
+            return (first, None);
+        }
+        let frame = self.pending.remove(&header.timestamp_ns).unwrap();
+        self.retire(header.timestamp_ns);
+        self.counters.complete += 1;
+        (
+            first,
+            Some(CompleteFrame {
+                timestamp_ns: header.timestamp_ns,
+                packets: frame.packets.into_iter().map(Option::unwrap).collect(),
+            }),
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn h(ts: u64, index: u16, count: u16) -> PyroWavePacketHeader {
+        PyroWavePacketHeader {
+            timestamp_ns: ts,
+            index,
+            count,
+            foveation_center: [[0.0; 2]; 2],
+        }
+    }
+    #[test]
+    fn duplicates_and_reordering_cannot_present_a_partial_frame() {
+        let mut a = Assembler::new(Duration::from_millis(8));
+        let now = Instant::now();
+        assert!(a.push(h(1, 2, 3), &[3], now).1.is_none());
+        assert!(a.push(h(1, 2, 3), &[3], now).1.is_none());
+        assert!(a.push(h(1, 0, 3), &[1], now).1.is_none());
+        assert_eq!(
+            a.push(h(1, 1, 3), &[2], now).1.unwrap().packets,
+            vec![vec![1], vec![2], vec![3]]
+        );
+        assert!(a.push(h(1, 0, 3), &[1], now).1.is_none());
+        assert_eq!(a.counters.complete, 1);
+        assert_eq!(a.counters.duplicates, 1);
+    }
+    #[test]
+    fn newer_first_packet_does_not_discard_a_reordered_tail() {
+        let mut a = Assembler::new(Duration::from_millis(8));
+        let now = Instant::now();
+        a.push(h(1, 0, 2), &[1], now);
+        a.push(h(2, 0, 2), &[3], now);
+        assert_eq!(a.push(h(1, 1, 2), &[2], now).1.unwrap().timestamp_ns, 1);
+        assert_eq!(a.push(h(2, 1, 2), &[4], now).1.unwrap().timestamp_ns, 2);
+    }
+    #[test]
+    fn loss_count_changes_and_empty_payloads_never_decode() {
+        let mut a = Assembler::new(Duration::from_millis(8));
+        let now = Instant::now();
+        a.push(h(1, 0, 2), &[1], now);
+        assert!(a.push(h(1, 1, 3), &[2], now).1.is_none());
+        assert!(a.push(h(1, 1, 2), &[], now).1.is_none());
+        a.expire(now + Duration::from_millis(26));
+        assert_eq!(a.counters.dropped, 1);
+        assert_eq!(a.counters.invalid, 2);
+        assert!(a.push(h(1, 1, 2), &[2], now).1.is_none());
+        assert_eq!(a.counters.complete, 0);
+    }
+    #[test]
+    fn fragments_restore_a_codec_block_larger_than_mtu() {
+        let original: Vec<u8> = (0..5000).map(|i| (i % 251) as u8).collect();
+        let chunks: Vec<_> = original
+            .chunks(alvr_packets::PYROWAVE_UDP_PAYLOAD)
+            .collect();
+        let mut a = Assembler::new(Duration::from_millis(8));
+        let now = Instant::now();
+        let mut complete = None;
+        for i in (0..chunks.len()).rev() {
+            complete = a
+                .push(h(1, i as u16, chunks.len() as u16), chunks[i], now)
+                .1
+                .or(complete);
+        }
+        assert_eq!(complete.unwrap().into_bitstream(), original);
+    }
+    #[test]
+    fn overload_preserves_four_newest_frames_and_bounds_allocations() {
+        let mut a = Assembler::new(Duration::from_millis(8));
+        let now = Instant::now();
+        for ts in 10..14 {
+            a.push(h(ts, 0, 2), &[1], now);
+        }
+        a.push(h(9, 0, 2), &[1], now);
+        assert!(a.pending.contains_key(&10));
+        a.push(h(14, 0, 2), &[1], now);
+        assert_eq!(a.pending.len(), 4);
+        assert!(!a.pending.contains_key(&10));
+        assert!(a.push(h(15, 0, u16::MAX), &[1], now).1.is_none());
+        assert_eq!(a.pending.len(), 4);
+        assert_eq!(a.counters.invalid, 1);
+    }
+}
