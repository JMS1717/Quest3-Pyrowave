@@ -0,0 +1,292 @@
+//! Optional EXT timer queries. No result read before availability, no added waits.
+use super::{direct_eye::import_diagnostic, GraphicsContext};
+use glow::HasContext;
+use std::{
+    ffi::c_void,
+    time::{Duration, Instant},
+};
+
+const ELAPSED: u32 = 0x88BF;
+const RESULT: u32 = 0x8866;
+const AVAILABLE: u32 = 0x8867;
+const BITS: u32 = 0x8864;
+const CURRENT: u32 = 0x8865;
+const DISJOINT: u32 = 0x8FBB;
+type Gen = unsafe extern "C" fn(i32, *mut u32);
+type Delete = unsafe extern "C" fn(i32, *const u32);
+type Begin = unsafe extern "C" fn(u32, u32);
+type End = unsafe extern "C" fn(u32);
+type Target = unsafe extern "C" fn(u32, u32, *mut i32);
+type Object = unsafe extern "C" fn(u32, u32, *mut u32);
+type Object64 = unsafe extern "C" fn(u32, u32, *mut u64);
+
+struct Slot {
+    id: u32,
+    pending: bool,
+    invalid: bool,
+}
+pub(super) struct EyeTimer {
+    delete: Delete,
+    begin: Begin,
+    end: End,
+    target: Target,
+    object: Object,
+    object64: Object64,
+    slots: Vec<Slot>,
+    values: Vec<f64>,
+    bits: u32,
+    invalid: u32,
+    busy: u32,
+    last_log: Instant,
+    enabled: bool,
+}
+
+fn requested() -> bool {
+    #[cfg(target_os = "android")]
+    unsafe {
+        extern "C" {
+            fn __system_property_get(
+                name: *const std::ffi::c_char,
+                value: *mut std::ffi::c_char,
+            ) -> i32;
+        }
+        let mut value = [0; 92];
+        return __system_property_get(
+            b"debug.q3pw.eye_gpu_probe\0".as_ptr().cast(),
+            value.as_mut_ptr(),
+        ) == 1
+            && value[0] == b'1' as std::ffi::c_char;
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        false
+    }
+}
+
+impl EyeTimer {
+    pub(super) unsafe fn new(context: &GraphicsContext) -> Option<Self> {
+        if !requested() {
+            return None;
+        }
+        let gl = &context.gl_context;
+        if !gl
+            .supported_extensions()
+            .contains("GL_EXT_disjoint_timer_query")
+        {
+            import_diagnostic(
+                5,
+                "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=extension".into(),
+            );
+            return None;
+        }
+        let names = [
+            "glGenQueriesEXT",
+            "glDeleteQueriesEXT",
+            "glBeginQueryEXT",
+            "glEndQueryEXT",
+            "glGetQueryivEXT",
+            "glGetQueryObjectuivEXT",
+            "glGetQueryObjectui64vEXT",
+        ];
+        let pointers: Vec<*const c_void> = names
+            .iter()
+            .map(|name| context.gl_proc_address(name))
+            .collect();
+        if pointers.iter().any(|p| p.is_null()) {
+            import_diagnostic(
+                5,
+                "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=entrypoint".into(),
+            );
+            return None;
+        }
+        let gen: Gen = std::mem::transmute(pointers[0]);
+        let delete: Delete = std::mem::transmute(pointers[1]);
+        let begin: Begin = std::mem::transmute(pointers[2]);
+        let end: End = std::mem::transmute(pointers[3]);
+        let target: Target = std::mem::transmute(pointers[4]);
+        let object: Object = std::mem::transmute(pointers[5]);
+        let object64: Object64 = std::mem::transmute(pointers[6]);
+        let mut bits = 0;
+        target(ELAPSED, BITS, &mut bits);
+        let error = gl.get_error();
+        if error != glow::NO_ERROR || bits < 30 || bits > 64 {
+            import_diagnostic(
+                5,
+                format!("[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=counter_bits gl_error={error}"),
+            );
+            return None;
+        }
+        let mut ids = [0u32; 8];
+        gen(ids.len() as i32, ids.as_mut_ptr());
+        let error = gl.get_error();
+        if error != glow::NO_ERROR || ids.iter().any(|&id| id == 0) {
+            delete(ids.len() as i32, ids.as_ptr());
+            import_diagnostic(
+                5,
+                format!(
+                    "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=allocation gl_error={error}"
+                ),
+            );
+            return None;
+        }
+        // Establish a disjoint baseline before any measurement begins.
+        gl.get_parameter_i32(DISJOINT);
+        let error = gl.get_error();
+        if error != glow::NO_ERROR {
+            delete(ids.len() as i32, ids.as_ptr());
+            import_diagnostic(
+                5,
+                format!(
+                    "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=disjoint gl_error={error}"
+                ),
+            );
+            return None;
+        }
+        import_diagnostic(
+            4,
+            format!("[Q3PW_EYE_GPU_SETUP] requested=1 active=1 bits={bits} slots=8"),
+        );
+        Some(Self {
+            delete,
+            begin,
+            end,
+            target,
+            object,
+            object64,
+            slots: ids
+                .into_iter()
+                .map(|id| Slot {
+                    id,
+                    pending: false,
+                    invalid: false,
+                })
+                .collect(),
+            values: Vec::new(),
+            bits: bits as u32,
+            invalid: 0,
+            busy: 0,
+            last_log: Instant::now(),
+            enabled: true,
+        })
+    }
+
+    pub(super) unsafe fn begin(&mut self, gl: &glow::Context) -> Option<usize> {
+        if !self.enabled {
+            return None;
+        }
+        let prior_values = self.values.len();
+        let disjoint = gl.get_parameter_i32(DISJOINT) != 0;
+        if disjoint {
+            for slot in &mut self.slots {
+                if slot.pending {
+                    slot.invalid = true;
+                }
+            }
+        }
+        for slot in &mut self.slots {
+            if !slot.pending {
+                continue;
+            }
+            let mut ready = 0;
+            (self.object)(slot.id, AVAILABLE, &mut ready);
+            if ready == 0 {
+                continue;
+            }
+            if slot.invalid {
+                self.invalid += 1;
+            } else {
+                let mut ns = 0u64;
+                (self.object64)(slot.id, RESULT, &mut ns);
+                let saturated = ns == 0 || ns >= u64::MAX >> (64 - self.bits);
+                if saturated {
+                    self.invalid += 1;
+                } else {
+                    self.values.push(ns as f64 / 1e6);
+                }
+            }
+            slot.pending = false;
+        }
+        // The second check closes the interval containing the result reads.
+        // A disjoint event during polling invalidates those newly read values.
+        if gl.get_parameter_i32(DISJOINT) != 0 {
+            self.invalid += (self.values.len() - prior_values) as u32;
+            self.values.truncate(prior_values);
+            for slot in &mut self.slots {
+                if slot.pending {
+                    slot.invalid = true;
+                }
+            }
+        }
+        // Query errors disable the diagnostic, rather than reaching the normal
+        // import error check and aborting the streaming process.
+        if !self.check(gl, "poll") {
+            return None;
+        }
+        if self.last_log.elapsed() >= Duration::from_secs(1) {
+            if self.values.is_empty() {
+                import_diagnostic(
+                    4,
+                    format!(
+                        "[Q3PW_EYE_GPU] samples=0 invalid={} skipped={} elapsed_ms=unknown",
+                        self.invalid, self.busy
+                    ),
+                );
+            } else {
+                self.values.sort_by(f64::total_cmp);
+                let n = self.values.len();
+                import_diagnostic(4, format!("[Q3PW_EYE_GPU] samples={n} mean_ms={:.3} p50_ms={:.3} p95_ms={:.3} max_ms={:.3} invalid={} skipped={}",
+                    self.values.iter().sum::<f64>() / n as f64, self.values[(n-1)/2],
+                    self.values[((n-1) as f64 * 0.95) as usize], self.values[n-1], self.invalid, self.busy));
+            }
+            self.values.clear();
+            self.invalid = 0;
+            self.busy = 0;
+            self.last_log = Instant::now();
+        }
+        let mut current = 0;
+        (self.target)(ELAPSED, CURRENT, &mut current);
+        if !self.check(gl, "current") {
+            return None;
+        }
+        if current != 0 {
+            self.busy += 1;
+            return None;
+        }
+        let Some(index) = self.slots.iter().position(|slot| !slot.pending) else {
+            self.busy += 1;
+            return None;
+        };
+        (self.begin)(ELAPSED, self.slots[index].id);
+        if !self.check(gl, "begin") {
+            return None;
+        }
+        self.slots[index].invalid = false;
+        Some(index)
+    }
+
+    pub(super) unsafe fn end(&mut self, gl: &glow::Context, index: usize) {
+        (self.end)(ELAPSED);
+        self.slots[index].pending = true;
+        self.check(gl, "end");
+    }
+
+    unsafe fn check(&mut self, gl: &glow::Context, stage: &str) -> bool {
+        let error = gl.get_error();
+        if error == glow::NO_ERROR {
+            return true;
+        }
+        self.enabled = false;
+        self.values.clear();
+        for slot in &mut self.slots {
+            slot.invalid = true;
+        }
+        import_diagnostic(5, format!("[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=gl_error stage={stage} gl_error={error}"));
+        false
+    }
+
+    pub(super) unsafe fn destroy(&mut self) {
+        for slot in self.slots.drain(..) {
+            (self.delete)(1, &slot.id);
+        }
+    }
+}
