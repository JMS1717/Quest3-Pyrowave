+// ---- PyroWave over parallel wired TCP connections ----
+//
+// adb forwards TCP only, and one forwarded connection moves about 2 Gbit/s; at 1000+ Mbps and
+// 207 Hz a frame's transfer takes most of a frame interval. With `wired_video_connections` set,
+// the server splits each complete frame into that many contiguous byte slices and writes one to
+// each of the connections in parallel; the client reassembles the frame and decodes it as if it
+// had arrived on ALVR's video stream. Each slice carries a fixed header with a per-frame sequence
+// number: the encoder can repeat a timestamp when a game stutters, so timestamps cannot identify
+// frames on their own.
+
+pub const PYROWAVE_WIRED_PORT: u16 = 9950;
+pub const PYROWAVE_WIRED_MAX_CONNECTIONS: u16 = 4;
+/// The client writes this on each accepted connection, so the server can tell a listening
+/// client from adb's forward accepting and closing for a device port nobody listens on.
+pub const PYROWAVE_WIRED_HELLO: [u8; 4] = *b"PWT1";
+pub const PYROWAVE_WIRED_HEADER_LEN: usize = 48;
+/// Larger than any frame the encoder's budget allows (1/207 s at 4000 Mbps is 2.4 MB).
+pub const PYROWAVE_WIRED_MAX_FRAME: u32 = 64 << 20;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct PyroWaveSliceHeader {
+    pub timestamp_ns: u64,
+    pub frame_len: u32,
+    pub offset: u32,
+    pub len: u32,
+    pub is_idr: bool,
+    /// The server's frame counter for this session, starting at 1; 0 from older servers.
+    pub sequence: u32,
+    pub foveation_center: [[f32; 2]; 2],
+}
+
+impl PyroWaveSliceHeader {
+    pub fn to_bytes(&self) -> [u8; PYROWAVE_WIRED_HEADER_LEN] {
+        let mut b = [0u8; PYROWAVE_WIRED_HEADER_LEN];
+        b[0..4].copy_from_slice(&PYROWAVE_WIRED_HELLO);
+        b[4..12].copy_from_slice(&self.timestamp_ns.to_le_bytes());
+        b[12..16].copy_from_slice(&self.frame_len.to_le_bytes());
+        b[16..20].copy_from_slice(&self.offset.to_le_bytes());
+        b[20..24].copy_from_slice(&self.len.to_le_bytes());
+        b[24] = self.is_idr as u8;
+        b[28..32].copy_from_slice(&self.sequence.to_le_bytes());
+        let c = &self.foveation_center;
+        for (i, v) in [c[0][0], c[0][1], c[1][0], c[1][1]].into_iter().enumerate() {
+            b[32 + i * 4..36 + i * 4].copy_from_slice(&v.to_le_bytes());
+        }
+        b
+    }
+
+    /// None unless the magic matches and the slice lies inside a frame of a sane size.
+    pub fn from_bytes(b: &[u8]) -> Option<Self> {
+        if b.len() < PYROWAVE_WIRED_HEADER_LEN || b[0..4] != PYROWAVE_WIRED_HELLO {
+            return None;
+        }
+        let u = |o: usize| u32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+        let f = |o: usize| f32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+        let h = Self {
+            timestamp_ns: u64::from_le_bytes(b[4..12].try_into().ok()?),
+            frame_len: u(12),
+            offset: u(16),
+            len: u(20),
+            is_idr: b[24] != 0,
+            sequence: u(28),
+            foveation_center: [[f(32), f(36)], [f(40), f(44)]],
+        };
+        (h.frame_len > 0
+            && h.frame_len <= PYROWAVE_WIRED_MAX_FRAME
+            && h.len > 0
+            && h.offset as u64 + h.len as u64 <= h.frame_len as u64)
+            .then_some(h)
+    }
+}
+
+/// The byte range of slice `index` when a frame of `len` bytes is split `count` ways. Empty for
+/// slices past the end of a tiny frame.
+pub fn pyrowave_wired_slice(len: usize, index: usize, count: usize) -> std::ops::Range<usize> {
+    let chunk = len.div_ceil(count.max(1));
+    let start = (index * chunk).min(len);
+    start..(start + chunk).min(len)
+}
