+            path_id: *id,
+            value: match action {
+                ButtonAction::Binary(action) => ButtonValue::Binary(
+                    !released
+                        && action
+                            .state(xr_session, xr::Path::NULL)
+                            .is_ok_and(|s| s.current_state),
+                ),
+                ButtonAction::Scalar(action) => ButtonValue::Scalar(if released {
+                    0.0
+                } else {
+                    action
+                        .state(xr_session, xr::Path::NULL)
+                        .map_or(0.0, |s| s.current_state)
+                }),
+            },
+        })
+        .collect()
