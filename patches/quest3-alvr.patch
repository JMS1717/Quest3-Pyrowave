diff --git a/alvr/client_core/src/performance.rs b/alvr/client_core/src/performance.rs
new file mode 100644
index 0000000000000000000000000000000000000000..84fe7d46be55d89ddedb1142df563458028248a4
--- /dev/null
+++ b/alvr/client_core/src/performance.rs
@@ -0,0 +1,754 @@
+//! Client overlay and headset menu logic; independent of graphics and OpenXR so the controller
+//! gestures and the menu can be regression tested on any platform.
+use alvr_session::headset_settings::{
+    panel_percent_size, HeadsetSettingsRequest, BITRATE_MBPS, RENDER_PERCENT, STREAM_PERCENT,
+};
+use std::{
+    sync::atomic::{AtomicBool, Ordering},
+    time::{Duration, Instant},
+};
+
+/// Holding both thumbsticks this long opens the menu instead of changing the overlay mode.
+pub const MENU_HOLD: Duration = Duration::from_millis(700);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum OverlayMode {
+    #[default]
+    Compact,
+    Full,
+    Hidden,
+}
+
+impl OverlayMode {
+    pub fn next(self) -> Self {
+        match self {
+            Self::Compact => Self::Full,
+            Self::Full => Self::Hidden,
+            Self::Hidden => Self::Compact,
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Compact => "Compact",
+            Self::Full => "Full",
+            Self::Hidden => "Hidden",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChordEvent {
+    CycleOverlay,
+    OpenMenu,
+}
+
+/// Both thumbstick clicks: a short click cycles the overlay on release, a hold opens the menu
+/// once. Both sticks must be released before the chord can fire again.
+#[derive(Default)]
+pub struct ThumbstickChord {
+    pressed_since: Option<Instant>,
+    fired: bool,
+    armed: bool,
+}
+
+impl ThumbstickChord {
+    pub fn new() -> Self {
+        Self {
+            armed: true,
+            ..Default::default()
+        }
+    }
+
+    pub fn update(&mut self, left: bool, right: bool, now: Instant) -> Option<ChordEvent> {
+        if !left && !right {
+            let short_click = self.pressed_since.is_some() && !self.fired;
+            self.pressed_since = None;
+            self.fired = false;
+            self.armed = true;
+            return short_click.then_some(ChordEvent::CycleOverlay);
+        }
+        if left && right && self.armed && self.pressed_since.is_none() {
+            self.pressed_since = Some(now);
+            self.armed = false;
+        }
+        if let Some(since) = self.pressed_since {
+            if !self.fired && now.saturating_duration_since(since) >= MENU_HOLD {
+                self.fired = true;
+                return Some(ChordEvent::OpenMenu);
+            }
+        }
+        None
+    }
+}
+
+static MENU_CAPTURES_INPUT: AtomicBool = AtomicBool::new(false);
+
+/// While the menu is open, controller buttons go to the menu instead of the game.
+pub fn set_menu_captures_input(captured: bool) {
+    MENU_CAPTURES_INPUT.store(captured, Ordering::Relaxed);
+}
+
+pub fn menu_captures_input() -> bool {
+    MENU_CAPTURES_INPUT.load(Ordering::Relaxed)
+}
+
+pub fn metric(value: f32) -> String {
+    if value.is_finite() && value >= 0.0 {
+        format!("{value:.1}")
+    } else {
+        "--".into()
+    }
+}
+
+/// Diagnostic override. `0` hides, `1` forces a visible mode; anything else uses the controller
+/// state, which keeps updating underneath so clearing the property restores it.
+pub fn overlay_visibility(property: &str, controller_mode: OverlayMode) -> OverlayMode {
+    match property.trim() {
+        "0" => OverlayMode::Hidden,
+        "1" if controller_mode == OverlayMode::Hidden => OverlayMode::Full,
+        _ => controller_mode,
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Health {
+    Good,
+    Warn,
+    Bad,
+    Unknown,
+}
+
+/// Fresh frames against the refresh rate.
+pub fn fps_health(fps: f32, refresh_hz: f32) -> Health {
+    if !fps.is_finite() || fps < 0.0 || !refresh_hz.is_finite() || refresh_hz <= 0.0 {
+        Health::Unknown
+    } else if fps >= refresh_hz * 0.97 {
+        Health::Good
+    } else if fps >= refresh_hz * 0.85 {
+        Health::Warn
+    } else {
+        Health::Bad
+    }
+}
+
+/// The project's end-to-end goal is under 30 ms.
+pub fn latency_health(ms: f32) -> Health {
+    if !ms.is_finite() || ms < 0.0 {
+        Health::Unknown
+    } else if ms <= 30.0 {
+        Health::Good
+    } else if ms <= 45.0 {
+        Health::Warn
+    } else {
+        Health::Bad
+    }
+}
+
+/// Quest GPU work for one frame against the frame period.
+pub fn budget_health(ms: f32, refresh_hz: f32) -> Health {
+    if !ms.is_finite() || ms < 0.0 || !refresh_hz.is_finite() || refresh_hz <= 0.0 {
+        return Health::Unknown;
+    }
+    let budget = 1000.0 / refresh_hz;
+    if ms <= budget * 0.7 {
+        Health::Good
+    } else if ms <= budget * 0.9 {
+        Health::Warn
+    } else {
+        Health::Bad
+    }
+}
+
+/// Turns an analog stick axis into discrete steps: one on push, then repeats while held.
+#[derive(Default)]
+pub struct StickRepeat {
+    direction: i32,
+    next: Option<Instant>,
+}
+
+impl StickRepeat {
+    const THRESHOLD: f32 = 0.6;
+    const RELEASE: f32 = 0.3;
+    const FIRST_REPEAT: Duration = Duration::from_millis(400);
+    const REPEAT: Duration = Duration::from_millis(120);
+
+    pub fn update(&mut self, value: f32, now: Instant) -> i32 {
+        let direction = if value >= Self::THRESHOLD {
+            1
+        } else if value <= -Self::THRESHOLD {
+            -1
+        } else if value.abs() < Self::RELEASE || !value.is_finite() {
+            0
+        } else {
+            self.direction
+        };
+        if direction == 0 {
+            self.direction = 0;
+            self.next = None;
+            return 0;
+        }
+        if direction != self.direction {
+            self.direction = direction;
+            self.next = Some(now + Self::FIRST_REPEAT);
+            return direction;
+        }
+        match self.next {
+            Some(next) if now >= next => {
+                self.next = Some(now + Self::REPEAT);
+                direction
+            }
+            _ => 0,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub struct MenuInput {
+    /// -1 up, +1 down
+    pub vertical: i32,
+    /// -1 left, +1 right
+    pub horizontal: i32,
+    pub confirm: bool,
+    pub back: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MenuRow {
+    Refresh,
+    Bitrate,
+    StreamSize,
+    RenderSize,
+    Chroma,
+    Overlay,
+    Apply,
+    Close,
+}
+
+#[derive(Debug, PartialEq)]
+pub enum MenuAction {
+    None,
+    Close,
+    SetOverlay(OverlayMode),
+    Apply(HeadsetSettingsRequest),
+}
+
+/// The values the stream is running with, as the menu shows them.
+#[derive(Clone, Debug, PartialEq)]
+pub struct MenuValues {
+    pub refresh_hz: f32,
+    pub bitrate_mbps: u64,
+    pub chroma_444: bool,
+    pub stream_percent: u32,
+    pub render_percent: u32,
+}
+
+pub struct MenuLine {
+    pub label: &'static str,
+    pub value: String,
+    pub selected: bool,
+    pub changed: bool,
+    /// Whether left/right does anything on this row
+    pub adjustable: bool,
+}
+
+pub struct SettingsMenu {
+    rows: Vec<MenuRow>,
+    selected: usize,
+    refresh_rates: Vec<f32>,
+    initial: MenuValues,
+    values: MenuValues,
+    overlay: OverlayMode,
+    pyrowave: bool,
+    next_request_id: u32,
+    pub pending: Option<(u32, Instant)>,
+    pub status: String,
+}
+
+fn snap(value: u64, (min, max, step): (u64, u64, u64)) -> u64 {
+    let value = value.clamp(min, max);
+    min + (value - min + step / 2) / step * step
+}
+
+fn step(value: u64, delta: i32, (min, max, step): (u64, u64, u64)) -> u64 {
+    let next = value as i64 + delta as i64 * step as i64;
+    snap(next.clamp(min as i64, max as i64) as u64, (min, max, step))
+}
+
+fn range32((min, max, step): (u32, u32, u32)) -> (u64, u64, u64) {
+    (min as u64, max as u64, step as u64)
+}
+
+impl SettingsMenu {
+    pub const PENDING_TIMEOUT: Duration = Duration::from_secs(3);
+
+    pub fn new(
+        current: MenuValues,
+        refresh_rates: &[f32],
+        overlay: OverlayMode,
+        pyrowave: bool,
+    ) -> Self {
+        let mut refresh_rates = refresh_rates
+            .iter()
+            .copied()
+            .filter(|r| r.is_finite() && *r > 0.0)
+            .collect::<Vec<_>>();
+        if !refresh_rates
+            .iter()
+            .any(|r| (r - current.refresh_hz).abs() < 0.01)
+        {
+            refresh_rates.push(current.refresh_hz);
+        }
+        refresh_rates.sort_by(f32::total_cmp);
+        refresh_rates.dedup();
+        let mut values = current.clone();
+        values.bitrate_mbps = snap(values.bitrate_mbps, BITRATE_MBPS);
+        values.stream_percent =
+            snap(values.stream_percent as u64, range32(STREAM_PERCENT)) as u32;
+        values.render_percent =
+            snap(values.render_percent as u64, range32(RENDER_PERCENT)) as u32;
+        let mut rows = vec![
+            MenuRow::Refresh,
+            MenuRow::Bitrate,
+            MenuRow::StreamSize,
+            MenuRow::RenderSize,
+        ];
+        if pyrowave {
+            rows.push(MenuRow::Chroma);
+        }
+        rows.extend([MenuRow::Overlay, MenuRow::Apply, MenuRow::Close]);
+        Self {
+            rows,
+            selected: 0,
+            refresh_rates,
+            initial: values.clone(),
+            values,
+            overlay,
+            pyrowave,
+            next_request_id: 1,
+            pending: None,
+            status: String::new(),
+        }
+    }
+
+    pub fn selected_row(&self) -> MenuRow {
+        self.rows[self.selected]
+    }
+
+    pub fn values(&self) -> &MenuValues {
+        &self.values
+    }
+
+    pub fn needs_reconnect(&self) -> bool {
+        let (a, b) = (&self.values, &self.initial);
+        (a.refresh_hz - b.refresh_hz).abs() >= 0.01
+            || a.chroma_444 != b.chroma_444
+            || a.stream_percent != b.stream_percent
+            || a.render_percent != b.render_percent
+    }
+
+    pub fn has_changes(&self) -> bool {
+        self.needs_reconnect() || self.values.bitrate_mbps != self.initial.bitrate_mbps
+    }
+
+    /// Only the fields the user moved, so values the menu could not read are never rewritten.
+    pub fn request(&mut self) -> HeadsetSettingsRequest {
+        let (a, b) = (&self.values, &self.initial);
+        let request = HeadsetSettingsRequest {
+            request_id: self.next_request_id,
+            refresh_hz: ((a.refresh_hz - b.refresh_hz).abs() >= 0.01).then_some(a.refresh_hz),
+            bitrate_mbps: (a.bitrate_mbps != b.bitrate_mbps).then_some(a.bitrate_mbps),
+            chroma_444: (a.chroma_444 != b.chroma_444).then_some(a.chroma_444),
+            stream_percent: (a.stream_percent != b.stream_percent).then_some(a.stream_percent),
+            render_percent: (a.render_percent != b.render_percent).then_some(a.render_percent),
+        };
+        self.next_request_id = self.next_request_id.wrapping_add(1);
+        request
+    }
+
+    /// A live change (bitrate) becomes the new baseline once the server confirms it.
+    pub fn confirm_applied(&mut self) {
+        self.initial = self.values.clone();
+    }
+
+    pub fn handle(&mut self, input: MenuInput, now: Instant) -> MenuAction {
+        if input.back {
+            return MenuAction::Close;
+        }
+        if input.vertical != 0 {
+            let len = self.rows.len() as i32;
+            self.selected = (self.selected as i32 + input.vertical).rem_euclid(len) as usize;
+        }
+        if input.horizontal != 0 {
+            let d = input.horizontal;
+            let row = self.selected_row();
+            let v = &mut self.values;
+            match row {
+                MenuRow::Refresh => {
+                    let index = self
+                        .refresh_rates
+                        .iter()
+                        .position(|r| (r - v.refresh_hz).abs() < 0.01)
+                        .unwrap_or(0) as i32;
+                    let index =
+                        (index + d).clamp(0, self.refresh_rates.len() as i32 - 1) as usize;
+                    v.refresh_hz = self.refresh_rates[index];
+                }
+                MenuRow::Bitrate => v.bitrate_mbps = step(v.bitrate_mbps, d, BITRATE_MBPS),
+                MenuRow::StreamSize => {
+                    v.stream_percent =
+                        step(v.stream_percent as u64, d, range32(STREAM_PERCENT)) as u32
+                }
+                MenuRow::RenderSize => {
+                    v.render_percent =
+                        step(v.render_percent as u64, d, range32(RENDER_PERCENT)) as u32
+                }
+                MenuRow::Chroma => v.chroma_444 = !v.chroma_444,
+                MenuRow::Overlay => {
+                    self.overlay = if d > 0 {
+                        self.overlay.next()
+                    } else {
+                        self.overlay.next().next()
+                    };
+                    return MenuAction::SetOverlay(self.overlay);
+                }
+                MenuRow::Apply | MenuRow::Close => (),
+            }
+        }
+        if input.confirm {
+            match self.selected_row() {
+                MenuRow::Close => return MenuAction::Close,
+                MenuRow::Apply => {
+                    if self.pending.is_some() {
+                        return MenuAction::None;
+                    }
+                    if !self.has_changes() {
+                        self.status = "Nothing to apply".into();
+                        return MenuAction::None;
+                    }
+                    let request = self.request();
+                    self.pending = Some((request.request_id, now));
+                    self.status = "Sending to PC...".into();
+                    return MenuAction::Apply(request);
+                }
+                MenuRow::Overlay => {
+                    self.overlay = self.overlay.next();
+                    return MenuAction::SetOverlay(self.overlay);
+                }
+                _ => {
+                    // A on a value row jumps to Apply, the usual next step
+                    if let Some(i) = self.rows.iter().position(|r| *r == MenuRow::Apply) {
+                        self.selected = i;
+                    }
+                }
+            }
+        }
+        MenuAction::None
+    }
+
+    /// Clears a request the PC never answered, e.g. an older streamer without menu support.
+    pub fn expire_pending(&mut self, now: Instant) {
+        if let Some((_, sent)) = self.pending {
+            if now.saturating_duration_since(sent) >= Self::PENDING_TIMEOUT {
+                self.pending = None;
+                self.status = "No reply from PC. Update the streamer to change settings here.".into();
+            }
+        }
+    }
+
+    pub fn lines(&self) -> Vec<MenuLine> {
+        let (v, i) = (&self.values, &self.initial);
+        let size = |percent: u32| {
+            let (w, h) = panel_percent_size(percent);
+            format!("{percent}%  ({w} x {h})")
+        };
+        self.rows
+            .iter()
+            .enumerate()
+            .map(|(index, row)| {
+                let (label, value, changed, adjustable) = match row {
+                    MenuRow::Refresh => (
+                        "Refresh rate",
+                        format!("{:.0} Hz", v.refresh_hz),
+                        (v.refresh_hz - i.refresh_hz).abs() >= 0.01,
+                        self.refresh_rates.len() > 1,
+                    ),
+                    MenuRow::Bitrate => (
+                        "Bitrate",
+                        format!("{} Mbps", v.bitrate_mbps),
+                        v.bitrate_mbps != i.bitrate_mbps,
+                        true,
+                    ),
+                    MenuRow::StreamSize => (
+                        "Stream size /eye",
+                        size(v.stream_percent),
+                        v.stream_percent != i.stream_percent,
+                        true,
+                    ),
+                    MenuRow::RenderSize => (
+                        "Game render /eye",
+                        size(v.render_percent),
+                        v.render_percent != i.render_percent,
+                        true,
+                    ),
+                    MenuRow::Chroma => (
+                        "Chroma",
+                        if v.chroma_444 { "4:4:4" } else { "4:2:0" }.into(),
+                        v.chroma_444 != i.chroma_444,
+                        self.pyrowave,
+                    ),
+                    MenuRow::Overlay => ("Overlay", self.overlay.name().into(), false, true),
+                    MenuRow::Apply => (
+                        if self.needs_reconnect() {
+                            "Apply and reconnect"
+                        } else {
+                            "Apply"
+                        },
+                        String::new(),
+                        false,
+                        false,
+                    ),
+                    MenuRow::Close => ("Close", String::new(), false, false),
+                };
+                MenuLine {
+                    label,
+                    value,
+                    selected: index == self.selected,
+                    changed,
+                    adjustable,
+                }
+            })
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn at(start: Instant, ms: u64) -> Instant {
+        start + Duration::from_millis(ms)
+    }
+
+    #[test]
+    fn short_chord_cycles_on_release_and_hold_opens_menu_once() {
+        let t = Instant::now();
+        let mut chord = ThumbstickChord::new();
+        assert_eq!(chord.update(true, false, at(t, 0)), None);
+        assert_eq!(chord.update(true, true, at(t, 10)), None);
+        assert_eq!(chord.update(true, true, at(t, 200)), None);
+        assert_eq!(chord.update(false, true, at(t, 250)), None);
+        assert_eq!(chord.update(false, false, at(t, 260)), Some(ChordEvent::CycleOverlay));
+
+        assert_eq!(chord.update(true, true, at(t, 1000)), None);
+        assert_eq!(chord.update(true, true, at(t, 1800)), Some(ChordEvent::OpenMenu));
+        assert_eq!(chord.update(true, true, at(t, 2500)), None);
+        // releasing after a hold does not also cycle the overlay
+        assert_eq!(chord.update(false, false, at(t, 2600)), None);
+    }
+
+    #[test]
+    fn chord_needs_both_sticks_released_to_rearm() {
+        let t = Instant::now();
+        let mut chord = ThumbstickChord::new();
+        chord.update(true, true, at(t, 0));
+        chord.update(true, true, at(t, 800));
+        // one stick still down: pressing the other again must not start a new chord
+        chord.update(true, false, at(t, 900));
+        assert_eq!(chord.update(true, true, at(t, 1000)), None);
+        assert_eq!(chord.update(true, true, at(t, 2000)), None);
+        assert_eq!(chord.update(false, false, at(t, 2100)), None);
+        chord.update(true, true, at(t, 3000));
+        assert_eq!(chord.update(false, false, at(t, 3100)), Some(ChordEvent::CycleOverlay));
+    }
+
+    #[test]
+    fn overlay_override_has_priority_without_changing_controller_state() {
+        assert_eq!(overlay_visibility("0", OverlayMode::Full), OverlayMode::Hidden);
+        assert_eq!(overlay_visibility("1\n", OverlayMode::Hidden), OverlayMode::Full);
+        assert_eq!(overlay_visibility("1", OverlayMode::Compact), OverlayMode::Compact);
+        assert_eq!(overlay_visibility("", OverlayMode::Hidden), OverlayMode::Hidden);
+        assert_eq!(overlay_visibility(" 0 ", OverlayMode::Compact), OverlayMode::Hidden);
+        assert_eq!(overlay_visibility("invalid", OverlayMode::Full), OverlayMode::Full);
+        assert_eq!(OverlayMode::default(), OverlayMode::Compact);
+        assert_eq!(OverlayMode::Hidden.next(), OverlayMode::Compact);
+    }
+
+    #[test]
+    fn unknown_metrics_are_never_displayed_as_valid_numbers() {
+        assert_eq!(metric(f32::NAN), "--");
+        assert_eq!(metric(f32::INFINITY), "--");
+        assert_eq!(metric(-1.0), "--");
+        assert_eq!(metric(120.0), "120.0");
+        assert_eq!(fps_health(f32::NAN, 120.0), Health::Unknown);
+        assert_eq!(latency_health(-1.0), Health::Unknown);
+        assert_eq!(budget_health(5.0, 0.0), Health::Unknown);
+    }
+
+    #[test]
+    fn health_thresholds_follow_refresh_and_budget() {
+        assert_eq!(fps_health(118.0, 120.0), Health::Good);
+        assert_eq!(fps_health(110.0, 120.0), Health::Warn);
+        assert_eq!(fps_health(90.0, 120.0), Health::Bad);
+        assert_eq!(latency_health(29.0), Health::Good);
+        assert_eq!(latency_health(44.0), Health::Warn);
+        // 207 Hz leaves 4.83 ms; today's 5.9 ms decode is over it
+        assert_eq!(budget_health(5.9, 207.0), Health::Bad);
+        assert_eq!(budget_health(5.9, 120.0), Health::Warn);
+        assert_eq!(budget_health(4.0, 120.0), Health::Good);
+    }
+
+    #[test]
+    fn stick_steps_once_then_repeats_while_held() {
+        let t = Instant::now();
+        let mut stick = StickRepeat::default();
+        assert_eq!(stick.update(0.2, at(t, 0)), 0);
+        assert_eq!(stick.update(0.9, at(t, 10)), 1);
+        assert_eq!(stick.update(0.9, at(t, 200)), 0);
+        assert_eq!(stick.update(0.5, at(t, 300)), 0); // hysteresis keeps it held
+        assert_eq!(stick.update(0.9, at(t, 420)), 1);
+        assert_eq!(stick.update(0.9, at(t, 500)), 0);
+        assert_eq!(stick.update(0.9, at(t, 545)), 1);
+        assert_eq!(stick.update(0.0, at(t, 600)), 0);
+        assert_eq!(stick.update(-0.8, at(t, 610)), -1);
+    }
+
+    fn menu() -> SettingsMenu {
+        SettingsMenu::new(
+            MenuValues {
+                refresh_hz: 120.0,
+                bitrate_mbps: 1000,
+                chroma_444: false,
+                stream_percent: 100,
+                render_percent: 100,
+            },
+            &[72.0, 90.0, 120.0, 144.0],
+            OverlayMode::Compact,
+            true,
+        )
+    }
+
+    fn press(menu: &mut SettingsMenu, input: MenuInput) -> MenuAction {
+        menu.handle(input, Instant::now())
+    }
+
+    const DOWN: MenuInput = MenuInput { vertical: 1, horizontal: 0, confirm: false, back: false };
+    const RIGHT: MenuInput = MenuInput { vertical: 0, horizontal: 1, confirm: false, back: false };
+    const LEFT: MenuInput = MenuInput { vertical: 0, horizontal: -1, confirm: false, back: false };
+    const A: MenuInput = MenuInput { vertical: 0, horizontal: 0, confirm: true, back: false };
+    const B: MenuInput = MenuInput { vertical: 0, horizontal: 0, confirm: false, back: true };
+
+    #[test]
+    fn bitrate_only_change_sends_just_bitrate_and_stays_live() {
+        let mut m = menu();
+        press(&mut m, DOWN);
+        assert_eq!(m.selected_row(), MenuRow::Bitrate);
+        press(&mut m, LEFT);
+        press(&mut m, LEFT);
+        assert!(!m.needs_reconnect());
+        press(&mut m, A); // jumps to Apply
+        assert_eq!(m.selected_row(), MenuRow::Apply);
+        let MenuAction::Apply(request) = press(&mut m, A) else {
+            panic!("no request")
+        };
+        assert_eq!(
+            request,
+            HeadsetSettingsRequest {
+                request_id: 1,
+                bitrate_mbps: Some(900),
+                ..Default::default()
+            }
+        );
+        // a second A while waiting does not resend
+        assert_eq!(press(&mut m, A), MenuAction::None);
+    }
+
+    #[test]
+    fn refresh_only_offers_confirmed_rates_and_needs_reconnect() {
+        let mut m = menu();
+        for _ in 0..5 {
+            press(&mut m, RIGHT);
+        }
+        assert_eq!(m.values().refresh_hz, 144.0);
+        assert!(m.needs_reconnect());
+        assert!(m.lines()[m.lines().len() - 2].label.contains("reconnect"));
+        for _ in 0..10 {
+            press(&mut m, LEFT);
+        }
+        assert_eq!(m.values().refresh_hz, 72.0);
+    }
+
+    #[test]
+    fn values_stay_inside_server_ranges() {
+        let mut m = menu();
+        press(&mut m, DOWN);
+        for _ in 0..200 {
+            press(&mut m, RIGHT);
+        }
+        assert_eq!(m.values().bitrate_mbps, BITRATE_MBPS.1);
+        press(&mut m, DOWN);
+        for _ in 0..100 {
+            press(&mut m, LEFT);
+        }
+        assert_eq!(m.values().stream_percent, STREAM_PERCENT.0);
+        press(&mut m, DOWN);
+        for _ in 0..100 {
+            press(&mut m, RIGHT);
+        }
+        assert_eq!(m.values().render_percent, RENDER_PERCENT.1);
+        let request = m.request();
+        assert!(alvr_session::headset_settings::plan(
+            &request,
+            &alvr_session::SessionConfig::default().to_settings(),
+            &[120.0]
+        )
+        .is_ok());
+    }
+
+    #[test]
+    fn nothing_changed_sends_nothing_and_back_closes() {
+        let mut m = menu();
+        for _ in 0..6 {
+            press(&mut m, DOWN);
+        }
+        assert_eq!(m.selected_row(), MenuRow::Apply);
+        assert_eq!(press(&mut m, A), MenuAction::None);
+        assert_eq!(m.status, "Nothing to apply");
+        assert_eq!(press(&mut m, B), MenuAction::Close);
+    }
+
+    #[test]
+    fn overlay_row_changes_mode_immediately_and_wraps() {
+        let mut m = menu();
+        for _ in 0..5 {
+            press(&mut m, DOWN);
+        }
+        assert_eq!(m.selected_row(), MenuRow::Overlay);
+        assert_eq!(press(&mut m, RIGHT), MenuAction::SetOverlay(OverlayMode::Full));
+        assert_eq!(press(&mut m, LEFT), MenuAction::SetOverlay(OverlayMode::Compact));
+        assert_eq!(press(&mut m, LEFT), MenuAction::SetOverlay(OverlayMode::Hidden));
+        // moving up from the first row wraps to the last
+        let mut m = menu();
+        press(&mut m, MenuInput { vertical: -1, ..Default::default() });
+        assert_eq!(m.selected_row(), MenuRow::Close);
+    }
+
+    #[test]
+    fn unanswered_request_expires_with_a_message() {
+        let mut m = menu();
+        press(&mut m, DOWN);
+        press(&mut m, RIGHT);
+        let t = Instant::now();
+        m.pending = Some((1, t));
+        m.expire_pending(t + Duration::from_secs(1));
+        assert!(m.pending.is_some());
+        m.expire_pending(t + SettingsMenu::PENDING_TIMEOUT);
+        assert!(m.pending.is_none() && m.status.contains("No reply"));
+    }
+
+    #[test]
+    fn chroma_row_is_hidden_for_hardware_codecs() {
+        let m = SettingsMenu::new(menu().values().clone(), &[120.0], OverlayMode::Full, false);
+        assert!(m.lines().iter().all(|l| l.label != "Chroma"));
+    }
+}
diff --git a/alvr/client_core/src/thread_hints.rs b/alvr/client_core/src/thread_hints.rs
new file mode 100644
index 0000000000000000000000000000000000000000..26cd78a8817842a326cb7e1088ff7f5993e961b1
--- /dev/null
+++ b/alvr/client_core/src/thread_hints.rs
@@ -0,0 +1,196 @@
+// `debug.q3pw.thread_hints=1`: declare the stream's time-critical threads to the OpenXR runtime
+// (XR_KHR_android_thread_settings) so it can raise their priority and keep them off the slow
+// efficiency cores. The network and decode threads live here in client_core, which has no
+// XrSession, so each one publishes its kernel thread id and the OpenXR frame loop declares it.
+// Unset or anything but "1" publishes nothing, and the extension is not even enabled.
+
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Mutex, OnceLock,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ThreadRole {
+    /// The OpenXR frame loop: xrWaitFrame, the GLES eye copy, xrEndFrame.
+    RendererMain,
+    /// Decode workers: Vulkan submission and the fence wait that gates each frame.
+    RendererWorker,
+    /// Socket reads, frame hand-off to the decoder and tracking input.
+    ApplicationWorker,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DeclaredThread {
+    pub role: ThreadRole,
+    pub tid: i32,
+    pub name: &'static str,
+}
+
+static PENDING: Mutex<Vec<DeclaredThread>> = Mutex::new(Vec::new());
+static HAS_PENDING: AtomicBool = AtomicBool::new(false);
+
+pub fn requested() -> bool {
+    static REQUESTED: OnceLock<bool> = OnceLock::new();
+    *REQUESTED.get_or_init(|| requested_from_str(&property(c"debug.q3pw.thread_hints")))
+}
+
+pub fn requested_from_str(value: &str) -> bool {
+    value.trim() == "1"
+}
+
+/// Publishes the calling thread for declaration. Does nothing unless requested.
+pub fn publish_current(role: ThreadRole, name: &'static str) {
+    if requested() {
+        publish(DeclaredThread { role, tid: current_tid(), name });
+    }
+}
+
+fn publish(thread: DeclaredThread) {
+    PENDING.lock().unwrap_or_else(|e| e.into_inner()).push(thread);
+    HAS_PENDING.store(true, Ordering::Release);
+}
+
+/// Threads published since the last call. One atomic swap when there are none, so the frame loop
+/// can call it every frame.
+pub fn take_pending() -> Vec<DeclaredThread> {
