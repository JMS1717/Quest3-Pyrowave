+            let values: Vec<_> = self.performance_window.iter().map(field)
+                .filter(|v| v.is_finite() && *v >= 0.0).collect();
+            if values.is_empty() { 0.0 } else { values.iter().sum::<f32>() / values.len() as f32 }
+        };
+        // Average intervals, not rates: alternating 60/120 FPS is 80 FPS, not 90.
+        let client_interval = mean(|s| if s.client_fps > 0.0 { 1.0 / s.client_fps } else { 0.0 });
