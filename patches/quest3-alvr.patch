new file mode 100644
index 0000000000000000000000000000000000000000..9e121e6a2b399dd8c670315ba0ab33c1959a1556
--- /dev/null
+++ b/alvr/graphics/src/panel.rs
@@ -0,0 +1,540 @@
+//! CPU layout and rasterization for the client overlay and headset menu. Drawing happens on a
+//! worker thread, so the render loop only uploads a finished image: nothing here runs per frame.
+use glyph_brush_layout::{
+    ab_glyph::{Font, FontRef, ScaleFont},
+    FontId, GlyphPositioner, Layout, SectionGeometry, SectionText,
+};
+use std::sync::mpsc::{self, Receiver, SyncSender, TrySendError};
+
+pub const STRIP_SIZE: (u32, u32) = (1024, 96);
+pub const PANEL_SIZE: (u32, u32) = (1024, 640);
+
+const FONT: &[u8] = include_bytes!("../resources/Ubuntu-Medium.ttf");
+
+type Rgba = [u8; 4];
+const BACKGROUND: Rgba = [12, 17, 26, 228];
+const CARD: Rgba = [26, 34, 48, 255];
+const SELECTED: Rgba = [44, 74, 122, 255];
+const TEXT: Rgba = [238, 242, 248, 255];
+const MUTED: Rgba = [140, 152, 170, 255];
+const ACCENT: Rgba = [98, 170, 255, 255];
+const GOOD: Rgba = [72, 214, 120, 255];
+const WARN: Rgba = [255, 196, 64, 255];
+const BAD: Rgba = [255, 92, 84, 255];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Tone {
+    Good,
+    Warn,
+    Bad,
+    Neutral,
+}
+
+impl Tone {
+    fn color(self) -> Rgba {
+        match self {
+            Tone::Good => GOOD,
+            Tone::Warn => WARN,
+            Tone::Bad => BAD,
+            Tone::Neutral => TEXT,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Tile {
+    pub label: String,
+    pub value: String,
+    pub unit: String,
+    pub tone: Tone,
+}
+
+#[derive(Clone, Debug)]
+pub struct StatsView {
+    pub title: String,
+    pub subtitle: String,
+    pub tiles: Vec<Tile>,
+    /// Delivered FPS samples, oldest first
+    pub history: Vec<f32>,
+    pub history_target: f32,
+    pub details: Vec<(String, String)>,
+    pub footer: String,
+}
+
+#[derive(Clone, Debug)]
+pub struct MenuViewLine {
+    pub label: String,
+    pub value: String,
+    pub selected: bool,
+    pub changed: bool,
+    pub adjustable: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct MenuView {
+    pub title: String,
+    pub subtitle: String,
+    pub lines: Vec<MenuViewLine>,
+    pub status: String,
+    pub hint: String,
+}
+
+#[derive(Clone, Debug)]
+pub enum PanelView {
+    Strip(Vec<Tile>),
+    Stats(StatsView),
+    Menu(MenuView),
+}
+
+impl PanelView {
+    pub fn size(&self) -> (u32, u32) {
+        match self {
+            PanelView::Strip(_) => STRIP_SIZE,
+            _ => PANEL_SIZE,
+        }
+    }
+}
+
+pub struct Canvas<'a> {
+    pub width: u32,
+    pub height: u32,
+    pub pixels: Vec<u8>,
+    font: FontRef<'a>,
+}
+
+impl Canvas<'_> {
+    pub fn new(width: u32, height: u32) -> Self {
+        Self {
+            width,
+            height,
+            pixels: vec![0; (width * height * 4) as usize],
+            font: FontRef::try_from_slice(FONT).unwrap(),
+        }
+    }
+
+    fn blend(&mut self, x: i32, y: i32, color: Rgba, coverage: f32) {
+        if x < 0 || y < 0 || x >= self.width as i32 || y >= self.height as i32 {
+            return;
+        }
+        let a = (color[3] as f32 / 255.0) * coverage.clamp(0.0, 1.0);
+        if a <= 0.0 {
+            return;
+        }
+        let i = ((y as u32 * self.width + x as u32) * 4) as usize;
+        let dst_a = self.pixels[i + 3] as f32 / 255.0;
+        let out_a = a + dst_a * (1.0 - a);
+        for c in 0..3 {
+            let src = color[c] as f32;
+            let dst = self.pixels[i + c] as f32;
+            self.pixels[i + c] = ((src * a + dst * dst_a * (1.0 - a)) / out_a.max(1e-6)) as u8;
+        }
+        self.pixels[i + 3] = (out_a * 255.0).round() as u8;
+    }
+
+    /// Antialiased rounded rectangle.
+    pub fn rounded_rect(&mut self, x: f32, y: f32, w: f32, h: f32, radius: f32, color: Rgba) {
+        let r = radius.min(w / 2.0).min(h / 2.0);
+        for py in y.floor() as i32..(y + h).ceil() as i32 {
+            for px in x.floor() as i32..(x + w).ceil() as i32 {
+                let (cx, cy) = (px as f32 + 0.5, py as f32 + 0.5);
+                let dx = (x + r - cx).max(cx - (x + w - r)).max(0.0);
+                let dy = (y + r - cy).max(cy - (y + h - r)).max(0.0);
+                let corner = (dx * dx + dy * dy).sqrt() - r;
+                let edge = (x - cx).max(cx - (x + w)).max(y - cy).max(cy - (y + h));
+                let distance = if dx > 0.0 && dy > 0.0 { corner } else { edge };
+                self.blend(px, py, color, 0.5 - distance);
+            }
+        }
+    }
+
+    /// Draws one line of text with its top-left at (x, y); returns the advance width.
+    pub fn text(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) -> f32 {
+        let font = self.font.clone();
+        let glyphs = Layout::default_single_line().calculate_glyphs(
+            &[&font],
+            &SectionGeometry {
+                screen_position: (x, y),
+                bounds: (f32::INFINITY, f32::INFINITY),
+            },
+            &[SectionText {
+                text,
+                scale: size.into(),
+                font_id: FontId(0),
+            }],
+        );
+        let scaled = font.as_scaled(size);
+        let mut right = x;
+        for glyph in glyphs {
+            right = right.max(glyph.glyph.position.x + scaled.h_advance(glyph.glyph.id));
+            if let Some(outline) = scaled.outline_glyph(glyph.glyph) {
+                let bounds = outline.px_bounds();
+                outline.draw(|gx, gy, alpha| {
+                    self.blend(
+                        gx as i32 + bounds.min.x as i32,
+                        gy as i32 + bounds.min.y as i32,
+                        color,
+                        alpha,
+                    );
+                });
+            }
+        }
+        right - x
+    }
+
+    pub fn text_width(&self, size: f32, text: &str) -> f32 {
+        let scaled = self.font.as_scaled(size);
+        text.chars()
+            .map(|c| scaled.h_advance(self.font.glyph_id(c)))
+            .sum()
+    }
+
+    fn text_right(&mut self, right: f32, y: f32, size: f32, color: Rgba, text: &str) {
+        let width = self.text_width(size, text);
+        self.text(right - width, y, size, color, text);
+    }
+
+    /// Antialiased segment, by distance from each pixel in its bounding box.
+    fn line(&mut self, x0: f32, y0: f32, x1: f32, y1: f32, width: f32, color: Rgba) {
+        let half = width / 2.0;
+        let (dx, dy) = (x1 - x0, y1 - y0);
+        let length_sq = (dx * dx + dy * dy).max(1e-6);
+        for py in (y0.min(y1) - half - 1.0) as i32..=(y0.max(y1) + half + 1.0) as i32 {
+            for px in (x0.min(x1) - half - 1.0) as i32..=(x0.max(x1) + half + 1.0) as i32 {
+                let (cx, cy) = (px as f32 + 0.5, py as f32 + 0.5);
+                let t = (((cx - x0) * dx + (cy - y0) * dy) / length_sq).clamp(0.0, 1.0);
+                let d = ((cx - x0 - dx * t).powi(2) + (cy - y0 - dy * t).powi(2)).sqrt();
+                self.blend(px, py, color, half + 0.5 - d);
+            }
+        }
+    }
+}
+
+fn tile(canvas: &mut Canvas, x: f32, y: f32, w: f32, h: f32, tile: &Tile) {
+    canvas.rounded_rect(x, y, w, h, 14.0, CARD);
+    canvas.rounded_rect(x, y + 14.0, 5.0, h - 28.0, 2.5, tile.tone.color());
+    canvas.text(x + 22.0, y + 12.0, 24.0, MUTED, &tile.label);
+    let advance = canvas.text(x + 20.0, y + 40.0, 60.0, tile.tone.color(), &tile.value);
+    canvas.text(x + 28.0 + advance, y + 68.0, 26.0, MUTED, &tile.unit);
+}
+
+fn draw_strip(canvas: &mut Canvas, tiles: &[Tile]) {
+    let (w, h) = (canvas.width as f32, canvas.height as f32);
+    canvas.rounded_rect(0.0, 0.0, w, h, h / 2.0, BACKGROUND);
+    let item = |canvas: &Canvas, t: &Tile| {
+        24.0 + canvas.text_width(46.0, &t.value) + 8.0 + canvas.text_width(26.0, &t.unit)
+    };
+    let gap = 44.0;
+    let total = tiles.iter().map(|t| item(canvas, t)).sum::<f32>()
+        + gap * tiles.len().saturating_sub(1) as f32;
+    let mut x = ((w - total) / 2.0).max(36.0);
+    for (i, t) in tiles.iter().enumerate() {
+        if i > 0 {
+            canvas.rounded_rect(x - gap / 2.0 - 1.0, 24.0, 2.0, h - 48.0, 1.0, CARD);
+        }
+        canvas.rounded_rect(x, h / 2.0 - 7.0, 14.0, 14.0, 7.0, t.tone.color());
+        x += 24.0;
+        x += canvas.text(x, 20.0, 46.0, TEXT, &t.value) + 8.0;
+        x += canvas.text(x, 36.0, 26.0, MUTED, &t.unit) + gap;
+    }
+}
+
+fn draw_stats(canvas: &mut Canvas, view: &StatsView) {
+    let (w, h) = (canvas.width as f32, canvas.height as f32);
+    canvas.rounded_rect(0.0, 0.0, w, h, 28.0, BACKGROUND);
+    canvas.text(32.0, 24.0, 34.0, TEXT, &view.title);
+    canvas.text(32.0, 66.0, 24.0, MUTED, &view.subtitle);
+
+    let count = view.tiles.len().max(1) as f32;
+    let gap = 16.0;
+    let tile_w = (w - 64.0 - gap * (count - 1.0)) / count;
+    for (i, t) in view.tiles.iter().enumerate() {
+        tile(canvas, 32.0 + i as f32 * (tile_w + gap), 106.0, tile_w, 112.0, t);
+    }
+
+    // Delivered FPS history against the refresh rate
+    let (gx, gy, gw, gh) = (32.0, 234.0, w - 64.0, 120.0);
+    canvas.rounded_rect(gx, gy, gw, gh, 14.0, CARD);
+    canvas.text(gx + 18.0, gy + 10.0, 22.0, MUTED, "Delivered FPS, last 30 s");
+    let target = view.history_target;
+    if target.is_finite() && target > 0.0 {
+        // Half the refresh rate at the bottom keeps small drops visible
+        let (bottom, top) = (target * 0.5, target * 1.08);
+        let (px, pw, py, ph) = (gx + 18.0, gw - 36.0, gy + 40.0, gh - 54.0);
+        let y_of = |v: f32| py + ph - ((v - bottom) / (top - bottom)).clamp(0.0, 1.0) * ph;
+        let ty = y_of(target);
+        canvas.line(px, ty, px + pw, ty, 1.5, [ACCENT[0], ACCENT[1], ACCENT[2], 140]);
+        canvas.text_right(gx + gw - 18.0, gy + 10.0, 22.0, ACCENT, &format!("{target:.0} Hz"));
+        let points = view
+            .history
+            .iter()
+            .map(|v| if v.is_finite() && *v >= 0.0 { *v } else { 0.0 })
+            .collect::<Vec<_>>();
+        if points.len() >= 2 {
+            let dx = pw / (points.len() - 1) as f32;
+            for (i, pair) in points.windows(2).enumerate() {
+                let tone = if pair[1] >= target * 0.97 {
+                    GOOD
+                } else if pair[1] >= target * 0.85 {
+                    WARN
+                } else {
+                    BAD
+                };
+                canvas.line(
+                    px + i as f32 * dx,
+                    y_of(pair[0]),
+                    px + (i + 1) as f32 * dx,
+                    y_of(pair[1]),
+                    3.0,
+                    tone,
+                );
+            }
+        }
+    }
+
+    // Two columns of label/value rows
+    let rows_y = 372.0;
+    let row_h = 34.0;
+    let col_w = (w - 64.0) / 2.0;
+    let per_column = view.details.len().div_ceil(2);
+    for (i, (label, value)) in view.details.iter().enumerate() {
+        let col = (i / per_column.max(1)) as f32;
+        let row = (i % per_column.max(1)) as f32;
+        let x = 32.0 + col * col_w;
+        let y = rows_y + row * row_h;
+        canvas.text(x, y, 24.0, MUTED, label);
+        canvas.text_right(x + col_w - 24.0, y, 24.0, TEXT, value);
+    }
+    canvas.text(32.0, h - 40.0, 20.0, MUTED, &view.footer);
+}
+
+fn draw_menu(canvas: &mut Canvas, view: &MenuView) {
+    let (w, h) = (canvas.width as f32, canvas.height as f32);
+    canvas.rounded_rect(0.0, 0.0, w, h, 28.0, BACKGROUND);
+    canvas.text(36.0, 24.0, 36.0, TEXT, &view.title);
+    canvas.text(36.0, 68.0, 22.0, MUTED, &view.subtitle);
+    let row_h = 52.0;
+    let mut y = 108.0;
+    for line in &view.lines {
+        if line.selected {
+            canvas.rounded_rect(24.0, y, w - 48.0, row_h - 6.0, 12.0, SELECTED);
+        }
+        let label_color = if line.selected { TEXT } else { [200, 208, 220, 255] };
+        canvas.text(48.0, y + 9.0, 28.0, label_color, &line.label);
+        if !line.value.is_empty() {
+            let right = w - 56.0;
+            let value_color = if line.changed { WARN } else { TEXT };
+            if line.adjustable && line.selected {
+                let arrows_w = canvas.text_width(28.0, ">");
+                canvas.text_right(right, y + 9.0, 28.0, ACCENT, ">");
+                let value_right = right - arrows_w - 14.0;
+                canvas.text_right(value_right, y + 9.0, 28.0, value_color, &line.value);
+                let value_w = canvas.text_width(28.0, &line.value);
+                canvas.text_right(value_right - value_w - 14.0, y + 9.0, 28.0, ACCENT, "<");
+            } else {
+                canvas.text_right(right, y + 9.0, 28.0, value_color, &line.value);
+            }
+        }
+        y += row_h;
+    }
+    if !view.status.is_empty() {
+        canvas.text(48.0, h - 78.0, 24.0, ACCENT, &view.status);
+    }
+    canvas.text(48.0, h - 42.0, 22.0, MUTED, &view.hint);
+}
+
+pub fn rasterize(view: &PanelView) -> Vec<u8> {
+    let (width, height) = view.size();
+    let mut canvas = Canvas::new(width, height);
+    match view {
+        PanelView::Strip(tiles) => draw_strip(&mut canvas, tiles),
+        PanelView::Stats(stats) => draw_stats(&mut canvas, stats),
+        PanelView::Menu(menu) => draw_menu(&mut canvas, menu),
+    }
+    canvas.pixels
+}
+
+/// Rasterizes views on a worker thread. At most one view waits; a newer one replaces it.
+pub struct PanelRasterizer {
+    jobs: SyncSender<PanelView>,
+    results: Receiver<(PanelView, Vec<u8>, f64)>,
+    busy: bool,
+    waiting: Option<PanelView>,
+}
+
+impl Default for PanelRasterizer {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl PanelRasterizer {
+    pub fn new() -> Self {
+        let (jobs, job_receiver) = mpsc::sync_channel::<PanelView>(1);
+        let (result_sender, results) = mpsc::channel();
+        std::thread::Builder::new()
+            .name("q3pw-overlay".into())
+            .spawn(move || {
+                while let Ok(view) = job_receiver.recv() {
+                    let started = std::time::Instant::now();
+                    let pixels = rasterize(&view);
+                    let ms = started.elapsed().as_secs_f64() * 1000.0;
+                    if result_sender.send((view, pixels, ms)).is_err() {
+                        break;
+                    }
+                }
+            })
+            .ok();
+        Self {
+            jobs,
+            results,
+            busy: false,
+            waiting: None,
+        }
+    }
+
+    pub fn submit(&mut self, view: PanelView) {
+        if self.busy {
+            self.waiting = Some(view);
+            return;
+        }
+        match self.jobs.try_send(view) {
+            Ok(()) => self.busy = true,
+            Err(TrySendError::Full(view)) => self.waiting = Some(view),
+            Err(TrySendError::Disconnected(_)) => (),
+        }
+    }
+
+    /// The newest finished image and its worker raster time, if one completed since the last call.
+    pub fn poll(&mut self) -> Option<(PanelView, Vec<u8>, f64)> {
+        let mut latest = None;
+        while let Ok(result) = self.results.try_recv() {
+            self.busy = false;
+            latest = Some(result);
+        }
+        if !self.busy {
+            if let Some(view) = self.waiting.take() {
+                self.submit(view);
+            }
+        }
+        latest
+    }
+}
