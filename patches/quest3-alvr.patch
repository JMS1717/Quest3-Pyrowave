+};
+use std::rc::Rc;
+use wgpu::*;
+
+/// A small client-local panel. Text is rasterized/uploaded only when updated, then
+/// the OpenXR compositor reuses the last released image at the headset refresh rate.
+pub struct PerformanceRenderer {
+    context: Rc<GraphicsContext>,
+    resolution: UVec2,
+    texture: Texture,
+    targets: Vec<TextureView>,
+    pipeline: RenderPipeline,
+    bind_group: BindGroup,
+}
+
+impl PerformanceRenderer {
+    pub fn new(context: Rc<GraphicsContext>, resolution: UVec2, images: &[u32]) -> Self {
+        let device = &context.device;
+        let texture = create_texture(device, resolution, SDR_FORMAT);
+        let targets = create_gl_swapchain(device, images, resolution, SDR_FORMAT);
+        let layout = device.create_bind_group_layout(&BindGroupLayoutDescriptor {
+            label: Some("performance_panel"),
+            entries: &[
+                BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: ShaderStages::FRAGMENT,
+                    ty: BindingType::Texture {
+                        sample_type: TextureSampleType::Float { filterable: true },
+                        view_dimension: TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: ShaderStages::FRAGMENT,
+                    ty: BindingType::Sampler(SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let view = texture.create_view(&TextureViewDescriptor::default());
+        let sampler = device.create_sampler(&SamplerDescriptor {
+            mag_filter: FilterMode::Linear,
+            min_filter: FilterMode::Linear,
+            ..Default::default()
+        });
+        let bind_group = device.create_bind_group(&BindGroupDescriptor {
+            label: None,
+            layout: &layout,
+            entries: &[
+                BindGroupEntry {
+                    binding: 0,
+                    resource: BindingResource::TextureView(&view),
+                },
+                BindGroupEntry {
+                    binding: 1,
+                    resource: BindingResource::Sampler(&sampler),
+                },
+            ],
+        });
+        let shader = device.create_shader_module(ShaderModuleDescriptor {
+            label: Some("performance_panel"),
+            source: ShaderSource::Wgsl(include_str!("../resources/performance.wgsl").into()),
+        });
+        let pipeline_layout = device.create_pipeline_layout(&PipelineLayoutDescriptor {
+            label: None,
+            bind_group_layouts: &[&layout],
+            push_constant_ranges: &[],
+        });
+        let pipeline = device.create_render_pipeline(&RenderPipelineDescriptor {
+            label: Some("performance_panel"),
+            layout: Some(&pipeline_layout),
+            vertex: VertexState {
+                module: &shader,
+                entry_point: Some("vertex_main"),
+                compilation_options: Default::default(),
+                buffers: &[],
+            },
+            primitive: PrimitiveState::default(),
+            depth_stencil: None,
+            multisample: Default::default(),
+            fragment: Some(FragmentState {
+                module: &shader,
+                entry_point: Some("fragment_main"),
+                compilation_options: Default::default(),
+                targets: &[Some(ColorTargetState {
+                    format: SDR_FORMAT,
+                    blend: None,
+                    write_mask: ColorWrites::ALL,
+                })],
+            }),
+            multiview: None,
+            cache: None,
+        });
+        Self {
+            context,
+            resolution,
+            texture,
+            targets,
+            pipeline,
+            bind_group,
+        }
+    }
+
+    pub fn update(&self, image: usize, text: &str) {
+        let font =
+            FontRef::try_from_slice(include_bytes!("../resources/Ubuntu-Medium.ttf")).unwrap();
+        let glyphs = Layout::default().calculate_glyphs(
+            &[&font],
+            &SectionGeometry {
+                screen_position: (24.0, 22.0),
+                bounds: (
+                    self.resolution.x as f32 - 48.0,
+                    self.resolution.y as f32 - 44.0,
+                ),
+            },
+            &[SectionText {
+                text,
+                scale: 27.0.into(),
+                font_id: FontId(0),
+            }],
+        );
+        let mut pixels = [10, 16, 24, 235].repeat((self.resolution.x * self.resolution.y) as usize);
+        let scaled = font.as_scaled(27.0);
+        for glyph in glyphs {
+            if let Some(outline) = scaled.outline_glyph(glyph.glyph) {
+                let bounds = outline.px_bounds();
+                outline.draw(|x, y, alpha| {
+                    let x = x as i32 + bounds.min.x as i32;
+                    let y = y as i32 + bounds.min.y as i32;
+                    if x >= 0
+                        && y >= 0
+                        && x < self.resolution.x as i32
+                        && y < self.resolution.y as i32
+                    {
+                        let index = ((y as u32 * self.resolution.x + x as u32) * 4) as usize;
+                        for channel in 0..3 {
+                            pixels[index + channel] =
+                                (pixels[index + channel] as f32 * (1.0 - alpha) + 245.0 * alpha)
+                                    as u8;
+                        }
+                        pixels[index + 3] = 255;
+                    }
+                });
+            }
+        }
+        self.context.queue.write_texture(
+            TexelCopyTextureInfo {
+                texture: &self.texture,
+                mip_level: 0,
+                origin: Origin3d::ZERO,
+                aspect: TextureAspect::All,
+            },
+            &pixels,
+            TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(self.resolution.x * 4),
+                rows_per_image: Some(self.resolution.y),
+            },
+            Extent3d {
+                width: self.resolution.x,
+                height: self.resolution.y,
+                depth_or_array_layers: 1,
+            },
+        );
+        let mut encoder = self
+            .context
+            .device
+            .create_command_encoder(&CommandEncoderDescriptor { label: None });
+        {
+            let mut pass = encoder.begin_render_pass(&RenderPassDescriptor {
+                label: Some("performance_panel"),
+                color_attachments: &[Some(RenderPassColorAttachment {
+                    view: &self.targets[image],
+                    resolve_target: None,
+                    ops: Operations {
+                        load: LoadOp::Clear(Color::TRANSPARENT),
+                        store: StoreOp::Store,
+                    },
+                })],
+                depth_stencil_attachment: None,
+                timestamp_writes: None,
+                occlusion_query_set: None,
+            });
+            pass.set_pipeline(&self.pipeline);
+            pass.set_bind_group(0, &self.bind_group, &[]);
+            pass.draw(0..3, 0..1);
+        }
+        self.context.queue.submit(Some(encoder.finish()));
+    }
+}
