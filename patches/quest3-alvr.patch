+            bitrate_mbps: match v.bitrate.mode {
+                BitrateMode::ConstantMbps(mbps) => Some(mbps),
+                _ => None,
+            },
+            chroma_444: pyrowave && v.pyrowave.chroma_444,
+            stream_percent,
+            render_percent: frame_size_percent(&v.emulated_headset_view_resolution)
