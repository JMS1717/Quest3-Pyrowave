+/// Validates a headset menu request and saves it to the session, as a dashboard edit would.
+fn apply_headset_settings(
+    request: &alvr_session::headset_settings::HeadsetSettingsRequest,
+    supported_refresh_rates: &[f32],
+) -> alvr_session::headset_settings::HeadsetSettingsAck {
+    use alvr_packets::{PathSegment, PathValuePair};
+    let mut session_manager = SESSION_MANAGER.write();
+    let result = alvr_session::headset_settings::plan(
+        request,
+        session_manager.settings(),
+        supported_refresh_rates,
+    )
+    .and_then(|plan| {
+        if !plan.assignments.is_empty() {
+            let descs = plan
+                .assignments
+                .iter()
+                .map(|(path, value)| PathValuePair {
+                    path: std::iter::once("session_settings")
+                        .chain(path.split('.'))
+                        .map(|name| PathSegment::Name(name.into()))
+                        .collect(),
+                    value: value.clone(),
+                })
+                .collect();
+            session_manager
+                .set_values(descs)
+                .map_err(|e| format!("Could not save settings: {e}"))?;
+        }
+        Ok(plan)
+    });
+    match result {
+        Ok(plan) => alvr_session::headset_settings::HeadsetSettingsAck {
+            request_id: request.request_id,
+            applied: true,
+            reconnect: plan.reconnect,
+            message: if plan.changes.is_empty() {
+                "No changes".into()
+            } else if plan.reconnect {
+                format!("Saved {}. Reconnecting...", plan.changes.join(", "))
+            } else {
+                format!("Applied {}", plan.changes.join(", "))
+            },
+        },
+        Err(message) => alvr_session::headset_settings::HeadsetSettingsAck {
+            request_id: request.request_id,
+            applied: false,
+            reconnect: false,
+            message,
+        },
+    }
 }
 
