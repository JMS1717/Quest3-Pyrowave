+const UPDATE_INTERVAL: Duration = Duration::from_millis(500);
+/// 30 s of history at the update interval
+const HISTORY_LEN: usize = 60;
+const MENU_DISTANCE_M: f32 = 1.0;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Shown {
+    Nothing,
+    Stats,
+    Menu,
+}
+
+/// A quad layer's swapchain and the GL renderer that uploads finished images into it.
+struct Surface {
+    swapchain: xr::Swapchain<xr::OpenGlEs>,
+    renderer: PerformanceRenderer,
+    size: UVec2,
+    shown: Shown,
+}
+
+impl Surface {
+    fn new(
+        session: &xr::Session<xr::OpenGlEs>,
+        context: &Rc<GraphicsContext>,
+        (width, height): (u32, u32),
+    ) -> xr::Result<Self> {
+        // The runtime creates the swapchain's GL textures in the current context, and wgpu's GLES
+        // backend releases it after each use; without this the second surface got texture name 0.
+        context.make_current();
+        let swapchain = session.create_swapchain(&xr::SwapchainCreateInfo {
+            create_flags: xr::SwapchainCreateFlags::EMPTY,
+            usage_flags: xr::SwapchainUsageFlags::COLOR_ATTACHMENT
+                | xr::SwapchainUsageFlags::SAMPLED,
+            format: SDR_FORMAT_GL,
+            sample_count: 1,
+            width,
+            height,
+            face_count: 1,
+            array_size: 1,
+            mip_count: 1,
+        })?;
+        let size = UVec2::new(width, height);
+        let images = swapchain.enumerate_images()?;
+        if images.iter().any(|&image| image == 0) {
+            // Disable the overlay rather than panic in texture import and take the client down.
+            return Err(xr::sys::Result::ERROR_RUNTIME_FAILURE);
+        }
+        let renderer = PerformanceRenderer::new(Rc::clone(context), size, &images);
+        Ok(Self {
+            swapchain,
+            renderer,
+            size,
+            shown: Shown::Nothing,
+        })
+    }
+
+    fn quad(&self) -> xr::CompositionLayerQuad<'_, xr::OpenGlEs> {
+        xr::CompositionLayerQuad::new()
+            .layer_flags(
+                xr::CompositionLayerFlags::BLEND_TEXTURE_SOURCE_ALPHA
+                    | xr::CompositionLayerFlags::UNPREMULTIPLIED_ALPHA,
+            )
+            .eye_visibility(xr::EyeVisibility::BOTH)
+            .sub_image(self.sub_image())
+    }
+
+    fn sub_image(&self) -> xr::SwapchainSubImage<'_, xr::OpenGlEs> {
+        xr::SwapchainSubImage::new()
+            .swapchain(&self.swapchain)
+            .image_array_index(0)
+            .image_rect(xr::Rect2Di {
+                offset: xr::Offset2Di { x: 0, y: 0 },
+                extent: xr::Extent2Di {
+                    width: self.size.x as i32,
+                    height: self.size.y as i32,
+                },
+            })
+    }
+}
+
+/// What the current stream was negotiated with, for the panel header and the menu.
+#[derive(Default)]
+struct StreamInfo {
