+    use super::*;
+    use windows_sys::Win32::{Foundation::{GetHandleInformation, HANDLE_FLAG_INHERIT},
+        Security::SECURITY_ATTRIBUTES, System::Threading::{CreateEventW, SetEvent}};
+
+    #[test]
+    fn bootstrap_preserves_exit_status_and_rejects_bad_paths() {
+        assert_eq!(run_no_inherit(OsStr::new("cmd.exe"), OsStr::new("cmd.exe /C exit 7")).unwrap(), 7);
+        assert!(start_server("bad\0path").is_err());
+        assert!(start_server("bad\"path").is_err());
+    }
+
+    #[test]
+    fn bootstrap_does_not_inherit_a_parent_handle() {
+        let mut attributes: SECURITY_ATTRIBUTES = unsafe { std::mem::zeroed() };
+        attributes.nLength = size_of::<SECURITY_ATTRIBUTES>() as u32;
+        attributes.bInheritHandle = 1;
+        let event = unsafe { CreateEventW(&attributes, 1, 0, ptr::null()) };
+        assert!(!event.is_null());
+        struct Event(HANDLE);
+        impl Drop for Event { fn drop(&mut self) { unsafe { CloseHandle(self.0); } } }
+        let event = Event(event);
+        let mut flags = 0;
+        assert_ne!(unsafe { GetHandleInformation(event.0, &mut flags) }, 0);
+        assert_ne!(flags & HANDLE_FLAG_INHERIT, 0);
+        // The ignored child probe runs in this same test binary. Env mutation is
+        // unnecessary: embed the handle in its exact test-filter argument.
+        let exe = std::env::current_exe().unwrap();
+        let filter = format!("windows_launcher::tests::child_handle_probe_{:x}", event.0 as usize);
+        // Rust test harness has no dynamic test names, so pass a marker argument
+        // after --; child probe reads argv and checks this parent handle value.
+        let command = format!("\"{}\" child_handle_probe --ignored --nocapture -- {}", exe.display(), filter);
+        // A distinct status proves the child probe actually ran, rather than
+        // accepting a harness invocation that matched no tests.
+        assert_eq!(run_no_inherit(exe.as_os_str(), OsStr::new(&command)).unwrap(), 57);
+        // A handle number may be reused for an unrelated object in the child.
+        // Check the parent event's identity by observing its signal, not whether
+        // that number is valid in a different process.
+        assert_eq!(unsafe { WaitForSingleObject(event.0, 0) }, WAIT_TIMEOUT,
+            "Parent event was signaled through a leaked inheritable handle");
+
+        // Positive control: the same probe must signal this actual parent event
+        // when inheritance is explicitly enabled. This prevents a no-op child
+        // or unrelated child handle from making the isolation assertion vacuous.
+        let mut line = wide(OsStr::new(&command)).unwrap();
+        let mut startup: STARTUPINFOW = unsafe { std::mem::zeroed() };
+        startup.cb = size_of::<STARTUPINFOW>() as u32;
+        let mut process = unsafe { std::mem::zeroed() };
+        assert_ne!(unsafe { CreateProcessW(ptr::null(), line.as_mut_ptr(), ptr::null(),
+            ptr::null(), 1, CREATE_NO_WINDOW, ptr::null(), ptr::null(),
+            &startup, &mut process) }, 0);
+        let process = ProcessHandles(process);
+        assert_eq!(unsafe { WaitForSingleObject(process.0.hProcess, 30_000) }, WAIT_OBJECT_0);
+        let mut exit_code = 0;
+        assert_ne!(unsafe { GetExitCodeProcess(process.0.hProcess, &mut exit_code) }, 0);
+        assert_eq!(exit_code, 57);
+        assert_eq!(unsafe { WaitForSingleObject(event.0, 0) }, WAIT_OBJECT_0,
+            "Positive control did not signal the actual parent event");
+    }
+
+    #[test]
+    #[ignore]
+    fn child_handle_probe() {
+        let marker = std::env::args().find(|a| a.starts_with("windows_launcher::tests::child_handle_probe_"))
+            .expect("parent handle marker");
+        let handle = usize::from_str_radix(marker.rsplit('_').next().unwrap(), 16).unwrap() as HANDLE;
+        // Failure is expected for a non-inherited handle. A reused handle may
+        // refer to a child-local event; only the parent's signal proves a leak.
+        unsafe { SetEvent(handle); }
+        std::process::exit(57);
+    }
+}
