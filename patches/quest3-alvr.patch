+
+pub fn frame_budget(
+    width: u32,
+    height: u32,
+    hz: f64,
+    mbps: u64,
+    full_chroma: bool,
+) -> Option<FrameBudget> {
+    if width == 0 || height == 0 || !hz.is_finite() || hz <= 0.0 || mbps == 0 {
+        return None;
+    }
+    let eye_width = width.checked_add(31)? / 32 * 32;
+    let eye_height = height.checked_add(31)? / 32 * 32;
+    let pixels = u64::from(eye_width)
+        .checked_mul(u64::from(eye_height))?
+        .checked_mul(2)?;
+    let raw_bytes = pixels.checked_mul(3)? / if full_chroma { 1 } else { 2 };
+    // Match the encoder's integer bps / 8 / integer framerate calculation.
+    let encoder_hz = hz.round() as u64;
+    if encoder_hz == 0 {
+        return None;
+    }
+    let payload_bytes = mbps.checked_mul(1_000_000)? / 8 / encoder_hz;
+    if payload_bytes == 0 {
+        return None;
+    }
+    Some(FrameBudget {
+        eye_width,
+        eye_height,
+        frame_ms: 1000.0 / hz,
+        payload_bytes,
+        raw_bytes,
+        raw_to_payload: raw_bytes as f64 / payload_bytes as f64,
+    })
+}
+
+/// Lowest PyroWave bitrate the streamer requests, in bits per padded stream pixel (both eyes,
+/// 4:2:0) per frame. Measured October 7 (docs/BITRATE.md): below about this rate the encoder's
+/// smooth-area quality falls under what the previous encoder gave at 1000 Mbps, 207 Hz and full
+/// panel size, which already looked pixelated next to Virtual Desktop.
+pub const QUALITY_FLOOR_BITS_PER_PIXEL: f64 = 0.25;
+
+/// The quality floor in Mbps for a stream size and refresh rate, rounded up to 50 Mbps. 4:4:4
+/// doubles the raw samples and the floor (not measured, so it errs high).
+pub fn quality_floor_mbps(width: u32, height: u32, hz: f64, full_chroma: bool) -> Option<u64> {
+    if width == 0 || height == 0 || !hz.is_finite() || hz.round() < 1.0 {
+        return None;
+    }
+    let pixels = 2.0 * f64::from(width.checked_add(31)? / 32 * 32)
+        * f64::from(height.checked_add(31)? / 32 * 32);
+    let chroma = if full_chroma { 2.0 } else { 1.0 };
+    let mbps = pixels * hz.round() * QUALITY_FLOOR_BITS_PER_PIXEL * chroma / 1e6;
+    Some(((mbps / 50.0).ceil() as u64 * 50).min(crate::headset_settings::MAX_BITRATE_MBPS))
+}
