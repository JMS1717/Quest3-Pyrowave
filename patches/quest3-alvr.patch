diff --git a/alvr/graphics/resources/direct_eye_fragment.glsl b/alvr/graphics/resources/direct_eye_fragment.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..b664b8244cebd480e2c841109fbf2f6bae735105
--- /dev/null
+++ b/alvr/graphics/resources/direct_eye_fragment.glsl
@@ -0,0 +1,34 @@
+#version 300 es
+#extension GL_OES_EGL_image_external_essl3 : require
+precision highp float;
+uniform samplerExternalOES tex;
+uniform int fix_limited_range;
+uniform int srgb_correction;
+uniform float encoding_gamma;
+in vec2 uv;
+out vec4 out_color;
+// Q3PW_FOVEATION_FUNCTION
+// Q3PW_PRESENT_FUNCTION
+void main() {
+    vec2 sample_uv = uv;
+#ifdef Q3PW_FFE
+    sample_uv = light_foveated_uv(uv);
+#endif
+#ifdef Q3PW_PRESENT_YCBCR
+    vec3 color = q3pw_present_sample(sample_uv);
+#else
+    vec3 color = texture(tex, sample_uv).rgb;
+#endif
+    if (fix_limited_range != 0)
+        color = vec3(16.0 / 255.0) + (219.0 / 255.0) * color;
+    if (srgb_correction != 0) {
+        vec3 low = color / 12.92;
+        vec3 high = pow((color + vec3(0.055)) / 1.055, vec3(2.4));
+        color = mix(high, low, lessThan(color, vec3(0.04045)));
+    }
+    // Identity gamma needs no power operation.
+    if (encoding_gamma != 0.0 && encoding_gamma != 1.0)
+        color = mix(pow(max(color, vec3(0.0)), vec3(encoding_gamma)),
+                    color, lessThan(color, vec3(0.0)));
+    out_color = vec4(color, 1.0);
+}
diff --git a/alvr/graphics/resources/direct_eye_vertex.glsl b/alvr/graphics/resources/direct_eye_vertex.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..fcae99d9ce0cffe4c3728b4709fa93bb9a644839
--- /dev/null
+++ b/alvr/graphics/resources/direct_eye_vertex.glsl
@@ -0,0 +1,9 @@
+#version 300 es
+uniform int view_idx;
+uniform int flip_y;
+out vec2 uv;
+void main() {
+    vec2 p = vec2(gl_VertexID & 1, gl_VertexID >> 1);
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+    uv = vec2((p.x + float(view_idx)) * 0.5, flip_y != 0 ? 1.0 - p.y : p.y);
+}
diff --git a/alvr/graphics/resources/performance.wgsl b/alvr/graphics/resources/performance.wgsl
new file mode 100644
index 0000000000000000000000000000000000000000..bc6bee02decfec1a7df24f18e8fd29911265830d
--- /dev/null
+++ b/alvr/graphics/resources/performance.wgsl
@@ -0,0 +1,15 @@
+struct VertexOutput { @builtin(position) position: vec4<f32>, @location(0) uv: vec2<f32>, }
+@vertex fn vertex_main(@builtin(vertex_index) index: u32) -> VertexOutput {
+    let positions = array<vec2<f32>, 3>(vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
+    let p = positions[index];
+    var out: VertexOutput;
+    out.position = vec4(p, 0.0, 1.0);
+    // OpenXR GLES swapchain images have a bottom-left origin.
+    out.uv = p * vec2(0.5, 0.5) + vec2(0.5);
+    return out;
+}
+@group(0) @binding(0) var panel: texture_2d<f32>;
+@group(0) @binding(1) var panel_sampler: sampler;
+@fragment fn fragment_main(in: VertexOutput) -> @location(0) vec4<f32> {
+    return textureSample(panel, panel_sampler, in.uv);
+}
