+// PyroWave Haar mode 5 (Quest3-Pyrowave docs/PRESENT-YCBCR.md): `tex` is a frame_size.x x
+// frame_size.y/2 RGBA8 buffer. x < frame_size.x/2 holds luma as 2x2 pixel quads ((0,0), (1,0),
+// (0,1), (1,1) in RGBA); x >= frame_size.x/2 holds the 4:2:0 chroma, one pixel per texel with Cb
+// in R and Cr in G. Mode 6 is the same buffer 3/4 as wide: each chroma texel holds two horizontally
+// adjacent pixels, (Cb, Cr) of the left one in RG and of the right one in BA. Full-range BT.709 with
+// bilinear chroma, the conversion pyroclient's convert.frag does in the other modes. The external
+// sampler must filter linearly.
+precision highp float;
+uniform highp vec2 q3pw_frame_size;
+highp vec2 q3pw_tex_size;
+
+float q3pw_luma(highp ivec2 p) {
+    vec4 quad = texture(tex, (vec2(p >> 1) + 0.5) / q3pw_tex_size);
+    int i = (p.x & 1) | ((p.y & 1) << 1);
+    return i == 0 ? quad.r : i == 1 ? quad.g : i == 2 ? quad.b : quad.a;
+}
+
+// uv spans the whole frame, both eyes.
+vec3 q3pw_present_sample(highp vec2 uv) {
+#if defined(Q3PW_EYE_PROBE) && Q3PW_EYE_PROBE == 1
+    // Diagnostic (debug.q3pw.eye_probe): no buffer reads; a smooth gradient compresses well.
+    return vec3(uv, 0.5);
+#elif defined(Q3PW_EYE_PROBE) && Q3PW_EYE_PROBE == 2
+    // Diagnostic: no buffer reads; per-pixel noise defeats framebuffer compression.
+    highp uvec2 n = uvec2(uv * vec2(4160.0, 2208.0));
+    highp uint h = (n.x * 1664525u) ^ (n.y * 1013904223u);
+    h ^= h >> 13; h *= 0x5bd1e995u; h ^= h >> 15;
+    return vec3(uvec3(h, h >> 8, h >> 16) & 255u) / 255.0;
+#endif
+    highp vec2 pos = uv * q3pw_frame_size;
+    highp ivec2 last = ivec2(q3pw_frame_size) - 1;
+    q3pw_tex_size = vec2(textureSize(tex, 0));
+#ifdef Q3PW_FFE
+    // Filter luma bilinearly like the RGBA path's sampler, but only along axes in a compressed
+    // band: the centre maps 1:1 onto decoded pixels, so there the nearest pixel is exact. Each
+    // packed luma read is a texture fetch, and filtering everywhere cost about 2 ms per frame.
+    // The renderer draws each band with a scissor and a program compiled for it
+    // (Q3PW_FFE_FILTER_X/Y); with run-time branches the drivers fetched all four pixels anyway.
+    highp vec2 p = pos - 0.5;
+    // Centre offsets are multiples of a quarter pixel; rounding with 0.375 never meets a tie.
+    highp vec2 base = floor(p + 0.375);
+#ifdef Q3PW_FFE_FILTER_X
+    base.x = floor(p.x);
+#endif
+#ifdef Q3PW_FFE_FILTER_Y
+    base.y = floor(p.y);
+#endif
+    vec2 f = p - base;
+    highp ivec2 i0 = clamp(ivec2(base), ivec2(0), last);
+    highp ivec2 i1 = clamp(ivec2(base) + 1, ivec2(0), last);
+    float Y = q3pw_luma(i0);
+#ifdef Q3PW_FFE_FILTER_X
+    Y = mix(Y, q3pw_luma(ivec2(i1.x, i0.y)), f.x);
+#endif
+#ifdef Q3PW_FFE_FILTER_Y
+    float below = q3pw_luma(ivec2(i0.x, i1.y));
+#ifdef Q3PW_FFE_FILTER_X
+    below = mix(below, q3pw_luma(i1), f.x);
+#endif
+    Y = mix(Y, below, f.y);
+#endif
+#else
+    float Y = q3pw_luma(clamp(ivec2(pos), ivec2(0), last));
+#endif
+    // Chroma texel space; clamping to the outer texel centres keeps the filter inside the chroma
+    // half, as CLAMP_TO_EDGE does on a separate plane.
+    highp vec2 half_size = q3pw_frame_size * 0.5;
+    highp vec2 c = clamp(pos * 0.5, vec2(0.5), half_size - 0.5);
+    highp float v = c.y / half_size.y;
+    vec2 chroma;
+#if defined(Q3PW_EYE_PROBE) && Q3PW_EYE_PROBE == 3
+    // Diagnostic: luma reads only.
+    if (true) {
+        chroma = vec2(0.0);
+    } else
+#endif
+    if (q3pw_tex_size.x < q3pw_frame_size.x) {
+        // Mode 6: the hardware filters vertically; mix the two nearest pixels horizontally.
+        highp float k = floor(c.x - 0.5);
+        float f = c.x - 0.5 - k;
+        highp float t = floor(k * 0.5);
+        vec4 a = texture(tex, vec2((half_size.x + t + 0.5) / q3pw_tex_size.x, v));
+        vec4 b = texture(tex, vec2((half_size.x + t + 1.5) / q3pw_tex_size.x, v));
+        bool odd = k - 2.0 * t > 0.5;
+        chroma = mix(odd ? a.ba : a.rg, odd ? b.rg : a.ba, f) - 0.5;
+    } else {
+        chroma = texture(tex, vec2((half_size.x + c.x) / q3pw_tex_size.x, v)).rg - 0.5;
+    }
+    return clamp(vec3(Y + 1.5748 * chroma.y, Y - 0.1873 * chroma.x - 0.4681 * chroma.y, Y + 1.8556 * chroma.x),
+                 0.0, 1.0);
+}
