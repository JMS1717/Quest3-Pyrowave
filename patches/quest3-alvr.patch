diff --git a/alvr/adb/src/display_override.rs b/alvr/adb/src/display_override.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1e58855f94e3ae6e1f923ca096ea307e719eabe5
--- /dev/null
+++ b/alvr/adb/src/display_override.rs
@@ -0,0 +1,592 @@
+//! Opt-in Quest 3 display and GPU developer properties, managed by the PC over USB.
+//!
+//! Any whole refresh rate can be forced (measured October 6, 2026): 144-207 Hz with the full
+//! 4128x2208 panel, and up to 240 Hz in the scaled 3104x1664 mode; native requests above 207 Hz
+//! clamp to 207.
+//!
+//! Measured on Quest 3 (October 2026): HorizonOS applies `debug.oculus.forceDisplayScaling` and
+//! `debug.oculus.refreshRate` only when they change while the display is awake; a change made
+//! while the headset sleeps is never picked up. SurfaceFlinger can report 240 Hz while the panel
+//! still runs 120 Hz, so the kernel's `dsi_display_set_mode` log line is the readback. 240 Hz
+//! exists only as the 3104x1664 scaled panel mode (1552x1664 per eye). `debug.oculus.gpuLevel` is
+//! read when a VR app starts, so the client is restarted after any change.
+//!
+//! The original values are saved before the first change and restored, the same way, when the
+//! request is withdrawn or the server shuts down. With nothing requested and nothing saved this
+//! module issues no ADB commands at all.
+//!
+//! A property is restored only while it still holds the value this module wrote. HorizonOS writes
+//! `debug.oculus.refreshRate` itself (72 when a VR app starts with it empty), and the user may set
+//! these properties too; restoring over such a value restarted the client in an endless loop.
+
+use anyhow::{bail, Result};
+use std::{
+    fs,
+    path::PathBuf,
+    thread,
+    time::{Duration, Instant},
+};
+
+pub const SCALING: &str = "debug.oculus.forceDisplayScaling";
+pub const RATE: &str = "debug.oculus.refreshRate";
+pub const GPU_LEVEL: &str = "debug.oculus.gpuLevel";
+pub const PROPERTIES: [&str; 3] = [SCALING, RATE, GPU_LEVEL];
+/// Rates above this exist only in the scaled panel mode.
+pub const NATIVE_MAX_HZ: u32 = 207;
+/// The highest rate the scaled panel mode runs.
+pub const SCALED_MAX_HZ: u32 = 240;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Request {
+    /// Panel forced to exactly this rate: natively up to 207 Hz, scaled above.
+    pub rate_hz: Option<u32>,
+    /// GPU pinned at level 7 (690 MHz on Quest 3).
+    pub gpu_level_7: bool,
+}
+
+impl Request {
+    fn scaled(&self) -> bool {
+        self.rate_hz.is_some_and(|hz| hz > NATIVE_MAX_HZ)
+    }
+}
+
+pub trait Shell {
+    fn shell(&self, command: &str) -> Result<String>;
+    fn sleep(&self, duration: Duration) {
+        thread::sleep(duration);
+    }
+    fn now(&self) -> Instant {
+        Instant::now()
+    }
+}
+
+/// (width, height, fps) of the last kernel DSI mode set in `text`.
+pub fn parse_panel_mode(text: &str) -> Option<(u32, u32, u32)> {
+    let line = text.lines().rev().find(|l| l.contains("dsi_display_set_mode"))?;
+    let field = |key: &str| -> Option<u32> {
+        let rest = &line[line.find(key)? + key.len()..];
+        rest.split(|c: char| !c.is_ascii_digit()).next()?.parse().ok()
+    };
+    Some((field("hactive=")?, field("vactive=")?, field("fps=")?))
+}
+
+/// The property values the PC wants. Requested properties take the requested values; the others
+/// go back to the originals saved before the first change, but only while they still hold the
+/// value this module last wrote (`applied`; `None` for state saved before that was recorded).
+pub fn targets(request: Request, original: &[String; 3], current: &[String; 3],
+               applied: Option<&[Option<String>; 3]>) -> [String; 3] {
+    let release = |i: usize| {
+        let ours = applied.map_or(true, |applied| applied[i].as_deref() == Some(current[i].as_str()));
+        if ours { original[i].clone() } else { current[i].clone() }
+    };
+    let (scaling, rate) = match request.rate_hz {
+        Some(hz) => (if request.scaled() { "1".into() } else { String::new() }, hz.to_string()),
+        None => (release(0), release(1)),
+    };
+    [scaling, rate, if request.gpu_level_7 { "7".into() } else { release(2) }]
+}
+
+/// What to apply this loop iteration. The headset is only changed for the Quest3-Pyrowave client:
+/// while it runs (or is about to be autolaunched, or was just restarted by this module). Otherwise
+/// the request is withdrawn, which restores saved values and is a no-op when nothing was saved, so
+/// another VR app such as Virtual Desktop never inherits a mode it did not ask for.
+pub fn effective_request(request: Request, client_running: bool, autolaunch: bool, recently_restarted: bool) -> Request {
+    if client_running || autolaunch || recently_restarted {
+        request
+    } else {
+        Request::default()
+    }
+}
+
+fn mode_satisfies(request: Request, mode: Option<(u32, u32, u32)>) -> bool {
+    match (request.rate_hz, mode) {
+        (Some(hz), Some((width, _, fps))) => fps == hz && (width == 3104) == request.scaled(),
+        (None, Some((_, _, fps))) => fps <= NATIVE_MAX_HZ,
+        // No mode line left in the log: only an unforced request can be assumed.
+        (Some(_), None) => false,
+        (None, None) => true,
+    }
+}
+
+/// "name: old -> new" for each property that changes, so a log shows what triggered a restart.
+fn describe_changes(current: &[String; 3], want: &[String; 3]) -> String {
+    let changes: Vec<String> = PROPERTIES.iter().zip(current.iter().zip(want))
+        .filter(|(_, (from, to))| from != to)
+        .map(|(name, (from, to))| format!("{name}: '{from}' -> '{to}'"))
+        .collect();
+    if changes.is_empty() { "panel mode only".into() } else { changes.join(", ") }
+}
+
+fn valid_value(value: &str) -> bool {
+    value.len() <= 8 && value.chars().all(|c| c.is_ascii_digit())
+}
+
+pub struct DisplayOverride {
+    state_path: PathBuf,
+    verified: Option<Request>,
+}
+
+impl DisplayOverride {
+    pub fn new(state_path: PathBuf) -> Self {
+        Self { state_path, verified: None }
+    }
+
+    /// The saved originals and, from state files with `format=2`, the values this module last
+    /// wrote (`applied.<property>=<value>`).
+    fn saved(&self, serial: &str) -> Result<Option<([String; 3], Option<[Option<String>; 3]>)>> {
+        let Ok(text) = fs::read_to_string(&self.state_path) else {
+            return Ok(None);
+        };
+        let mut lines = text.lines();
+        if lines.next() != Some(serial) {
+            bail!("Saved Quest display values belong to another headset: {}", self.state_path.display());
+        }
+        let mut values: [String; 3] = Default::default();
+        let mut applied: [Option<String>; 3] = Default::default();
+        let mut tracked = false;
+        for line in lines {
+            if line == "format=2" {
+                tracked = true;
+            } else if let Some((name, value)) = line.split_once('=') {
+                let (name, slot) = match name.strip_prefix("applied.") {
+                    Some(name) => (name, true),
+                    None => (name, false),
+                };
+                if let Some(index) = PROPERTIES.iter().position(|p| *p == name) {
+                    if slot { applied[index] = Some(value.to_owned()) } else { values[index] = value.to_owned() }
+                }
+            }
+        }
+        Ok(Some((values, tracked.then_some(applied))))
+    }
+
+    fn save(&self, serial: &str, values: &[String; 3], applied: &[Option<String>; 3]) -> Result<()> {
+        let mut text = format!("{serial}\nformat=2\n");
+        for (name, value) in PROPERTIES.iter().zip(values) {
+            text.push_str(&format!("{name}={value}\n"));
+        }
+        for (name, value) in PROPERTIES.iter().zip(applied) {
+            if let Some(value) = value {
+                text.push_str(&format!("applied.{name}={value}\n"));
+            }
+        }
+        fs::write(&self.state_path, text)?;
+        Ok(())
+    }
+
+    fn current(shell: &impl Shell) -> Result<[String; 3]> {
+        let mut values: [String; 3] = Default::default();
+        for (value, name) in values.iter_mut().zip(PROPERTIES) {
+            *value = shell.shell(&format!("getprop {name}"))?.trim().to_owned();
+        }
+        Ok(values)
+    }
+
+    fn set(shell: &impl Shell, name: &str, value: &str) -> Result<()> {
+        if !PROPERTIES.contains(&name) || !valid_value(value) {
+            bail!("Refusing to set {name}={value}");
+        }
+        shell.shell(&format!("setprop {name} '{value}'"))?;
+        if shell.shell(&format!("getprop {name}"))?.trim() != value {
+            bail!("Headset rejected {name}={value}");
+        }
+        Ok(())
+    }
+
+    fn wake(shell: &impl Shell) -> Result<()> {
+        shell.shell("am broadcast -a com.oculus.vrpowermanager.automation_enable")?;
+        shell.shell("am broadcast -a com.oculus.vrpowermanager.prox_close --ei duration 30000")?;
+        shell.shell("input keyevent KEYCODE_WAKEUP")?;
+        let deadline = shell.now() + Duration::from_secs(8);
+        while !shell.shell("dumpsys power | grep mWakefulness=")?.contains("Awake") {
+            if shell.now() > deadline {
+                bail!("Headset did not wake");
+            }
+            shell.sleep(Duration::from_millis(300));
+        }
+        shell.sleep(Duration::from_millis(1500));
+        Ok(())
+    }
+
+    fn panel_mode(shell: &impl Shell) -> Result<Option<(u32, u32, u32)>> {
+        Ok(parse_panel_mode(&shell.shell(
+            "logcat -d -t 200000 | grep dsi_display_set_mode | tail -1",
+        )?))
+    }
+
+    /// Bring the headset to `request`. `Ok(None)`: nothing to do. `Ok(Some(message))`: values or
+    /// the panel mode changed (or are still changing); restart the client so its refresh probe and
+    /// GPU level see the new state, then call again.
+    pub fn ensure(&mut self, shell: &impl Shell, serial: &str, request: Request) -> Result<Option<String>> {
+        let saved = self.saved(serial)?;
+        if saved.is_none() && request == Request::default() {
+            return Ok(None);
+        }
+        // A saved state means this module may have changed the panel mode earlier.
+        let had_saved = saved.is_some();
+        let current = Self::current(shell)?;
+        let (original, applied) = match saved {
+            Some(saved) => saved,
+            None => {
+                let applied = Default::default();
+                self.save(serial, &current, &applied)?;
+                (current.clone(), Some(applied))
+            }
+        };
+        let want = targets(request, &original, &current, applied.as_ref());
+        // Verified earlier and the values still hold: skip the panel check. A headset reboot
+        // clears the properties, which this comparison notices.
+        if self.verified == Some(request) && current == want {
+            return Ok(None);
+        }
+        let display_differs = current[..2] != want[..2];
+        let needs_mode_check = request.rate_hz.is_some() || had_saved || display_differs;
+        let mode_ok = !needs_mode_check || mode_satisfies(request, Self::panel_mode(shell)?);
+        if !display_differs && current[2] == want[2] && mode_ok {
+            self.finish(request)?;
+            return Ok(None);
+        }
+
+        // The wake enables proximity automation, so it runs inside the block whose end always
+        // hands proximity back: a headset that never wakes, or a cable pulled mid-change, must not
+        // be left ignoring its proximity sensor.
+        let result = (|| -> Result<bool> {
+            Self::wake(shell)?;
+            if !display_differs && !mode_ok {
+                // Only a change is applied: step through the opposite values first.
+                Self::set(shell, SCALING, if want[0] == "1" { "" } else { "1" })?;
+                Self::set(shell, RATE, if want[1] == "120" { "240" } else { "120" })?;
+                shell.sleep(Duration::from_secs(3));
+            }
+            for (name, value) in PROPERTIES.iter().zip(&want) {
+                Self::set(shell, name, value)?;
+            }
+            let deadline = shell.now() + Duration::from_secs(8);
+            loop {
+                if !needs_mode_check || mode_satisfies(request, Self::panel_mode(shell)?) {
+                    return Ok(true);
+                }
+                if shell.now() > deadline {
+                    return Ok(false);
+                }
+                shell.sleep(Duration::from_millis(500));
+            }
+        })();
+        let released = shell.shell("am broadcast -a com.oculus.vrpowermanager.automation_disable");
+        let done = result;
+        // Whatever was written is this module's to restore, even when the mode never switched.
+        if done.is_ok() {
+            let mut written = applied.unwrap_or_default();
+            for (i, value) in want.iter().enumerate() {
+                let requested = if i == 2 { request.gpu_level_7 } else { request.rate_hz.is_some() };
+                if requested || *value != current[i] {
+                    written[i] = Some(value.clone());
+                }
+            }
+            self.save(serial, &original, &written)?;
+        }
+        let done = done?;
+        released?;
+        if !done {
+            return Ok(Some("Waiting for the headset display mode to change".into()));
+        }
+        self.finish(request)?;
+        let changes = describe_changes(&current, &want);
+        Ok(Some(if let Some(hz) = request.rate_hz {
+            format!("Headset display switched to {hz} Hz ({changes}); restarting the client")
+        } else {
+            format!("Headset display and GPU values updated ({changes}); restarting the client")
+        }))
+    }
+
+    fn finish(&mut self, request: Request) -> Result<()> {
+        if request == Request::default() && self.state_path.exists() {
+            fs::remove_file(&self.state_path)?;
+        }
+        self.verified = Some(request);
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{cell::RefCell, collections::HashMap};
+
+    /// Applies the display properties only when they change while awake, like HorizonOS.
+    struct FakeQuest {
+        props: RefCell<HashMap<String, String>>,
+        awake: RefCell<bool>,
+        mode: RefCell<(u32, u32, u32)>,
+        applies: bool,
+        wakes: bool,
+        log: RefCell<Vec<String>>,
+        clock: RefCell<Instant>,
+    }
+
+    impl FakeQuest {
+        fn new(awake: bool) -> Self {
+            let props = [(SCALING, ""), (RATE, "120"), (GPU_LEVEL, "")]
+                .iter()
+                .map(|(k, v)| (k.to_string(), v.to_string()))
+                .collect();
+            Self {
+                props: RefCell::new(props),
+                awake: RefCell::new(awake),
+                mode: RefCell::new((4128, 2208, 120)),
+                applies: true,
+                wakes: true,
+                log: RefCell::new(vec![]),
+                clock: RefCell::new(Instant::now()),
+            }
+        }
+        fn prop(&self, name: &str) -> String {
+            self.props.borrow()[name].clone()
+        }
+    }
+
+    impl Shell for FakeQuest {
+        fn shell(&self, command: &str) -> Result<String> {
+            self.log.borrow_mut().push(command.into());
+            if let Some(name) = command.strip_prefix("getprop ") {
+                return Ok(self.props.borrow().get(name).cloned().unwrap_or_default());
+            }
+            if let Some(rest) = command.strip_prefix("setprop ") {
+                let (name, value) = rest.split_once(' ').unwrap();
+                let value = value.trim_matches('\'').to_string();
+                let changed = self.props.borrow().get(name) != Some(&value);
+                self.props.borrow_mut().insert(name.into(), value);
+                if changed && *self.awake.borrow() && self.applies {
+                    let scaled = self.prop(SCALING) == "1";
+                    let rate: u32 = self.prop(RATE).parse().unwrap_or(120);
+                    *self.mode.borrow_mut() = if scaled { (3104, 1664, rate) } else { (4128, 2208, rate.min(207)) };
+                }
+                return Ok(String::new());
+            }
+            if command == "input keyevent KEYCODE_WAKEUP" && self.wakes {
+                *self.awake.borrow_mut() = true;
+            }
+            if command.contains("mWakefulness") {
+                return Ok(format!("mWakefulness={}", if *self.awake.borrow() { "Awake" } else { "Asleep" }));
+            }
+            if command.contains("dsi_display_set_mode") {
+                let (w, h, fps) = *self.mode.borrow();
+                return Ok(format!(
+                    "10-06 21:37:50.275 0 0 I [drm:dsi_display_set_mode [msm_drm]] [msm-dsi-info]: mdp_transfer_time=0, hactive={w}, vactive={h}, fps={fps}, clk_rate=0"
+                ));
+            }
+            Ok(String::new())
+        }
+        fn sleep(&self, duration: Duration) {
+            *self.clock.borrow_mut() += duration;
+        }
+        fn now(&self) -> Instant {
+            *self.clock.borrow()
+        }
+    }
