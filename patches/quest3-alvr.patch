+
+    pub fn set_stream(&mut self, config: &StreamConfig, refresh_rates: &[f32]) {
+        let v = &config.settings.video;
+        let n = &config.negotiated_config;
+        let pyrowave = v.preferred_codec == CodecType::PyroWave;
+        let transport = if n.wired {
+            "USB/TCP"
