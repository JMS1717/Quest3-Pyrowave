+            subtitle: "".into(),
+            lines: (0..8)
+                .map(|i| MenuViewLine {
+                    label: format!("Row {i}"),
+                    value: "100%  (2064 x 2208)".into(),
+                    selected: i == 2,
+                    changed: i == 3,
+                    adjustable: true,
+                })
+                .collect(),
+            status: "Sending to PC...".into(),
+            hint: "Stick: choose | A: apply | B: close".into(),
+        });
+        assert!(rasterize(&menu).chunks(4).any(|p| p == SELECTED));
+    }
+
+    #[test]
+    fn worker_returns_the_newest_view() {
+        let mut worker = PanelRasterizer::new();
+        worker.submit(PanelView::Strip(vec![]));
+        worker.submit(PanelView::Strip(tiles()));
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let mut last = None;
+        while Instant::now() < deadline {
+            if let Some((view, _, _)) = worker.poll() {
+                last = Some(view);
+                if matches!(&last, Some(PanelView::Strip(t)) if t.len() == 2) {
+                    break;
+                }
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        assert!(matches!(last, Some(PanelView::Strip(t)) if t.len() == 2));
+    }
