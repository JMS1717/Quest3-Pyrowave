+/// Codec payload budget, after ALVR's per-eye padding. Excludes transport overhead.
+#[derive(Debug)]
+pub struct FrameBudget {
+    pub eye_width: u32,
+    pub eye_height: u32,
+    pub frame_ms: f64,
+    pub payload_bytes: u64,
+    pub raw_bytes: u64,
+    pub raw_to_payload: f64,
+}
+
+pub fn frame_budget(
+    width: u32,
+    height: u32,
+    hz: f64,
+    mbps: u64,
+    full_chroma: bool,
+) -> Option<FrameBudget> {
+    if width == 0 || height == 0 || !hz.is_finite() || hz <= 0.0 || mbps == 0 {
+        return None;
+    }
+    let eye_width = width.checked_add(31)? / 32 * 32;
+    let eye_height = height.checked_add(31)? / 32 * 32;
+    let pixels = u64::from(eye_width)
+        .checked_mul(u64::from(eye_height))?
+        .checked_mul(2)?;
+    let raw_bytes = pixels.checked_mul(3)? / if full_chroma { 1 } else { 2 };
+    // Match the encoder's integer bps / 8 / integer framerate calculation.
+    let encoder_hz = hz.round() as u64;
+    if encoder_hz == 0 {
+        return None;
+    }
+    let payload_bytes = mbps.checked_mul(1_000_000)? / 8 / encoder_hz;
+    if payload_bytes == 0 {
+        return None;
+    }
+    Some(FrameBudget {
+        eye_width,
+        eye_height,
+        frame_ms: 1000.0 / hz,
+        payload_bytes,
+        raw_bytes,
+        raw_to_payload: raw_bytes as f64 / payload_bytes as f64,
+    })
+}
+
+#[cfg(test)]
+mod budget_tests {
+    use super::*;
+    #[test]
+    fn full_panel_120_budget_matches_encoder_and_420_sampling() {
+        let b = frame_budget(2064, 2208, 120.0, 1000, false).unwrap();
+        assert_eq!((b.eye_width, b.eye_height), (2080, 2208));
+        assert_eq!(b.payload_bytes, 1_041_666);
+        assert_eq!(frame_budget(2064, 2208, 119.99999, 1000, false).unwrap().payload_bytes, b.payload_bytes);
+        assert_eq!(b.raw_bytes, 13_777_920);
+        assert_eq!(
+            frame_budget(2064, 2208, 120.0, 1000, true)
+                .unwrap()
+                .raw_bytes,
+            b.raw_bytes * 2
+        );
+        assert!(frame_budget(0, 2208, 120.0, 1000, false).is_none());
+        assert!(frame_budget(2064, 2208, f64::NAN, 1000, false).is_none());
+    }
+}
