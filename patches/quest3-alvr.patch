+#[cfg(test)]
+mod light_foveation_tests {
+    use super::*;
+    #[test]
+    fn fixed_light_profile_is_explicit_and_never_gaze_driven() {
+        assert!(!crate::SessionConfig::default().to_settings().video.pyrowave.light_foveated_encoding);
+        let config = pyrowave_light_foveation();
+        assert_eq!((config.center_size_x, config.center_size_y), (0.8, 0.8));
+        assert_eq!((config.edge_ratio_x, config.edge_ratio_y), (1.5, 1.5));
+        assert_eq!((config.center_shift_x, config.center_shift_y), (0.0, 0.0));
+        assert!(!config.follow_gaze && !config.force_enable);
+        assert!(pyrowave_light_foveation_enabled(CodecType::PyroWave, true, true));
+        assert!(!pyrowave_light_foveation_enabled(CodecType::PyroWave, false, true));
+        assert!(!pyrowave_light_foveation_enabled(CodecType::PyroWave, true, false));
+        for codec in [CodecType::H264, CodecType::Hevc, CodecType::AV1] {
+            assert!(!pyrowave_light_foveation_enabled(codec, true, true));
+        }
+    }
+    #[test]
+    fn old_pyrowave_config_deserializes_with_light_disabled() {
+        let old: PyroWaveConfig = serde_json::from_value(serde_json::json!({
+            "chroma_444":false, "transport":"Tcp", "wavelet":"Haar", "decode_path":"Compute"
+        })).unwrap();
+        assert!(!old.light_foveated_encoding);
+    }
+}
