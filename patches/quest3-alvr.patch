+                    .ok()
+                    .filter(|state| state.is_active)
+                    .map_or(0.0, |state| state.current_state)
+            } else {
+                0.0
+            }
+        };
+        let chord = self.chord.update(
+            pressed(*LEFT_THUMBSTICK_CLICK_ID),
+            pressed(*RIGHT_THUMBSTICK_CLICK_ID),
+            now,
+        );
+        // Either hand drives the menu; the stick pushed further wins.
+        let strongest = |a: f32, b: f32| if a.abs() >= b.abs() { a } else { b };
+        let stick_x = strongest(axis(*LEFT_THUMBSTICK_X_ID), axis(*RIGHT_THUMBSTICK_X_ID));
+        let stick_y = strongest(axis(*LEFT_THUMBSTICK_Y_ID), axis(*RIGHT_THUMBSTICK_Y_ID));
+        let confirm = pressed(*RIGHT_A_CLICK_ID) || pressed(*LEFT_X_CLICK_ID);
+        let back = pressed(*RIGHT_B_CLICK_ID) || pressed(*LEFT_Y_CLICK_ID);
+        drop(interactions);
+
+        match chord {
+            Some(ChordEvent::OpenMenu) if self.menu.is_some() => self.close_menu(),
+            Some(ChordEvent::OpenMenu) => self.open_menu(core),
+            Some(ChordEvent::CycleOverlay) if self.menu.is_none() => {
+                self.mode = self.mode.next();
+                alvr_common::error!("[Q3PW_OVERLAY_CONTROL] mode={}", self.mode.name());
+            }
+            _ => (),
+        }
+
+        let input = MenuInput {
+            // Stick up is positive Y; the menu counts rows downward.
+            vertical: -self.vertical.update(stick_y, now),
+            horizontal: self.horizontal.update(stick_x, now),
+            confirm: confirm && !self.buttons.confirm,
+            back: back && !self.buttons.back,
+        };
+        self.buttons = MenuButtons { confirm, back };
+
+        let mut close = false;
+        if let Some(menu) = &mut self.menu {
+            if input != MenuInput::default() {
+                self.menu_dirty = true;
+                match menu.handle(input, now) {
+                    MenuAction::None => (),
+                    MenuAction::Close => close = true,
+                    MenuAction::SetOverlay(mode) => self.mode = mode,
+                    MenuAction::Apply(request) => {
+                        alvr_common::error!("[Q3PW_MENU] request={request:?}");
+                        if !core.send_headset_settings(request) {
+                            menu.pending = None;
+                            menu.status = "Not connected to the PC".into();
+                        }
+                    }
+                }
+            }
+            if let Some(ack) = core.take_headset_settings_ack() {
+                if menu.pending.is_some_and(|(id, _)| id == ack.request_id) {
+                    menu.pending = None;
+                    if ack.applied && !ack.reconnect {
+                        menu.confirm_applied();
+                    }
+                    menu.status = ack.message;
+                    self.menu_dirty = true;
+                }
+            }
+            if menu.pending.is_some() {
+                menu.expire_pending(now);
+                self.menu_dirty |= menu.pending.is_none();
+            }
+        }
+        if close {
+            self.close_menu();
+        }
+
+        if now >= self.next_property_poll {
+            let property = crate::extra_extensions::perf_settings::system_property(
+                "debug.q3pw.overlay_visible",
+            );
+            if property != self.visibility_property {
+                alvr_common::error!(
+                    "[Q3PW_OVERLAY_CONTROL] mode={}",
+                    match property.trim() {
+                        "0" => "forced_hidden",
+                        "1" => "forced_visible",
+                        _ => "controllers",
+                    }
+                );
+            }
+            self.visibility_property = property;
+            self.next_property_poll = now + Duration::from_millis(500);
+        }
+        let shown_mode = overlay_visibility(&self.visibility_property, self.mode);
+        if shown_mode != self.shown_mode {
+            alvr_common::error!(
+                "[Q3PW_OVERLAY] visible={} forced={} mode={}",
+                shown_mode != OverlayMode::Hidden,
+                matches!(self.visibility_property.trim(), "0" | "1"),
+                shown_mode.name()
+            );
+            self.shown_mode = shown_mode;
+            self.next_update = now;
+        }
+
+        let text_started = self.probe.then(Instant::now);
+        if self.menu.is_some() {
+            self.anchor_menu(time);
+        }
+        if let Some(menu) = &self.menu {
+            if self.menu_dirty || now >= self.next_update {
+                self.rasterizer.submit(PanelView::Menu(menu_view(menu)));
+                self.menu_dirty = false;
+                self.next_update = now + UPDATE_INTERVAL;
+            }
+        } else if self.shown_mode != OverlayMode::Hidden && now >= self.next_update {
+            let snapshot = core
+                .performance_snapshot()
+                .filter(|s| s.frame_age_ms < 2000.0);
+            if let Some(s) = &snapshot {
+                if self.history.len() == HISTORY_LEN {
+                    self.history.pop_front();
+                }
+                self.history.push_back(s.client_fps);
+            }
+            let view = if self.shown_mode == OverlayMode::Compact {
+                PanelView::Strip(self.strip_tiles(snapshot.as_ref()))
+            } else {
+                PanelView::Stats(self.stats_view(snapshot.as_ref()))
+            };
+            self.rasterizer.submit(view);
+            self.next_update = now + UPDATE_INTERVAL;
+        }
+        let text_ms = text_started.map_or(0.0, |t| t.elapsed().as_secs_f64() * 1000.0);
+
+        if let Some((view, pixels, raster_ms)) = self.rasterizer.poll() {
+            let (surface, shown) = match view {
+                PanelView::Strip(_) => (&mut self.strip, Shown::Stats),
+                PanelView::Stats(_) => (&mut self.panel, Shown::Stats),
+                PanelView::Menu(_) => (&mut self.panel, Shown::Menu),
+            };
+            let acquire_started = self.probe.then(Instant::now);
+            self.context.make_current();
+            let image = surface.swapchain.acquire_image()?;
+            surface.swapchain.wait_image(xr::Duration::INFINITE)?;
+            let acquire_ms = acquire_started.map_or(0.0, |t| t.elapsed().as_secs_f64() * 1000.0);
+            let draw_started = self.probe.then(Instant::now);
+            surface.renderer.update(image as usize, &pixels);
+            let draw_ms = draw_started.map_or(0.0, |t| t.elapsed().as_secs_f64() * 1000.0);
+            let release_started = self.probe.then(Instant::now);
+            surface.swapchain.release_image()?;
+            surface.shown = shown;
+            if let Some(t) = release_started {
+                alvr_common::error!("[Q3PW_OVERLAY_DRAW] text_cpu_ms={text_ms:.3} acquire_wait_cpu_ms={acquire_ms:.3} renderer_submit_cpu_ms={draw_ms:.3} release_cpu_ms={:.3} raster_worker_ms={raster_ms:.3}", t.elapsed().as_secs_f64() * 1000.0);
+            }
+        }
+        Ok(())
+    }
+
+    fn strip_tiles(&self, data: Option<&PerformanceSnapshot>) -> Vec<Tile> {
+        let Some(s) = data else {
+            return vec![Tile {
+                label: String::new(),
+                value: if self.stream.is_some() {
+                    "Waiting for statistics"
+                } else {
+                    "Waiting for stream"
+                }
+                .into(),
+                unit: String::new(),
+                tone: Tone::Neutral,
+            }];
+        };
+        let refresh = self.refresh_hz();
+        let mut tiles = vec![
+            Tile {
+                label: "Fresh".into(),
+                value: metric(s.client_fps),
+                unit: format!("/ {refresh:.0} fps"),
+                tone: tone(fps_health(s.client_fps, refresh)),
+            },
+            Tile {
+                label: "Latency".into(),
+                value: metric(s.total_ms),
+                unit: "ms latency*".into(),
+                tone: tone(latency_health(s.total_ms)),
+            },
+        ];
+        if let Some(decode) = gpu_decode_ms(s) {
+            tiles.push(Tile {
+                label: "Decode".into(),
+                value: metric(decode),
+                unit: "ms decode".into(),
+                tone: tone(budget_health(decode, refresh)),
+            });
+        }
+        tiles
+    }
+
+    fn stats_view(&self, data: Option<&PerformanceSnapshot>) -> StatsView {
+        let refresh = self.refresh_hz();
+        let subtitle = self
+            .stream
+            .as_ref()
+            .map_or("Waiting for stream".into(), |s| s.subtitle.clone());
+        let footer = "*ALVR estimates, not optical latency.  Click both sticks: overlay mode.  Hold both: settings".into();
+        let Some(s) = data else {
+            return StatsView {
+                title: "Quest3 PyroWave".into(),
+                subtitle: format!("{subtitle}  |  waiting for fresh statistics"),
+                tiles: vec![],
+                history: self.history.iter().copied().collect(),
+                history_target: refresh,
+                details: vec![],
+                footer,
+            };
+        };
+        let decode = gpu_decode_ms(s);
+        let mut tiles = vec![
+            Tile {
+                label: "Fresh FPS".into(),
+                value: metric(s.client_fps),
+                unit: format!("/ {refresh:.0}"),
+                tone: tone(fps_health(s.client_fps, refresh)),
+            },
+            Tile {
+                label: "Latency*".into(),
+                value: metric(s.total_ms),
+                unit: "ms".into(),
+                tone: tone(latency_health(s.total_ms)),
+            },
+        ];
+        tiles.push(match decode {
+            Some(ms) => Tile {
+                label: "GPU decode".into(),
+                value: metric(ms),
+                unit: "ms".into(),
+                tone: tone(budget_health(ms, refresh)),
+            },
+            None => Tile {
+                label: "Decode*".into(),
+                value: metric(s.decoder_ms),
+                unit: "ms".into(),
+                tone: Tone::Neutral,
+            },
+        });
+        tiles.push(Tile {
+            label: "Bitrate".into(),
+            value: format!("{:.0}", s.bitrate_bps / 1e6),
+            unit: format!("/ {:.0} Mbps", s.requested_bitrate_bps / 1e6),
+            tone: Tone::Neutral,
+        });
+
+        let ms = |v: f32| format!("{} ms", metric(v));
+        let pair = |a: f32, b: f32| format!("{} / {} ms", metric(a), metric(b));
+        let mut details = vec![
+            ("Game / host*".into(), format!("{} fps", metric(s.server_fps))),
+            ("Encode".into(), ms(s.encoder_ms)),
+            ("Network*".into(), ms(s.network_ms)),
+            ("Decode / queue".into(), pair(s.decoder_ms, s.queue_ms)),
+            ("Render / vsync".into(), pair(s.compositor_ms, s.vsync_ms)),
+            ("Lost packets".into(), s.packets_lost_total.to_string()),
+        ];
+        let headset = s.headset.as_ref();
+        if let Some(p) = headset.and_then(|h| h.pyrowave.as_ref()) {
+            details.extend([
+                ("Completion".into(), ms(mean(&p.fence_ms).unwrap_or(-1.0))),
+                ("Decoded / presented".into(), format!("{} / {}", p.complete, s.frames_total)),
+                ("Dropped / skipped".into(), format!("{} / {}", p.dropped, p.skipped)),
+                (
+                    "Superseded / errors".into(),
+                    format!("{} / {}", p.superseded, p.decode_failures),
+                ),
+            ]);
+        } else {
+            details.push(("Presented frames".into(), s.frames_total.to_string()));
+        }
+        if let Some(h) = headset {
+            details.extend([
+                (
+                    "Battery".into(),
+                    format!(
+                        "{}% / {} C",
+                        h.battery_level
+                            .map(|v| format!("{:.0}", v * 100.0))
+                            .unwrap_or_else(|| "--".into()),
+                        h.battery_temperature_c
+                            .map(metric)
+                            .unwrap_or_else(|| "--".into())
+                    ),
+                ),
+                (
+                    "Thermal / GPU".into(),
+                    format!(
+                        "{} / {} MHz",
+                        h.thermal_status
+                            .map(|v| v.to_string())
+                            .unwrap_or_else(|| "--".into()),
+                        gpu_clock()
+                    ),
+                ),
+            ]);
+        }
+        StatsView {
+            title: "Quest3 PyroWave".into(),
+            subtitle,
+            tiles,
+            history: self.history.iter().copied().collect(),
+            history_target: refresh,
+            details,
+            footer,
+        }
+    }
+
+    fn refresh_hz(&self) -> f32 {
+        self.stream.as_ref().map_or(f32::NAN, |s| s.refresh_hz)
+    }
+
+    pub fn layer(&self) -> Option<xr::CompositionLayerQuad<'_, xr::OpenGlEs>> {
+        let aspect = |surface: &Surface, width: f32| xr::Extent2Df {
+            width,
+            height: width * surface.size.y as f32 / surface.size.x as f32,
+        };
+        let head_locked = |x: f32, y: f32, z: f32| xr::Posef {
+            position: xr::Vector3f { x, y, z },
+            ..xr::Posef::IDENTITY
+        };
+        if self.menu.is_some() {
+            let (pose, world) = self.menu_pose?;
+            return (self.panel.shown == Shown::Menu).then(|| {
+                self.panel.quad()
+                    .space(if world {
+                        &self.local_space
+                    } else {
+                        &self.view_space
+                    })
+                    .pose(pose)
+                    .size(aspect(&self.panel, 0.8))
+            });
+        }
+        match self.shown_mode {
+            OverlayMode::Hidden => None,
+            OverlayMode::Compact => (self.strip.shown == Shown::Stats).then(|| {
+                self.strip.quad()
+                    .space(&self.view_space)
+                    .pose(head_locked(0.0, -0.40, -1.2))
+                    .size(aspect(&self.strip, 0.62))
+            }),
+            OverlayMode::Full => (self.panel.shown == Shown::Stats).then(|| {
+                self.panel.quad()
+                    .space(&self.view_space)
+                    .pose(head_locked(0.0, -0.30, -1.2))
+                    .size(aspect(&self.panel, 0.84))
+            }),
+        }
+    }
+}
+
+fn menu_view(menu: &SettingsMenu) -> MenuView {
+    MenuView {
+        title: "Stream settings".into(),
+        subtitle: "Saved on the PC. Bitrate applies live; the rest reconnect the stream.".into(),
+        lines: menu
+            .lines()
+            .into_iter()
+            .map(|line| MenuViewLine {
+                label: line.label.into(),
+                value: line.value,
+                selected: line.selected,
+                changed: line.changed,
+                adjustable: line.adjustable,
+            })
+            .collect(),
+        status: menu.status.clone(),
+        hint: "Stick: move and change   A/X: select   B/Y: close   Game input paused".into(),
+    }
+}
+
+fn tone(health: Health) -> Tone {
+    match health {
+        Health::Good => Tone::Good,
+        Health::Warn => Tone::Warn,
+        Health::Bad => Tone::Bad,
+        Health::Unknown => Tone::Neutral,
+    }
+}
+
+fn mean(values: &[f32]) -> Option<f32> {
+    let values = values
+        .iter()
+        .copied()
+        .filter(|v| v.is_finite() && *v >= 0.0)
+        .collect::<Vec<_>>();
+    (!values.is_empty()).then(|| values.iter().sum::<f32>() / values.len() as f32)
+}
+
+fn gpu_decode_ms(s: &PerformanceSnapshot) -> Option<f32> {
+    s.headset
+        .as_ref()
+        .and_then(|h| h.pyrowave.as_ref())
+        .and_then(|p| mean(&p.gpu_decode_ms))
+}
+
+fn gpu_clock() -> String {
+    std::fs::read_to_string("/sys/class/kgsl/kgsl-3d0/gpuclk")
+        .ok()
+        .and_then(|v| v.trim().parse::<f32>().ok())
+        .map(|v| format!("{:.0}", v / 1e6))
+        .unwrap_or_else(|| "--".into())
+}
diff --git a/alvr/client_openxr/src/refresh_probe.rs b/alvr/client_openxr/src/refresh_probe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..be1205ccfde1989670f4732b16b7982a8a9763d3
--- /dev/null
+++ b/alvr/client_openxr/src/refresh_probe.rs
@@ -0,0 +1,185 @@
+//! Quest 3 HorizonOS v2.7 permits rates absent from enumeration. Never infer support
+//! from a property: require request success, runtime frequency and three frame periods.
+use openxr as xr;
+use std::{collections::VecDeque, time::Instant};
+
+pub struct RefreshProbe {
+    pending: VecDeque<f32>,
+    current: Option<(f32, Instant)>,
+    stable: usize,
+    confirmed: Vec<f32>,
+    enumerated: Vec<f32>,
+    restore: f32,
+    restoring: bool,
+}
+
+pub fn matches(target: f32, actual: f32, period_ns: i64) -> bool {
+    period_ns > 0
+        && target.is_finite()
+        && actual.is_finite()
+        && (actual - target).abs() < 0.1
+        && (1e9 / period_ns as f64 - target as f64).abs() < target as f64 * 0.005
+}
+
+/// Rates the probe tries when no system override is active.
+pub const PROBE_RATES: [f32; 9] = [72.0, 90.0, 120.0, 144.0, 165.0, 180.0, 200.0, 207.0, 240.0];
+
+/// The rate a system override (`debug.oculus.refreshRate`) pins, if the property holds one.
+pub fn override_rate(property: &str) -> Option<f32> {
+    property.trim().parse::<f32>().ok().filter(|hz| hz.is_finite() && *hz > 0.0)
+}
+
+/// Rates to probe. While a system override (`debug.oculus.refreshRate`, natively up to 207 Hz or
+/// in the scaled mode above) pins the display, every other request "succeeds" without changing the
+/// rate and would cost the full two-second timeout each, so only the forced rate is verified. The
+/// override is recognised from the property when the runtime runs at its rate (this covers forced
+/// rates the runtime also enumerates, such as 144 Hz), or, if the property cannot be read, from a
+/// runtime rate above 120 Hz that is not enumerated.
+pub fn probe_rates(enumerated: &[f32], current: f32, override_hz: Option<f32>) -> Vec<f32> {
+    let unlisted = current > 120.5 && !enumerated.iter().any(|r| (r - current).abs() < 0.1);
+    let pinned = override_hz.is_some_and(|hz| (hz - current).abs() < 0.5);
+    let forced = current.is_finite() && (unlisted || pinned);
+    if forced {
+        alvr_common::error!("[Q3PW_PROBE] forced_mode=true runtime_hz={current} probing_only_current=true");
+        vec![current.round()]
+    } else {
+        PROBE_RATES.to_vec()
+    }
+}
+
+/// True when the runtime already reports `target` (within 0.1 Hz). Used when a request is refused
+/// although a system override already runs the display at that rate.
+pub fn runtime_matches(session: &xr::Session<xr::OpenGlEs>, target: f32) -> bool {
+    session
+        .get_display_refresh_rate()
+        .is_ok_and(|actual| actual.is_finite() && (actual - target).abs() < 0.1)
+}
+
+impl RefreshProbe {
+    pub fn new(enumerated: Vec<f32>, restore: f32, override_hz: Option<f32>) -> Self {
+        Self {
+            pending: probe_rates(&enumerated, restore, override_hz).into(),
+            current: None,
+            stable: 0,
+            confirmed: vec![],
+            enumerated,
+            restore,
+            restoring: false,
+        }
+    }
+
+    // Called only while the session runs, before xrWaitFrame. No sleeps on render thread.
+    pub fn request_next(&mut self, session: &xr::Session<xr::OpenGlEs>) {
+        while self.current.is_none() {
+            let target = if let Some(rate) = self.pending.pop_front() {
+                rate
+            } else {
+                self.restoring = true;
+                self.restore
+            };
+            match session.request_display_refresh_rate(target) {
+                Ok(()) => {
+                    self.current = Some((target, Instant::now()));
+                    self.stable = 0;
+                }
+                Err(err) if runtime_matches(session, target) => {
+                    // A system override (debug.oculus.refreshRate=240 with
+                    // debug.oculus.forceDisplayScaling=1) runs the display at a rate the request API
+                    // refuses. The rate is already active, so confirm it the same way as an accepted
+                    // request: runtime frequency plus three frame periods.
+                    alvr_common::error!("[Q3PW_PROBE] request={target} rejected={err:?} runtime_already=true verifying=true");
+                    self.current = Some((target, Instant::now()));
+                    self.stable = 0;
+                }
+                Err(err) => {
+                    alvr_common::error!("[Q3PW_PROBE] request={target} confirmed=false reason=request_rejected error={err:?}");
+                    if self.restoring {
+                        self.current = Some((target, Instant::now()));
+                        break;
+                    }
+                }
+            }
+        }
+    }
+
+    pub fn observe(
+        &mut self,
+        session: &xr::Session<xr::OpenGlEs>,
+        period_ns: i64,
+    ) -> Option<Vec<f32>> {
+        let (target, start) = self.current?;
+        let actual = session.get_display_refresh_rate().ok();
+        if actual.is_some_and(|actual| matches(target, actual, period_ns)) {
+            self.stable += 1;
+        } else {
+            self.stable = 0;
+        }
+        let confirmed = self.stable >= 3;
+        if !confirmed && start.elapsed().as_secs_f32() < 2.0 {
+            return None;
+        }
+        alvr_common::error!("[Q3PW_PROBE] request={target} confirmed={confirmed} runtime_hz={actual:?} period_ns={period_ns} restore={}", self.restoring);
+        self.current = None;
+        if self.restoring {
+            // Preserve ordinary enumerated modes; extended benchmark modes only after confirmation.
+            let mut rates: Vec<_> = self
+                .enumerated
+                .iter()
+                .copied()
+                .filter(|r| !PROBE_RATES.contains(r))
+                .collect();
+            rates.extend(&self.confirmed);
+            rates.sort_by(f32::total_cmp);
+            rates.dedup();
+            alvr_common::error!("[Q3PW_VERIFIED] rates={:?}", self.confirmed);
+            return Some(rates);
+        }
+        if confirmed {
+            self.confirmed.push(target);
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::matches;
+    #[test]
+    fn runtime_and_period_must_agree() {
+        assert!(matches(207.0, 207.0, 4_830_918));
+        assert!(!matches(207.0, 207.0, 8_333_333));
+        assert!(!matches(207.0, 120.0, 4_830_918));
+        assert!(!matches(240.0, f32::NAN, 4_166_667));
+        assert!(!matches(240.0, 240.0, 0));
+    }
+
+    #[test]
+    fn a_forced_rate_probes_only_that_rate() {
+        use super::{override_rate, probe_rates};
+        let enumerated = [72.0, 80.0, 90.0, 120.0];
+        // Scaled 240 Hz and native forced rates such as 165 or 207 Hz are system overrides.
+        assert_eq!(probe_rates(&enumerated, 240.0, None), vec![240.0]);
+        assert_eq!(probe_rates(&enumerated, 165.0, None), vec![165.0]);
+        assert_eq!(probe_rates(&enumerated, 207.0, Some(207.0)), vec![207.0]);
+        assert_eq!(probe_rates(&enumerated, 180.000_02, None), vec![180.0]);
+        // An override the runtime also enumerates is still forced when the property names it.
+        assert_eq!(probe_rates(&[72.0, 120.0, 144.0], 144.0, Some(144.0)), vec![144.0]);
+        assert_eq!(probe_rates(&enumerated, 120.0, override_rate("120")), vec![120.0]);
+        // An enumerated or ordinary current rate probes the full list.
+        assert_eq!(probe_rates(&enumerated, 120.0, None).len(), 9);
+        assert_eq!(probe_rates(&[72.0, 120.0, 144.0], 144.0, None).len(), 9);
