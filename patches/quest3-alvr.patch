diff --git a/alvr/graphics/resources/direct_eye_fragment.glsl b/alvr/graphics/resources/direct_eye_fragment.glsl
new file mode 100644
index 0000000..901d8fa
--- /dev/null
+++ b/alvr/graphics/resources/direct_eye_fragment.glsl
@@ -0,0 +1,29 @@
+#version 300 es
+#extension GL_OES_EGL_image_external_essl3 : require
+precision highp float;
+uniform samplerExternalOES tex;
+uniform int fix_limited_range;
+uniform int srgb_correction;
+uniform float encoding_gamma;
+in vec2 uv;
+out vec4 out_color;
+// Q3PW_FOVEATION_FUNCTION
+void main() {
+    vec2 sample_uv = uv;
+#ifdef Q3PW_FFE
+    sample_uv = light_foveated_uv(uv);
+#endif
+    vec3 color = texture(tex, sample_uv).rgb;
+    if (fix_limited_range != 0)
+        color = vec3(16.0 / 255.0) + (219.0 / 255.0) * color;
+    if (srgb_correction != 0) {
+        vec3 low = color / 12.92;
+        vec3 high = pow((color + vec3(0.055)) / 1.055, vec3(2.4));
+        color = mix(high, low, lessThan(color, vec3(0.04045)));
+    }
+    // Identity gamma needs no power operation.
+    if (encoding_gamma != 0.0 && encoding_gamma != 1.0)
+        color = mix(pow(max(color, vec3(0.0)), vec3(encoding_gamma)),
+                    color, lessThan(color, vec3(0.0)));
+    out_color = vec4(color, 1.0);
+}
diff --git a/alvr/graphics/resources/direct_eye_vertex.glsl b/alvr/graphics/resources/direct_eye_vertex.glsl
new file mode 100644
index 0000000..fcae99d
--- /dev/null
+++ b/alvr/graphics/resources/direct_eye_vertex.glsl
@@ -0,0 +1,9 @@
+#version 300 es
+uniform int view_idx;
+uniform int flip_y;
+out vec2 uv;
+void main() {
+    vec2 p = vec2(gl_VertexID & 1, gl_VertexID >> 1);
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+    uv = vec2((p.x + float(view_idx)) * 0.5, flip_y != 0 ? 1.0 - p.y : p.y);
+}
diff --git a/alvr/graphics/resources/performance.wgsl b/alvr/graphics/resources/performance.wgsl
new file mode 100644
index 0000000..bc6bee0
--- /dev/null
+++ b/alvr/graphics/resources/performance.wgsl
@@ -0,0 +1,15 @@
+struct VertexOutput { @builtin(position) position: vec4<f32>, @location(0) uv: vec2<f32>, }
+@vertex fn vertex_main(@builtin(vertex_index) index: u32) -> VertexOutput {
+    let positions = array<vec2<f32>, 3>(vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
+    let p = positions[index];
+    var out: VertexOutput;
+    out.position = vec4(p, 0.0, 1.0);
+    // OpenXR GLES swapchain images have a bottom-left origin.
+    out.uv = p * vec2(0.5, 0.5) + vec2(0.5);
+    return out;
+}
+@group(0) @binding(0) var panel: texture_2d<f32>;
+@group(0) @binding(1) var panel_sampler: sampler;
+@fragment fn fragment_main(in: VertexOutput) -> @location(0) vec4<f32> {
+    return textureSample(panel, panel_sampler, in.uv);
+}
diff --git a/alvr/graphics/src/direct_eye.rs b/alvr/graphics/src/direct_eye.rs
new file mode 100644
index 0000000..9abe01d
--- /dev/null
+++ b/alvr/graphics/src/direct_eye.rs
@@ -0,0 +1,462 @@
+//! Opt-in SDR, unwarped PyroWave AHB -> acquired OpenXR eye-image copy.
+//! Vulkan decoding retains its consumer lease until BOTH eyes finish sampling.
+//! An opt-in GL fence allows CPU overlap; the default remains synchronous.
+use super::{egl, GraphicsContext, GL_TEXTURE_EXTERNAL_OES};
+use alvr_common::glam::UVec2;
+use glow::{self as gl, HasContext};
+use std::{cell::{Cell, RefCell}, ffi::c_void, num::NonZeroU32, rc::Rc, time::Instant};
+use std::collections::VecDeque;
+use super::native_release::{NativeRelease, ReleaseFence};
+
+#[cfg(target_os = "android")]
+#[link(name = "android")]
+extern "C" {
+    fn AHardwareBuffer_acquire(buffer: *const c_void);
+    fn AHardwareBuffer_release(buffer: *const c_void);
+    fn __android_log_write(priority: i32, tag: *const std::ffi::c_char,
+                           text: *const std::ffi::c_char) -> i32;
+}
+
+// Initialization diagnostics bypass the mirrored-log severity filter. No per-frame
+// logging or device/pointer identifiers; this confirms effective experimental paths.
+pub(super) fn import_diagnostic(priority: i32, message: String) {
+    #[cfg(target_os = "android")]
+    if let Ok(message) = std::ffi::CString::new(message) {
+        unsafe { __android_log_write(priority, b"q3pw_copy\0".as_ptr().cast(), message.as_ptr()); }
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        let _ = priority;
+        alvr_common::info!("{message}");
+    }
+}
+
+struct CachedImport {
+    buffer: *const c_void,
+    image: egl::EGLImage,
+    texture: gl::Texture,
+}
+
+pub struct DirectEyeConfig {
+    pub textures: [Vec<u32>; 2],
+    pub resolution: UVec2,
+    pub srgb_correction: bool,
+    pub srgb_target: bool,
+    pub fix_limited_range: bool,
+    pub encoding_gamma: f32,
+    pub foveation: Option<([f32; 6], [f32; 16], UVec2)>,
+}
+
+pub struct DirectEyeRenderer {
+    context: Rc<GraphicsContext>,
+    program: gl::Program,
+    source_texture: gl::Texture,
+    vertex_array: gl::VertexArray,
+    framebuffers: [Vec<gl::Framebuffer>; 2],
+    resolution: UVec2,
+    view_idx: gl::UniformLocation,
+    flip_y: gl::UniformLocation,
+    flip: bool,
+    asynchronous: Cell<bool>,
+    copy_wait_ns: i32,
+    bypass_srgb: bool,
+    image_cache_enabled: Cell<bool>,
+    image_cache: RefCell<Vec<CachedImport>>,
+    pending: RefCell<Option<(gl::Fence, Instant)>>,
+    timer: RefCell<Option<super::eye_timer::EyeTimer>>,
+    native_release: Option<NativeRelease>,
+    release_active: Cell<bool>,
+    source_release_token: Cell<u64>,
+    release_fd: RefCell<Option<ReleaseFence>>,
+    release_observers: RefCell<VecDeque<(gl::Fence, Instant)>>,
+    release_exported: Cell<u64>,
+    release_observed: Cell<u64>,
+    release_last_log: RefCell<Instant>,
+}
+
+unsafe fn compile_program(gl: &gl::Context, foveation: bool) -> Result<gl::Program, String> {
+    let program = gl.create_program()?;
+    let mut shaders = Vec::new();
+    let result = (|| {
+        for (kind, source) in [
+            (gl::VERTEX_SHADER, include_str!("../resources/direct_eye_vertex.glsl")),
+            (gl::FRAGMENT_SHADER, include_str!("../resources/direct_eye_fragment.glsl")),
+        ] {
+            let shader = gl.create_shader(kind)?;
+            shaders.push(shader);
+            let source = if kind == gl::FRAGMENT_SHADER && foveation {
+                source.replace("#version 300 es", "#version 300 es\n#define Q3PW_FFE")
+                    .replace("// Q3PW_FOVEATION_FUNCTION", include_str!("../resources/light_foveation.glsl"))
+            } else { source.to_owned() };
+            gl.shader_source(shader, &source);
+            gl.compile_shader(shader);
+            if !gl.get_shader_compile_status(shader) {
+                return Err(gl.get_shader_info_log(shader));
+            }
+            gl.attach_shader(program, shader);
+        }
+        gl.link_program(program);
+        if !gl.get_program_link_status(program) {
+            return Err(gl.get_program_info_log(program));
+        }
+        Ok(program)
+    })();
+    for shader in shaders { gl.delete_shader(shader); }
+    if result.is_err() { gl.delete_program(program); }
+    result
+}
+
+impl DirectEyeRenderer {
+    /// Any compile/import-target failure leaves the existing renderer usable.
+    pub fn new(context: Rc<GraphicsContext>, config: &DirectEyeConfig,
+               flip: bool, asynchronous: bool, copy_wait_us: i32, raw_srgb_requested: bool, image_cache_requested: bool) -> Result<Self, String> {
+        context.make_current();
+        let gl = &context.gl_context;
+        unsafe {
+            // Removing the paired transfer functions is valid only for the
+            // existing SDR identity-gamma path with an sRGB destination.
+            // External sampling and range adjustment remain unchanged.
+            let bypass_srgb = raw_srgb_requested && config.srgb_target
+                && config.srgb_correction && config.encoding_gamma == 1.0
+                && gl.supported_extensions().contains("GL_EXT_sRGB_write_control");
+            import_diagnostic(4, format!("[Q3PW_COLOR_COPY] requested={} active={} srgb_target={} correction={} gamma={}",
+                raw_srgb_requested, bypass_srgb, config.srgb_target,
+                config.srgb_correction, config.encoding_gamma));
+            let program = compile_program(gl, config.foveation.is_some())?;
+            let source_texture = match gl.create_texture() {
+                Ok(texture) => texture,
+                Err(e) => { gl.delete_program(program); return Err(e); }
+            };
+            let vertex_array = match gl.create_vertex_array() {
+                Ok(array) => array,
+                Err(e) => {
+                    gl.delete_texture(source_texture);
+                    gl.delete_program(program);
+                    return Err(e);
+                }
+            };
+            let mut framebuffers: [Vec<gl::Framebuffer>; 2] = [vec![], vec![]];
+            let setup = (|| {
+                let location = |name: &str| gl.get_uniform_location(program, name)
+                    .ok_or_else(|| format!("Direct eye copy missing uniform {name}"));
+                let view_idx = location("view_idx")?;
+                let flip_y = location("flip_y")?;
+                gl.use_program(Some(program));
+                gl.uniform_1_i32(Some(&location("tex")?), 0);
+                gl.uniform_1_i32(Some(&location("fix_limited_range")?), config.fix_limited_range as i32);
+                gl.uniform_1_i32(Some(&location("srgb_correction")?), (config.srgb_correction && !bypass_srgb) as i32);
+                gl.uniform_1_f32(Some(&location("encoding_gamma")?), if bypass_srgb { 0.0 } else { config.encoding_gamma });
+                if let Some((values, params, encoded)) = &config.foveation {
+                    gl.uniform_2_f32(Some(&location("ffe_view_ratio")?), values[0], values[1]);
+                    gl.uniform_2_f32(Some(&location("ffe_edge_ratio")?), values[2], values[3]);
+                    gl.uniform_2_f32(Some(&location("ffe_c2")?), values[4], values[5]);
+                    gl.uniform_4_f32_slice(Some(&location("ffe_p[0]")?), params);
+                    gl.uniform_2_f32(Some(&location("ffe_half_texel")?), 0.25 / encoded.x as f32, 0.5 / encoded.y as f32);
+                    import_diagnostic(4, format!("[Q3PW_LIGHT_FFE] direct=true expanded_eye={}x{} encoded_eye={}x{} center=0.8 edge=1.5 fixed=true",
+                        config.resolution.x, config.resolution.y, encoded.x, encoded.y));
+                }
+                for eye in 0..2 {
+                    if config.textures[eye].is_empty() {
+                        return Err("Direct eye copy empty swapchain".into());
+                    }
+                    for &id in &config.textures[eye] {
+                        let texture = gl::NativeTexture(NonZeroU32::new(id)
+                            .ok_or("Direct eye copy zero texture")?);
+                        let framebuffer = gl.create_framebuffer()?;
+                        framebuffers[eye].push(framebuffer);
+                        gl.bind_framebuffer(gl::DRAW_FRAMEBUFFER, Some(framebuffer));
+                        gl.framebuffer_texture_2d(gl::DRAW_FRAMEBUFFER, gl::COLOR_ATTACHMENT0,
+                                                 gl::TEXTURE_2D, Some(texture), 0);
+                        if gl.check_framebuffer_status(gl::DRAW_FRAMEBUFFER) != gl::FRAMEBUFFER_COMPLETE {
+                            return Err("Direct eye copy framebuffer incomplete".into());
+                        }
+                    }
+                }
+                Ok((view_idx, flip_y))
+            })();
+            gl.bind_framebuffer(gl::DRAW_FRAMEBUFFER, None);
+            gl.use_program(None);
+            match setup {
+                Ok((view_idx, flip_y)) => {
+                    let timer = RefCell::new(super::eye_timer::EyeTimer::new(&context));
+                    let native_release = NativeRelease::new(&context);
+                    Ok(Self { context, program, source_texture,
+                    vertex_array, framebuffers, resolution: config.resolution,
+                    view_idx, flip_y, flip, asynchronous: Cell::new(asynchronous),
+                    image_cache_enabled: Cell::new(image_cache_requested && cfg!(target_os = "android")),
+                    timer,
+                    native_release, release_active: Cell::new(true), source_release_token: Cell::new(0),
+                    release_fd: RefCell::new(None), release_observers: RefCell::new(VecDeque::new()),
+                    release_exported: Cell::new(0), release_observed: Cell::new(0), release_last_log: RefCell::new(Instant::now()),
+                    image_cache: RefCell::new(Vec::new()), pending: RefCell::new(None), copy_wait_ns: copy_wait_us.clamp(0, 2000) * 1000, bypass_srgb })
+                },
+                Err(e) => {
+                    for framebuffer in framebuffers.into_iter().flatten() { gl.delete_framebuffer(framebuffer); }
+                    gl.delete_vertex_array(vertex_array);
+                    gl.delete_texture(source_texture);
+                    gl.delete_program(program);
+                    Err(e)
+                }
+            }
+        }
+    }
+
+    /// Each entry holds an AHB reference, so its pointer cannot be recycled for a
+    /// different allocation. Leases still protect per-frame content writes.
+    unsafe fn cached_source_texture(&self, buffer: *const c_void) -> Option<gl::Texture> {
+        if buffer.is_null() { return None; }
+        #[cfg(target_os = "android")]
+        {
+            let mut cache = self.image_cache.borrow_mut();
+            if let Some(entry) = cache.iter().find(|entry| entry.buffer == buffer) {
+                return Some(entry.texture);
+            }
+            // Existing imports remain usable if a later entry caused fallback.
+            if !self.image_cache_enabled.get() { return None; }
+            // Do not evict images while an external producer may still own them.
+            // Bounded fallback keeps retained storage below eight ring entries.
+            if cache.len() >= 8 {
+                self.image_cache_enabled.set(false);
+                import_diagnostic(5, format!("[Q3PW_IMAGE_CACHE] capacity reached; legacy import fallback"));
+                return None;
+            }
+            let gl = &self.context.gl_context;
+            super::check_error(gl, "before cached import");
+            AHardwareBuffer_acquire(buffer);
+            let client = (self.context.get_native_client_buffer)(buffer);
+            if client.is_null() {
+                AHardwareBuffer_release(buffer);
+                self.image_cache_enabled.set(false);
+                import_diagnostic(5, format!("[Q3PW_IMAGE_CACHE] no native client buffer; legacy fallback"));
+                return None;
+            }
+            // EGL_IMAGE_PRESERVED_KHR: the first imported frame must survive.
+            let attributes = [0x30D2, 1, egl::NONE];
+            let image = (self.context.create_image)(self.context.egl_display.as_ptr(),
+                egl::NO_CONTEXT, 0x3140, client, attributes.as_ptr());
+            if image.is_null() {
+                AHardwareBuffer_release(buffer);
+                self.image_cache_enabled.set(false);
+                import_diagnostic(5, format!("[Q3PW_IMAGE_CACHE] image creation failed; legacy fallback"));
+                return None;
+            }
+            let texture = match gl.create_texture() {
+                Ok(texture) => texture,
+                Err(error) => {
+                    (self.context.destroy_image)(self.context.egl_display.as_ptr(), image);
+                    AHardwareBuffer_release(buffer);
+                    self.image_cache_enabled.set(false);
+                    import_diagnostic(5, format!("[Q3PW_IMAGE_CACHE] texture creation failed: {error}; legacy fallback"));
+                    return None;
+                }
+            };
+            gl.bind_texture(GL_TEXTURE_EXTERNAL_OES, Some(texture));
+            (self.context.image_target_texture_2d)(GL_TEXTURE_EXTERNAL_OES, image);
+            let error = gl.get_error();
+            if error != gl::NO_ERROR {
+                gl.delete_texture(texture);
+                (self.context.destroy_image)(self.context.egl_display.as_ptr(), image);
+                AHardwareBuffer_release(buffer);
+                self.image_cache_enabled.set(false);
+                import_diagnostic(5, format!("[Q3PW_IMAGE_CACHE] texture import failed={error}; legacy fallback"));
+                return None;
+            }
+            cache.push(CachedImport { buffer, image, texture });
+            import_diagnostic(4, format!("[Q3PW_IMAGE_CACHE] imported slots={}", cache.len()));
+            Some(texture)
+        }
+        #[cfg(not(target_os = "android"))]
+        { None }
+    }
+
+    /// Returns readiness and, once per completed async copy, observed wall time.
+    /// TIMEOUT retains the texture binding AND decoder consumer lease. Never
+    /// dequeue/rebind another source until this returns ready.
+    pub fn poll_copy(&self) -> (bool, Vec<f32>) {
+        let mut observed = Vec::new();
+        if !self.release_observers.borrow().is_empty() {
+            self.context.make_current();
+            let gl = &self.context.gl_context;
+            let mut queue = self.release_observers.borrow_mut();
+            unsafe {
+                while let Some((fence, started)) = queue.front() {
+                    match gl.client_wait_sync(*fence, 0, 0) {
+                        gl::TIMEOUT_EXPIRED => break,
+                        gl::ALREADY_SIGNALED | gl::CONDITION_SATISFIED => {
+                            observed.push(started.elapsed().as_secs_f32() * 1000.0);
+                            gl.delete_sync(*fence); queue.pop_front();
+                        },
+                        _ => {
+                            gl.finish(); self.release_active.set(false);
+                            for (fence, _) in queue.drain(..) { gl.delete_sync(fence); }
+                            import_diagnostic(6, "[Q3PW_RELEASE_FD] observer failure; synchronous fallback, failed completions unknown".into());
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        self.release_observed.set(self.release_observed.get() + observed.len() as u64);
+        if self.native_release.is_some() && self.release_last_log.borrow().elapsed().as_secs() >= 1 {
+            import_diagnostic(4, format!("[Q3PW_RELEASE_FD] GLES exports={} observed={} pending={} active={}",
+                self.release_exported.get(), self.release_observed.get(), self.release_observers.borrow().len(), self.release_active.get()));
+            *self.release_last_log.borrow_mut() = Instant::now();
+        }
+        let mut pending = self.pending.borrow_mut();
+        let Some((fence, started)) = pending.as_ref() else { return (true, observed); };
+        self.context.make_current();
+        let gl = &self.context.gl_context;
+        unsafe {
+            match gl.client_wait_sync(*fence, 0, self.copy_wait_ns) {
+                gl::TIMEOUT_EXPIRED => return (false, observed),
+                gl::ALREADY_SIGNALED | gl::CONDITION_SATISFIED => {},
+                _ => {
+                    // A failed wait must not release memory the GPU may read.
+                    gl.finish();
+                    self.asynchronous.set(false);
+                    alvr_common::error!("Direct eye fence wait failed; synchronous fallback");
+                }
+            }
+            let elapsed = started.elapsed().as_secs_f32() * 1000.0;
+            gl.delete_sync(*fence);
+            *pending = None;
+            observed.push(elapsed);
+            (true, observed)
+        }
+    }
+
+    /// Required before replacing a decoder, rebinding its source, destroying
+    /// borrowed OpenXR images, or falling back to another rendering path.
+    pub fn drain_copy(&self) {
+        if self.pending.borrow().is_none() && self.release_observers.borrow().is_empty() && self.release_fd.borrow().is_none() { return; }
+        self.context.make_current();
+        unsafe {
+            let gl = &self.context.gl_context;
+            gl.finish();
+            if let Some((fence, _)) = self.pending.borrow_mut().take() {
+                gl.delete_sync(fence);
+            }
+            for (fence, _) in self.release_observers.borrow_mut().drain(..) { gl.delete_sync(fence); }
+            self.release_fd.borrow_mut().take();
+        }
+    }
+
+    pub fn copy_pending(&self) -> bool { self.pending.borrow().is_some() || !self.release_observers.borrow().is_empty() }
+    pub fn set_source_release_token(&self, token: u64) { self.source_release_token.set(token); }
+    pub fn take_release_fence(&self) -> Option<ReleaseFence> { self.release_fd.borrow_mut().take() }
+    pub fn release_export_requested(&self) -> bool { self.native_release.is_some() && self.release_active.get() }
+    pub fn reject_release_fence(&self) {
+        self.drain_copy(); self.release_active.set(false);
+        import_diagnostic(6, "[Q3PW_RELEASE_FD] attachment rejected; synchronous fallback".into());
+    }
+
+    /// The caller has acquired/waited both indices and retains the PyroWave
+    /// source lease until poll_copy completes. These textures are borrowed;
+    /// this object owns ONLY its FBOs/program/external texture/VAO.
+    pub unsafe fn render(&self, buffer: *mut c_void, indices: [u32; 2]) {
+        if self.pending.borrow().is_some() { self.drain_copy(); }
+        if self.release_fd.borrow().is_some() { self.reject_release_fence(); }
+        self.context.make_current();
+        let gl = &self.context.gl_context;
+        let started = Instant::now();
+        let cached = self.cached_source_texture(buffer);
+        let source_texture = cached.unwrap_or(self.source_texture);
+        let draw = || {
+            gl.use_program(Some(self.program));
+            gl.bind_vertex_array(Some(self.vertex_array));
+            gl.viewport(0, 0, self.resolution.x as i32, self.resolution.y as i32);
+            for state in [gl::SCISSOR_TEST, gl::STENCIL_TEST, gl::DEPTH_TEST, gl::BLEND, gl::CULL_FACE] {
+                gl.disable(state);
+            }
+            gl.color_mask(true, true, true, true);
+            // GLES normally always encodes sRGB FBO writes. WGPU may have used
+            // EXT_sRGB_write_control, so restore its enabled state where present.
+            if gl.supported_extensions().contains("GL_EXT_sRGB_write_control") {
+                if self.bypass_srgb { gl.disable(0x8DB9); }
+                else { gl.enable(0x8DB9); } // GL_FRAMEBUFFER_SRGB_EXT
+            }
+            gl.active_texture(gl::TEXTURE0);
+            gl.bind_texture(GL_TEXTURE_EXTERNAL_OES, Some(source_texture));
+            gl.bind_sampler(0, None);
+            gl.tex_parameter_i32(GL_TEXTURE_EXTERNAL_OES, gl::TEXTURE_MIN_FILTER, gl::LINEAR as i32);
+            gl.tex_parameter_i32(GL_TEXTURE_EXTERNAL_OES, gl::TEXTURE_MAG_FILTER, gl::LINEAR as i32);
+            gl.tex_parameter_i32(GL_TEXTURE_EXTERNAL_OES, gl::TEXTURE_WRAP_S, gl::CLAMP_TO_EDGE as i32);
+            gl.tex_parameter_i32(GL_TEXTURE_EXTERNAL_OES, gl::TEXTURE_WRAP_T, gl::CLAMP_TO_EDGE as i32);
+            gl.uniform_1_i32(Some(&self.flip_y), self.flip as i32);
+            let query = self.timer.borrow_mut().as_mut().and_then(|timer| timer.begin(gl));
+            for (eye, &index) in indices.iter().enumerate() {
+                gl.bind_framebuffer(gl::DRAW_FRAMEBUFFER, Some(self.framebuffers[eye][index as usize]));
+                gl.uniform_1_i32(Some(&self.view_idx), eye as i32);
+                gl.draw_arrays(gl::TRIANGLE_STRIP, 0, 4);
+            }
+            if let Some(index) = query {
+                if let Some(timer) = self.timer.borrow_mut().as_mut() { timer.end(gl, index); }
+            }
+            // Restore the legacy state for WGPU/lobby/overlay users. This
+            // does not change the already-recorded eye draws or their lease.
+            if self.bypass_srgb { gl.enable(0x8DB9); }
+            if self.release_export_requested() && self.source_release_token.get() != 0 {
+                // Bound telemetry observers. A busy ring falls back instead of creating
+                // an unbounded completion queue or reporting submission as completion.
+                let exported = (self.release_observers.borrow().len() < 3)
+                    .then(|| self.native_release.as_ref().unwrap().export(&self.context, buffer as usize, self.source_release_token.get())).flatten();
+                if let Some(fd) = exported {
+                    match gl.fence_sync(gl::SYNC_GPU_COMMANDS_COMPLETE, 0) {
+                        Ok(fence) if !fence.0.is_null() => {
+                            self.release_observers.borrow_mut().push_back((fence, started));
+                            self.release_exported.set(self.release_exported.get() + 1);
+                            *self.release_fd.borrow_mut() = Some(fd);
+                            gl.flush();
+                        },
+                        _ => { drop(fd); self.reject_release_fence(); gl.finish(); }
+                    }
+                } else {
+                    self.reject_release_fence(); gl.finish();
+                }
+            } else if self.asynchronous.get() {
+                match gl.fence_sync(gl::SYNC_GPU_COMMANDS_COMPLETE, 0) {
+                    Ok(fence) if !fence.0.is_null() => {
+                        *self.pending.borrow_mut() = Some((fence, started));
+                        // Submit writes before releasing OpenXR images. The
+                        // runtime orders its consumer; our fence protects AHB.
+                        gl.flush();
+                    }
+                    result => {
+                        gl.finish();
+                        self.asynchronous.set(false);
+                        alvr_common::error!("Direct eye fence unavailable: {result:?}");
+                    }
+                }
+            } else {
+                gl.finish();
+            }
+            gl.bind_framebuffer(gl::DRAW_FRAMEBUFFER, None);
+            gl.bind_vertex_array(None);
+        };
+        if cached.is_some() { draw(); }
+        else { self.context.render_ahardwarebuffer_using_texture(buffer, self.source_texture, draw); }
+    }
+}
+
+impl Drop for DirectEyeRenderer {
+    fn drop(&mut self) {
+        self.drain_copy();
+        self.context.make_current();
+        let gl = &self.context.gl_context;
+        unsafe {
+            // Finish sampling before deleting siblings or dropping AHB references.
+            if let Some(timer) = self.timer.get_mut().as_mut() { timer.destroy(); }
+            if !self.image_cache.get_mut().is_empty() { gl.finish(); }
+            for entry in self.image_cache.get_mut().drain(..) {
+                gl.delete_texture(entry.texture);
+                (self.context.destroy_image)(self.context.egl_display.as_ptr(), entry.image);
+                #[cfg(target_os = "android")]
+                AHardwareBuffer_release(entry.buffer);
+            }
+            for framebuffer in self.framebuffers.iter().flatten() { gl.delete_framebuffer(*framebuffer); }
+            gl.delete_vertex_array(self.vertex_array);
+            gl.delete_texture(self.source_texture);
+            gl.delete_program(self.program);
+        }
+    }
+}
diff --git a/alvr/graphics/src/eye_timer.rs b/alvr/graphics/src/eye_timer.rs
new file mode 100644
index 0000000..832dd35
--- /dev/null
+++ b/alvr/graphics/src/eye_timer.rs
@@ -0,0 +1,292 @@
+//! Optional EXT timer queries. No result read before availability, no added waits.
+use super::{direct_eye::import_diagnostic, GraphicsContext};
+use glow::HasContext;
+use std::{
+    ffi::c_void,
+    time::{Duration, Instant},
+};
+
+const ELAPSED: u32 = 0x88BF;
+const RESULT: u32 = 0x8866;
+const AVAILABLE: u32 = 0x8867;
+const BITS: u32 = 0x8864;
+const CURRENT: u32 = 0x8865;
+const DISJOINT: u32 = 0x8FBB;
+type Gen = unsafe extern "C" fn(i32, *mut u32);
+type Delete = unsafe extern "C" fn(i32, *const u32);
+type Begin = unsafe extern "C" fn(u32, u32);
+type End = unsafe extern "C" fn(u32);
+type Target = unsafe extern "C" fn(u32, u32, *mut i32);
+type Object = unsafe extern "C" fn(u32, u32, *mut u32);
+type Object64 = unsafe extern "C" fn(u32, u32, *mut u64);
+
+struct Slot {
+    id: u32,
+    pending: bool,
+    invalid: bool,
+}
+pub(super) struct EyeTimer {
+    delete: Delete,
+    begin: Begin,
+    end: End,
+    target: Target,
+    object: Object,
+    object64: Object64,
+    slots: Vec<Slot>,
+    values: Vec<f64>,
+    bits: u32,
+    invalid: u32,
+    busy: u32,
+    last_log: Instant,
+    enabled: bool,
+}
+
+fn requested() -> bool {
+    #[cfg(target_os = "android")]
+    unsafe {
+        extern "C" {
+            fn __system_property_get(
+                name: *const std::ffi::c_char,
+                value: *mut std::ffi::c_char,
+            ) -> i32;
+        }
+        let mut value = [0; 92];
+        return __system_property_get(
+            b"debug.q3pw.eye_gpu_probe\0".as_ptr().cast(),
+            value.as_mut_ptr(),
+        ) == 1
+            && value[0] == b'1' as std::ffi::c_char;
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        false
+    }
+}
+
+impl EyeTimer {
+    pub(super) unsafe fn new(context: &GraphicsContext) -> Option<Self> {
+        if !requested() {
+            return None;
+        }
+        let gl = &context.gl_context;
+        if !gl
+            .supported_extensions()
+            .contains("GL_EXT_disjoint_timer_query")
+        {
+            import_diagnostic(
+                5,
+                "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=extension".into(),
+            );
+            return None;
+        }
+        let names = [
+            "glGenQueriesEXT",
+            "glDeleteQueriesEXT",
+            "glBeginQueryEXT",
+            "glEndQueryEXT",
+            "glGetQueryivEXT",
+            "glGetQueryObjectuivEXT",
+            "glGetQueryObjectui64vEXT",
+        ];
+        let pointers: Vec<*const c_void> = names
+            .iter()
+            .map(|name| context.gl_proc_address(name))
+            .collect();
+        if pointers.iter().any(|p| p.is_null()) {
+            import_diagnostic(
+                5,
+                "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=entrypoint".into(),
+            );
+            return None;
+        }
+        let gen: Gen = std::mem::transmute(pointers[0]);
+        let delete: Delete = std::mem::transmute(pointers[1]);
+        let begin: Begin = std::mem::transmute(pointers[2]);
+        let end: End = std::mem::transmute(pointers[3]);
+        let target: Target = std::mem::transmute(pointers[4]);
+        let object: Object = std::mem::transmute(pointers[5]);
+        let object64: Object64 = std::mem::transmute(pointers[6]);
+        let mut bits = 0;
+        target(ELAPSED, BITS, &mut bits);
+        let error = gl.get_error();
+        if error != glow::NO_ERROR || bits < 30 || bits > 64 {
+            import_diagnostic(
+                5,
+                format!("[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=counter_bits gl_error={error}"),
+            );
+            return None;
+        }
+        let mut ids = [0u32; 8];
+        gen(ids.len() as i32, ids.as_mut_ptr());
+        let error = gl.get_error();
+        if error != glow::NO_ERROR || ids.iter().any(|&id| id == 0) {
+            delete(ids.len() as i32, ids.as_ptr());
+            import_diagnostic(
+                5,
+                format!(
+                    "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=allocation gl_error={error}"
+                ),
+            );
+            return None;
+        }
+        // Establish a disjoint baseline before any measurement begins.
+        gl.get_parameter_i32(DISJOINT);
+        let error = gl.get_error();
+        if error != glow::NO_ERROR {
+            delete(ids.len() as i32, ids.as_ptr());
+            import_diagnostic(
+                5,
+                format!(
+                    "[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=disjoint gl_error={error}"
+                ),
+            );
+            return None;
+        }
+        import_diagnostic(
+            4,
+            format!("[Q3PW_EYE_GPU_SETUP] requested=1 active=1 bits={bits} slots=8"),
+        );
+        Some(Self {
+            delete,
+            begin,
+            end,
+            target,
+            object,
+            object64,
+            slots: ids
+                .into_iter()
+                .map(|id| Slot {
+                    id,
+                    pending: false,
+                    invalid: false,
+                })
+                .collect(),
+            values: Vec::new(),
+            bits: bits as u32,
+            invalid: 0,
+            busy: 0,
+            last_log: Instant::now(),
+            enabled: true,
+        })
+    }
+
+    pub(super) unsafe fn begin(&mut self, gl: &glow::Context) -> Option<usize> {
+        if !self.enabled {
+            return None;
+        }
+        let prior_values = self.values.len();
+        let disjoint = gl.get_parameter_i32(DISJOINT) != 0;
+        if disjoint {
+            for slot in &mut self.slots {
+                if slot.pending {
+                    slot.invalid = true;
+                }
+            }
+        }
+        for slot in &mut self.slots {
+            if !slot.pending {
+                continue;
+            }
+            let mut ready = 0;
+            (self.object)(slot.id, AVAILABLE, &mut ready);
+            if ready == 0 {
+                continue;
+            }
+            if slot.invalid {
+                self.invalid += 1;
+            } else {
+                let mut ns = 0u64;
+                (self.object64)(slot.id, RESULT, &mut ns);
+                let saturated = ns == 0 || ns >= u64::MAX >> (64 - self.bits);
+                if saturated {
+                    self.invalid += 1;
+                } else {
+                    self.values.push(ns as f64 / 1e6);
+                }
+            }
+            slot.pending = false;
+        }
+        // The second check closes the interval containing the result reads.
+        // A disjoint event during polling invalidates those newly read values.
+        if gl.get_parameter_i32(DISJOINT) != 0 {
+            self.invalid += (self.values.len() - prior_values) as u32;
+            self.values.truncate(prior_values);
+            for slot in &mut self.slots {
+                if slot.pending {
+                    slot.invalid = true;
+                }
+            }
+        }
+        // Query errors disable the diagnostic, rather than reaching the normal
+        // import error check and aborting the streaming process.
+        if !self.check(gl, "poll") {
+            return None;
+        }
+        if self.last_log.elapsed() >= Duration::from_secs(1) {
+            if self.values.is_empty() {
+                import_diagnostic(
+                    4,
+                    format!(
+                        "[Q3PW_EYE_GPU] samples=0 invalid={} skipped={} elapsed_ms=unknown",
+                        self.invalid, self.busy
+                    ),
+                );
+            } else {
+                self.values.sort_by(f64::total_cmp);
+                let n = self.values.len();
+                import_diagnostic(4, format!("[Q3PW_EYE_GPU] samples={n} mean_ms={:.3} p50_ms={:.3} p95_ms={:.3} max_ms={:.3} invalid={} skipped={}",
+                    self.values.iter().sum::<f64>() / n as f64, self.values[(n-1)/2],
+                    self.values[((n-1) as f64 * 0.95) as usize], self.values[n-1], self.invalid, self.busy));
+            }
+            self.values.clear();
+            self.invalid = 0;
+            self.busy = 0;
+            self.last_log = Instant::now();
+        }
+        let mut current = 0;
+        (self.target)(ELAPSED, CURRENT, &mut current);
+        if !self.check(gl, "current") {
+            return None;
+        }
+        if current != 0 {
+            self.busy += 1;
+            return None;
+        }
+        let Some(index) = self.slots.iter().position(|slot| !slot.pending) else {
+            self.busy += 1;
+            return None;
+        };
+        (self.begin)(ELAPSED, self.slots[index].id);
+        if !self.check(gl, "begin") {
+            return None;
+        }
+        self.slots[index].invalid = false;
+        Some(index)
+    }
+
+    pub(super) unsafe fn end(&mut self, gl: &glow::Context, index: usize) {
+        (self.end)(ELAPSED);
+        self.slots[index].pending = true;
+        self.check(gl, "end");
+    }
+
+    unsafe fn check(&mut self, gl: &glow::Context, stage: &str) -> bool {
+        let error = gl.get_error();
+        if error == glow::NO_ERROR {
+            return true;
+        }
+        self.enabled = false;
+        self.values.clear();
+        for slot in &mut self.slots {
+            slot.invalid = true;
+        }
+        import_diagnostic(5, format!("[Q3PW_EYE_GPU_SETUP] requested=1 active=0 reason=gl_error stage={stage} gl_error={error}"));
+        false
+    }
+
+    pub(super) unsafe fn destroy(&mut self) {
+        for slot in self.slots.drain(..) {
+            (self.delete)(1, &slot.id);
+        }
+    }
+}
