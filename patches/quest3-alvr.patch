diff --git a/alvr/client_core/src/frame_trace.rs b/alvr/client_core/src/frame_trace.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ed952972c5004d1f1e9d4f0ed674c9dde6570ad8
--- /dev/null
+++ b/alvr/client_core/src/frame_trace.rs
@@ -0,0 +1,127 @@
+//! Opt-in per-frame critical-path trace for Quest PyroWave (`debug.q3pw.frame_trace=1`, read when
+//! a stream starts). Hot paths only read CLOCK_MONOTONIC and push a fixed-size record into a
+//! bounded buffer; a separate thread logs the records as `[Q3PW_TRACE]` batches about four times
+//! a second, so no formatting or logging happens on the decode or render threads.
+//!
+//! Record: `kind,t_us,id,a,b` with `t_us` CLOCK_MONOTONIC microseconds. `id` is the frame's
+//! tracking timestamp (OpenXR XrTime nanoseconds) for frame records, or the predicted display time
+//! for render-loop records. `K` records pair the monotonic clock with xrConvertTimespecTimeToTimeKHR
+//! so the two clocks are compared only through that measured offset. Kinds are listed in
+//! `tools/quest3/frame_trace.py`.
+
+use alvr_common::parking_lot::Mutex;
+use std::{
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        Once,
+    },
+    thread,
+    time::Duration,
+};
+
+/// About 18 s of records at 207 Hz; a stalled logger drops (and counts) records rather than grow.
+const MAX_RECORDS: usize = 1 << 16;
+const PER_LINE: usize = 40;
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static DROPPED: AtomicU64 = AtomicU64::new(0);
+static RECORDS: Mutex<Vec<Record>> = Mutex::new(Vec::new());
+static FLUSHER: Once = Once::new();
+
+#[derive(Clone, Copy)]
+struct Record {
+    kind: u8,
+    t_us: u64,
+    id: u64,
+    a: i64,
+    b: i64,
+}
+
+#[cfg(unix)]
+pub fn mono_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+#[cfg(not(unix))]
+pub fn mono_ns() -> u64 {
+    static EPOCH: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+    EPOCH.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64
+}
+
+#[inline]
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// `kind` is one ASCII letter; see the module documentation.
+#[inline]
+pub fn record(kind: u8, id: u64, a: i64, b: i64) {
+    if enabled() {
+        record_at(kind, mono_ns(), id, a, b);
+    }
+}
+
+pub fn record_at(kind: u8, t_ns: u64, id: u64, a: i64, b: i64) {
+    if !enabled() {
+        return;
+    }
+    let mut records = RECORDS.lock();
+    if records.len() < MAX_RECORDS {
+        records.push(Record { kind, t_us: t_ns / 1000, id, a, b });
+    } else {
+        DROPPED.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Called when a stream starts. Enabling spawns the logging thread once per process.
+pub fn start(enable: bool) {
+    RECORDS.lock().clear();
+    ENABLED.store(enable, Ordering::Relaxed);
+    if !enable {
+        return;
+    }
+    FLUSHER.call_once(|| {
+        thread::spawn(|| loop {
+            thread::sleep(Duration::from_millis(250));
+            let batch = std::mem::take(&mut *RECORDS.lock());
+            for (index, chunk) in batch.chunks(PER_LINE).enumerate() {
+                log(&line(chunk, if index == 0 { DROPPED.swap(0, Ordering::Relaxed) } else { 0 }));
+            }
+        });
+    });
+}
+
+fn line(chunk: &[Record], dropped: u64) -> String {
+    use std::fmt::Write;
+    let mut out = format!("[Q3PW_TRACE] v1 dropped={dropped} ");
+    for r in chunk {
+        let _ = write!(out, "{},{},{},{},{};", r.kind as char, r.t_us, r.id, r.a, r.b);
+    }
+    out
+}
+
+#[cfg(target_os = "android")]
+fn log(message: &str) {
+    crate::video_decoder::logcat_info("Q3PW", message);
+}
+
+#[cfg(not(target_os = "android"))]
+fn log(message: &str) {
+    alvr_common::info!("{message}");
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn line_lists_records_in_order() {
+        let chunk = [
+            Record { kind: b'S', t_us: 10, id: 7, a: 1, b: 0 },
+            Record { kind: b'D', t_us: 12, id: 7, a: 2500, b: -1 },
+        ];
+        assert_eq!(line(&chunk, 3), "[Q3PW_TRACE] v1 dropped=3 S,10,7,1,0;D,12,7,2500,-1;");
+    }
+}
