diff --git a/alvr/client_core/src/performance.rs b/alvr/client_core/src/performance.rs
new file mode 100644
index 0000000..5e9bb7c
--- /dev/null
+++ b/alvr/client_core/src/performance.rs
@@ -0,0 +1,62 @@
+//! Client overlay controls; independent of graphics so the chord can be regression tested.
+pub struct OverlayToggle {
+    pub visible: bool,
+    armed: bool,
+}
+
+impl Default for OverlayToggle {
+    fn default() -> Self {
+        Self {
+            visible: true,
+            armed: true,
+        }
+    }
+}
+
+impl OverlayToggle {
+    pub fn update(&mut self, left: bool, right: bool) {
+        if !left && !right {
+            self.armed = true;
+        }
+        if self.armed && left && right {
+            self.visible = !self.visible;
+            self.armed = false;
+        }
+    }
+}
+
+pub fn metric(value: f32) -> String {
+    if value.is_finite() && value >= 0.0 {
+        format!("{value:.1}")
+    } else {
+        "--".into()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn both_sticks_toggle_once_and_both_must_be_released_to_rearm() {
+        let mut toggle = OverlayToggle::default();
+        assert!(toggle.visible);
+        toggle.update(true, false);
+        assert!(toggle.visible);
+        toggle.update(true, true);
+        assert!(!toggle.visible);
+        toggle.update(true, true);
+        toggle.update(true, false);
+        toggle.update(true, true);
+        assert!(!toggle.visible);
+        toggle.update(false, false);
+        toggle.update(true, true);
+        assert!(toggle.visible);
+    }
+    #[test]
+    fn unknown_metrics_are_never_displayed_as_valid_numbers() {
+        assert_eq!(metric(f32::NAN), "--");
+        assert_eq!(metric(f32::INFINITY), "--");
+        assert_eq!(metric(-1.0), "--");
+        assert_eq!(metric(120.0), "120.0");
+    }
+}
