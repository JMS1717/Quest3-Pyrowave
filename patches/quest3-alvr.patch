+
+impl PerformanceOverlay {
+    pub fn new(
+        session: xr::Session<xr::OpenGlEs>,
+        context: Rc<GraphicsContext>,
+        interactions: Arc<RwLock<InteractionContext>>,
+    ) -> xr::Result<Self> {
+        context.make_current();
+        let view_space =
+            session.create_reference_space(xr::ReferenceSpaceType::VIEW, xr::Posef::IDENTITY)?;
+        let local_space =
+            session.create_reference_space(xr::ReferenceSpaceType::LOCAL, xr::Posef::IDENTITY)?;
+        let strip = Surface::new(&session, &context, STRIP_SIZE)?;
+        let panel = Surface::new(&session, &context, PANEL_SIZE)?;
+        Ok(Self {
+            session,
+            context,
+            interactions,
+            view_space,
+            local_space,
+            strip,
+            panel,
+            rasterizer: PanelRasterizer::new(),
+            chord: ThumbstickChord::new(),
+            mode: OverlayMode::default(),
