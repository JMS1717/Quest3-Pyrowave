+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::{Duration, Instant};
+
+    fn tiles() -> Vec<Tile> {
+        vec![
+            Tile {
+                label: "Fresh FPS".into(),
+                value: "118".into(),
+                unit: "/ 120 Hz".into(),
+                tone: Tone::Good,
+            },
+            Tile {
+                label: "Latency".into(),
+                value: "44".into(),
+                unit: "ms".into(),
+                tone: Tone::Warn,
+            },
+        ]
+    }
+
+    fn alpha(pixels: &[u8], width: u32, x: u32, y: u32) -> u8 {
+        pixels[((y * width + x) * 4 + 3) as usize]
+    }
+
+    #[test]
+    fn rounded_corners_are_transparent_and_text_draws_pixels() {
+        let view = PanelView::Strip(tiles());
+        let pixels = rasterize(&view);
+        let (w, h) = STRIP_SIZE;
+        assert_eq!(pixels.len(), (w * h * 4) as usize);
+        assert_eq!(alpha(&pixels, w, 0, 0), 0);
+        assert_eq!(alpha(&pixels, w, w - 1, h - 1), 0);
+        assert!(alpha(&pixels, w, w / 2, h / 2) > 200);
+        // Some bright text pixels exist
+        assert!(pixels.chunks(4).any(|p| p[0] > 200 && p[1] > 200 && p[2] > 200));
+    }
+
+    #[test]
+    fn stats_and_menu_fit_their_panel_and_tolerate_missing_values() {
+        let stats = PanelView::Stats(StatsView {
+            title: "Quest3 PyroWave".into(),
+            subtitle: "PyroWave 4:2:0 | 2080x2208 /eye | 120 Hz | USB/TCP".into(),
+            tiles: tiles(),
+            history: vec![118.0, f32::NAN, 60.0, 119.0],
+            history_target: 120.0,
+            details: (0..12).map(|i| (format!("Row {i}"), "--".into())).collect(),
+            footer: "Click both sticks: overlay mode | Hold both: settings".into(),
+        });
+        assert_eq!(rasterize(&stats).len(), (PANEL_SIZE.0 * PANEL_SIZE.1 * 4) as usize);
+        let menu = PanelView::Menu(MenuView {
