+
+#[derive(Default)]
+struct FrameSlotState {
+    pending: Option<(Duration, usize)>,
+    superseded: u64,
+    /// The render loop can hold a dequeued buffer across xrWaitFrame. Keep it out
+    /// of the producer's write rotation until a subsequent frame is dequeued.
+    leased: usize,
 }
 
 impl FrameSlot {
     pub fn publish(&self, timestamp: Duration, buffer: usize) {
-        *self.inner.lock() = Some((timestamp, buffer));
+        let mut state = self.inner.lock();
+        if state.pending.replace((timestamp, buffer)).is_some() {
+            state.superseded += 1;
+        }
+    }
+    pub fn superseded(&self) -> u64 {
+        self.inner.lock().superseded
     }
     pub fn take(&self) -> Option<(Duration, usize)> {
-        self.inner.lock().take()
+        let mut state = self.inner.lock();
+        let frame = state.pending.take()?;
+        state.leased = frame.1;
+        Some(frame)
+    }
+    /// Exclude both possible consumer buffers before reserving a native output
+    /// slot: the currently leased one and the pending one that could be taken.
+    pub fn protected_buffers(&self) -> [usize; 2] {
+        let state = self.inner.lock();
+        [state.leased, state.pending.map_or(0, |(_, buffer)| buffer)]
     }
 }
 
