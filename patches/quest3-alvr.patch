+/// `debug.q3pw.layer_filter`: '+'-separated `sharpen`, `sharpen_hq`, `supersample`,
+/// `supersample_hq` and `auto`, applied by the compositor to the projection layer.
+/// `auto` must not be the only bit (XR_META_automatic_layer_filter).
+fn layer_filter_flags(request: &str, supported: bool, auto_supported: bool) -> xr::sys::CompositionLayerSettingsFlagsFB {
+    use xr::sys::CompositionLayerSettingsFlagsFB as Flags;
+    if !supported { return Flags::EMPTY; }
+    let mut flags = Flags::EMPTY;
+    for name in request.split('+').map(str::trim) {
+        flags |= match name {
+            "sharpen" => Flags::NORMAL_SHARPENING,
+            "sharpen_hq" => Flags::QUALITY_SHARPENING,
+            "supersample" => Flags::NORMAL_SUPER_SAMPLING,
+            "supersample_hq" => Flags::QUALITY_SUPER_SAMPLING,
+            "auto" if auto_supported => Flags::AUTO_LAYER_FILTER,
+            _ => Flags::EMPTY,
+        };
+    }
+    if flags.into_raw() == Flags::AUTO_LAYER_FILTER.into_raw() { Flags::EMPTY } else { flags }
+}
