+void Decoder::get_block_stats(uint64_t *blocks, uint64_t *empty_blocks, uint64_t *coded_subblocks, bool reset)
+{
+	for (int i = 0; i < 3 * DecompositionLevels; i++)
+	{
+		blocks[i] = impl->stat_blocks[i];
+		empty_blocks[i] = impl->stat_empty_blocks[i];
+		coded_subblocks[i] = impl->stat_coded_subblocks[i];
+	}
+	if (reset)
+	{
+		std::fill(std::begin(impl->stat_blocks), std::end(impl->stat_blocks), 0);
+		std::fill(std::begin(impl->stat_empty_blocks), std::end(impl->stat_empty_blocks), 0);
+		std::fill(std::begin(impl->stat_coded_subblocks), std::end(impl->stat_coded_subblocks), 0);
+	}
+}
