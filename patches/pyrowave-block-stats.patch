+pyrowave_result pyrowave_decoder_get_block_stats(pyrowave_decoder decoder, uint64_t blocks[15],
+                                                 uint64_t empty_blocks[15], uint64_t coded_subblocks[15],
+                                                 int reset)
+{
+	if (!decoder || !blocks || !empty_blocks || !coded_subblocks)
+		return PYROWAVE_ERROR_INVALID_ARGUMENT;
+	decoder->decoder.get_block_stats(blocks, empty_blocks, coded_subblocks, reset != 0);
+	return PYROWAVE_SUCCESS;
+}
