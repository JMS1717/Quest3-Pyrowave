+pyrowave_encoder_set_quality_floor(pyrowave_encoder encoder, uint32_t bucket)
+{
+	if (bucket > 128)
+		return PYROWAVE_ERROR_INVALID_ARGUMENT;
+	encoder->encoder.set_quality_floor(bucket);
+	return PYROWAVE_SUCCESS;
+}
