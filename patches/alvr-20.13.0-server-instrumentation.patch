+        assert_eq!(frame_decision(false, true, Duration::from_millis(5), d), FrameDecision::Wait);
+        assert_eq!(frame_decision(false, true, Duration::from_millis(14), d), FrameDecision::DecodePartial);
+        assert_eq!(frame_decision(false, false, Duration::from_millis(14), d), FrameDecision::Drop);
+        // a complete frame is decoded even if it arrived late: it is newer than anything shown
+        assert_eq!(frame_decision(true, true, Duration::from_millis(40), d), FrameDecision::DecodeComplete);
+    }
