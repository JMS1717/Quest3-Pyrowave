+
+/// Thermal status (Android PowerManager, 0 none .. 6 shutdown) and battery temperature in °C, for
+/// the beta test report. Either is `None` when the platform does not report it; nothing panics.
+pub fn get_thermal_snapshot() -> (Option<i32>, Option<f32>) {
+    let vm = vm();
+    let Ok(mut env) = vm.attach_current_thread() else {
+        return (None, None);
+    };
+    let context = unsafe { JObject::from_raw(context()) };
+
+    // PowerManager.getCurrentThermalStatus() exists from API 29
+    let thermal_status = (get_api_level() >= 29)
+        .then(|| -> Option<i32> {
+            let service = env.new_string("power").ok()?;
+            let power = env
+                .call_method(
+                    &context,
+                    "getSystemService",
+                    "(Ljava/lang/String;)Ljava/lang/Object;",
+                    &[(&service).into()],
+                )
+                .ok()?
+                .l()
+                .ok()?;
+            env.call_method(&power, "getCurrentThermalStatus", "()I", &[])
+                .ok()?
+                .i()
+                .ok()
+        })
+        .flatten();
+
+    let battery_temperature_c = (|| -> Option<f32> {
+        let action = env
+            .new_string("android.intent.action.BATTERY_CHANGED")
+            .ok()?;
+        let filter = env
+            .new_object(
+                "android/content/IntentFilter",
+                "(Ljava/lang/String;)V",
+                &[(&action).into()],
+            )
+            .ok()?;
+        let intent = env
+            .call_method(
+                &context,
+                "registerReceiver",
+                "(Landroid/content/BroadcastReceiver;Landroid/content/IntentFilter;)Landroid/content/Intent;",
+                &[(&JObject::null()).into(), (&filter).into()],
+            )
+            .ok()?
+            .l()
+            .ok()?;
+        let key = env.new_string("temperature").ok()?;
+        let tenths = env
+            .call_method(
+                &intent,
+                "getIntExtra",
+                "(Ljava/lang/String;I)I",
+                &[(&key).into(), (i32::MIN).into()],
+            )
+            .ok()?
+            .i()
+            .ok()?;
+        (tenths != i32::MIN).then(|| tenths as f32 / 10.0)
+    })();
+
+    if env.exception_check().unwrap_or(false) {
+        env.exception_clear().ok();
+    }
+
+    (thermal_status, battery_temperature_c)
+}
