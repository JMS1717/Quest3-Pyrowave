diff --git a/alvr/client_openxr/src/extra_extensions/perf_settings.rs b/alvr/client_openxr/src/extra_extensions/perf_settings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..30b0e81f826fc22dd6db995b9406c260cd9472c4
--- /dev/null
+++ b/alvr/client_openxr/src/extra_extensions/perf_settings.rs
@@ -0,0 +1,83 @@
+// XR_EXT_performance_settings. ALVR never enables it, so the runtime's DynamicPolicyManager
+// records the client's CPU and GPU votes as POWER_SAVING (captured while streaming).
+// PyroWave decodes on the shader cores, so the GPU clock this vote allows is now on the frame's
+// critical path.
+
+use super::{get_instance_proc, xr_res};
+use openxr::{self as xr, sys};
+
+pub const CPU: sys::PerfSettingsDomainEXT = sys::PerfSettingsDomainEXT::CPU;
+pub const GPU: sys::PerfSettingsDomainEXT = sys::PerfSettingsDomainEXT::GPU;
+
+/// `debug.xrwired.perf_level` system property: `power_savings`, `sustained_low`,
+/// `sustained_high`, `boost`, or `off` to leave the runtime's default vote (an A/B arm).
+/// Unset means `sustained_high`.
+pub fn level_from_property() -> Option<sys::PerfSettingsLevelEXT> {
+    level_from_str(&system_property("debug.xrwired.perf_level"))
+}
+
+pub fn level_from_str(s: &str) -> Option<sys::PerfSettingsLevelEXT> {
+    match s.trim() {
+        "off" => None,
+        "power_savings" => Some(sys::PerfSettingsLevelEXT::POWER_SAVINGS),
+        "sustained_low" => Some(sys::PerfSettingsLevelEXT::SUSTAINED_LOW),
+        "boost" => Some(sys::PerfSettingsLevelEXT::BOOST),
+        _ => Some(sys::PerfSettingsLevelEXT::SUSTAINED_HIGH),
+    }
+}
+
+#[cfg(target_os = "android")]
+pub fn system_property(name: &str) -> String {
+    use std::ffi::CString;
+    let name = CString::new(name).unwrap();
+    let mut buf = [0u8; 92]; // PROP_VALUE_MAX
+    let n = unsafe { libc::__system_property_get(name.as_ptr(), buf.as_mut_ptr() as *mut _) };
+    String::from_utf8_lossy(&buf[..n.max(0) as usize]).into_owned()
+}
+
+#[cfg(not(target_os = "android"))]
+pub fn system_property(_name: &str) -> String {
+    String::new()
+}
+
+pub fn set_performance_level<G>(
+    session: &xr::Session<G>,
+    level: sys::PerfSettingsLevelEXT,
+) -> xr::Result<()> {
+    let set: sys::pfn::PerfSettingsSetPerformanceLevelEXT =
+        get_instance_proc(session, "xrPerfSettingsSetPerformanceLevelEXT")?;
+    for domain in [CPU, GPU] {
+        xr_res(unsafe { set(session.as_raw(), domain, level) })?;
+    }
+    Ok(())
+}
+
+/// `debug.xrwired.early_poll`: `0` restores the stock order (xrWaitFrame, then wait for the
+/// frame); anything else, including unset, polls for the frame first.
+pub fn early_poll_enabled() -> bool {
+    early_poll_from_str(&system_property("debug.xrwired.early_poll"))
+}
+
+pub fn early_poll_from_str(s: &str) -> bool {
+    s.trim() != "0"
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn early_poll_is_on_unless_the_property_says_zero() {
+        assert!(early_poll_from_str(""));
+        assert!(early_poll_from_str("1\n"));
+        assert!(!early_poll_from_str("0"));
+    }
+
+    #[test]
+    fn property_picks_the_level_and_off_leaves_the_default() {
+        assert_eq!(level_from_str("off"), None);
+        assert_eq!(level_from_str(""), Some(sys::PerfSettingsLevelEXT::SUSTAINED_HIGH));
+        assert_eq!(level_from_str("boost\n"), Some(sys::PerfSettingsLevelEXT::BOOST));
+        assert_eq!(level_from_str("power_savings"), Some(sys::PerfSettingsLevelEXT::POWER_SAVINGS));
+    }
+}
