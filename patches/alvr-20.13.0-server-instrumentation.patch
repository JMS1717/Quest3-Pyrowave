+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alvr_session::beta;
+
+    fn choice(node: PresetSchemaNode) -> HigherOrderChoiceSchema {
+        match node {
+            PresetSchemaNode::HigherOrderChoice(schema) => schema,
+            PresetSchemaNode::Mirror(_) => panic!("not a choice"),
+        }
+    }
+
+    #[test]
+    fn streaming_profile_lists_the_two_profiles_recommended_first() {
+        let schema = choice(streaming_profile_schema());
+        let names = schema
+            .options
+            .iter()
+            .map(|o| o.display_name.as_str())
+            .collect::<Vec<_>>();
+        assert_eq!(names, ["PyroWave 4:4:4 (Recommended)", "ALVR H.264 (tuned)"]);
+        assert_eq!(schema.default_option_display_name, beta::RECOMMENDED_PROFILE);
+        assert_eq!(
+            schema.options[0].description.as_deref(),
+            Some("Full-chroma experimental wireless VR streaming")
+        );
+        // every assignment of the shared profile table, under session_settings
+        let profile = &beta::streaming_profiles()[0];
+        assert_eq!(schema.options[0].modifiers.len(), profile.assignments.len());
+        for (modifier, (path, value)) in schema.options[0].modifiers.iter().zip(&profile.assignments) {
+            assert_eq!(modifier.target_path, format!("session_settings.{path}"));
+            let PresetModifierOperation::Assign(assigned) = &modifier.operation;
+            assert_eq!(assigned, value);
+        }
+    }
+
+    #[test]
+    fn render_scale_is_panel_relative_and_sets_both_resolutions() {
+        let schema = choice(render_scale_schema());
+        let names = schema
+            .options
+            .iter()
+            .map(|o| o.display_name.as_str())
+            .collect::<Vec<_>>();
+        assert_eq!(
+            names,
+            [
+                "50 % (1776x1920 per eye)",
+                "60 % (2131x2304 per eye)",
+                "70 % (2486x2688 per eye)",
+                "80 % (2842x3072 per eye)",
+                "90 % (3197x3456 per eye)",
+                "100 % (3552x3840 per eye, panel)",
+            ]
+        );
+        assert_eq!(schema.default_option_display_name, "60 % (2131x2304 per eye)");
+        let seventy = &schema.options[2];
+        let width = |field: &str| {
+            seventy
+                .modifiers
+                .iter()
+                .find(|m| m.target_path == format!("session_settings.video.{field}.Absolute.width"))
+                .map(|m| {
+                    let PresetModifierOperation::Assign(value) = &m.operation;
+                    value.clone()
+                })
+        };
+        assert_eq!(width("transcoding_view_resolution"), Some(2486.into()));
+        assert_eq!(width("emulated_headset_view_resolution"), Some(2486.into()));
+    }
+
+    #[test]
+    fn refresh_rate_offers_what_the_headset_runs() {
+        let schema = choice(refresh_rate_schema());
+        let names = schema
+            .options
+            .iter()
+            .map(|o| o.display_name.as_str())
+            .collect::<Vec<_>>();
+        assert_eq!(names, ["60 Hz", "72 Hz", "90 Hz"]);
+        assert_eq!(schema.default_option_display_name, "90 Hz");
+    }
+}
