+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alvr_packets::PyroWaveDecodeStats;
+    use alvr_session::SessionConfig;
+
+    /// Research check, not part of the suite: builds a report from a harness cell's recorded
+    /// events (telemetry/events.json and telemetry/session.json) so its numbers can be compared
+    /// with the harness's own. `ALVR_REPORT_CELL=<cell>/telemetry cargo test -- --ignored`
+    #[test]
+    #[ignore]
+    fn report_from_a_recorded_cell() {
+        let dir = std::path::PathBuf::from(std::env::var("ALVR_REPORT_CELL").unwrap());
+        let read = |name: &str| {
+            let text = std::fs::read_to_string(dir.join(name)).unwrap();
+            serde_json::from_str::<Value>(text.trim_start_matches('\u{feff}')).unwrap()
+        };
+        let session: SessionConfig = serde_json::from_value(read("session.json")).unwrap();
+        let mut recording = Recording::default();
+        for event in read("events.json").as_array().unwrap() {
+            match serde_json::from_value::<alvr_events::EventType>(event["event_type"].clone()) {
+                Ok(alvr_events::EventType::GraphStatistics(g)) => recording.frames.push(g),
+                Ok(alvr_events::EventType::HeadsetTelemetry(t)) => recording.telemetry.push(t),
+                Ok(alvr_events::EventType::StatisticsSummary(s)) => {
+                    recording.packets_lost_start.get_or_insert(s.packets_lost_total);
+                    recording.packets_lost_end = Some(s.packets_lost_total);
+                }
+                _ => (),
+            }
+        }
+        let mut report = build_report(
+            "recorded",
+            &session.to_settings(),
+            &serde_json::to_value(&session.session_settings).unwrap(),
+            &collect_system_info(),
+            &recording,
+            &Subjective::default(),
+        );
+        report.as_object_mut().unwrap().remove("per_frame");
+        println!("{}", serde_json::to_string_pretty(&report).unwrap());
+        assert!(find_identifying(&report).is_empty(), "{:?}", find_identifying(&report));
+    }
+
+    #[test]
+    fn statistics_match_the_research_harness() {
+        let v = (1..=100).map(|i| i as f32).collect::<Vec<_>>();
+        assert_eq!(percentile(&v, 0.5), Some(51.0));
+        assert_eq!(percentile(&v, 0.99), Some(100.0));
+        assert_eq!(one_percent_low(&v), Some(1.0));
+        let v = (1..=300).map(|i| i as f32).collect::<Vec<_>>();
+        assert_eq!(one_percent_low(&v), Some(2.0), "mean of the slowest three");
+        assert_eq!(mean(&[]), None);
+        assert_eq!(percentile(&[], 0.5), None);
+    }
+
+    #[test]
+    fn identifying_tokens_are_found_and_redacted() {
+        for (text, kind) in [
+            ("streaming from 192.0.2.44 fine", "IP address"),
+            ("udp 198.51.100.12:9944", "IP address"),
+            ("fe80::1c2a:3bff:fe4d:5e6f", "IP address"),
+            ("2001:0db8:85a3:0000:0000:8a2e:0370:7334", "IP address"),
+            ("router aa:bb:cc:dd:ee:ff", "MAC address"),
+            ("mail me@example.com", "e-mail"),
+            (r"C:\Users\someone\Documents", "user path"),
+            ("/Users/someone/x", "user path"),
+            ("headset ZX81TEST99", "serial-like token"),
+            ("host 5050.client.alvr", "hostname"),
+            ("box.local", "hostname"),
+        ] {
+            let found = find_identifying(&json!({ "t": text }));
+            assert!(
+                found.iter().any(|f| f.starts_with(kind)),
+                "{text}: {found:?}"
+            );
+            assert!(find_identifying(&json!(sanitize_text(text))).is_empty(), "{text}");
+        }
+        for clean in [
+            "NVIDIA GeForce RTX 3090",
+            "32.0.15.6094",
+            "AMD Ryzen 9 5950X 16-Core Processor",
+            "SM-I610",
+            "Windows 11 (26100)",
+            "Wi-Fi 6E, 6 GHz, 160 MHz",
+            "CDF 9/7",
+            "4:4:4",
+            "4:2:0",
+            "20.13.0-pyro.1",
+        ] {
+            assert!(find_identifying(&json!(clean)).is_empty(), "{clean}");
+            assert_eq!(sanitize_text(clean), clean);
+        }
+    }
+
+    fn frame(total_s: f32, fps: f32) -> GraphStatistics {
+        GraphStatistics {
+            total_pipeline_latency_s: total_s,
+            client_fps: fps,
+            encoder_s: 0.007,
+            bitrate_bps: 400e6,
+            ..Default::default()
+        }
+    }
+
+    fn telemetry(complete: u64, dropped: u64, thermal: i32) -> HeadsetTelemetry {
+        HeadsetTelemetry {
+            model: "SM-I610".into(),
+            thermal_status: Some(thermal),
+            battery_temperature_c: Some(30.0),
+            battery_level: Some(0.5),
+            pyrowave: Some(PyroWaveDecodeStats {
+                complete,
+                dropped,
+                encoded_width: 1984,
+                encoded_height: 896,
+                gpu_decode_ms: vec![3.2, 3.4],
+                fence_ms: vec![4.8, 5.0],
