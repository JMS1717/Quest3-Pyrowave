+    }
+}
+
+fn default_settings() -> Settings {
+    SessionConfig::default().to_settings()
+}
+
+#[test]
+fn fresh_install_streams_the_recommended_profile() {
+    let s = default_settings();
+    assert_eq!(s.video.preferred_codec, CodecType::PyroWave);
+    assert!(matches!(s.video.bitrate.mode, BitrateMode::ConstantMbps(400)));
+    assert_eq!(s.video.preferred_fps, 90.0);
+    for size in [
+        &s.video.transcoding_view_resolution,
+        &s.video.emulated_headset_view_resolution,
+    ] {
+        assert!(matches!(
+            size,
+            FrameSize::Absolute {
+                width: 2131,
+                height: Some(2304)
+            }
+        ));
+    }
+    let Switch::Enabled(fov) = &s.video.foveated_encoding else {
+        panic!("foveation off")
+    };
+    assert_eq!((fov.center_size_x, fov.center_size_y), (0.20, 0.178));
+    assert_eq!((fov.edge_ratio_x, fov.edge_ratio_y), (3.0, 4.0));
+    assert_eq!((fov.center_shift_x, fov.center_shift_y), (0.0, 0.0));
+    assert!(fov.follow_gaze);
+    assert_eq!(s.video.pyrowave.transport, PyroWaveTransport::Udp);
+    assert_eq!(s.video.pyrowave.wavelet, PyroWaveWavelet::Cdf97);
+    assert_eq!(s.video.pyrowave.decode_path, PyroWaveDecodePath::Compute);
+    assert_eq!(s.video.max_buffering_frames, 1.5);
+    assert!(s.video.enforce_server_frame_pacing);
+    assert!(!s.video.color_correction.enabled());
+    assert!(!s.video.upscaling.enabled());
+    assert!(!s.video.clientside_foveation.enabled());
+    assert_eq!(s.connection.packet_size, 65000);
+    assert_eq!(s.connection.max_queued_server_video_frames, 12);
+    // No pairing step: a headset running the beta client connects as soon as it is discovered
+    let Switch::Enabled(discovery) = &s.connection.client_discovery else {
+        panic!("discovery off")
+    };
+    assert!(discovery.auto_trust_clients);
+}
+
+// Applies session-style assignments the way the dashboard's SetValues does.
+fn apply(profile: &StreamingProfile) -> Settings {
+    let mut session = SessionConfig::default();
+    let mut root = json::to_value(&session.session_settings).unwrap();
+    for (path, value) in &profile.assignments {
+        let mut node = &mut root;
+        for segment in path.split('.') {
+            node = node
+                .get_mut(segment)
+                .unwrap_or_else(|| panic!("{} has no {segment}", profile.name));
+        }
+        *node = value.clone();
+    }
+    session.session_settings = json::from_value(root).unwrap();
+    session.to_settings()
+}
+
+fn profile(name: &str) -> StreamingProfile {
+    streaming_profiles()
+        .into_iter()
+        .find(|p| p.name == name)
+        .unwrap_or_else(|| panic!("no profile named {name}"))
+}
