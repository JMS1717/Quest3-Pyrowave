+// Beta research release: what testers see, what a fresh install streams, and how research
+// overrides resolve. Paths are session-style, relative to `session_settings`.
+
+use crate::{beta::*, settings::*, SessionConfig};
+use serde_json as json;
+use settings_schema::Switch;
+use std::collections::HashMap;
+
+fn schema() -> settings_schema::SchemaNode {
+    Settings::schema(session_settings_default())
+}
+
+fn names(entries: Vec<VisibleEntry>, visibility: Visibility) -> Vec<String> {
+    let mut names = entries
+        .into_iter()
+        .filter(|e| e.visibility == visibility)
+        .map(|e| e.name)
+        .collect::<Vec<_>>();
+    names.sort();
+    names
+}
+
+fn sorted(list: &[&str]) -> Vec<String> {
+    let mut list = list.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+    list.sort();
+    list
+}
+
+#[test]
+fn video_shows_only_codec_experiment_controls() {
+    let entries = visible_children(&schema(), &["video"]).unwrap();
+    assert_eq!(
+        names(entries.clone(), Visibility::Experiment),
+        sorted(&["passthrough", "bitrate", "preferred_codec", "pyrowave", "foveated_encoding"])
+    );
+    assert_eq!(
+        names(entries, Visibility::Advanced),
+        sorted(&[
+            "max_buffering_frames",
+            "buffering_history_weight",
+            "enforce_server_frame_pacing",
+            "encoder_config",
+            "adapter_index",
+        ])
+    );
+}
+
+#[test]
+fn codec_picker_offers_pyrowave_and_h264_only() {
+    assert_eq!(
+        visible_variants(&schema(), &["video", "preferred_codec"]).unwrap(),
+        sorted(&["H264", "PyroWave"])
+    );
+}
+
+#[test]
+fn pyrowave_section_exposes_transport_wavelet_and_decode_path() {
+    let entries = visible_children(&schema(), &["video", "pyrowave"]).unwrap();
+    assert_eq!(
+        names(entries, Visibility::Experiment),
+        sorted(&["transport", "wavelet", "decode_path"])
+    );
+    assert_eq!(
+        visible_variants(&schema(), &["video", "pyrowave", "decode_path"]).unwrap(),
+        sorted(&["Compute", "Fragment"])
+    );
+}
+
+#[test]
+fn foveation_exposes_size_edges_and_gaze() {
+    let entries = visible_children(&schema(), &["video", "foveated_encoding"]).unwrap();
+    assert_eq!(
+        names(entries, Visibility::Experiment),
+        sorted(&[
+            "center_size_x",
+            "center_size_y",
+            "edge_ratio_x",
+            "edge_ratio_y",
+            "follow_gaze"
+        ])
+    );
+}
+
+#[test]
+fn bitrate_and_encoder_are_trimmed() {
+    let bitrate = visible_children(&schema(), &["video", "bitrate"]).unwrap();
+    assert_eq!(names(bitrate, Visibility::Experiment), sorted(&["mode"]));
+
+    // encoder_config is advanced as a whole, so everything under it is too
+    let encoder = visible_children(&schema(), &["video", "encoder_config"]).unwrap();
+    assert_eq!(
+        names(encoder, Visibility::Advanced),
+        sorted(&["rate_control_mode", "entropy_coding", "nvenc"])
+    );
+    let nvenc = visible_children(&schema(), &["video", "encoder_config", "nvenc"]).unwrap();
+    assert_eq!(
+        names(nvenc, Visibility::Advanced),
+        sorted(&[
+            "quality_preset",
+            "tuning_preset",
+            "multi_pass",
+            "adaptive_quantization_mode"
+        ])
+    );
+}
+
+#[test]
+fn core_features_stay_visible() {
+    let top = visible_children(&schema(), &[]).unwrap();
+    assert_eq!(
+        names(top, Visibility::Experiment),
+        sorted(&["video", "audio", "headset", "connection", "extra"])
+    );
+    let audio = visible_children(&schema(), &["audio"]).unwrap();
+    assert_eq!(
+        names(audio, Visibility::Experiment),
+        sorted(&["game_audio", "microphone"])
+    );
+    let headset = names(
+        visible_children(&schema(), &["headset"]).unwrap(),
