+// ---- collection and export (not in the browser build) ----
+
+/// GPU, CPU and OS as reported by the machine; model names and versions only.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn collect_system_info() -> SystemInfo {
+    let mut system = sysinfo::System::new();
+    system.refresh_cpu_all();
+    let cpu = system
+        .cpus()
+        .first()
+        .map(|c| c.brand().trim().to_owned())
+        .unwrap_or_default();
+    let os = sysinfo::System::long_os_version().unwrap_or_default();
+
+    #[cfg(windows)]
+    let (gpu, gpu_driver) = {
+        use std::os::windows::process::CommandExt;
+        const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+        let out = std::process::Command::new("powershell")
+            .args([
+                "-NoProfile",
+                "-Command",
+                "Get-CimInstance Win32_VideoController | ForEach-Object { $_.Name + '|' + $_.DriverVersion }",
+            ])
+            .creation_flags(CREATE_NO_WINDOW)
+            .output()
+            .map(|o| String::from_utf8_lossy(&o.stdout).into_owned())
+            .unwrap_or_default();
+        let rows = out
+            .lines()
+            .filter_map(|l| l.trim().split_once('|'))
+            .collect::<Vec<_>>();
+        (
+            rows.iter().map(|(n, _)| n.trim()).collect::<Vec<_>>().join("; "),
+            rows.iter().map(|(_, d)| d.trim()).collect::<Vec<_>>().join("; "),
+        )
+    };
+    #[cfg(not(windows))]
+    let (gpu, gpu_driver) = (String::new(), String::new());
+
+    SystemInfo {
+        gpu,
+        gpu_driver,
+        cpu,
+        os,
+        streamer_version: alvr_common::ALVR_VERSION.to_string(),
+    }
+}
+
+/// Writes the report to Documents/PyroWave reports and returns the file's path. Refuses to write
+/// anything that still looks identifying.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn export(report: &Value) -> Result<std::path::PathBuf, String> {
+    let leftovers = find_identifying(report);
+    if !leftovers.is_empty() {
+        return Err(format!("not written, identifying data found: {}", leftovers.join(", ")));
+    }
+    let home = std::env::var_os("USERPROFILE")
+        .or_else(|| std::env::var_os("HOME"))
+        .ok_or("no home folder")?;
+    let dir = std::path::PathBuf::from(home)
+        .join("Documents")
+        .join("PyroWave reports");
+    std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+    let path = dir.join(format!(
+        "pyrowave-report-{}.json",
+        report["report_id"].as_str().unwrap_or("unknown")
+    ));
+    let text = serde_json::to_string_pretty(report).map_err(|e| e.to_string())?;
+    std::fs::write(&path, text).map_err(|e| e.to_string())?;
+    Ok(path)
+}
+
+pub fn new_report_id() -> String {
+    format!("{:016x}", rand::random::<u64>())
+}
