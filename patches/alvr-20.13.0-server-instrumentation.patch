diff --git a/alvr/server_openvr/cpp/alvr_server/BitstreamTap.cpp b/alvr/server_openvr/cpp/alvr_server/BitstreamTap.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6f9fe8fe4b19de20e593d572be66a36bebbb63b6
--- /dev/null
+++ b/alvr/server_openvr/cpp/alvr_server/BitstreamTap.cpp
@@ -0,0 +1,175 @@
+#include "BitstreamTap.h"
+
+#include "ALVR-common/packet_types.h"
+#include "Logger.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <mutex>
+#include <ctime>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+struct Record {
+    uint64_t pts;
+    bool idr;
+    std::vector<uint8_t> payload;
+};
+
+// Enough to ride out a slow disk without letting the queue become a second frame buffer: at
+// ~700 KB a frame and 72 fps this is about two seconds of stream and ~180 MB worst case.
+constexpr size_t kMaxQueued = 128;
+
+std::mutex g_mutex;
+std::condition_variable g_wake;
+std::deque<Record> g_queue;
+std::thread g_writer;
+bool g_running = false;
+uint64_t g_written = 0;
+uint64_t g_dropped = 0;
+FILE* g_stream = nullptr;
+FILE* g_index = nullptr;
+uint64_t g_offset = 0;
+std::string g_base;
+int g_codec = 0;
+int g_width = 0;
+int g_height = 0;
+
+const char* CodecSuffix(int codec) {
+    switch (codec) {
+    case ALVR_CODEC_H264:
+        return "h264";
+    case ALVR_CODEC_HEVC:
+        return "h265";
+    default:
+        return "av1";
+    }
+}
+
+// Called from the writer thread only, so it never delays Submit().
+bool EnsureOpen() {
+    if (g_stream) {
+        return true;
+    }
+    char stamp[32];
+    std::time_t now = std::time(nullptr);
+    std::strftime(stamp, sizeof(stamp), "%Y%m%d-%H%M%S", std::localtime(&now));
+    std::string stream_path = g_base + "-" + stamp + "." + CodecSuffix(g_codec);
+    std::string index_path = g_base + "-" + stamp + ".idx";
+    g_stream = fopen(stream_path.c_str(), "wb");
+    g_index = fopen(index_path.c_str(), "w");
+    if (!g_stream || !g_index) {
+        Warn("[TAP] could not open %s; tap disabled for this session\n", stream_path.c_str());
+        if (g_stream) { fclose(g_stream); g_stream = nullptr; }
+        if (g_index) { fclose(g_index); g_index = nullptr; }
+        return false;
+    }
+    fprintf(g_index, "# alvr-bitstream-tap v1 codec=%s width=%d height=%d\n",
+            CodecSuffix(g_codec), g_width, g_height);
+    fprintf(g_index, "pts_ns,offset,bytes,idr\n");
+    Info("[TAP] writing %s\n", stream_path.c_str());
+    return true;
+}
+
+void WriterLoop() {
+    for (;;) {
+        Record record;
+        {
+            std::unique_lock<std::mutex> lock(g_mutex);
+            g_wake.wait(lock, [] { return !g_queue.empty() || !g_running; });
+            if (g_queue.empty()) {
+                return; // stopped and drained
+            }
+            record = std::move(g_queue.front());
+            g_queue.pop_front();
+        }
+        // Written outside the lock so a slow disk never holds up Submit().
+        if (!EnsureOpen()) {
+            continue;
+        }
+        if (!record.payload.empty()) {
+            fwrite(record.payload.data(), 1, record.payload.size(), g_stream);
+        }
+        if (g_index) {
+            fprintf(g_index, "%llu,%llu,%zu,%d\n", (unsigned long long)record.pts,
+                    (unsigned long long)g_offset, record.payload.size(), record.idr ? 1 : 0);
+        }
+        g_offset += record.payload.size();
+        g_written++;
+        fflush(g_index); // the index is small; losing it to a crash would orphan the payload
+    }
+}
+
+}
+
+namespace BitstreamTap {
+
+void Start(int codec, int width, int height) {
+    const char* base = std::getenv("ALVR_BITSTREAM_TAP");
+    if (!base || !*base) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_running) {
+        return;
+    }
+    // Files are opened on the first frame, not here. A sweep restarts SteamVR twice per segment,
+    // and the last restart encodes nothing -- opening eagerly with "wb" truncated the capture the
+    // measurement had just produced. Nothing is created for a session that never encodes.
+    g_base = base;
+    g_codec = codec;
+    g_width = width;
+    g_height = height;
+    g_offset = 0;
+    g_written = 0;
+    g_dropped = 0;
+    g_running = true;
+    g_writer = std::thread(WriterLoop);
+}
+
+void Submit(uint64_t targetTimestampNs, bool isIdr, const uint8_t* data, int length) {
+    if (length <= 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (!g_running) {
+        return;
+    }
+    if (g_queue.size() >= kMaxQueued) {
+        g_dropped++; // never block the encoder; a hole in the capture is the lesser harm
+        return;
+    }
+    g_queue.push_back(Record { targetTimestampNs, isIdr, std::vector<uint8_t>(data, data + length) });
+    g_wake.notify_one();
+}
+
+void Stop() {
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (!g_running) {
+            return;
+        }
+        g_running = false;
+    }
+    g_wake.notify_all();
+    if (g_writer.joinable()) {
+        g_writer.join();
+    }
+    // Into the index rather than the log: ALVR's Info() goes to its event stream, which the
+    // benchmark's telemetry capture filters down to statistics, so a count logged there is
+    // invisible. A reader of the capture needs to know whether it is complete.
+    if (g_index) {
+        fprintf(g_index, "# frames=%llu dropped=%llu\n", (unsigned long long)g_written,
+                (unsigned long long)g_dropped);
+    }
+    if (g_stream) { fclose(g_stream); g_stream = nullptr; }
+    if (g_index) { fclose(g_index); g_index = nullptr; }
+}
+
+}
diff --git a/alvr/server_openvr/cpp/alvr_server/BitstreamTap.h b/alvr/server_openvr/cpp/alvr_server/BitstreamTap.h
new file mode 100644
index 0000000000000000000000000000000000000000..898e5ef6138279cfc8603ba9f2422a20b622bdc4
--- /dev/null
+++ b/alvr/server_openvr/cpp/alvr_server/BitstreamTap.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstdint>
+
+/// Writes the encoded stream to disk for offline analysis, off the encoder thread.
+///
+/// The benchmark needs to know what each frame cost and to decode the stream afterwards without
+/// capturing anything on the headset. Both come from the bytes NVENC already produced, so nothing
+/// needs to be re-encoded or re-measured -- they only need writing down.
+///
+/// Off the encoder thread matters: CEncoder::Run blocks the SteamVR presentation thread via
+/// WaitForEncode(), so any file I/O done inline in Transmit() delays the next frame and inflates
+/// the very latency numbers being collected. Submit() therefore only moves bytes into a bounded
+/// queue and returns; a writer thread drains it. If the queue fills, frames are dropped and
+/// counted rather than blocking the encoder -- a gap in the capture is recoverable, a stall in
+/// the pipeline corrupts the measurement.
+///
+/// Enabled by setting ALVR_BITSTREAM_TAP to an output path; absent, every call is a no-op.
+namespace BitstreamTap {
+
+/// Called once per stream. Safe to call when disabled.
+void Start(int codec, int width, int height);
+
+/// Queue one encoded access unit. Never blocks; drops when the queue is full.
+void Submit(uint64_t targetTimestampNs, bool isIdr, const uint8_t* data, int length);
+
+/// Flush and close. Logs how many frames were written and how many were dropped.
+void Stop();
+
+}
