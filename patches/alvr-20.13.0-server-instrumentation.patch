diff --git a/alvr/client_openxr/src/extra_extensions/eye_tracking_android.rs b/alvr/client_openxr/src/extra_extensions/eye_tracking_android.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0edb24d1e256970779597e318005052b717d3fa7
--- /dev/null
+++ b/alvr/client_openxr/src/extra_extensions/eye_tracking_android.rs
@@ -0,0 +1,176 @@
+//! `XR_ANDROID_eye_tracking` — Google's eye tracking for the Android XR runtime.
+//!
+//! ALVR's existing gaze path is `XR_EXT_eye_gaze_interaction`, which is an *action*: the runtime
+//! binds `/interaction_profiles/ext/eye_gaze_interaction` and the app reads a pose from an action
+//! space. On Galaxy XR that action never becomes active, with the extension enabled, the binding
+//! suggested without error, the permission granted, calibration done and eyes in the headset
+//! (measured). The same mechanism failed elsewhere too, see CheekyFoveatedDLSS#31.
+//!
+//! This extension has no actions, no interaction profile and no binding: create a tracker, then
+//! query poses per frame. That removes the entire layer that is failing, and it is the runtime
+//! vendor's own API.
+//!
+//! The `openxr` crate has no bindings for it, so the structures and entry points are declared
+//! here. The XrStructureType values follow the registry rule
+//! `1000000000 + 1000*(extension_number - 1) + offset` with extension number 457; the rule was
+//! checked against `XR_FB_eye_tracking_social`, whose values the crate does define.
+
+use openxr::{self as xr, sys};
+use std::{ffi::CString, mem, ptr};
+
+pub const ANDROID_EYE_TRACKING_EXTENSION_NAME: &str = "XR_ANDROID_eye_tracking";
+
+const TYPE_EYES: i32 = 1_000_456_000;
+const TYPE_EYE_TRACKER_CREATE_INFO: i32 = 1_000_456_001;
+const TYPE_EYES_GET_INFO: i32 = 1_000_456_002;
+const TYPE_SYSTEM_EYE_TRACKING_PROPERTIES: i32 = 1_000_456_004;
+
+const EYE_MAX: usize = 2;
+const EYE_STATE_GAZING: i32 = 1;
+
+#[repr(C)]
+struct EyeTrackerCreateInfo {
+    ty: sys::StructureType,
+    next: *const std::ffi::c_void,
+}
+
+#[repr(C)]
+struct EyesGetInfo {
+    ty: sys::StructureType,
+    next: *const std::ffi::c_void,
+    time: sys::Time,
+    base_space: sys::Space,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Eye {
+    eye_state: i32,
+    eye_pose: sys::Posef,
+}
+
+#[repr(C)]
+struct Eyes {
+    ty: sys::StructureType,
+    next: *mut std::ffi::c_void,
+    eyes: [Eye; EYE_MAX],
+    mode: i32,
+}
+
+#[repr(C)]
+struct SystemEyeTrackingProperties {
+    ty: sys::StructureType,
+    next: *mut std::ffi::c_void,
+    supports_eye_tracking: sys::Bool32,
+}
+
+type EyeTrackerHandle = u64;
+
+type CreateEyeTracker = unsafe extern "system" fn(
+    sys::Session,
+    *const EyeTrackerCreateInfo,
+    *mut EyeTrackerHandle,
+) -> sys::Result;
+type DestroyEyeTracker = unsafe extern "system" fn(EyeTrackerHandle) -> sys::Result;
+type GetEyesInfo = unsafe extern "system" fn(
+    EyeTrackerHandle,
+    *const EyesGetInfo,
+    *mut Eyes,
+) -> sys::Result;
+
+unsafe fn proc_addr(instance: &xr::Instance, name: &str) -> Option<sys::pfn::VoidFunction> {
+    let cname = CString::new(name).ok()?;
+    let mut f = None;
+    let get = instance.fp().get_instance_proc_addr;
+    if get(instance.as_raw(), cname.as_ptr(), &mut f).into_raw() < 0 {
+        return None;
+    }
+    f
+}
+
+pub struct EyeTrackerAndroid {
+    handle: EyeTrackerHandle,
+    get_fine: GetEyesInfo,
+    destroy: DestroyEyeTracker,
+}
+
+impl EyeTrackerAndroid {
+    /// None when the runtime does not advertise eye tracking, the entry points are missing, or
+    /// tracker creation fails — most often because EYE_TRACKING_FINE has not been granted.
+    pub fn new<G>(session: &xr::Session<G>, system: xr::SystemId) -> Option<Self> {
+        let instance = session.instance();
+
+        let mut props = SystemEyeTrackingProperties {
+            ty: sys::StructureType::from_raw(TYPE_SYSTEM_EYE_TRACKING_PROPERTIES),
+            next: ptr::null_mut(),
+            supports_eye_tracking: sys::FALSE,
+        };
+        let mut system_props =
+            sys::SystemProperties::out((&mut props as *mut SystemEyeTrackingProperties).cast());
+        let supported = unsafe {
+            (instance.fp().get_system_properties)(
+                instance.as_raw(),
+                system,
+                system_props.as_mut_ptr(),
+            )
+            .into_raw()
+                >= 0
+                && props.supports_eye_tracking.into()
+        };
+        if !supported {
+            return None;
+        }
+
+        let create: CreateEyeTracker =
+            unsafe { mem::transmute(proc_addr(instance, "xrCreateEyeTrackerANDROID")?) };
+        let get_fine: GetEyesInfo =
+            unsafe { mem::transmute(proc_addr(instance, "xrGetFineTrackingEyesInfoANDROID")?) };
+        let destroy: DestroyEyeTracker =
+            unsafe { mem::transmute(proc_addr(instance, "xrDestroyEyeTrackerANDROID")?) };
+
+        let info = EyeTrackerCreateInfo {
+            ty: sys::StructureType::from_raw(TYPE_EYE_TRACKER_CREATE_INFO),
+            next: ptr::null(),
+        };
+        let mut handle: EyeTrackerHandle = 0;
+        if unsafe { create(session.as_raw(), &info, &mut handle).into_raw() } < 0 {
+            return None;
+        }
+
+        Some(Self {
+            handle,
+            get_fine,
+            destroy,
+        })
+    }
+
+    /// Per-eye pupil poses, None per eye when that eye is not gazing (shut, or not tracked).
+    pub fn get_eye_poses(&self, base: &xr::Space, time: xr::Time) -> [Option<xr::Posef>; 2] {
+        let info = EyesGetInfo {
+            ty: sys::StructureType::from_raw(TYPE_EYES_GET_INFO),
+            next: ptr::null(),
+            time,
+            base_space: base.as_raw(),
+        };
+        let mut eyes = Eyes {
+            ty: sys::StructureType::from_raw(TYPE_EYES),
+            next: ptr::null_mut(),
+            eyes: [Eye {
+                eye_state: 0,
+                eye_pose: sys::Posef::IDENTITY,
+            }; EYE_MAX],
+            mode: 0,
+        };
+        if unsafe { (self.get_fine)(self.handle, &info, &mut eyes).into_raw() } < 0 {
+            return [None, None];
+        }
+        let pick = |e: &Eye| (e.eye_state == EYE_STATE_GAZING).then_some(e.eye_pose);
+        [pick(&eyes.eyes[0]), pick(&eyes.eyes[1])]
+    }
+}
+
+impl Drop for EyeTrackerAndroid {
+    fn drop(&mut self) {
+        unsafe { (self.destroy)(self.handle) };
+    }
+}
