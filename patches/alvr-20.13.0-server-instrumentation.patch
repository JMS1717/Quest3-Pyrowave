diff --git a/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.cpp b/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fc0632b8d79d66c79f6dbb3f6aaee8610b6687a7
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.cpp
@@ -0,0 +1,551 @@
+#ifdef ALVR_PYROWAVE
+
+#include "VideoEncoderPyroWave.h"
+
+#include "alvr_server/BitstreamTap.h"
+#include "alvr_server/Logger.h"
+#include "alvr_server/Settings.h"
+#include "alvr_server/Utils.h"
+#include "alvr_server/bindings.h"
+#include "d3d-render-utils/RenderUtils.h"
+
+#include <dxgi1_2.h>
+
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+
+#define PYRO_OR_THROW(call)                                                                        \
+    {                                                                                              \
+        pyrowave_result _r = (call);                                                               \
+        if (_r != PYROWAVE_SUCCESS)                                                                \
+            throw MakeException("%s failed: %d", #call, (int)_r);                                  \
+    }
+
+// PyroWave over UDP: the same resolved value the Rust side uses when it opens the socket
+// (dashboard transport, or the research override ALVR_PYROWAVE_UDP).
+static bool UdpEnabled() { return Settings::Instance().m_pyrowaveUdp; }
+
+// CDF 5/3 when the dashboard (or ALVR_PYROWAVE_WAVELET=53) asks for it; CDF 9/7 otherwise.
+// Carried to the client as byte 13 of the decoder config so both sides agree by construction.
+static bool Legall53() { return Settings::Instance().m_pyrowaveWavelet53; }
+
+VideoEncoderPyroWave::VideoEncoderPyroWave(
+    std::shared_ptr<CD3DRender> pD3DRender, int width, int height, ID3D11Texture2D* planes[3]
+)
+    : m_pD3DRender(pD3DRender)
+    , m_renderWidth(width)
+    , m_renderHeight(height)
+    , m_codec(Settings::Instance().m_codec) {
+    for (int i = 0; i < 3; i++) {
+        if (planes[i] == nullptr) {
+            throw MakeException("PyroWave requires the planar YCbCr textures; plane %d is null. "
+                                "FrameRender only builds them when the codec is PyroWave and HDR "
+                                "is off.",
+                                i);
+        }
+        m_planes[i] = planes[i];
+    }
+}
+
+VideoEncoderPyroWave::~VideoEncoderPyroWave() { Shutdown(); }
+
+void VideoEncoderPyroWave::Initialize() {
+    OK_OR_THROW(QUERY(m_pD3DRender->GetDevice(), m_device5.GetAddressOf()),
+                L"PyroWave needs ID3D11Device5 for shared fences.");
+    OK_OR_THROW(QUERY(m_pD3DRender->GetContext(), m_context4.GetAddressOf()),
+                L"PyroWave needs ID3D11DeviceContext4.");
+
+    // Match the Vulkan device to the adapter SteamVR is rendering on. Picking a different GPU
+    // would still "work" but every frame would cross the PCIe bus twice.
+    Microsoft::WRL::ComPtr<IDXGIDevice> dxgiDevice;
+    OK_OR_THROW(QUERY(m_pD3DRender->GetDevice(), dxgiDevice.GetAddressOf()), L"No IDXGIDevice.");
+    Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+    OK_OR_THROW(dxgiDevice->GetAdapter(&adapter), L"No IDXGIAdapter.");
+    DXGI_ADAPTER_DESC adapterDesc;
+    OK_OR_THROW(adapter->GetDesc(&adapterDesc), L"No adapter desc.");
+
+    static_assert(sizeof(LUID) == sizeof(pyrowave_luid), "LUID size mismatch");
+    PYRO_OR_THROW(pyrowave_create_device_by_compat(
+        0, 0, nullptr, nullptr, reinterpret_cast<pyrowave_luid*>(&adapterDesc.AdapterLuid),
+        &m_pyroDevice
+    ));
+
+    if (!pyrowave_device_confirm_interop_support(m_pyroDevice)) {
+        throw MakeException("PyroWave reports no external memory/semaphore interop on this GPU.");
+    }
+
+    // Import each plane. Three separate single-component images rather than one NV12 texture:
+    // importing 2-plane NV12 misreads chroma (~26 dB against 60 dB here), and each view must
+    // report its OWN extent -- see tools/pyrowave_d3d11/README.md.
+    for (int i = 0; i < 3; i++) {
+        Microsoft::WRL::ComPtr<IDXGIResource1> resource;
+        OK_OR_THROW(
+            QUERY(m_planes[i].Get(), resource.GetAddressOf()), L"Plane is not shareable."
+        );
+        HANDLE sharedHandle = nullptr;
+        OK_OR_THROW(
+            resource->CreateSharedHandle(nullptr, GENERIC_ALL, nullptr, &sharedHandle),
+            L"Failed to create a shared handle for a YCbCr plane."
+        );
+
+        D3D11_TEXTURE2D_DESC desc;
+        m_planes[i]->GetDesc(&desc);
+
+        VkImageCreateInfo imageInfo = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+        imageInfo.imageType = VK_IMAGE_TYPE_2D;
+        imageInfo.extent = { desc.Width, desc.Height, 1u };
+        imageInfo.mipLevels = 1;
+        imageInfo.arrayLayers = 1;
+        imageInfo.format = VK_FORMAT_R8_UNORM;
+        imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+        imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+        imageInfo.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT
+            | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+
+        pyrowave_image_create_info importInfo = {};
+        importInfo.device = m_pyroDevice;
+        importInfo.external_handle = (pyrowave_os_handle)sharedHandle;
+        importInfo.handle_type = VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_BIT;
+        importInfo.image_create_info = &imageInfo;
+        PYRO_OR_THROW(pyrowave_image_create(&importInfo, &m_pyroImages[i]));
+
+        // The aspect is ignored for single-component formats: the image is the plane.
+        PYRO_OR_THROW(pyrowave_image_get_image_view(
+            m_pyroImages[i], VK_IMAGE_ASPECT_PLANE_0_BIT, VK_IMAGE_USAGE_SAMPLED_BIT,
+            &m_pyroBuffers.planes[i]
+        ));
+    }
+
+    pyrowave_encoder_create_info encoderInfo = {};
+    encoderInfo.device = m_pyroDevice;
+    encoderInfo.width = m_renderWidth;
+    encoderInfo.height = m_renderHeight;
+    encoderInfo.chroma = PYROWAVE_CHROMA_SUBSAMPLING_444;
+    encoderInfo.wavelet = Legall53() ? PYROWAVE_WAVELET_CDF53 : PYROWAVE_WAVELET_CDF97;
+    PYRO_OR_THROW(pyrowave_encoder_create(&encoderInfo, &m_pyroEncoder));
+    Info("[PYROWAVE] wavelet CDF %s\n", Legall53() ? "5/3" : "9/7");
+
+    // What H.264 carries as SPS/PPS, PyroWave carries here: the client's DecoderConfig payload.
+    // Sent on the next RequestIdr, which the client issues as soon as it sees a frame it cannot
+    // place -- so this must be registered before the first frame goes out. Layout is
+    // alvr_client_core::video_decoder::parse_pyrowave_config: u32 w, u32 h, u8 chroma444,
+    // u8 full_range, little endian.
+    {
+        // ... u8 transport (1 = our UDP socket), u16 deadline_us (one frame period),
+        // u8 wavelet (0 = CDF 9/7, 1 = CDF 5/3), u8 headset decode path (0 auto, 1 fragment,
+        // 2 compute).
+        unsigned char cfg[15];
+        uint32_t w = (uint32_t)m_renderWidth, h = (uint32_t)m_renderHeight;
+        memcpy(cfg, &w, 4);
+        memcpy(cfg + 4, &h, 4);
+        cfg[8] = 1;  // this encoder is 4:4:4
+        cfg[9] = Settings::Instance().m_useFullRangeEncoding ? 1 : 0;
+        cfg[10] = UdpEnabled() ? 1 : 0;
+        const int fps = Settings::Instance().m_refreshRate > 0 ? Settings::Instance().m_refreshRate : 72;
+        const uint16_t deadlineUs = (uint16_t)(1000000 / fps);
+        memcpy(cfg + 11, &deadlineUs, 2);
+        cfg[13] = Legall53() ? 1 : 0;
+        cfg[14] = (unsigned char)Settings::Instance().m_pyrowaveDecodePath;
+        SetVideoConfigNals(cfg, sizeof cfg, 3 /* CodecType::PyroWave */);
+        static const char* kDecodePaths[] = { "auto", "fragment", "compute" };
+        const int path = Settings::Instance().m_pyrowaveDecodePath;
+        Info("[PYROWAVE] decoder config registered: %ux%u 4:4:4 %s range, %s, deadline %u us, "
+             "CDF %s, decode path %s\n",
+             w, h, cfg[9] ? "full" : "limited", cfg[10] ? "UDP" : "TCP", (unsigned)deadlineUs,
+             cfg[13] ? "5/3" : "9/7", (path >= 0 && path <= 2) ? kDecodePaths[path] : "auto");
+    }
+
+    OK_OR_THROW(
+        m_device5->CreateFence(0, D3D11_FENCE_FLAG_NONE, __uuidof(ID3D11Fence),
+                               (void**)m_fence.GetAddressOf()),
+        L"Failed to create the D3D11 fence ordering render before encode."
+    );
+    m_fenceEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    if (m_fenceEvent == nullptr) {
+        throw MakeException("Failed to create the fence event.");
+    }
+
+    // Ground-truth dump. The encoder's input is what we want to score against, in the codec's
+    // own colour space -- not a screen capture, which measures the compositor more than the codec
+    // (PSNR there rose as bitrate fell; see tools/xrbench notes on the still-capture path).
+    if (const char* dumpPath = std::getenv("ALVR_PYROWAVE_DUMP")) {
+        m_dumpPath = dumpPath;
+        m_dumpFrame = 120; // a couple of seconds in, past any black or loading frames
+        if (const char* n = std::getenv("ALVR_PYROWAVE_DUMP_FRAME")) {
+            m_dumpFrame = strtoull(n, nullptr, 10);
+        }
+        // Experiment 4 corpus: ALVR_PYROWAVE_DUMP_COUNT consecutive frames (every
+        // ALVR_PYROWAVE_DUMP_EVERY-th) appended as FRAMEs of one y4m, with a .frames.csv sidecar
+        // (index, target timestamp ns, encoded bytes) so a clip stays a temporal sequence.
+        m_dumpCount = 1;
+        if (const char* n = std::getenv("ALVR_PYROWAVE_DUMP_COUNT")) {
+            m_dumpCount = strtoull(n, nullptr, 10);
+            if (m_dumpCount < 1) m_dumpCount = 1;
+        }
+        m_dumpEvery = 1;
+        if (const char* n = std::getenv("ALVR_PYROWAVE_DUMP_EVERY")) {
+            m_dumpEvery = strtoull(n, nullptr, 10);
+            if (m_dumpEvery < 1) m_dumpEvery = 1;
+        }
+
+        EnsureDumpStaging();
+        Warn("[PYROWAVE] will dump encoder input to %s from frame %llu (%llu frames, every %llu)\n",
+              m_dumpPath.c_str(),
+              (unsigned long long)m_dumpFrame, (unsigned long long)m_dumpCount, (unsigned long long)m_dumpEvery);
+    }
+    // Experiment 5: runtime clip trigger. ALVR_PYROWAVE_DUMP_TRIGGER names a directory; when
+    // <dir>\trigger.txt appears (first line: "<path> <count>") a fresh clip of <count> consecutive
+    // frames is written to <path> starting at the next frame, and the trigger file is deleted.
+    // Polled every 8 frames so a worn session can take clips on demand without a SteamVR restart.
+    if (const char* trig = std::getenv("ALVR_PYROWAVE_DUMP_TRIGGER")) {
+        m_dumpTriggerDir = trig;
+        Warn("[PYROWAVE] dump trigger directory %s\n", m_dumpTriggerDir.c_str());
+    }
+
+    // Generous: 4:4:4 at a high bitrate cap still lands far under this, and the buffer is reused.
+    m_bitstream.resize((size_t)m_renderWidth * m_renderHeight * 3 / 2 + (1u << 20));
+
+    // Warn(): informational, so it goes to SteamVR's driver log (vrserver.txt) without the
+    // message box ALVR raises for every Error(); genuine failures below stay Error().
+    // Arm the bitstream tap. Without this Submit() silently discards everything, which is how
+    // the first live run produced a ground-truth dump and no bitstream to compare it against.
+    // The codec id is cosmetic here -- it only picks the capture's file extension, and a PyroWave
+    // stream is neither H.264 nor HEVC whatever it is called.
+    BitstreamTap::Start(m_codec, m_renderWidth, m_renderHeight);
+
+    Warn("[PYROWAVE] encoder ready: %dx%d 4:4:4, three imported R8 planes\n",
+         m_renderWidth,
+         m_renderHeight);
+}
+
+void VideoEncoderPyroWave::Shutdown() {
+    BitstreamTap::Stop();
+
+    if (m_pyroEncoder) {
+        pyrowave_encoder_destroy(m_pyroEncoder);
+        m_pyroEncoder = nullptr;
+    }
+    for (int i = 0; i < 3; i++) {
+        if (m_pyroImages[i]) {
+            pyrowave_image_destroy(m_pyroImages[i]);
+            m_pyroImages[i] = nullptr;
+        }
+    }
+    if (m_pyroDevice) {
+        pyrowave_device_destroy(m_pyroDevice);
+        m_pyroDevice = nullptr;
+    }
+    if (m_fenceEvent) {
+        CloseHandle(m_fenceEvent);
+        m_fenceEvent = nullptr;
+    }
+}
+
+void VideoEncoderPyroWave::EnsureDumpStaging() {
+    if (m_dumpStaging)
+        return;
+    D3D11_TEXTURE2D_DESC stagingDesc = {};
+    stagingDesc.Width = m_renderWidth;
+    stagingDesc.Height = m_renderHeight;
+    stagingDesc.MipLevels = 1;
+    stagingDesc.ArraySize = 1;
+    stagingDesc.Format = DXGI_FORMAT_R8_UNORM;
+    stagingDesc.SampleDesc.Count = 1;
+    stagingDesc.Usage = D3D11_USAGE_STAGING;
+    stagingDesc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    OK_OR_THROW(
+        m_pD3DRender->GetDevice()->CreateTexture2D(
+            &stagingDesc, nullptr, m_dumpStaging.GetAddressOf()
+        ),
+        L"Failed to create the plane dump staging texture."
+    );
+}
+
+void VideoEncoderPyroWave::PollDumpTrigger() {
+    const std::string trigger = m_dumpTriggerDir + "\\trigger.txt";
+    FILE* f = nullptr;
+    if (fopen_s(&f, trigger.c_str(), "r") != 0 || f == nullptr)
+        return;
+    char line[1024] = {};
+    if (!fgets(line, sizeof line, f)) {
+        fclose(f);
+        DeleteFileA(trigger.c_str());
+        return;
+    }
+    fclose(f);
+    DeleteFileA(trigger.c_str());
+    // "<path> <count>": the path is everything up to the last space.
+    std::string text(line);
+    while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' '))
+        text.pop_back();
+    size_t sp = text.find_last_of(' ');
+    if (sp == std::string::npos) {
+        Error("[PYROWAVE] bad trigger line: %s\n", text.c_str());
+        return;
+    }
+    m_dumpPath = text.substr(0, sp);
+    m_dumpCount = strtoull(text.c_str() + sp + 1, nullptr, 10);
+    if (m_dumpCount < 1) m_dumpCount = 1;
+    m_dumpEvery = 1;
+    m_dumpFrame = m_frameCount;
+    m_dumpedFrames = 0;
+    m_dumped = false;
+    EnsureDumpStaging();
+    Warn("[PYROWAVE] triggered dump of %llu frames to %s from frame %llu\n",
+          (unsigned long long)m_dumpCount, m_dumpPath.c_str(), (unsigned long long)m_dumpFrame);
+}
+
+// Writes the three planes as a 4:4:4 y4m, which is exactly what pyrowave-decode emits, so the
+// tapped bitstream can be decoded and scored against this with ffmpeg and nothing in between.
+void VideoEncoderPyroWave::DumpPlanes() {
+    FILE* out = nullptr;
+    const bool first = m_dumpedFrames == 0;
+    if (fopen_s(&out, m_dumpPath.c_str(), first ? "wb" : "ab") != 0 || out == nullptr) {
+        Error("[PYROWAVE] cannot open dump file %s\n", m_dumpPath.c_str());
+        return;
+    }
+
+    // XCOLORRANGE is NOT cosmetic, unlike the frame rate. Omitting it makes every tool default
+    // to limited range while the shader writes full-range BT.709, and ffmpeg then silently
+    // inserts a range conversion when comparing against a stream that declares FULL. That reads
+    // as a 29 dB luma loss -- lifted blacks and banding -- in an encoder that is actually exact.
+    // Declare what the data really is.
+    if (first) {
+        fprintf(out, "YUV4MPEG2 W%d H%d F%u:1 Ip A1:1 XCOLORRANGE=%s C444\n",
+                m_renderWidth,
+                m_renderHeight,
+                m_framerate ? m_framerate : 72u,
+                Settings::Instance().m_useFullRangeEncoding ? "FULL" : "LIMITED");
+    }
+    fprintf(out, "FRAME\n");
+
+    auto* context = m_pD3DRender->GetContext();
+    std::vector<uint8_t> planes[3];
+    for (int i = 0; i < 3; i++) {
+        planes[i].resize((size_t)m_renderWidth * m_renderHeight);
+        context->CopyResource(m_dumpStaging.Get(), m_planes[i].Get());
+        D3D11_MAPPED_SUBRESOURCE mapped;
+        if (FAILED(context->Map(m_dumpStaging.Get(), 0, D3D11_MAP_READ, 0, &mapped))) {
+            Error("[PYROWAVE] failed to map plane %d for dump\n", i);
+            fclose(out);
+            return;
+        }
+        const uint8_t* src = static_cast<const uint8_t*>(mapped.pData);
+        for (int row = 0; row < m_renderHeight; row++) {
+            const uint8_t* line = src + (size_t)row * mapped.RowPitch;
+            fwrite(line, 1, (size_t)m_renderWidth, out);
+            memcpy(planes[i].data() + (size_t)row * m_renderWidth, line, (size_t)m_renderWidth);
+        }
+        context->Unmap(m_dumpStaging.Get(), 0);
+    }
+
+    fclose(out);
+    m_dumpedFrames++;
+    {
+        FILE* idx = nullptr;
+        if (fopen_s(&idx, (m_dumpPath + ".frames.csv").c_str(), first ? "wb" : "ab") == 0 && idx) {
+            if (first) fprintf(idx, "dump_index,frame_count,target_timestamp_ns\n");
+            fprintf(idx, "%llu,%llu,%llu\n", (unsigned long long)(m_dumpedFrames - 1),
+                    (unsigned long long)m_frameCount, (unsigned long long)m_dumpTimestampNs);
+            fclose(idx);
+        }
+    }
+    if (!first)
+        return;   // the CPU-path cross-check below is only meaningful once, on the first frame
+
+    // Same bytes, same device, same encoder, different entry point. If this scores well and the
+    // GPU path does not, the fault is in how the imported images are read rather than in the
+    // encoder, the rate control or the data.
+    {
+        pyrowave_cpu_buffer cpu = {};
+        for (int i = 0; i < 3; i++) {
+            cpu.data[i] = planes[i].data();
+            cpu.row_stride_in_bytes[i] = (size_t)m_renderWidth;
+            cpu.plane_size_in_bytes[i] = (size_t)m_renderWidth * m_renderHeight;
+        }
+        cpu.width = m_renderWidth;
+        cpu.height = m_renderHeight;
+        cpu.format = PYROWAVE_CPU_BUFFER_FORMAT_YUV444P;
+
+        pyrowave_rate_control rc = {};
+        rc.maximum_bitstream_size = m_bitrateBps && m_framerate
+            ? (size_t)(m_bitrateBps / 8 / m_framerate)
+            : (size_t)1041664;
+
+        if (pyrowave_encoder_encode_cpu_synchronous(m_pyroEncoder, &cpu, &rc)
+            == PYROWAVE_SUCCESS) {
+            size_t n = 0;
+            pyrowave_encoder_compute_num_packets(m_pyroEncoder, m_bitstream.size(), &n);
+            std::vector<pyrowave_packet> packets(n ? n : 1);
+            size_t outCount = 0;
+            if (pyrowave_encoder_packetize(m_pyroEncoder, packets.data(), m_bitstream.size(),
+                                           &outCount, m_bitstream.data(), m_bitstream.size())
+                    == PYROWAVE_SUCCESS
+                && outCount > 0) {
+                std::string wavePath = m_dumpPath + ".cpu.wave";
+                FILE* wave = nullptr;
+                if (fopen_s(&wave, wavePath.c_str(), "wb") == 0 && wave) {
+                    const int32_t params[8] = { m_renderWidth, m_renderHeight, 1, 1,
+                                                Settings::Instance().m_useFullRangeEncoding ? 1 : 0,
+                                                (int32_t)(m_framerate ? m_framerate : 72), 1, 0 };
+                    fwrite("PYROWAVE", 1, 8, wave);
+                    fwrite(params, sizeof(params), 1, wave);
+                    const uint32_t size32 = (uint32_t)packets[0].size;
+                    fwrite(&size32, sizeof(size32), 1, wave);
+                    fwrite(m_bitstream.data() + packets[0].offset, 1, packets[0].size, wave);
+                    fclose(wave);
+                    Warn("[PYROWAVE] CPU-path control written: %s (%zu bytes)\n",
+                          wavePath.c_str(), packets[0].size);
+                }
+            }
+        } else {
+            Error("[PYROWAVE] CPU-path control encode failed\n");
+        }
+    }
+
+    Warn("[PYROWAVE] dumped encoder input (%dx%d 4:4:4) to %s at frame %llu\n",
+          m_renderWidth,
+          m_renderHeight,
+          m_dumpPath.c_str(),
+          (unsigned long long)m_frameCount);
+}
+
+void VideoEncoderPyroWave::Transmit(
+    ID3D11Texture2D* /*pTexture*/,
+    uint64_t /*presentationTime*/,
+    uint64_t targetTimestampNs,
+    bool insertIDR
+) {
+    // pTexture is deliberately unused: FrameRender has already rendered the three YCbCr planes
+    // this encoder imported, as part of the same frame's render.
+
+    auto params = GetDynamicEncoderParams();
+    if (params.updated) {
+        m_bitrateBps = params.bitrate_bps;
+        m_framerate = (uint32_t)params.framerate;
+    }
+    if (m_bitrateBps == 0 || m_framerate == 0) {
+        // Nothing to target yet; dropping the frame beats encoding at an arbitrary rate.
+        return;
+    }
+
+    // PyroWave's rate control is a hard per-frame byte cap rather than an average, which suits an
+    // intra-only codec: every frame is independent, so there is no rate buffer to drain.
+    pyrowave_rate_control rateControl = {};
+    rateControl.maximum_bitstream_size = (size_t)(m_bitrateBps / 8 / m_framerate);
+
+    // Order the D3D11 render before the Vulkan read. A shared fence imported as a timeline
+    // semaphore would avoid the CPU round trip; this is the simpler correct version, and the
+    // encode itself is ~0.25 ms so the wait dominates neither.
+    if (FAILED(m_context4->Signal(m_fence.Get(), ++m_fenceValue))) {
+        Error("[PYROWAVE] fence signal failed\n");
+        return;
+    }
+    m_pD3DRender->GetContext()->Flush();
+    if (FAILED(m_fence->SetEventOnCompletion(m_fenceValue, m_fenceEvent))) {
+        Error("[PYROWAVE] SetEventOnCompletion failed\n");
+        return;
+    }
+    WaitForSingleObject(m_fenceEvent, INFINITE);
+
+    if (!m_dumpTriggerDir.empty() && (m_frameCount % 8) == 0)
+        PollDumpTrigger();
+    if (!m_dumpPath.empty() && !m_dumped && m_frameCount >= m_dumpFrame &&
+        (m_frameCount - m_dumpFrame) % m_dumpEvery == 0) {
+        m_dumpTimestampNs = targetTimestampNs;
+        DumpPlanes();
+        if (m_dumpedFrames >= m_dumpCount) {
+            m_dumped = true;
+            Warn("[PYROWAVE] dumped %llu frames to %s\n", (unsigned long long)m_dumpedFrames, m_dumpPath.c_str());
+        }
+    }
+
+    // Imported images get an explicit ownership acquire/release, which is what the API asks for
+    // and what PyroWave needs in order to barrier them -- it performs no layout transitions of
+    // its own in the GPU paths. No semaphore: the fence above already ordered this.
+    pyrowave_gpu_external_reference refs[3] = {
+        { m_pyroImages[0], VK_QUEUE_FAMILY_EXTERNAL },
+        { m_pyroImages[1], VK_QUEUE_FAMILY_EXTERNAL },
+        { m_pyroImages[2], VK_QUEUE_FAMILY_EXTERNAL },
+    };
+    pyrowave_gpu_sync_operation acquire = {};
+    acquire.images = refs;
+    acquire.num_images = 3;
+    pyrowave_gpu_sync_operation release = acquire;
+
+    pyrowave_result encoded = pyrowave_encoder_encode_gpu_synchronous(
+        m_pyroEncoder, &acquire, &release, &m_pyroBuffers, &rateControl
+    );
+    if (encoded != PYROWAVE_SUCCESS) {
+        Error("[PYROWAVE] encode failed: %d\n", (int)encoded);
+        return;
+    }
+
+    // TCP: one packet for the whole frame, ALVR shards it. UDP: MTU-sized packets from PyroWave's
+    // own packetizer, each independently decodable, one datagram each -- the whole point.
+    const size_t packetBoundary = UdpEnabled() ? 1368 /* alvr_packets::PYROWAVE_UDP_PAYLOAD: 1400 - 32-byte header */ : m_bitstream.size();
+    size_t numPackets = 0;
+    if (pyrowave_encoder_compute_num_packets(m_pyroEncoder, packetBoundary, &numPackets)
+        != PYROWAVE_SUCCESS) {
+        Error("[PYROWAVE] compute_num_packets failed\n");
+        return;
+    }
+    std::vector<pyrowave_packet> packets(numPackets ? numPackets : 1);
+    size_t outPackets = 0;
+    if (pyrowave_encoder_packetize(
+            m_pyroEncoder, packets.data(), packetBoundary, &outPackets, m_bitstream.data(),
+            m_bitstream.size()
+        )
+        != PYROWAVE_SUCCESS) {
+        Error("[PYROWAVE] packetize failed\n");
+        return;
+    }
+
+    for (size_t i = 0; i < outPackets; i++) {
+        uint8_t* buf = m_bitstream.data() + packets[i].offset;
+        int len = (int)packets[i].size;
+
+        if (UdpEnabled()) {
+            VideoSendUdp(
+                targetTimestampNs,
+                (unsigned)i,
+                (unsigned)outPackets,
+                buf,
+                len,
+                AppliedFoveationCenterX().load(std::memory_order_relaxed),
+                AppliedFoveationCenterY().load(std::memory_order_relaxed),
+                AppliedFoveationCenterRightX().load(std::memory_order_relaxed),
+                AppliedFoveationCenterRightY().load(std::memory_order_relaxed)
+            );
+            BitstreamTap::Submit(targetTimestampNs, insertIDR, buf, len);
+            continue;
+        }
+
+        // Straight to VideoSend: ParseFrameNals only exists to pull SPS/PPS out of an H.264 or
+        // HEVC stream, and a PyroWave bitstream has neither.
+        VideoSend(
+            targetTimestampNs,
+            buf,
+            len,
+            insertIDR,
+            AppliedFoveationCenterX().load(std::memory_order_relaxed),
+            AppliedFoveationCenterY().load(std::memory_order_relaxed),
+            AppliedFoveationCenterRightX().load(std::memory_order_relaxed),
+            AppliedFoveationCenterRightY().load(std::memory_order_relaxed)
+        );
+
+        BitstreamTap::Submit(targetTimestampNs, insertIDR, buf, len);
+    }
+
+    if (m_frameCount == 0 && outPackets > 0) {
+        Warn("[PYROWAVE] first frame: %zu packet(s), %zu bytes, cap %zu\n",
+             outPackets,
+             packets[0].size,
+             rateControl.maximum_bitstream_size);
+    }
+    m_frameCount++;
+}
+
+#endif
diff --git a/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.h b/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.h
new file mode 100644
index 0000000000000000000000000000000000000000..a0356d3dd4231a40ffe4b1bce4fb9b1427528aeb
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#ifdef ALVR_PYROWAVE
+
+#include "VideoEncoder.h"
+#include "shared/d3drender.h"
+#include <d3d11_4.h>
+#include <memory>
+#include <string>
+#include <vector>
+#include <wrl.h>
+
+// pyrowave.h hard-errors unless the Vulkan headers are already in scope.
+#include <vulkan/vulkan.h>
+
+#include "pyrowave.h"
+
+// Video encoder backed by PyroWave: an intra-only wavelet codec running in Vulkan compute.
+//
+// Why it exists: on the Galaxy XR the hardware H.264 decoder takes 14.8-18.9 ms per frame and
+// HEVC takes 82 ms, while PyroWave decodes the same frame in 2.67 ms. On the RTX 3090 it encodes
+// in 0.25 ms against NVENC's 9-11 ms. That is ~23 ms out of a pipeline whose best measured total
+// was 89 ms against a 60 ms target.
+//
+// Unlike the other encoders this one does not consume the composited RGB texture. FrameRender
+// renders three full-resolution YCbCr planes (4:4:4) into shared textures, and this imports those
+// directly as Vulkan images -- no colour conversion or copy here. 4:4:4 because PyroWave can
+// afford it (~1.5x decode) and it removes chroma subsampling as a loss term entirely.
+class VideoEncoderPyroWave : public VideoEncoder {
+public:
+    VideoEncoderPyroWave(
+        std::shared_ptr<CD3DRender> pD3DRender,
+        int width,
+        int height,
+        ID3D11Texture2D* planes[3]
+    );
+    ~VideoEncoderPyroWave();
+
+    void Initialize();
+    void Shutdown();
+
+    void Transmit(
+        ID3D11Texture2D* pTexture,
+        uint64_t presentationTime,
+        uint64_t targetTimestampNs,
+        bool insertIDR
+    );
+
+private:
+    std::shared_ptr<CD3DRender> m_pD3DRender;
+    int m_renderWidth;
+    int m_renderHeight;
+
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> m_planes[3];
+    Microsoft::WRL::ComPtr<ID3D11Device5> m_device5;
+    Microsoft::WRL::ComPtr<ID3D11DeviceContext4> m_context4;
+    Microsoft::WRL::ComPtr<ID3D11Fence> m_fence;
+    HANDLE m_fenceEvent = nullptr;
+    uint64_t m_fenceValue = 0;
+
+    pyrowave_device m_pyroDevice = nullptr;
+    pyrowave_encoder m_pyroEncoder = nullptr;
+    pyrowave_image m_pyroImages[3] = {};
+    pyrowave_gpu_buffers m_pyroBuffers = {};
+
+    // One-shot ground-truth dump of the encoder's actual input, for closed-loop quality checks.
+    void DumpPlanes();
+    void EnsureDumpStaging();
+    void PollDumpTrigger();
+    std::string m_dumpTriggerDir;   // Experiment 5 runtime clip trigger
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> m_dumpStaging;
+    std::string m_dumpPath;
+    uint64_t m_dumpFrame = 0;
+    bool m_dumped = false;
+    uint64_t m_dumpCount = 1;       // Experiment 4 clip dump
+    uint64_t m_dumpEvery = 1;
+    uint64_t m_dumpedFrames = 0;
+    uint64_t m_dumpTimestampNs = 0;
+
+    // Only picks the capture file's extension; PyroWave is neither H.264 nor HEVC.
+    int m_codec = 0;
+
+    std::vector<uint8_t> m_bitstream;
+    uint64_t m_bitrateBps = 0;
+    uint32_t m_framerate = 0;
+    uint64_t m_frameCount = 0;
+};
+
+#endif
diff --git a/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.cpp b/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..89d30532a07ee262ce254e00642b4502f4a5f718
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.cpp
@@ -0,0 +1,107 @@
+#include "RenderPipelinePlanar.h"
+
+namespace d3d_render_utils {
+
+RenderPipelinePlanar::RenderPipelinePlanar(ID3D11Device* device) {
+    mDevice = device;
+    mDevice->GetImmediateContext(&mImmediateContext);
+}
+
+void RenderPipelinePlanar::Initialize(
+    std::vector<ID3D11Texture2D*> inputTextures,
+    ID3D11VertexShader* quadVertexShader,
+    std::vector<uint8_t>& pixelShaderCSO,
+    ID3D11Texture2D* renderTargets[3],
+    ID3D11Buffer* shaderBuffer
+) {
+    mInputTextureViews.clear();
+    for (auto tex : inputTextures) {
+        ID3D11ShaderResourceView* resourceView;
+        OK_OR_THROW(
+            mDevice->CreateShaderResourceView(tex, nullptr, &resourceView),
+            "Failed to create input texture resource view."
+        );
+        mInputTextureViews.push_back(resourceView);
+    }
+
+    D3D11_TEXTURE2D_DESC firstDesc = {};
+    for (int i = 0; i < 3; i++) {
+        OK_OR_THROW(
+            mDevice->CreateRenderTargetView(renderTargets[i], nullptr, &mRenderTargetViews[i]),
+            "Failed to create plane ID3D11RenderTargetView."
+        );
+
+        D3D11_TEXTURE2D_DESC desc;
+        renderTargets[i]->GetDesc(&desc);
+        if (i == 0) {
+            firstDesc = desc;
+        } else if (desc.Width != firstDesc.Width || desc.Height != firstDesc.Height) {
+            // D3D11 requires every bound target to share dimensions, and silently clipping to the
+            // smallest would corrupt whichever plane is larger.
+            throw MakeException(
+                "Planar render targets must match: plane 0 is %ux%u, plane %d is %ux%u",
+                firstDesc.Width,
+                firstDesc.Height,
+                i,
+                desc.Width,
+                desc.Height
+            );
+        }
+    }
+
+    mViewport.Width = (FLOAT)firstDesc.Width;
+    mViewport.Height = (FLOAT)firstDesc.Height;
+    mViewport.MinDepth = 0.0f;
+    mViewport.MaxDepth = 1.0f;
+    mViewport.TopLeftX = 0.0f;
+    mViewport.TopLeftY = 0.0f;
+
+    mShaderBuffer = shaderBuffer;
+    mVertexShader = quadVertexShader;
+    mPixelShader = CreatePixelShader(mDevice.Get(), pixelShaderCSO);
+
+    // Plain overwrite. The planes are fully written every frame, so there is nothing to blend
+    // with, and each target carries one channel.
+    D3D11_BLEND_DESC blendDesc = { 0 };
+    for (int i = 0; i < 3; i++) {
+        blendDesc.RenderTarget[i].BlendEnable = FALSE;
+        blendDesc.RenderTarget[i].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    }
+    blendDesc.IndependentBlendEnable = TRUE;
+    OK_OR_THROW(
+        mDevice->CreateBlendState(&blendDesc, &mBlendState), "Failed to create blend state."
+    );
+}
+
