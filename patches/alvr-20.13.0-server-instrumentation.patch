+            p.step(Duration::from_millis(8), Duration::from_millis(36));
+        }
+        assert_eq!(p.shift_total_us, 3000, "ten early frames, each clamped to +300 us");
+        let s = p.step(Duration::ZERO, Duration::from_millis(30));
+        assert_eq!(s, -300, "lead fell 6 ms below its 36 ms reference: late, move earlier");
+    }
+}
diff --git a/alvr/server_core/src/tracking/mod.rs b/alvr/server_core/src/tracking/mod.rs
index a70cfc5774b3aef190f891c44a33b9d6f9dd28f7..64f93a6fd54e90b50e5382e09f539f4cefa7817f 100644
--- a/alvr/server_core/src/tracking/mod.rs
+++ b/alvr/server_core/src/tracking/mod.rs
@@ -302,6 +302,8 @@ impl TrackingManager {
             face_data.eye_gazes[1].map(|e| self.last_head_pose.inverse() * self.recenter_pose(e)),
         ];
 
+        gaze_arrival_diag(&face_data.eye_gazes);
+
         self.last_face_data = face_data;
     }
 
@@ -563,3 +565,98 @@ pub fn tracking_loop(
         }
     }
 }
+
+/// Proof that client gaze reaches the server, in the form foveation will consume -- and how stale
+/// it is by the time the frame it steers is displayed.
+///
+/// Logged at `error!` on purpose. ALVR's `info!` goes to the event stream, which the benchmark's
+/// telemetry capture filters down to statistics, so anything below error level is invisible during
+/// a sweep; `error!` reaches `crash_log.txt`, which persists as a file. The frame counter keeps
+/// every line unique.
+///
+/// Yaw/pitch rather than the raw quaternion, because that is what a foveation centre actually
+/// needs -- these are what `FoveationVars`' `center_shift` is driven from in 2d. Gaze is already
+/// head-local by this point, so forward is -Z and the angles are the offset from straight ahead.
+///
+/// **Staleness.** Gaze rides in the same `target_timestamp`-keyed `Tracking` packet that drives
+/// the rendered frame, so the gaze steering a frame is exactly one pipeline latency old when that
+/// frame is displayed. Rather than assume how far an eye travels in that time, this measures it:
+/// each frame it compares the current angle against the one `GAZE_LAG_FRAMES` ago and accumulates
+/// the angular displacement, reporting the distribution once a second. That number is what decides
+/// whether 2d needs gaze prediction or merely a generous centre region.
+const GAZE_LAG_FRAMES: usize = 6; // ~83 ms at 72 Hz -- the measured mean total pipeline latency
+
+#[derive(Default)]
+struct GazeLag {
+    /// (yaw_deg, pitch_deg), newest last, capped at GAZE_LAG_FRAMES + 1.
+    history: VecDeque<(f32, f32)>,
+    /// Angular displacement in degrees over GAZE_LAG_FRAMES, one per frame, whole run.
+    displacements: Vec<f32>,
+}
+
+static GAZE_LAG: alvr_common::once_cell::sync::Lazy<Mutex<GazeLag>> =
+    alvr_common::once_cell::sync::Lazy::new(|| Mutex::new(GazeLag::default()));
+
+fn percentile(sorted: &[f32], pct: f32) -> f32 {
+    if sorted.is_empty() {
+        return f32::NAN;
+    }
+    let pos = (sorted.len() - 1) as f32 * pct / 100.0;
+    let low = pos.floor() as usize;
+    let high = (low + 1).min(sorted.len() - 1);
+    sorted[low] + (sorted[high] - sorted[low]) * (pos - low as f32)
+}
+
+fn gaze_arrival_diag(eye_gazes: &[Option<Pose>; 2]) {
+    use std::sync::atomic::{AtomicU64, Ordering as AtomicOrdering};
+    static TICK: AtomicU64 = AtomicU64::new(0);
+
+    let tick = TICK.fetch_add(1, AtomicOrdering::Relaxed);
+
+    let Some(pose) = eye_gazes[0].or(eye_gazes[1]) else {
+        if tick % 72 == 0 {
+            alvr_common::error!("[GAZE-SRV] frame {tick}: no gaze in FaceData");
+        }
+        return;
+    };
+
+    let dir = pose.orientation * Vec3::NEG_Z;
+    let yaw_deg = dir.x.atan2(-dir.z).to_degrees();
+    let pitch_deg = dir.y.clamp(-1.0, 1.0).asin().to_degrees();
+
+    let mut lag = GAZE_LAG.lock();
+
+    // Displacement against the sample one pipeline latency ago, before pushing the new one.
+    if lag.history.len() > GAZE_LAG_FRAMES {
+        let (old_yaw, old_pitch) = lag.history[lag.history.len() - 1 - GAZE_LAG_FRAMES];
+        let displacement = ((yaw_deg - old_yaw).powi(2) + (pitch_deg - old_pitch).powi(2)).sqrt();
+        lag.displacements.push(displacement);
+    }
+
+    lag.history.push_back((yaw_deg, pitch_deg));
+    while lag.history.len() > GAZE_LAG_FRAMES + 1 {
+        lag.history.pop_front();
+    }
+
+    if tick % 72 != 0 {
+        return;
+    }
+
+    let mut sorted = lag.displacements.clone();
+    sorted.sort_by(|a, b| a.partial_cmp(b).unwrap_or(Ordering::Equal));
+    let (p50, p95, max, n) = (
+        percentile(&sorted, 50.0),
+        percentile(&sorted, 95.0),
+        sorted.last().copied().unwrap_or(f32::NAN),
+        sorted.len(),
+    );
+    drop(lag);
+
+    alvr_common::error!(
+        "[GAZE-SRV] frame {tick}: yaw {yaw_deg:+.1} pitch {pitch_deg:+.1} \
+         (left {} right {}) | lag over {GAZE_LAG_FRAMES} frames: \
+         p50 {p50:.1} p95 {p95:.1} max {max:.1} deg (n={n})",
+        eye_gazes[0].is_some(),
+        eye_gazes[1].is_some(),
+    );
+}
