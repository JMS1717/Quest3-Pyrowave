@@ -0,0 +1,382 @@
+//! PyroWave over UDP: our own socket, straight into the decoder.
+//!
+//! One thread owns the socket and the decoder, so every Vulkan call and every packet push stays
+//! on one thread. Datagrams are read in batches (`recvmmsg` with `MSG_WAITFORONE`: return as soon
+//! as one is there -- without that flag the call waits for the whole batch and every frame's
+//! tail arrives a frame late, measured) and pushed into PyroWave one by one; the codec
+//! sequences frames itself. A frame is decoded the moment PyroWave reports it complete. A frame
+//! still incomplete one deadline after its first datagram is decoded partial (missing blocks
+//! blur) or dropped if nothing usable arrived; a newer frame arriving first supersedes it the
+//! same way. Nothing is ever retransmitted.
+use super::{
+    dist, frame_decision, parse_pyrowave_config, skip_for_newer, FrameDecision, FrameSlot,
+    PyroWaveConfig, VideoDecoderConfig,
+};
+use alvr_common::{
+    anyhow::{anyhow, Result},
+    info,
+};
+use alvr_packets::{PyroWavePacketHeader, PYROWAVE_UDP_HEADER_LEN, PYROWAVE_UDP_PORT};
+use std::{
+    collections::VecDeque,
+    ffi::{c_void, CString},
+    net::UdpSocket,
+    os::fd::AsRawFd,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    thread::{self, JoinHandle},
+    time::{Duration, Instant},
+};
+
+#[repr(C)]
+struct PyroClient {
+    _private: [u8; 0],
+}
+
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct FrameInfo {
+    decode_ms: f64,
+    convert_ms: f64,
+    total_ms: f64,
+    complete: i32,
+}
+
+extern "C" {
+    fn pyroclient_create_ex(width: u32, height: u32, chroma444: i32, full_range: i32, ring: u32, wavelet: i32, decode_path: i32) -> *mut PyroClient;
+    fn pyroclient_push_packet(c: *mut PyroClient, data: *const u8, size: usize) -> i32;
+    fn pyroclient_decode(c: *mut PyroClient, out: *mut *mut c_void, info: *mut FrameInfo) -> i32;
+    fn pyroclient_clear(c: *mut PyroClient);
+    fn pyroclient_destroy(c: *mut PyroClient);
+}
+
+/// The TCP video stream carries nothing in this mode; anything that does arrive is ignored.
+pub struct VideoDecoderSink;
+
+impl VideoDecoderSink {
+    pub fn push_frame_nal(&mut self, _timestamp: Duration, _data: &[u8]) -> Result<bool> {
+        Ok(true)
+    }
+}
+
+pub struct VideoDecoderSource {
+    running: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+    decoded: Arc<FrameSlot>,
+}
+
+impl VideoDecoderSource {
+    pub fn dequeue_frame(&mut self) -> Option<(Duration, *mut c_void)> {
+        self.decoded.take().map(|(ts, ptr)| (ts, ptr as *mut c_void))
+    }
+}
+
+impl Drop for VideoDecoderSource {
+    fn drop(&mut self) {
+        self.running.store(false, Ordering::Relaxed);
+        if let Some(t) = self.thread.take() {
+            t.join().ok();
+        }
+    }
+}
+
+/// Straight to logcat. Once the ALVR connection is up, the client's `info!` lines are forwarded
+/// to the server and never reach logcat, which is how two runs went by with the receiver's
+/// counters invisible. These are the lines the harness keeps per segment.
+#[cfg(target_os = "android")]
+fn alog(msg: &str) {
+    extern "C" {
+        fn __android_log_write(prio: i32, tag: *const std::ffi::c_char, text: *const std::ffi::c_char) -> i32;
+    }
+    let tag = CString::new("PYROWAVE-UDP").unwrap();
+    let text = CString::new(msg).unwrap_or_default();
+    unsafe { __android_log_write(4 /* ANDROID_LOG_INFO */, tag.as_ptr(), text.as_ptr()) };
+}
+#[cfg(not(target_os = "android"))]
+fn alog(msg: &str) {
+    info!("[PYROWAVE-UDP] {msg}");
+}
+
+fn recv(fd: i32, msgs: &mut [libc::mmsghdr], flags: i32) -> isize {
+    unsafe {
+        libc::recvmmsg(fd, msgs.as_mut_ptr(), msgs.len() as libc::c_uint, flags, std::ptr::null_mut()) as isize
+    }
+}
+
+const BATCH: usize = 64;
+const DATAGRAM: usize = 2048;
+const SOCKET_RECV_BUFFER: libc::c_int = 16 << 20;
+
+/// The frame being assembled.
+struct Pending {
+    timestamp_ns: u64,
+    first_seen: Instant,
+    count: u16,
+    received: u32,
+    decodable: bool,
+}
+
+#[derive(Default)]
+struct Counters {
+    complete: u64,
+    partial: u64,
+    dropped: u64,
+    superseded: u64,
+    /// Complete frames thrown away because a newer one was already queued behind them.
+    skipped: u64,
+    stale_packets: u64,
+    foreign: u64,
+    decode_failures: u64,
+    total_ms: f64,
+    last: FrameInfo,
+    /// Per-frame GPU timings since the last report, for the distribution line.
+    decode_samples: Vec<f32>,
+    convert_samples: Vec<f32>,
+    fence_samples: Vec<f32>,
+    /// Frame count at the last report, so a loop iteration that completes no frame does not
+    /// print the same report again (it did: every 720th count was logged ~100 times).
+    last_report_frames: u64,
+}
+
+
+fn open_socket() -> Result<UdpSocket> {
+    let socket = UdpSocket::bind(("0.0.0.0", PYROWAVE_UDP_PORT))?;
+    unsafe {
+        let v = SOCKET_RECV_BUFFER;
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_RCVBUF,
+            &v as *const _ as *const c_void,
+            std::mem::size_of_val(&v) as libc::socklen_t,
+        );
+    }
+    // Short timeout so the deadline tick runs even when nothing arrives.
+    socket.set_read_timeout(Some(Duration::from_millis(2)))?;
+    Ok(socket)
+}
+
+pub fn video_decoder_split(
+    config: VideoDecoderConfig,
+    report_frame_decoded: impl Fn(Result<Duration>) + Send + Sync + 'static,
+    report_video_packet_received: impl Fn(Duration) + Send + Sync + 'static,
+) -> Result<(VideoDecoderSink, VideoDecoderSource)> {
+    let cfg: PyroWaveConfig = parse_pyrowave_config(&config.config_buffer)?;
+    let decoded = Arc::new(FrameSlot::default());
+    let running = Arc::new(AtomicBool::new(true));
+
+    let thread = thread::spawn({
+        let decoded = Arc::clone(&decoded);
+        let running = Arc::clone(&running);
+        move || {
+            let socket = match open_socket() {
+                Ok(s) => s,
+                Err(e) => {
+                    report_frame_decoded(Err(anyhow!("PyroWave UDP socket: {e}")));
+                    return;
+                }
+            };
+            let client = unsafe {
+                pyroclient_create_ex(cfg.width, cfg.height, cfg.chroma444 as i32, cfg.full_range as i32, 3, cfg.wavelet as i32, cfg.decode_path as i32)
+            };
+            if client.is_null() {
+                report_frame_decoded(Err(anyhow!("pyroclient_create_ex failed (see logcat pyroclient)")));
+                return;
+            }
+            alog(&format!(
+                "listening on {PYROWAVE_UDP_PORT}, {}x{}, deadline {:?}, CDF {}",
+                cfg.width, cfg.height, cfg.deadline, cfg.wavelet
+            ));
+
+            let fd = socket.as_raw_fd();
+            let mut bufs = vec![[0u8; DATAGRAM]; BATCH];
+            let mut iovs: Vec<libc::iovec> = bufs
+                .iter_mut()
+                .map(|b| libc::iovec { iov_base: b.as_mut_ptr() as *mut c_void, iov_len: DATAGRAM })
+                .collect();
+            let mut msgs: Vec<libc::mmsghdr> = (0..BATCH)
+                .map(|i| {
+                    let mut hdr: libc::msghdr = unsafe { std::mem::zeroed() };
+                    hdr.msg_iov = &mut iovs[i];
+                    hdr.msg_iovlen = 1;
+                    libc::mmsghdr { msg_hdr: hdr, msg_len: 0 }
+                })
+                .collect();
+
+            let mut pending: Option<Pending> = None;
+            let mut counters = Counters::default();
+            super::telemetry::start(cfg.width, cfg.height);
+            // Everything the socket held at the last read, parsed and in order. A completed frame
+            // looks here for anything newer before it spends a decode on itself.
+            let mut inbox: VecDeque<(PyroWavePacketHeader, Vec<u8>)> = VecDeque::new();
+
+            // Decode whatever is queued, publish it, and account for it.
+            let decode_and_publish = |timestamp_ns: u64, counters: &mut Counters, complete: bool| {
+                let mut out: *mut c_void = std::ptr::null_mut();
+                let mut info = FrameInfo::default();
+                let rc = unsafe { pyroclient_decode(client, &mut out, &mut info) };
+                if rc != 0 || out.is_null() {
+                    counters.decode_failures += 1;
+                    return;
+                }
+                let ts = Duration::from_nanos(timestamp_ns);
+                decoded.publish(ts, out as usize);
+                report_frame_decoded(Ok(ts));
+                counters.total_ms += info.total_ms;
+                counters.decode_samples.push(info.decode_ms as f32);
+                counters.convert_samples.push(info.convert_ms as f32);
+                counters.fence_samples.push(info.total_ms as f32);
+                super::telemetry::record_frame(info.decode_ms as f32, info.total_ms as f32);
+                counters.last = info;
+                if complete {
+                    counters.complete += 1;
+                } else {
+                    counters.partial += 1;
+                }
+            };
+
+            // Settle an unfinished frame: decode it partial if anything usable arrived and nothing
+            // newer is waiting, else drop it.
+            let settle = |p: Pending, now: Instant, counters: &mut Counters, superseded: bool, behind: bool| {
+                let decision = frame_decision(false, p.decodable, now - p.first_seen, cfg.deadline);
+                let worth_decoding = matches!(decision, FrameDecision::DecodePartial)
+                    || (matches!(decision, FrameDecision::Wait) && superseded && p.decodable);
+                if worth_decoding && !behind {
+                    if superseded {
+                        counters.superseded += 1;
+                    }
+                    decode_and_publish(p.timestamp_ns, counters, false);
+                } else {
+                    counters.dropped += 1;
+                    unsafe { pyroclient_clear(client) };
+                }
+            };
+
+            while running.load(Ordering::Relaxed) {
+                // One read that waits for the first datagram (or the timeout), then drain the rest
+                // without blocking, so `inbox` is the socket's whole backlog at this moment.
+                let mut n = recv(fd, &mut msgs, libc::MSG_WAITFORONE);
+                let now = Instant::now();
+                if n < 0 {
+                    // timeout or interrupt: run the deadline tick
+                    if let Some(p) = pending.take() {
+                        if now - p.first_seen >= cfg.deadline {
+                            settle(p, now, &mut counters, false, false);
+                        } else {
+                            pending = Some(p);
+                        }
+                    }
+                    continue;
+                }
+                loop {
+                    for i in 0..n as usize {
+                        let len = msgs[i].msg_len as usize;
+                        let data = &bufs[i][..len];
+                        match PyroWavePacketHeader::from_bytes(data) {
+                            Some(hdr) => inbox.push_back((hdr, data[PYROWAVE_UDP_HEADER_LEN..].to_vec())),
+                            None => counters.foreign += 1,
+                        }
+                    }
+                    n = recv(fd, &mut msgs, libc::MSG_DONTWAIT);
+                    if n <= 0 {
+                        break;
+                    }
+                }
+
+                while let Some((hdr, payload)) = inbox.pop_front() {
+                    match &pending {
+                        Some(p) if hdr.timestamp_ns < p.timestamp_ns => {
+                            counters.stale_packets += 1;
+                            continue;
+                        }
+                        Some(p) if hdr.timestamp_ns > p.timestamp_ns => {
+                            let old = pending.take().unwrap();
+                            let behind = skip_for_newer(old.timestamp_ns, inbox.iter().map(|(h, _)| h.timestamp_ns));
+                            settle(old, now, &mut counters, true, behind);
+                        }
+                        _ => {}
+                    }
+                    if pending.is_none() {
+                        pending = Some(Pending {
+                            timestamp_ns: hdr.timestamp_ns,
+                            first_seen: now,
+                            count: hdr.count,
+                            received: 0,
+                            decodable: false,
+                        });
+                        let ts = Duration::from_nanos(hdr.timestamp_ns);
+                        report_video_packet_received(ts);
+                        crate::push_foveation_center(ts, hdr.foveation_center);
+                    }
+                    let p = pending.as_mut().unwrap();
+                    let r = unsafe { pyroclient_push_packet(client, payload.as_ptr(), payload.len()) };
+                    p.received += 1;
+                    if r >= 0 {
+                        p.decodable = true;
+                    }
+                    if r == 1 || p.received >= p.count as u32 {
+                        let done = pending.take().unwrap();
+                        if skip_for_newer(done.timestamp_ns, inbox.iter().map(|(h, _)| h.timestamp_ns)) {
+                            counters.skipped += 1;
+                            unsafe { pyroclient_clear(client) };
+                        } else {
+                            decode_and_publish(done.timestamp_ns, &mut counters, r == 1);
+                        }
+                    }
+                }
+                // deadline tick for the frame still pending after this batch
+                if let Some(p) = pending.take() {
+                    if now - p.first_seen >= cfg.deadline {
+                        settle(p, now, &mut counters, false, false);
+                    } else {
+                        pending = Some(p);
+                    }
+                }
+                super::telemetry::set_counters(super::telemetry::Counters {
+                    complete: counters.complete,
+                    partial: counters.partial,
+                    skipped: counters.skipped,
+                    dropped: counters.dropped,
+                    superseded: counters.superseded,
+                    stale_packets: counters.stale_packets,
+                    decode_failures: counters.decode_failures,
+                });
+                let frames = counters.complete + counters.partial + counters.skipped + counters.dropped;
+                if frames > 0 && frames % 720 == 0 && frames != counters.last_report_frames {
+                    counters.last_report_frames = frames;
+                    let decoded_n = (counters.complete + counters.partial).max(1);
+                    alog(&format!(
+                        "frames complete {} partial {} skipped {} dropped {} superseded {} | stale pk {} foreign {} decode fail {} | last decode {:.2} convert {:.2} submit->fence {:.2} ms (mean {:.2})",
+                        counters.complete, counters.partial, counters.skipped, counters.dropped, counters.superseded,
+                        counters.stale_packets, counters.foreign, counters.decode_failures,
+                        counters.last.decode_ms, counters.last.convert_ms, counters.last.total_ms,
+                        counters.total_ms / decoded_n as f64
+                    ));
+                    alog(&format!("gpu decode ms: {}", dist(&mut counters.decode_samples)));
+                    alog(&format!("convert ms: {}", dist(&mut counters.convert_samples)));
+                    alog(&format!("submit->fence ms: {}", dist(&mut counters.fence_samples)));
+                    counters.decode_samples.clear();
+                    counters.convert_samples.clear();
+                    counters.fence_samples.clear();
+                }
+            }
+            unsafe { pyroclient_destroy(client) };
+            alog(&format!(
+                "stopped: complete {} partial {} skipped {} dropped {} decode fail {}",
+                counters.complete, counters.partial, counters.skipped, counters.dropped, counters.decode_failures
+            ));
+        }
+    });
+
+    Ok((
+        VideoDecoderSink,
+        VideoDecoderSource {
+            running,
+            thread: Some(thread),
+            decoded,
+        },
+    ))
+}
+
diff --git a/alvr/client_core/src/video_decoder/telemetry.rs b/alvr/client_core/src/video_decoder/telemetry.rs
new file mode 100644
index 0000000000000000000000000000000000000000..da58258ad92ba71c0d44e7d437bedf084cf6940f
--- /dev/null
+++ b/alvr/client_core/src/video_decoder/telemetry.rs
@@ -0,0 +1,129 @@
+//! PyroWave decode statistics for the beta test report: per-frame GPU decode and submit->fence
+//! times since the last report, plus the decoder's cumulative frame counters. The decode thread
+//! records; the connection thread takes a snapshot about once a second and sends it to the
+//! server with the headset's thermals.
+
+use alvr_packets::PyroWaveDecodeStats;
+use std::sync::Mutex;
+
+/// Samples kept between reports; at 90 fps a one-second window needs 90.
+const MAX_SAMPLES: usize = 1024;
+
+#[derive(Default)]
+struct State {
+    active: bool,
+    stats: PyroWaveDecodeStats,
+}
+
+static STATE: Mutex<State> = Mutex::new(State {
+    active: false,
+    stats: PyroWaveDecodeStats {
+        complete: 0,
+        partial: 0,
+        skipped: 0,
+        dropped: 0,
+        superseded: 0,
+        stale_packets: 0,
+        decode_failures: 0,
+        encoded_width: 0,
+        encoded_height: 0,
+        gpu_decode_ms: vec![],
+        fence_ms: vec![],
+    },
+});
+
+/// Cumulative frame outcomes, as the decoder counts them.
+#[derive(Clone, Copy, Default, Debug, PartialEq)]
+pub struct Counters {
+    pub complete: u64,
+    pub partial: u64,
+    pub skipped: u64,
+    pub dropped: u64,
+    pub superseded: u64,
+    pub stale_packets: u64,
+    pub decode_failures: u64,
+}
+
+/// A new stream: forget the previous one's counters and samples.
+pub fn start(encoded_width: u32, encoded_height: u32) {
+    let mut state = STATE.lock().unwrap();
+    *state = State {
+        active: true,
+        ..Default::default()
+    };
+    state.stats.encoded_width = encoded_width;
+    state.stats.encoded_height = encoded_height;
+}
+
+pub fn record_frame(gpu_decode_ms: f32, fence_ms: f32) {
+    let mut state = STATE.lock().unwrap();
+    state.active = true;
+    if state.stats.gpu_decode_ms.len() < MAX_SAMPLES {
+        state.stats.gpu_decode_ms.push(gpu_decode_ms);
+        state.stats.fence_ms.push(fence_ms);
+    }
+}
+
+pub fn set_counters(counters: Counters) {
+    let mut state = STATE.lock().unwrap();
+    state.active = true;
+    let stats = &mut state.stats;
+    stats.complete = counters.complete;
+    stats.partial = counters.partial;
+    stats.skipped = counters.skipped;
+    stats.dropped = counters.dropped;
+    stats.superseded = counters.superseded;
+    stats.stale_packets = counters.stale_packets;
+    stats.decode_failures = counters.decode_failures;
+}
+
+/// The samples since the last call and the counters so far; `None` when no PyroWave decoder has
+/// run (the H.264 path).
+pub fn take() -> Option<PyroWaveDecodeStats> {
+    let mut state = STATE.lock().unwrap();
+    if !state.active {
+        return None;
+    }
+    let snapshot = state.stats.clone();
+    state.stats.gpu_decode_ms.clear();
+    state.stats.fence_ms.clear();
+    Some(snapshot)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // One test: the state is process-wide, and tests run in parallel.
+    #[test]
+    fn snapshots_carry_new_samples_and_cumulative_counters() {
+        start(1984, 896);
+        assert_eq!(take().map(|s| s.gpu_decode_ms.len()), Some(0));
+        record_frame(3.1, 4.8);
+        record_frame(3.3, 5.0);
+        set_counters(Counters {
+            complete: 2,
+            partial: 1,
+            dropped: 3,
+            ..Default::default()
+        });
+        let first = take().unwrap();
+        assert_eq!((first.encoded_width, first.encoded_height), (1984, 896));
+        assert_eq!(first.gpu_decode_ms, vec![3.1, 3.3]);
+        assert_eq!(first.fence_ms, vec![4.8, 5.0]);
+        assert_eq!((first.complete, first.partial, first.dropped), (2, 1, 3));
+
+        record_frame(3.2, 4.9);
+        let second = take().unwrap();
+        assert_eq!(second.gpu_decode_ms, vec![3.2], "only samples since the last report");
+        assert_eq!(second.complete, 2, "counters are cumulative");
+
+        for _ in 0..(MAX_SAMPLES + 10) {
+            record_frame(1.0, 1.0);
+        }
+        assert_eq!(take().unwrap().gpu_decode_ms.len(), MAX_SAMPLES);
+
+        start(1984, 896);
+        assert_eq!(take().unwrap().complete, 0, "a new stream starts from zero");
+    }
+}
