+// ---- Phase lock: align the server's virtual vsync with the headset's display ----------------
+//
+// `last_vsync_time` free-runs on the server clock with no relation to the headset's vsync, so
+// the phase between them is arbitrary and drifts. Measured (pyro-latestart sweep):
+// starting the frame 0-12 ms later changed the total not at all (82-84 ms) because every
+// millisecond was absorbed by the client waiting -- as `video_decoder_queue` when the frame is
+// early, and as a shrunken `vsync_queue` when it is late and the render loop blocks for it.
+// Those two client stats are therefore the phase error, and they already arrive every frame.
+//
+// `ALVR_PHASE_LOCK=1` enables it; `ALVR_PHASE_TARGET_US` (default 2000) is the decoder-queue
+// the controller aims for, `ALVR_PHASE_GAIN` (0.1) and `ALVR_PHASE_STEP_US` (300) bound the
+// per-frame move. Positive correction moves the virtual vsync later.
+
+pub struct PhaseLock {
+    pub enabled: bool,
+    pub target_us: i64,
+    pub gain: f32,
+    pub max_step_us: i64,
+    pub lead_ref_us: i64,
+    pub shift_total_us: i64,
+    samples: u32,
+    sum_dq_us: i64,
+    sum_late_us: i64,
+    last_log: Instant,
+}
+
+impl PhaseLock {
+    pub fn from_env() -> Self {
+        let var = |k: &str| std::env::var(k).ok();
+        Self {
+            enabled: var("ALVR_PHASE_LOCK").as_deref() == Some("1"),
+            target_us: var("ALVR_PHASE_TARGET_US").and_then(|v| v.parse().ok()).unwrap_or(2000),
+            gain: var("ALVR_PHASE_GAIN").and_then(|v| v.parse().ok()).unwrap_or(0.1),
+            max_step_us: var("ALVR_PHASE_STEP_US").and_then(|v| v.parse().ok()).unwrap_or(300),
+            lead_ref_us: 0,
+            shift_total_us: 0,
+            samples: 0,
+            sum_dq_us: 0,
+            sum_late_us: 0,
+            last_log: Instant::now(),
+        }
+    }
+
+    /// Fold one frame's client stats in and return the correction to apply to the virtual
+    /// vsync, in microseconds, positive = later.
+    pub fn step(&mut self, decoder_queue: Duration, vsync_queue: Duration) -> i64 {
+        let dq = decoder_queue.as_micros() as i64;
+        let vq = vsync_queue.as_micros() as i64;
+        self.lead_ref_us = update_lead_ref(self.lead_ref_us, vq);
+        // A frame that waited in the decoder queue was not late, whatever vsync_queue did:
+        // its jitter below the reference is noise, and counting it walked the clock earlier
+        // without limit (-113 ms in one segment). Lateness only exists when
+        // nothing waited.
+        let late = if dq < PHASE_LATE_GATE_US { lateness_us(vq, self.lead_ref_us) } else { 0 };
+        let step = phase_correction_us(dq, late, self.target_us, self.gain, self.max_step_us);
+        self.shift_total_us += step;
+        self.samples += 1;
+        self.sum_dq_us += dq;
+        self.sum_late_us += late;
+        if self.last_log.elapsed() >= Duration::from_secs(2) {
+            let n = self.samples.max(1) as i64;
+            alvr_common::error!(
+                "[PHASE] shift {:+.2} ms | decoder_queue mean {:.2} ms, late mean {:.2} ms, lead ref {:.2} ms | {} frames",
+                self.shift_total_us as f64 / 1000.0,
+                self.sum_dq_us as f64 / n as f64 / 1000.0,
+                self.sum_late_us as f64 / n as f64 / 1000.0,
+                self.lead_ref_us as f64 / 1000.0,
+                n
+            );
+            self.samples = 0;
+            self.sum_dq_us = 0;
+            self.sum_late_us = 0;
+            self.last_log = Instant::now();
+        }
+        step
+    }
+}
+
+/// How far to move the virtual vsync this frame. The frame was early by `decoder_queue` (it sat
+/// decoded, waiting for the render loop) or late by `lateness` (the render loop blocked for it);
+/// the controller aims the early margin at `target` and never moves more than `max_step`.
+pub fn phase_correction_us(decoder_queue_us: i64, lateness_us: i64, target_us: i64, gain: f32, max_step_us: i64) -> i64 {
+    let err = decoder_queue_us - lateness_us - target_us;
+    if err.abs() <= PHASE_DEADBAND_US {
+        return 0;
+    }
+    ((err as f32 * gain) as i64).clamp(-max_step_us, max_step_us)
+}
+
+/// Below this decoder-queue wait a frame is taken as having arrived late (nothing waited).
+pub const PHASE_LATE_GATE_US: i64 = 500;
+/// Errors inside this band are jitter, not phase; moving on them only hunts.
+pub const PHASE_DEADBAND_US: i64 = 1000;
+
+/// Lateness cannot be measured directly: the client's render loop blocks for a late frame and
+/// nothing times that wait. What shrinks is `vsync_queue`, the runtime lead left at submit, so
+/// lateness is how far below its reference the lead fell.
+pub fn lateness_us(vsync_queue_us: i64, lead_ref_us: i64) -> i64 {
+    (lead_ref_us - vsync_queue_us).max(0)
+}
+
+/// The reference lead: a running maximum of `vsync_queue` with a slow decay (0.5 % per frame,
+/// so a genuine drop in the runtime's lead is followed within a few seconds).
+pub fn update_lead_ref(lead_ref_us: i64, vsync_queue_us: i64) -> i64 {
+    if vsync_queue_us > lead_ref_us {
+        vsync_queue_us
+    } else {
+        lead_ref_us - (lead_ref_us - vsync_queue_us) / 200
+    }
+}
