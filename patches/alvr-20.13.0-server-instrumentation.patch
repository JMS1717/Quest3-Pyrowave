+/// Indices of the entries to draw, in order: the ordinary ones, then (only when the group is
+/// open) the ones flagged "advanced". Hidden entries are never drawn.
+fn render_order(flags: &[(bool, bool)], show_advanced: bool) -> (Vec<usize>, Vec<usize>) {
+    let visible = |advanced: bool| {
+        flags
+            .iter()
+            .enumerate()
+            .filter(move |(_, (hidden, adv))| !hidden && *adv == advanced)
+            .map(|(i, _)| i)
+            .collect::<Vec<_>>()
+    };
+    (
+        visible(false),
+        if show_advanced { visible(true) } else { vec![] },
+    )
+}
+
+fn has_advanced(flags: &[(bool, bool)]) -> bool {
+    flags.iter().any(|(hidden, advanced)| !hidden && *advanced)
+}
