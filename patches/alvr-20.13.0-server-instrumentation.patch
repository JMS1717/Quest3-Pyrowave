+//! Beta research release: the streaming profiles testers pick from, the panel-relative render
+//! scale, which settings the dashboard shows, and PyroWave's effective configuration once research
+//! environment overrides are applied. The server, the dashboard and the tests all read from here,
+//! so the UI, the defaults and the documentation cannot drift apart.
+
+use crate::settings::{CodecType, PyroWaveDecodePath, PyroWaveTransport, PyroWaveWavelet, Settings};
+use serde_json as json;
+use settings_schema::{SchemaEntry, SchemaNode};
+use std::fmt;
+
+pub const RECOMMENDED_PROFILE: &str = "PyroWave 4:4:4 (Recommended)";
+pub const RECOMMENDED_SUBTITLE: &str = "Full-chroma experimental wireless VR streaming";
+pub const H264_PROFILE: &str = "ALVR H.264 (tuned)";
+
+/// Galaxy XR panel, per eye, as reported by `dumpsys display` (7104x3840 for both).
+pub const PANEL_PER_EYE: (u32, u32) = (3552, 3840);
+
+/// Per-eye render size for a percentage of the panel. ALVR floors the width to a multiple of 32
+/// on its own, so the requested size is not pre-aligned.
+pub fn render_scale_size(percent: u32) -> (u32, u32) {
+    let scale = |v: u32| ((v as f64) * percent as f64 / 100.0).round() as u32;
+    (scale(PANEL_PER_EYE.0), scale(PANEL_PER_EYE.1))
+}
+
+pub struct StreamingProfile {
+    pub name: &'static str,
+    pub subtitle: &'static str,
+    /// Session-style paths relative to `session_settings`, and the value each one gets.
+    pub assignments: Vec<(String, json::Value)>,
+}
+
+fn assign(path: &str, value: json::Value) -> (String, json::Value) {
+    (path.to_owned(), value)
+}
+
+fn render_size(percent: u32) -> Vec<(String, json::Value)> {
+    let (width, height) = render_scale_size(percent);
+    ["transcoding_view_resolution", "emulated_headset_view_resolution"]
+        .into_iter()
+        .flat_map(|field| {
+            [
+                assign(&format!("video.{field}.variant"), "Absolute".into()),
+                assign(&format!("video.{field}.Absolute.width"), width.into()),
+                assign(&format!("video.{field}.Absolute.height.set"), true.into()),
+                assign(&format!("video.{field}.Absolute.height.content"), height.into()),
+            ]
+        })
+        .collect()
+}
+
+/// The settings both profiles pin: the measured foveation, buffering, pacing, encoder and
+/// socket values, so switching profiles never leaves one of them at a tester's experiment.
+fn shared(codec: &str, mbps: u64, fps: f32, percent: u32) -> Vec<(String, json::Value)> {
+    let mut list = vec![
+        assign("video.preferred_codec.variant", codec.into()),
+        assign("video.bitrate.mode.variant", "ConstantMbps".into()),
+        assign("video.bitrate.mode.ConstantMbps", mbps.into()),
+        assign("video.preferred_fps", json::json!(fps)),
+        assign("video.foveated_encoding.enabled", true.into()),
+        assign("video.foveated_encoding.content.center_size_x", json::json!(0.20)),
+        assign("video.foveated_encoding.content.center_size_y", json::json!(0.178)),
+        assign("video.foveated_encoding.content.center_shift_x", json::json!(0.0)),
+        assign("video.foveated_encoding.content.center_shift_y", json::json!(0.0)),
+        assign("video.foveated_encoding.content.edge_ratio_x", json::json!(3.0)),
+        assign("video.foveated_encoding.content.edge_ratio_y", json::json!(4.0)),
+        assign("video.foveated_encoding.content.follow_gaze", true.into()),
+        assign("video.max_buffering_frames", json::json!(1.5)),
+        assign("video.enforce_server_frame_pacing", true.into()),
+        assign("video.encoder_config.rate_control_mode.variant", "Cbr".into()),
+        assign("video.encoder_config.entropy_coding.variant", "Cavlc".into()),
+        assign("video.encoder_config.nvenc.quality_preset.variant", "P1".into()),
+        assign("connection.stream_protocol.variant", "Tcp".into()),
+        assign("connection.packet_size", 65000.into()),
+        assign("connection.max_queued_server_video_frames", 12.into()),
+    ];
+    list.extend(render_size(percent));
+    list
+}
+
+pub fn streaming_profiles() -> Vec<StreamingProfile> {
+    let mut pyrowave = shared("PyroWave", 400, 90.0, 60);
+    pyrowave.extend([
+        assign("video.pyrowave.transport.variant", "Udp".into()),
+        assign("video.pyrowave.wavelet.variant", "Cdf97".into()),
+        assign("video.pyrowave.decode_path.variant", "Compute".into()),
+    ]);
+
+    vec![
+        StreamingProfile {
+            name: RECOMMENDED_PROFILE,
+            subtitle: RECOMMENDED_SUBTITLE,
+            assignments: pyrowave,
+        },
+        StreamingProfile {
+            name: H264_PROFILE,
+            subtitle: "ALVR's hardware H.264 path at its best measured settings (NVIDIA GPU)",
+            // Panel-native, 600 Mbps, 72 Hz: the configuration that measured 80 ms
+            assignments: shared("H264", 600, 72.0, 100),
+        },
+    ]
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Visibility {
+    Experiment,
+    Advanced,
+}
+
+#[derive(Clone, Debug)]
+pub struct VisibleEntry {
+    pub name: String,
+    pub visibility: Visibility,
+}
+
+fn entry_visibility<T>(entry: &SchemaEntry<T>, inherited: Visibility) -> Option<Visibility> {
+    if entry.flags.contains("hidden") {
+        None
+    } else if entry.flags.contains("advanced") {
+        Some(Visibility::Advanced)
+    } else {
+        Some(inherited)
+    }
+}
+
+// Switches and optionals wrap their content without adding a path segment the tester sees.
+fn unwrap_node(node: &SchemaNode) -> &SchemaNode {
+    match node {
+        SchemaNode::Switch { content, .. } | SchemaNode::Optional { content, .. } => {
+            unwrap_node(content)
+        }
+        other => other,
+    }
+}
+
+fn find<'a>(root: &'a SchemaNode, path: &[&str]) -> Option<(&'a SchemaNode, Visibility)> {
+    let mut node = unwrap_node(root);
+    let mut visibility = Visibility::Experiment;
+    for name in path {
+        let SchemaNode::Section { entries, .. } = node else {
+            return None;
+        };
+        let entry = entries.iter().find(|e| e.name == *name)?;
+        visibility = entry_visibility(entry, visibility)?;
+        node = unwrap_node(&entry.content);
+    }
+    Some((node, visibility))
+}
+
+/// The entries of the section at `path` the dashboard shows, and whether each sits in the
+/// Advanced / Research group. `None` if the path is hidden or not a section.
+pub fn visible_children(root: &SchemaNode, path: &[&str]) -> Option<Vec<VisibleEntry>> {
+    let (node, visibility) = find(root, path)?;
+    let SchemaNode::Section { entries, .. } = node else {
+        return None;
+    };
+    Some(
+        entries
+            .iter()
+            .filter_map(|entry| {
+                entry_visibility(entry, visibility).map(|visibility| VisibleEntry {
+                    name: entry.name.clone(),
+                    visibility,
+                })
+            })
+            .collect(),
+    )
+}
+
+/// The variants of the choice at `path` the dashboard offers, sorted.
+pub fn visible_variants(root: &SchemaNode, path: &[&str]) -> Option<Vec<String>> {
+    let (node, _) = find(root, path)?;
+    let SchemaNode::Choice { variants, .. } = node else {
+        return None;
+    };
+    let mut names = variants
+        .iter()
+        .filter(|v| !v.flags.contains("hidden"))
+        .map(|v| v.name.clone())
+        .collect::<Vec<_>>();
+    names.sort();
+    Some(names)
+}
+
+/// PyroWave's configuration as the server and client actually use it. Research environment
+/// variables, when set, win over the session settings and are listed in `overrides`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PyroWaveEffective {
+    pub enabled: bool,
+    pub udp: bool,
+    pub wavelet_53: bool,
+    pub decode_path: PyroWaveDecodePath,
+    pub follow_gaze: bool,
+    pub overrides: Vec<&'static str>,
+}
+
+fn env_flag(value: &str) -> bool {
+    !value.is_empty() && value != "0"
+}
+
+pub fn pyrowave_effective(
+    settings: &Settings,
+    env: &dyn Fn(&str) -> Option<String>,
+) -> PyroWaveEffective {
+    let video = &settings.video;
+    let mut overrides = vec![];
+    let mut read = |key: &'static str| {
+        let value = env(key);
+        if value.is_some() {
+            overrides.push(key);
+        }
+        value
+    };
+
+    let enabled = read("ALVR_PYROWAVE")
+        .map(|v| env_flag(&v))
+        .unwrap_or(false)
+        || video.preferred_codec == CodecType::PyroWave;
+    let udp = read("ALVR_PYROWAVE_UDP")
+        .map(|v| env_flag(&v))
+        .unwrap_or(video.pyrowave.transport == PyroWaveTransport::Udp);
+    let wavelet_53 = read("ALVR_PYROWAVE_WAVELET")
+        .map(|v| v == "53")
+        .unwrap_or(video.pyrowave.wavelet == PyroWaveWavelet::Cdf53);
+    let follow_gaze = read("ALVR_GAZE_FOVEATION")
+        .map(|v| v != "0")
+        .unwrap_or_else(|| {
+            video
+                .foveated_encoding
+                .as_option()
+                .map(|f| f.follow_gaze)
+                .unwrap_or(false)
+        });
+
+    PyroWaveEffective {
+        enabled,
+        udp,
+        wavelet_53,
+        decode_path: video.pyrowave.decode_path,
+        follow_gaze,
+        overrides,
+    }
+}
+
+/// The process environment, for callers outside tests.
+pub fn process_env(key: &str) -> Option<String> {
+    std::env::var(key).ok()
+}
+
+impl fmt::Display for PyroWaveEffective {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let decode_path = match self.decode_path {
+            PyroWaveDecodePath::Auto => "auto",
+            PyroWaveDecodePath::Compute => "compute",
+            PyroWaveDecodePath::Fragment => "fragment",
+        };
+        write!(
+            f,
+            "PyroWave effective config: chroma=4:4:4 transport={} wavelet=CDF {} \
+             decode_path={decode_path} follow_gaze={} overrides={}",
+            if self.udp { "UDP" } else { "TCP" },
+            if self.wavelet_53 { "5/3" } else { "9/7" },
+            if self.follow_gaze { "on" } else { "off" },
+            if self.overrides.is_empty() {
+                "none".to_owned()
+            } else {
+                self.overrides.join(",")
+            }
+        )
+    }
+}
+
+// Within f32 precision, as the dashboard's preset matching compares: settings are f32, so 0.178
+// comes back from session.json as 0.17800000309944153.
+fn json_eq(a: &json::Value, b: &json::Value) -> bool {
+    match (a.as_f64(), b.as_f64()) {
+        (Some(a), Some(b)) => (a - b).abs() < f32::EPSILON as f64,
+        _ => a == b,
+    }
+}
+
+fn at<'a>(root: &'a json::Value, path: &str) -> Option<&'a json::Value> {
+    path.split('.').try_fold(root, |node, segment| node.get(segment))
+}
+
+/// The profile whose every assignment the session (`session_settings` as JSON) currently holds,
+/// or `None` once a tester has moved any of them.
+pub fn matching_profile(session_settings: &json::Value) -> Option<&'static str> {
+    streaming_profiles()
+        .into_iter()
+        .find(|profile| {
+            profile.assignments.iter().all(|(path, value)| {
+                at(session_settings, path)
+                    .map(|v| json_eq(v, value))
+                    .unwrap_or(false)
+            })
+        })
+        .map(|profile| profile.name)
+}
+
+fn diff_leaves(path: &str, current: &json::Value, default: &json::Value, out: &mut Vec<String>) {
+    match (current, default) {
+        (json::Value::Object(current), json::Value::Object(default)) => {
+            for (key, value) in current {
+                if key == "gui_collapsed" {
+                    continue;
+                }
+                match default.get(key) {
+                    Some(default_value) => {
+                        diff_leaves(&format!("{path}.{key}"), value, default_value, out)
+                    }
+                    None => out.push(format!("{path}.{key}")),
+                }
+            }
+        }
+        (current, default) if !json_eq(current, default) => out.push(path.to_owned()),
+        _ => (),
+    }
+}
+
+/// Session paths under the Advanced / Research controls whose value differs from the measured
+/// default (which both profiles keep), for the test report.
+pub fn advanced_changes(session_settings: &json::Value) -> Vec<String> {
+    let default = json::to_value(crate::settings::session_settings_default()).unwrap();
+    let schema = Settings::schema(crate::settings::session_settings_default());
+    let mut out = vec![];
+    for entry in visible_children(&schema, &["video"]).unwrap_or_default() {
+        if entry.visibility != Visibility::Advanced {
+            continue;
+        }
+        let path = format!("video.{}", entry.name);
+        if let (Some(current), Some(default)) = (at(session_settings, &path), at(&default, &path)) {
+            diff_leaves(&path, current, default, &mut out);
+        }
+    }
+    out
+}
