+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn config_round_trips_the_encoder_blob() {
+        let mut buf = Vec::new();
+        buf.extend_from_slice(&3552u32.to_le_bytes());
+        buf.extend_from_slice(&3840u32.to_le_bytes());
+        buf.push(1);
+        buf.push(0);
+        let c = parse_pyrowave_config(&buf).unwrap();
+        assert_eq!(c, PyroWaveConfig { width: 3552, height: 3840, chroma444: true, full_range: false,
+                                       udp: false, deadline: Duration::from_micros(13_889), wavelet: 97,
+                                       decode_path: 0 });
+        // the 13-byte form: transport udp, deadline 11111 us
+        buf.push(1);
+        buf.extend_from_slice(&11_111u16.to_le_bytes());
+        let c = parse_pyrowave_config(&buf).unwrap();
+        assert!(c.udp);
+        assert_eq!(c.deadline, Duration::from_micros(11_111));
+        assert_eq!(c.wavelet, 97, "13-byte blob from a server without the wavelet byte is 9/7");
+        // the 14-byte form (Experiment 2): wavelet byte 0 = 9/7, 1 = 5/3
+        buf.push(0);
+        assert_eq!(parse_pyrowave_config(&buf).unwrap().wavelet, 97);
+        buf[13] = 1;
+        assert_eq!(parse_pyrowave_config(&buf).unwrap().wavelet, 53);
+        assert_eq!(parse_pyrowave_config(&buf).unwrap().decode_path, 0, "no byte 14 is auto");
+        // the 15-byte form (beta): the dashboard's headset decode path, 1 fragment, 2 compute
+        buf.push(2);
+        assert_eq!(parse_pyrowave_config(&buf).unwrap().decode_path, 2);
+        buf[14] = 1;
+        assert_eq!(parse_pyrowave_config(&buf).unwrap().decode_path, 1);
+        buf[14] = 9;
+        assert_eq!(parse_pyrowave_config(&buf).unwrap().decode_path, 0, "unknown is auto");
+    }
