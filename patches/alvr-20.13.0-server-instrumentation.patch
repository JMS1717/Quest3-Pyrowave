+    s.video.pyrowave.wavelet = PyroWaveWavelet::Cdf53;
+    s.video.pyrowave.decode_path = PyroWaveDecodePath::Fragment;
+    let e = pyrowave_effective(&s, &env(&[]));
+    assert!(!e.udp);
+    assert!(e.wavelet_53);
+    assert_eq!(e.decode_path, PyroWaveDecodePath::Fragment);
+}
+
+#[test]
+fn research_env_overrides_win_and_are_reported() {
+    let mut s = default_settings();
+    s.video.preferred_codec = CodecType::H264;
+    let e = pyrowave_effective(
+        &s,
+        &env(&[
+            ("ALVR_PYROWAVE", "1"),
+            ("ALVR_PYROWAVE_UDP", "0"),
+            ("ALVR_PYROWAVE_WAVELET", "53"),
+            ("ALVR_GAZE_FOVEATION", "0"),
+        ]),
+    );
+    assert!(e.enabled);
+    assert!(!e.udp);
+    assert!(e.wavelet_53);
+    assert!(!e.follow_gaze);
+    assert_eq!(
+        e.overrides,
+        vec![
+            "ALVR_PYROWAVE",
+            "ALVR_PYROWAVE_UDP",
+            "ALVR_PYROWAVE_WAVELET",
+            "ALVR_GAZE_FOVEATION"
+        ]
+    );
+}
+
+#[test]
+fn h264_is_not_pyrowave() {
+    let mut s = default_settings();
+    s.video.preferred_codec = CodecType::H264;
+    assert!(!pyrowave_effective(&s, &env(&[])).enabled);
+}
+
+#[test]
+fn effective_config_log_line_names_chroma_and_every_knob() {
+    let line = pyrowave_effective(&default_settings(), &env(&[])).to_string();
+    assert_eq!(
+        line,
+        "PyroWave effective config: chroma=4:4:4 transport=UDP wavelet=CDF 9/7 \
+         decode_path=compute follow_gaze=on overrides=none"
+    );
+}
+
+fn session_json_after(profile_name: Option<&str>, tweak: impl Fn(&mut json::Value)) -> json::Value {
+    let mut root = json::to_value(&SessionConfig::default().session_settings).unwrap();
+    if let Some(name) = profile_name {
+        for (path, value) in &profile(name).assignments {
+            let mut node = &mut root;
+            for segment in path.split('.') {
+                node = node.get_mut(segment).unwrap();
+            }
+            *node = value.clone();
+        }
+    }
+    tweak(&mut root);
+    root
+}
+
+#[test]
+fn matching_profile_names_the_applied_profile_or_none() {
+    assert_eq!(
+        matching_profile(&session_json_after(None, |_| ())),
+        Some(RECOMMENDED_PROFILE)
+    );
+    assert_eq!(
+        matching_profile(&session_json_after(Some(H264_PROFILE), |_| ())),
+        Some(H264_PROFILE)
+    );
+    let tweaked = session_json_after(None, |root| {
+        root["video"]["bitrate"]["mode"]["ConstantMbps"] = 300.into();
+    });
+    assert_eq!(matching_profile(&tweaked), None);
+}
+
+#[test]
+fn advanced_changes_lists_only_advanced_controls_moved_off_their_defaults() {
+    assert!(advanced_changes(&session_json_after(None, |_| ())).is_empty());
+    assert!(
+        advanced_changes(&session_json_after(Some(H264_PROFILE), |_| ())).is_empty(),
+        "both profiles keep the advanced controls at their measured values"
+    );
+    let tweaked = session_json_after(None, |root| {
+        root["video"]["max_buffering_frames"] = json::json!(3.0);
+        root["video"]["encoder_config"]["nvenc"]["quality_preset"]["variant"] = "P5".into();
+        root["video"]["encoder_config"]["gui_collapsed"] = false.into();
+        root["video"]["bitrate"]["mode"]["ConstantMbps"] = 300.into();
+    });
+    assert_eq!(
+        advanced_changes(&tweaked),
+        vec![
+            "video.max_buffering_frames",
+            "video.encoder_config.nvenc.quality_preset.variant"
+        ]
+    );
+}
+
+#[test]
+fn a_session_from_before_the_beta_keeps_its_clients() {
+    // session.json written by the research build: no pyrowave_* in openvr_config
+    let mut old = SessionConfig::default();
+    old.client_connections.insert(
+        "5050.client".into(),
+        crate::ClientConnectionConfig {
+            display_name: "Galaxy XR".into(),
+            current_ip: None,
+            manual_ips: Default::default(),
+            trusted: true,
+            connection_state: crate::ConnectionState::Disconnected,
+        },
+    );
+    let mut old_json = json::to_value(&old).unwrap();
+    let openvr = old_json["openvr_config"].as_object_mut().unwrap();
+    for key in [
+        "pyrowave_enabled",
+        "pyrowave_udp",
+        "pyrowave_wavelet_53",
+        "pyrowave_decode_path",
+    ] {
+        openvr.remove(key).expect(key);
+    }
+
+    let mut session = SessionConfig::default();
+    session.merge_from_json(&old_json).unwrap();
+    assert!(
+        session.client_connections["5050.client"].trusted,
+        "upgrading must not forget the paired headset"
+    );
+}
