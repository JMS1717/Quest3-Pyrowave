+/// Recent `(target_timestamp, foveation_center)` pairs from video packet headers.
+///
+/// Bounded and tiny: the consumer asks for the frame it is about to draw, which is always within
+/// a few frames of arrival, so anything older is dead weight.
+static FOVEATION_CENTER_HISTORY: Lazy<Mutex<VecDeque<(Duration, [[f32; 2]; 2])>>> =
+    Lazy::new(|| Mutex::new(VecDeque::new()));
+
+const FOVEATION_CENTER_HISTORY_SIZE: usize = 16;
+
+pub(crate) fn push_foveation_center(timestamp: Duration, center: [[f32; 2]; 2]) {
+    let mut history = FOVEATION_CENTER_HISTORY.lock();
+    history.push_back((timestamp, center));
+    while history.len() > FOVEATION_CENTER_HISTORY_SIZE {
+        history.pop_front();
+    }
