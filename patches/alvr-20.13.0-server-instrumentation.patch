+// ---- PyroWave over UDP ----
+//
+// PyroWave frames leave the server as MTU-sized datagrams, one PyroWave packet each (the codec's
+// own packetizer, so every datagram is independently decodable and a lost one costs blocks, not
+// the frame). Each carries this 16-byte header. `count` lets the receiver judge completeness
+// against a deadline without waiting for the decoder; `timestamp_ns` is ALVR's target timestamp
+// so the client's statistics line up with every other stage.
+
+pub const PYROWAVE_UDP_PORT: u16 = 9948;
+pub const PYROWAVE_UDP_HEADER_LEN: usize = 32;
+pub const PYROWAVE_UDP_MAGIC: [u8; 4] = *b"PWU1";
+/// Datagram payload budget below a 1500-byte MTU with IPv4/UDP headers and ours.
+pub const PYROWAVE_UDP_PAYLOAD: usize = 1400 - PYROWAVE_UDP_HEADER_LEN;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct PyroWavePacketHeader {
+    pub timestamp_ns: u64,
+    pub index: u16,
+    pub count: u16,
+    /// The per-eye foveation centre the server encoded this frame with. Over TCP it rides in
+    /// `VideoPacketHeader`; UDP has no such packet, and a client whose inverse warp does not
+    /// follow the encoder's centre shows each eye warped by a different amount (stereo will not
+    /// fuse). Repeated in every packet so the first one to arrive carries it.
+    pub foveation_center: [[f32; 2]; 2],
+}
+
+impl PyroWavePacketHeader {
+    pub fn to_bytes(&self) -> [u8; PYROWAVE_UDP_HEADER_LEN] {
+        let mut b = [0u8; PYROWAVE_UDP_HEADER_LEN];
+        b[0..4].copy_from_slice(&PYROWAVE_UDP_MAGIC);
+        b[4..12].copy_from_slice(&self.timestamp_ns.to_le_bytes());
+        b[12..14].copy_from_slice(&self.index.to_le_bytes());
+        b[14..16].copy_from_slice(&self.count.to_le_bytes());
+        let c = &self.foveation_center;
+        for (i, v) in [c[0][0], c[0][1], c[1][0], c[1][1]].into_iter().enumerate() {
+            b[16 + i * 4..20 + i * 4].copy_from_slice(&v.to_le_bytes());
+        }
+        b
+    }
+
+    /// None for anything that is not one of ours: wrong magic, too short, index past count.
+    pub fn from_bytes(b: &[u8]) -> Option<Self> {
+        if b.len() < PYROWAVE_UDP_HEADER_LEN || b[0..4] != PYROWAVE_UDP_MAGIC {
+            return None;
+        }
+        let f = |o: usize| f32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+        let h = Self {
+            timestamp_ns: u64::from_le_bytes(b[4..12].try_into().ok()?),
+            index: u16::from_le_bytes(b[12..14].try_into().ok()?),
+            count: u16::from_le_bytes(b[14..16].try_into().ok()?),
+            foveation_center: [[f(16), f(20)], [f(24), f(28)]],
+        };
+        (h.count > 0 && h.index < h.count).then_some(h)
+    }
+}
