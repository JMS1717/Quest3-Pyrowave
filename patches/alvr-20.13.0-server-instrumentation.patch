+    fn early_frames_move_the_vsync_later_and_late_frames_earlier() {
+        // 6 ms early against a 2 ms target: move later, scaled by the gain
+        assert_eq!(phase_correction_us(6000, 0, 2000, 0.1, 300), 300); // clamped
+        assert_eq!(phase_correction_us(3500, 0, 2000, 0.1, 300), 150);
+        // late by 4 ms with no early margin: move earlier
+        assert_eq!(phase_correction_us(0, 4000, 2000, 0.1, 300), -300);
+        // on target, and within the deadband either side: no move
+        assert_eq!(phase_correction_us(2000, 0, 2000, 0.1, 300), 0);
+        assert_eq!(phase_correction_us(2900, 0, 2000, 0.1, 300), 0);
+        assert_eq!(phase_correction_us(1100, 0, 2000, 0.1, 300), 0);
