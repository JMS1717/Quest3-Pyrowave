+/// The beta's one-click profiles, from the shared table in `alvr_session::beta`, so a fresh
+/// install, the dashboard and the documentation agree.
+pub fn streaming_profile_schema() -> PresetSchemaNode {
+    PresetSchemaNode::HigherOrderChoice(HigherOrderChoiceSchema {
+        name: "streaming_profile".into(),
+        strings: [(
+            "help".into(),
+            "Sets every streaming setting to a measured configuration. Changing any of them \
+afterwards leaves no profile selected; pick the profile again to return to it."
+                .into(),
+        )]
+        .into_iter()
+        .collect(),
+        flags: ["steamvr-restart".into()].into_iter().collect(),
+        options: alvr_session::beta::streaming_profiles()
+            .into_iter()
+            .map(|profile| HigherOrderChoiceOption {
+                display_name: profile.name.into(),
+                description: Some(profile.subtitle.into()),
+                modifiers: profile
+                    .assignments
+                    .into_iter()
+                    .map(|(path, value)| PresetModifier {
+                        target_path: format!("session_settings.{path}"),
+                        operation: PresetModifierOperation::Assign(value),
+                    })
+                    .collect(),
+                content: None,
+            })
+            .collect(),
+        default_option_display_name: alvr_session::beta::RECOMMENDED_PROFILE.into(),
+        gui: ChoiceControlType::Dropdown,
+    })
+}
+
+/// Render size as a share of the Galaxy XR panel, the axis the resolution matrix measured.
+pub fn render_scale_schema() -> PresetSchemaNode {
+    PresetSchemaNode::HigherOrderChoice(HigherOrderChoiceSchema {
+        name: "render_scale".into(),
+        strings: [(
+            "help".into(),
+            "Per-eye render size as a share of the 3552x3840 panel. On static SteamVR Home, \
+PyroWave held 90 fps up to 70 % at 400 Mbps; 80 % and above dropped frames and ran the headset hot."
+                .into(),
+        )]
+        .into_iter()
+        .collect(),
+        flags: ["steamvr-restart".into()].into_iter().collect(),
+        options: [50, 60, 70, 80, 90, 100]
+            .into_iter()
+            .map(|percent| {
+                let (width, height) = alvr_session::beta::render_scale_size(percent);
+                let panel = if percent == 100 { ", panel" } else { "" };
+                HigherOrderChoiceOption {
+                    display_name: format!("{percent} % ({width}x{height} per eye{panel})"),
+                    description: None,
+                    modifiers: ["transcoding_view_resolution", "emulated_headset_view_resolution"]
+                        .into_iter()
+                        .flat_map(|field| {
+                            let prefix = format!("session_settings.video.{field}");
+                            [
+                                string_modifier(&format!("{prefix}.variant"), "Absolute"),
+                                num_modifier(&format!("{prefix}.Absolute.width"), &width.to_string()),
+                                bool_modifier(&format!("{prefix}.Absolute.height.set"), true),
+                                num_modifier(
+                                    &format!("{prefix}.Absolute.height.content"),
+                                    &height.to_string(),
+                                ),
+                            ]
+                        })
+                        .collect(),
+                    content: None,
+                }
+            })
+            .collect(),
+        default_option_display_name: "60 % (2131x2304 per eye)".into(),
+        gui: ChoiceControlType::Dropdown,
+    })
+}
+
