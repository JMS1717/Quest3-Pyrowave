+#pragma once
+
+#include "RenderUtils.h"
+
+namespace d3d_render_utils {
+
+// A RenderPipeline variant that writes three single-component render targets in one pass, for
+// producing planar YCbCr. RenderPipeline binds exactly one target, and three passes over the same
+// input would be three times the sampling for no reason.
+//
+// All three targets must have the same dimensions, which is why this is 4:4:4 only. Subsampled
+// chroma would need either a second half-resolution pass or the differently-sized-target trick
+// rgbtoyuv420.hlsl relies on.
+class RenderPipelinePlanar {
+public:
+    RenderPipelinePlanar(ID3D11Device* device);
+
+    void Initialize(
+        std::vector<ID3D11Texture2D*> inputTextures,
+        ID3D11VertexShader* quadVertexShader,
+        std::vector<uint8_t>& pixelShaderCSO,
+        ID3D11Texture2D* renderTargets[3],
+        ID3D11Buffer* shaderBuffer = nullptr
+    );
+
+    void Render(ID3D11DeviceContext* otherContext = nullptr);
+
+private:
+    D3D11_VIEWPORT mViewport;
+
+    Microsoft::WRL::ComPtr<ID3D11Device> mDevice;
+    Microsoft::WRL::ComPtr<ID3D11DeviceContext> mImmediateContext;
+    std::vector<Microsoft::WRL::ComPtr<ID3D11ShaderResourceView>> mInputTextureViews;
+    Microsoft::WRL::ComPtr<ID3D11RenderTargetView> mRenderTargetViews[3];
+    Microsoft::WRL::ComPtr<ID3D11Buffer> mShaderBuffer;
+    Microsoft::WRL::ComPtr<ID3D11VertexShader> mVertexShader;
+    Microsoft::WRL::ComPtr<ID3D11PixelShader> mPixelShader;
+    Microsoft::WRL::ComPtr<ID3D11BlendState> mBlendState;
+};
+}
