+
+    fn report(subjective: &Subjective) -> Value {
+        let session = SessionConfig::default();
+        let settings = session.to_settings();
+        let session_json = serde_json::to_value(&session.session_settings).unwrap();
+        let recording = Recording {
+            frames: (0..900).map(|i| frame(0.055 + (i % 10) as f32 * 0.001, 90.0)).collect(),
+            telemetry: vec![telemetry(100, 1, 0), telemetry(1000, 4, 2)],
+            packets_lost_start: Some(5),
+            packets_lost_end: Some(7),
+        };
+        let system = SystemInfo {
+            gpu: "NVIDIA GeForce RTX 3090".into(),
+            gpu_driver: "32.0.15.6094".into(),
+            cpu: "AMD Ryzen 9 5950X 16-Core Processor".into(),
+            os: "Windows 11 (26100)".into(),
+            streamer_version: "20.13.0-pyro.1".into(),
+        };
+        build_report("0123abcd", &settings, &session_json, &system, &recording, subjective)
+    }
+
+    #[test]
+    fn report_has_the_pooled_schema() {
+        let r = report(&Subjective::default());
+        assert_eq!(r["schema_version"], 1);
+        assert_eq!(r["settings"]["profile"], beta::RECOMMENDED_PROFILE);
+        assert_eq!(r["settings"]["codec"], "PyroWave 4:4:4");
+        assert_eq!(r["settings"]["chroma"], "4:4:4");
+        assert_eq!(r["settings"]["render_per_eye"], json!([2131, 2304]));
+        assert_eq!(r["settings"]["render_scale_percent"], 60.0);
+        assert_eq!(r["settings"]["pyrowave"]["transport"], "UDP");
+        assert_eq!(r["settings"]["advanced_changes"], json!([]));
+        assert_eq!(r["encoded_size"], json!([1984, 896]));
+        assert_eq!(r["window"]["frames"], 900);
+        assert_eq!(r["fps"]["median"], 90.0);
+        assert_eq!(r["motion_to_photon_ms"]["p50"], 60.0);
+        assert_eq!(r["stage_means_ms"]["encoder"], 7.0);
+        assert_eq!(r["pyrowave_gpu_decode_ms"]["p50"], 3.4);
+        assert_eq!(r["frame_counts"]["complete"], 900, "the window's own frames, not cumulative");
+        assert_eq!(r["frame_counts"]["dropped"], 3);
+        assert_eq!(r["packets_lost"], 2);
+        assert_eq!(r["bitrate_mbps_achieved"], 400.0);
+        assert_eq!(r["headset_start"]["thermal_status"], 0);
+        assert_eq!(r["headset_end"]["thermal_status"], 2);
+        assert_eq!(r["system"]["headset_model"], "SM-I610");
+        assert!(find_identifying(&r).is_empty(), "{:?}", find_identifying(&r));
+    }
+
+    #[test]
+    fn subjective_answers_are_kept_and_free_text_is_redacted() {
+        let r = report(&Subjective {
+            chroma_difference: ChromaDifference::Clear,
+            sharpness: Some(4),
+            smoothness: Some(9),
+            link: "Wi-Fi 6E".into(),
+            band: "6 GHz".into(),
+            router_model: "Some Router AX11000".into(),
+            notes: "fine at 192.0.2.20, ask me@example.com".into(),
+        });
+        assert_eq!(r["subjective"]["chroma_444_difference"], "clear");
+        assert_eq!(r["subjective"]["sharpness_1_to_5"], 4);
+        assert_eq!(r["subjective"]["smoothness_1_to_5"], Value::Null, "out of range");
+        assert_eq!(
+            r["subjective"]["notes"],
+            "fine at [redacted] ask [redacted]"
+        );
+        assert!(find_identifying(&r).is_empty());
+    }
+}
