index 0000000000000000000000000000000000000000..2e22601497aaca790db25fa1b37423948fdfaa86
--- /dev/null
+++ b/alvr/client_core/src/video_decoder/pyrowave.rs
@@ -0,0 +1,201 @@
+//! PyroWave decoding through libpyroclient (tools/pyroclient in the research repo).
+//!
+//! Same shape as the MediaCodec path: a sink the video receive thread pushes frames into, a
+//! source the render loop polls for an AHardwareBuffer. The differences are that PyroWave is
+//! intra-only (every frame stands alone, so "latest frame wins" is always safe) and that the
+//! decode is synchronous on our own thread, which keeps every Vulkan call on one thread and
+//! keeps the receive thread free to keep reading the socket.
+use super::{parse_pyrowave_config, FrameSlot, VideoDecoderConfig};
+use alvr_common::{
+    anyhow::{bail, Result},
+    parking_lot::{Condvar, Mutex},
+    warn,
+};
+use std::{
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    thread::{self, JoinHandle},
+    time::Duration,
+};
+
+#[repr(C)]
+struct PyroClient {
+    _private: [u8; 0],
+}
+
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct FrameInfo {
+    decode_ms: f64,
+    convert_ms: f64,
+    total_ms: f64,
+    complete: i32,
+}
+
+extern "C" {
+    fn pyroclient_create_ex(width: u32, height: u32, chroma444: i32, full_range: i32, ring: u32, wavelet: i32, decode_path: i32) -> *mut PyroClient;
+    fn pyroclient_push_packet(c: *mut PyroClient, data: *const u8, size: usize) -> i32;
+    fn pyroclient_decode(
+        c: *mut PyroClient,
+        out: *mut *mut c_void,
+        info: *mut FrameInfo,
+    ) -> i32;
+    fn pyroclient_destroy(c: *mut PyroClient);
+}
+
+/// One pending frame, latest wins. Intra-only, so skipping a frame costs nothing downstream.
+struct Pending {
+    frame: Mutex<Option<(Duration, Vec<u8>)>>,
+    ready: Condvar,
+}
+
+pub struct VideoDecoderSink {
+    pending: Arc<Pending>,
+}
+
+impl VideoDecoderSink {
+    pub fn push_frame_nal(&mut self, timestamp: Duration, data: &[u8]) -> Result<bool> {
+        let mut slot = self.pending.frame.lock();
+        if slot.is_some() {
+            warn!("PyroWave: frame replaced before decode (decoder slower than the stream)");
+        }
+        *slot = Some((timestamp, data.to_vec()));
+        self.pending.ready.notify_one();
+        Ok(true)
+    }
+}
+
+pub struct VideoDecoderSource {
+    running: Arc<AtomicBool>,
+    pending: Arc<Pending>,
+    thread: Option<JoinHandle<()>>,
+    decoded: Arc<FrameSlot>,
+}
+
+impl VideoDecoderSource {
+    pub fn dequeue_frame(&mut self) -> Option<(Duration, *mut c_void)> {
+        self.decoded.take().map(|(ts, ptr)| (ts, ptr as *mut c_void))
+    }
+}
+
+impl Drop for VideoDecoderSource {
+    fn drop(&mut self) {
+        self.running.store(false, Ordering::Relaxed);
+        self.pending.ready.notify_all();
+        if let Some(t) = self.thread.take() {
+            t.join().ok();
+        }
+    }
+}
+
+pub fn video_decoder_split(
+    config: VideoDecoderConfig,
+    report_frame_decoded: impl Fn(Result<Duration>) + Send + Sync + 'static,
+) -> Result<(VideoDecoderSink, VideoDecoderSource)> {
+    let cfg = parse_pyrowave_config(&config.config_buffer)?;
+    let pending = Arc::new(Pending {
+        frame: Mutex::new(None),
+        ready: Condvar::new(),
+    });
+    let decoded = Arc::new(FrameSlot::default());
+    let running = Arc::new(AtomicBool::new(true));
+
+    let thread = thread::spawn({
+        let pending = Arc::clone(&pending);
+        let decoded = Arc::clone(&decoded);
+        let running = Arc::clone(&running);
+        move || {
+            // Created here so every Vulkan call the library makes stays on this thread.
+            let client = unsafe {
+                pyroclient_create_ex(
+                    cfg.width,
+                    cfg.height,
+                    cfg.chroma444 as i32,
+                    cfg.full_range as i32,
+                    3,
+                    cfg.wavelet as i32,
+                    cfg.decode_path as i32,
+                )
+            };
+            if client.is_null() {
+                report_frame_decoded(Err(alvr_common::anyhow::anyhow!(
+                    "pyroclient_create_ex failed for {}x{} (see logcat pyroclient)",
+                    cfg.width,
+                    cfg.height
+                )));
+                return;
+            }
+            let mut frames: u64 = 0;
+            let mut failures: u64 = 0;
+            let mut sum_total = 0.0f64;
+            super::telemetry::start(cfg.width, cfg.height);
+            while running.load(Ordering::Relaxed) {
+                let next = {
+                    let mut slot = pending.frame.lock();
+                    while slot.is_none() && running.load(Ordering::Relaxed) {
+                        pending.ready.wait_for(&mut slot, Duration::from_millis(100));
+                    }
+                    slot.take()
+                };
+                let Some((timestamp, data)) = next else {
+                    continue;
+                };
+                let pushed = unsafe { pyroclient_push_packet(client, data.as_ptr(), data.len()) };
+                if pushed < 0 {
+                    warn!("PyroWave: push_packet failed ({pushed})");
+                    continue;
+                }
+                let mut out: *mut c_void = std::ptr::null_mut();
+                let mut info = FrameInfo::default();
+                let rc = unsafe { pyroclient_decode(client, &mut out, &mut info) };
+                if rc != 0 || out.is_null() {
+                    warn!("PyroWave: decode failed ({rc})");
+                    failures += 1;
+                    continue;
+                }
+                decoded.publish(timestamp, out as usize);
+                report_frame_decoded(Ok(timestamp));
+                frames += 1;
+                sum_total += info.total_ms;
+                // TCP delivers every frame whole: all complete, nothing partial or dropped here
+                super::telemetry::record_frame(info.decode_ms as f32, info.total_ms as f32);
+                super::telemetry::set_counters(super::telemetry::Counters {
+                    complete: frames,
+                    decode_failures: failures,
+                    ..Default::default()
+                });
+                if frames % 720 == 0 {
+                    alvr_common::info!(
+                        "[PYROWAVE] {frames} frames, last decode {:.2} ms convert {:.2} ms submit->fence {:.2} ms (mean {:.2}), complete={}",
+                        info.decode_ms, info.convert_ms, info.total_ms, sum_total / frames as f64, info.complete
+                    );
+                }
+            }
+            unsafe { pyroclient_destroy(client) };
+        }
+    });
+
+    Ok((
+        VideoDecoderSink {
+            pending: Arc::clone(&pending),
+        },
+        VideoDecoderSource {
+            running,
+            pending,
+            thread: Some(thread),
+            decoded,
+        },
+    ))
+}
+
+// Keep the compiler honest about the one config field we do not use.
+#[allow(dead_code)]
+fn _unused(config: &VideoDecoderConfig) -> Result<()> {
+    if config.config_buffer.is_empty() {
+        bail!("empty");
+    }
+    Ok(())
+}
