+        let mut buf = Vec::new();
+        buf.extend_from_slice(&1984u32.to_le_bytes());
+        buf.extend_from_slice(&896u32.to_le_bytes());
+        buf.extend_from_slice(&[1, 1, 1]);
+        buf.extend_from_slice(&11_111u16.to_le_bytes());
