new file mode 100644
index 0000000000000000000000000000000000000000..3be93190b208e2811ea657244046718f516760da
--- /dev/null
+++ b/alvr/dashboard/src/dashboard/components/test_report.rs
@@ -0,0 +1,671 @@
+//! "Export PyroWave Test Report": a fixed 60-second measurement window, summarised into one
+//! sanitized JSON file that testers can share. Every report has the same shape, so reports from
+//! many headsets and PCs can be pooled (`xrbench.beta_reports` in the research repo reads them).
+//!
+//! Nothing identifying goes in: no IP or MAC addresses, hostnames, user names or paths, serial
+//! numbers or e-mail addresses. Free text is redacted, and the finished report is checked again
+//! before it is written.
+
+use alvr_events::GraphStatistics;
+use alvr_packets::HeadsetTelemetry;
+use alvr_session::{
+    beta, BitrateMode, CodecType, FrameSize, PyroWaveDecodePath, PyroWaveTransport,
+    PyroWaveWavelet, Settings,
+};
+use serde_json::{json, Value};
+
+pub const SCHEMA_VERSION: u32 = 1;
+pub const TEST_SECONDS: u64 = 60;
+
+/// Nearest rank, as the research harness computes it (`xrbench.matrix._pct`).
+pub fn percentile(values: &[f32], q: f32) -> Option<f32> {
+    let mut xs = values.to_vec();
+    xs.sort_by(|a, b| a.total_cmp(b));
+    (!xs.is_empty()).then(|| xs[((q * xs.len() as f32) as usize).min(xs.len() - 1)])
+}
+
+pub fn mean(values: &[f32]) -> Option<f32> {
+    (!values.is_empty()).then(|| values.iter().sum::<f32>() / values.len() as f32)
+}
+
+/// Mean of the slowest hundredth of per-frame values, at least one (`xrbench.matrix`).
+pub fn one_percent_low(values: &[f32]) -> Option<f32> {
+    let mut xs = values.to_vec();
+    xs.sort_by(|a, b| a.total_cmp(b));
+    let n = (xs.len() / 100).max(1);
+    (!xs.is_empty()).then(|| xs[..n].iter().sum::<f32>() / n as f32)
+}
+
+fn round2(v: f32) -> f64 {
+    (v as f64 * 100.0).round() / 100.0
+}
+
+fn distribution(values: &[f32]) -> Value {
+    if values.is_empty() {
+        return Value::Null;
+    }
+    json!({
+        "mean": mean(values).map(round2),
+        "p50": percentile(values, 0.5).map(round2),
+        "p95": percentile(values, 0.95).map(round2),
+        "p99": percentile(values, 0.99).map(round2),
+    })
+}
+
+// ---- sanitizing ----
+
+fn is_ipv4(token: &str) -> bool {
+    let parts = token.split('.').collect::<Vec<_>>();
+    parts.len() == 4
+        && parts
+            .iter()
+            .all(|p| !p.is_empty() && p.len() <= 3 && p.parse::<u16>().map(|v| v <= 255).unwrap_or(false))
+}
+
+fn is_mac(token: &str) -> bool {
+    let parts = token.split([':', '-']).collect::<Vec<_>>();
+    parts.len() == 6
+        && parts
+            .iter()
+            .all(|p| p.len() == 2 && p.chars().all(|c| c.is_ascii_hexdigit()))
+}
+
+// Compressed ("fe80::1") or full eight-group form; "4:4:4" (chroma) is neither.
+fn is_ipv6(token: &str) -> bool {
+    (token.contains("::") || token.matches(':').count() == 7)
+        && token.chars().all(|c| c.is_ascii_hexdigit() || c == ':')
+        && token.chars().any(|c| c.is_ascii_hexdigit())
+}
+
+fn is_email(token: &str) -> bool {
+    match token.split_once('@') {
+        Some((user, domain)) => !user.is_empty() && domain.contains('.') && !domain.starts_with('.'),
+        None => false,
+    }
+}
+
+/// Uppercase letters and digits mixed, 8 or more: the shape of device serials (and adb ids).
+fn is_serial(token: &str) -> bool {
+    token.len() >= 8
+        && token.chars().all(|c| c.is_ascii_uppercase() || c.is_ascii_digit())
+        && token.chars().any(|c| c.is_ascii_digit())
+        && token.chars().any(|c| c.is_ascii_uppercase())
+}
+
+fn is_hostname(token: &str) -> bool {
+    let lower = token.to_ascii_lowercase();
+    lower.ends_with(".local") || lower.ends_with(".lan") || lower.ends_with(".client.alvr")
+        || lower.ends_with(".alvr")
+}
+
+fn is_user_path(token: &str) -> bool {
+    let lower = token.to_ascii_lowercase().replace('\\', "/");
+    ["c:/users/", "/users/", "/home/", "/storage/emulated/", "/sdcard/"]
+        .iter()
+        .any(|p| lower.contains(p))
+}
+
+fn identifying_kind(token: &str) -> Option<&'static str> {
+    let token = token.trim_matches(|c: char| ",;()[]{}<>\"'".contains(c));
+    let bare = token.trim_end_matches('.');
+    if is_user_path(token) {
+        Some("user path")
+    } else if is_email(bare) {
+        Some("e-mail")
+    } else if is_mac(bare) {
+        Some("MAC address")
+    } else if is_ipv4(bare) || is_ipv4(bare.split(':').next().unwrap_or_default()) {
+        Some("IP address")
+    } else if is_ipv6(bare) {
+        Some("IP address")
+    } else if is_hostname(bare) {
+        Some("hostname")
+    } else if is_serial(bare) {
+        Some("serial-like token")
+    } else {
+        None
+    }
+}
+
+/// Free text with anything identifying replaced by "[redacted]".
+pub fn sanitize_text(text: &str) -> String {
+    text.split_whitespace()
+        .map(|token| {
+            if identifying_kind(token).is_some() {
+                "[redacted]"
+            } else {
+                token
+            }
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// Every identifying token left anywhere in a report, as "kind: token". Empty means clean.
+pub fn find_identifying(value: &Value) -> Vec<String> {
+    let mut found = vec![];
+    let mut visit = |text: &str, found: &mut Vec<String>| {
+        for token in text.split_whitespace() {
+            if let Some(kind) = identifying_kind(token) {
+                found.push(format!("{kind}: {token}"));
+            }
+        }
+    };
+    fn walk(value: &Value, found: &mut Vec<String>, visit: &mut dyn FnMut(&str, &mut Vec<String>)) {
+        match value {
+            Value::String(s) => visit(s, found),
+            Value::Array(items) => items.iter().for_each(|v| walk(v, found, visit)),
+            Value::Object(map) => map.iter().for_each(|(k, v)| {
+                visit(k, found);
+                walk(v, found, visit)
+            }),
+            _ => (),
+        }
+    }
+    walk(value, &mut found, &mut visit);
+    found
+}
+
+// ---- the report ----
+
+#[derive(Clone, Copy, PartialEq, Eq, Default, Debug)]
+pub enum ChromaDifference {
+    #[default]
+    NotCompared,
+    None,
+    Slight,
+    Clear,
+    Large,
+}
+
+impl ChromaDifference {
+    pub const ALL: [Self; 5] = [
+        Self::NotCompared,
+        Self::None,
+        Self::Slight,
+        Self::Clear,
+        Self::Large,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::NotCompared => "not compared",
+            Self::None => "none",
+            Self::Slight => "slight",
+            Self::Clear => "clear",
+            Self::Large => "large",
+        }
+    }
+}
+
+#[derive(Clone, Default, Debug)]
+pub struct Subjective {
+    /// How different 4:4:4 looked against H.264 (4:2:0) on the same content
+    pub chroma_difference: ChromaDifference,
+    /// 1 (poor) to 5 (excellent); `None` when not rated
+    pub sharpness: Option<u8>,
+    pub smoothness: Option<u8>,
+    /// e.g. "Wi-Fi 6E", "Wi-Fi 7", "wired AP"
+    pub link: String,
+    /// e.g. "5 GHz", "6 GHz"
+    pub band: String,
+    pub router_model: String,
+    pub notes: String,
+}
+
+#[derive(Clone, Default, Debug)]
+pub struct SystemInfo {
+    pub gpu: String,
+    pub gpu_driver: String,
+    pub cpu: String,
+    pub os: String,
+    pub streamer_version: String,
+}
+
+/// What the dashboard saw during the window.
+#[derive(Default)]
+pub struct Recording {
+    pub frames: Vec<GraphStatistics>,
+    pub telemetry: Vec<HeadsetTelemetry>,
+    pub packets_lost_start: Option<usize>,
+    pub packets_lost_end: Option<usize>,
+}
+
+fn effective_settings(settings: &Settings, session_settings: &Value) -> Value {
+    let video = &settings.video;
+    let render = match &video.transcoding_view_resolution {
+        FrameSize::Absolute { width, height } => json!([width, height.unwrap_or(*width)]),
+        FrameSize::Scale(scale) => json!({ "scale_of_headset_default": scale }),
+    };
+    let render_percent = match &video.transcoding_view_resolution {
+        FrameSize::Absolute { width, .. } => {
+            Some((*width as f64 * 100.0 / beta::PANEL_PER_EYE.0 as f64).round())
+        }
+        FrameSize::Scale(_) => None,
+    };
+    let pyrowave = video.preferred_codec == CodecType::PyroWave;
+    let foveation = match video.foveated_encoding.as_option() {
+        Some(f) => json!({
+            "enabled": true,
+            "center_size": [round2(f.center_size_x), round2(f.center_size_y * 1000.0) / 1000.0],
+            "edge_ratio": [f.edge_ratio_x, f.edge_ratio_y],
+            "follow_gaze": f.follow_gaze,
+        }),
+        None => json!({ "enabled": false }),
+    };
+    json!({
+        "profile": beta::matching_profile(session_settings).unwrap_or("custom"),
+        "codec": if pyrowave { "PyroWave 4:4:4" } else { "H.264" },
+        "chroma": if pyrowave { "4:4:4" } else { "4:2:0" },
+        "render_per_eye": render,
+        "render_scale_percent": render_percent,
+        "refresh_hz": video.preferred_fps,
+        "bitrate_mbps": match video.bitrate.mode {
+            BitrateMode::ConstantMbps(mbps) => json!(mbps),
+            BitrateMode::Adaptive { .. } => json!("adaptive"),
+        },
+        "pyrowave": pyrowave.then(|| json!({
+            "transport": match video.pyrowave.transport {
+                PyroWaveTransport::Udp => "UDP",
+                PyroWaveTransport::Tcp => "TCP",
+            },
+            "wavelet": match video.pyrowave.wavelet {
+                PyroWaveWavelet::Cdf97 => "CDF 9/7",
+                PyroWaveWavelet::Cdf53 => "CDF 5/3",
+            },
+            "decode_path": match video.pyrowave.decode_path {
+                PyroWaveDecodePath::Compute => "compute",
+                PyroWaveDecodePath::Fragment => "fragment",
+                PyroWaveDecodePath::Auto => "auto",
+            },
+        })),
+        "foveated_encoding": foveation,
+        "advanced_changes": beta::advanced_changes(session_settings),
+    })
+}
+
+fn headset_state(t: Option<&HeadsetTelemetry>) -> Value {
+    match t {
+        Some(t) => json!({
+            "thermal_status": t.thermal_status,
+            "battery_temperature_c": t.battery_temperature_c,
+            "battery_level": t.battery_level.map(round2),
+        }),
+        None => Value::Null,
+    }
+}
+
+pub fn build_report(
+    report_id: &str,
+    settings: &Settings,
+    session_settings: &Value,
+    system: &SystemInfo,
+    recording: &Recording,
+    subjective: &Subjective,
+) -> Value {
+    let series = |f: fn(&GraphStatistics) -> f32| recording.frames.iter().map(f).collect::<Vec<_>>();
+    let ms = |f: fn(&GraphStatistics) -> f32| mean(&series(f)).map(|s| round2(s * 1000.0));
+    let total_ms = series(|g| g.total_pipeline_latency_s * 1000.0);
+    let fps = series(|g| g.client_fps);
+
+    let decode_stats = recording
+        .telemetry
+        .iter()
+        .filter_map(|t| t.pyrowave.as_ref())
+        .collect::<Vec<_>>();
+    let gpu_decode = decode_stats
+        .iter()
+        .flat_map(|s| s.gpu_decode_ms.iter().copied())
+        .collect::<Vec<_>>();
+    let fence = decode_stats
+        .iter()
+        .flat_map(|s| s.fence_ms.iter().copied())
+        .collect::<Vec<_>>();
+    let frame_counts = match (decode_stats.first(), decode_stats.last()) {
+        (Some(first), Some(last)) => json!({
+            "complete": last.complete - first.complete,
+            "partial": last.partial - first.partial,
+            "skipped": last.skipped - first.skipped,
+            "dropped": last.dropped - first.dropped,
+            "superseded": last.superseded - first.superseded,
+            "late_packets": last.stale_packets - first.stale_packets,
+            "decode_failures": last.decode_failures - first.decode_failures,
+        }),
+        _ => Value::Null,
+    };
+    let encoded = decode_stats
+        .last()
+        .filter(|s| s.encoded_width > 0)
+        .map(|s| json!([s.encoded_width, s.encoded_height]));
+
+    let rating = |r: Option<u8>| r.filter(|v| (1..=5).contains(v));
+
+    json!({
+        "schema_version": SCHEMA_VERSION,
+        "report_id": report_id,
+        "kind": "PyroWave beta test report",
+        "settings": effective_settings(settings, session_settings),
+        "encoded_size": encoded,
+        "system": {
+            "gpu": sanitize_text(&system.gpu),
+            "gpu_driver": sanitize_text(&system.gpu_driver),
+            "cpu": sanitize_text(&system.cpu),
+            "os": sanitize_text(&system.os),
+            "streamer_version": system.streamer_version,
+            "headset_model": recording.telemetry.last().map(|t| sanitize_text(&t.model)),
+        },
+        "window": {
+            "seconds": TEST_SECONDS,
+            "frames": recording.frames.len(),
+        },
+        "fps": {
+            "median": percentile(&fps, 0.5).map(round2),
+            "p1_low": one_percent_low(&fps).map(round2),
+            "mean": mean(&fps).map(round2),
+        },
+        "motion_to_photon_ms": distribution(&total_ms),
+        "stage_means_ms": {
+            "game": ms(|g| g.game_time_s),
+            "server_compositor": ms(|g| g.server_compositor_s),
+            "encoder": ms(|g| g.encoder_s),
+            "network": ms(|g| g.network_s),
+            "decoder": ms(|g| g.decoder_s),
+            "decoder_queue": ms(|g| g.decoder_queue_s),
+            "client_compositor": ms(|g| g.client_compositor_s),
+            "vsync_queue": ms(|g| g.vsync_queue_s),
+        },
+        "pyrowave_gpu_decode_ms": distribution(&gpu_decode),
+        "pyrowave_fence_ms": distribution(&fence),
+        "frame_counts": frame_counts,
+        "bitrate_mbps_achieved": mean(&series(|g| g.bitrate_bps / 1e6)).map(round2),
+        "packets_lost": match (recording.packets_lost_start, recording.packets_lost_end) {
+            (Some(start), Some(end)) => json!(end.saturating_sub(start)),
+            _ => Value::Null,
+        },
+        "headset_start": headset_state(recording.telemetry.first()),
+        "headset_end": headset_state(recording.telemetry.last()),
+        "subjective": {
+            "chroma_444_difference": subjective.chroma_difference.label(),
+            "sharpness_1_to_5": rating(subjective.sharpness),
+            "smoothness_1_to_5": rating(subjective.smoothness),
+            "link": sanitize_text(&subjective.link),
+            "band": sanitize_text(&subjective.band),
+            "router_model": sanitize_text(&subjective.router_model),
+            "notes": sanitize_text(&subjective.notes),
+        },
+        "per_frame": {
+            "motion_to_photon_ms": total_ms.iter().map(|v| round2(*v)).collect::<Vec<_>>(),
+            "client_fps": fps.iter().map(|v| round2(*v)).collect::<Vec<_>>(),
+            "gpu_decode_ms": gpu_decode.iter().map(|v| round2(*v)).collect::<Vec<_>>(),
+            "fence_ms": fence.iter().map(|v| round2(*v)).collect::<Vec<_>>(),
+        },
+    })
+}
