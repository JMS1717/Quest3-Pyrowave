+/// The DecoderConfig payload the server's PyroWave encoder sends in place of SPS/PPS:
+/// u32 width, u32 height, u8 chroma444, u8 full_range, little endian.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PyroWaveConfig {
+    pub width: u32,
+    pub height: u32,
+    pub chroma444: bool,
+    pub full_range: bool,
+    /// Frames arrive on our own UDP socket instead of ALVR's video stream.
+    pub udp: bool,
+    /// How long after a frame's first datagram the receiver stops waiting for the rest.
+    pub deadline: Duration,
+    /// 97 (CDF 9/7) or 53 (CDF 5/3); byte 13 of the blob, absent means 9/7.
+    pub wavelet: u8,
+    /// Headset decode path from the dashboard: 0 auto (driver heuristic), 1 fragment, 2 compute.
+    /// Byte 14; absent or unknown means auto. debug.xrwired.decode_path still overrides it.
+    pub decode_path: u8,
+}
+
+impl PyroWaveConfig {
+    /// One line for logcat, the headset's half of the server's "PyroWave effective config".
+    pub fn summary(&self) -> String {
+        format!(
+            "PyroWave effective config (headset): {}x{} chroma={} transport={} wavelet=CDF {} \
+             decode_path={} range={}",
+            self.width,
+            self.height,
+            if self.chroma444 { "4:4:4" } else { "4:2:0" },
+            if self.udp { "UDP" } else { "TCP" },
+            if self.wavelet == 53 { "5/3" } else { "9/7" },
+            match self.decode_path {
+                1 => "fragment",
+                2 => "compute",
+                _ => "auto",
+            },
+            if self.full_range { "full" } else { "limited" },
+        )
+    }
+}
+
+pub fn parse_pyrowave_config(buffer: &[u8]) -> Result<PyroWaveConfig> {
+    use alvr_common::anyhow::bail;
+    if buffer.len() < 10 {
+        bail!("PyroWave decoder config is {} bytes, expected 10", buffer.len());
+    }
+    let width = u32::from_le_bytes(buffer[0..4].try_into().unwrap());
+    let height = u32::from_le_bytes(buffer[4..8].try_into().unwrap());
+    if width == 0 || height == 0 {
+        bail!("PyroWave decoder config has zero geometry");
+    }
+    // Bytes 10.. are optional so an older server's 10-byte blob still parses as TCP.
+    let udp = buffer.len() >= 11 && buffer[10] != 0;
+    let deadline_us = if buffer.len() >= 13 {
+        u16::from_le_bytes([buffer[11], buffer[12]])
+    } else {
+        0
+    };
+    // Byte 13 (Experiment 2): 0 = CDF 9/7, 1 = CDF 5/3. Absent on older servers.
+    let wavelet = if buffer.len() >= 14 && buffer[13] == 1 { 53 } else { 97 };
+    let decode_path = match buffer.get(14) {
+        Some(&path @ (1 | 2)) => path,
+        _ => 0,
+    };
+    Ok(PyroWaveConfig {
+        width,
+        height,
+        chroma444: buffer[8] != 0,
+        full_range: buffer[9] != 0,
+        udp,
+        deadline: Duration::from_micros(if deadline_us == 0 { 13_889 } else { deadline_us as u64 }),
+        wavelet,
+        decode_path,
+    })
+}
+
+/// What the UDP receiver should do with the frame it is assembling, judged once per received
+/// datagram and once per tick. A frame is "complete" when the decoder has every packet; the
+/// deadline is measured from the frame's *first* packet on the receiver's own clock, the only
+/// clock it has (the server's is unrelated). Past the deadline a partial frame is decoded as-is
+/// -- PyroWave fills missing blocks with zero coefficients, which blurs rather than breaks --
+/// unless nothing usable arrived, in which case it is dropped so the next frame is not delayed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FrameDecision {
+    Wait,
+    DecodeComplete,
+    DecodePartial,
+    Drop,
+}
+
+pub fn frame_decision(complete: bool, any_decodable: bool, age: Duration, deadline: Duration) -> FrameDecision {
+    if complete {
+        FrameDecision::DecodeComplete
+    } else if age < deadline {
+        FrameDecision::Wait
+    } else if any_decodable {
+        FrameDecision::DecodePartial
+    } else {
+        FrameDecision::Drop
+    }
+}
+
+/// A complete frame is only worth decoding if nothing newer is already waiting in the socket.
+/// Intra-only, so skipping straight to the newest frame loses nothing but the frame itself,
+/// whereas decoding in arrival order while behind lets the kernel queue fill to its 16 MB and
+/// parks the whole stream 400-600 ms late (measured at 200-300 Mbps).
+pub fn skip_for_newer(ready_ts: u64, queued: impl IntoIterator<Item = u64>) -> bool {
+    queued.into_iter().any(|ts| ts > ready_ts)
+}
+
+/// min / mean / p50 / p95 / p99 / max of a sample set, formatted; "-" when empty.
+pub fn dist(samples: &mut Vec<f32>) -> String {
+    if samples.is_empty() {
+        return "-".into();
+    }
+    samples.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let n = samples.len();
+    let q = |f: f64| samples[((n as f64 - 1.0) * f).round() as usize];
+    let mean = samples.iter().sum::<f32>() / n as f32;
+    format!(
+        "min {:.2} mean {:.2} p50 {:.2} p95 {:.2} p99 {:.2} max {:.2}",
+        samples[0], mean, q(0.5), q(0.95), q(0.99), samples[n - 1]
+    )
+}
+
+/// The newest decoded frame, handed out once. Intra-only codecs can always skip to the newest.
+#[derive(Default)]
+pub struct FrameSlot {
+    inner: alvr_common::parking_lot::Mutex<Option<(Duration, usize)>>,
+}
+
+impl FrameSlot {
+    pub fn publish(&self, timestamp: Duration, buffer: usize) {
+        *self.inner.lock() = Some((timestamp, buffer));
+    }
+    pub fn take(&self) -> Option<(Duration, usize)> {
+        self.inner.lock().take()
+    }
+}
