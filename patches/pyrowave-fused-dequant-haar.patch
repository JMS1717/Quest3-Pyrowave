+bool Decoder::Impl::dequant_haar_final(CommandBuffer &cmd, const ViewBuffers &views)
+{
+	const int mode = payload_r8_image && payload_r16_image && payload_r32_image ? 2 : use_readonly_texel_buffer ? 1 : 0;
+	cmd.set_program(shaders.wavelet_dequant_haar0[mode]);
+	cmd.set_specialization_constant_mask(0);
+	cmd.enable_subgroup_size_control(true);
+	if (device->supports_subgroup_size_log2(true, 4, 7))
+		cmd.set_subgroup_size_log2(true, 4, 7);
+	else if (device->supports_subgroup_size_log2(true, 2, 7))
+		cmd.set_subgroup_size_log2(true, 2, 7);
+	else
+	{
+		LOGE("No compatible subgroup size config.\n");
+		cmd.enable_subgroup_size_control(false);
+		return false;
+	}
+
+	DequantHaarPushData push = {};
+	push.resolution = ivec2(int(wavelet_img_high_res->get_width(0)), int(wavelet_img_high_res->get_height(0)));
+	push.output_size = ivec2(int(views.planes[0]->get_view_width()), int(views.planes[0]->get_view_height()));
+	for (int band = 1; band < 4; band++)
+		push.band_offsets_32x32[band - 1] = block_meta[0][0][band].block_offset_32x32;
+	push.block_stride_32x32 = block_meta[0][0][1].block_stride_32x32;
+	cmd.push_constants(&push, 0, sizeof(push));
+
+	cmd.set_storage_texture(0, 0, *component_layer_views[0][0]);
+	cmd.set_storage_buffer(0, 1, *dequant_offset_buffer);
+	if (mode == 2)
+	{
+		cmd.set_texture(0, 2, payload_r32_image->get_view());
+		cmd.set_texture(0, 3, payload_r16_image->get_view());
+		cmd.set_texture(0, 4, payload_r8_image->get_view());
+	}
+	else if (mode == 1)
+	{
+		cmd.set_buffer_view(0, 2, *payload_u32_view);
+		cmd.set_buffer_view(0, 3, *payload_u16_view);
+		cmd.set_buffer_view(0, 4, *payload_u8_view);
+	}
+	else
+		cmd.set_storage_buffer(0, 2, *payload_data);
+	cmd.set_storage_texture(0, 5, *views.planes[0]);
+
+	cmd.begin_region("Dequant + iDWT final");
+	cmd.dispatch((push.resolution.x + 31) / 32, (push.resolution.y + 31) / 32, 1);
+	cmd.end_region();
+	cmd.enable_subgroup_size_control(false);
+	return true;
+}
